imitMessage).toBeVisible();\n    await expect(limitMessage).toBeFocused();\n    await expect(limitMessage).toHaveCSS('outline', 'rgb(251, 191, 36) solid 3px');\n    await expect(limitMessage).toHaveCSS('outline-offset', '3px');\n\n    const heldByBothTabs = await prisma.seatHold.findMany({\n      where: {\n        flightId: flight.id,\n        seatNumber: { in: [firstSeatName, secondSeatName] },\n      },\n      orderBy: { seatNumber: 'asc' },\n","exit_code":0,"duration":{"secs":0,"nanos":10857},"formatted_output":"214:      expect(dialog.message()).toContain('Are you sure you want to cancel booking for flight');\n217:    await page.click('button:has-text(\"Cancel\")');\n219:    // Confirm cancel status badge and action buttons are gone\n223:    await expect(page.getByTestId(/^booking-status-/).first()).toContainText('Cancelled');\n235:    // The paid booking crosses the real cancellation action and the guarded\n240:      .toHaveText(`${formatPrice(expectedRefundCents)} refund sent.`);\n257:    const pointsTextAfterCancel = await page.locator('p:has-text(\"Status Points\")').textContent();\n258:    const pointsNumAfter = parseInt(pointsTextAfterCancel?.replace(/[^0-9]/g, '') || '0', 10);\n262:    await expect(page.locator('text=❌ Cancelled:').first()).toBeVisible();\n    await page.keyboard.press('Tab');\n    await expect(confirmButton).toBeFocused();\n    await expect(confirmButton).toHaveCSS('outline-style', 'solid');\n    await expect(confirmButton).toHaveCSS('outline-width', '3px');\n    await expect(confirmButton).toHaveCSS('outline-color', 'rgb(251, 191, 36)');\n\n    // Browser timers may be throttled while a checkout is hidden. Advancing\n    // the wall clock drives the same absolute-deadline reconciliation without\n    // waiting ten real minutes.\n    await page.clock.fastForward('10:01');\n\n    await expect(page.getByRole('heading', { name: 'Select Your Seats' })).toBeVisible();\n    await expect(page.getByText(/Your seat hold expired/)).toBeVisible();\