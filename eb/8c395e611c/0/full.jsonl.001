{"timestamp":"2026-08-16T18:39:00.654Z","ordinal":24884,"type":"response_item","payload":{"type":"custom_tool_call","id":"ctc_00fb20eee1c75140016a8203bfd72c8198a26eef0e98b929c0","status":"completed","call_id":"call_mIbzckvTtrOYRhZS2BlR11dw","name":"exec","input":"const r = await tools.exec_command({cmd:\"nl -ba lib/bookingItinerary.ts | sed -n '18,52p'; nl -ba lib/flightLock.ts | sed -n '30,55p'; nl -ba app/profile/page.tsx | sed -n '34,50p'; nl -ba app/admin/page.tsx | sed -n '18,35p'; nl -ba app/admin/flights/page.tsx | sed -n '28,42p'; nl -ba app/actions.ts | sed -n '658,722p'; nl -ba app/actions.ts | sed -n '868,885p'; nl -ba app/actions.ts | sed -n '1420,1436p'; nl -ba lib/FlightBookingService.ts | sed -n '132,160p'; nl -ba lib/FlightBookingService.ts | sed -n '300,315p'; nl -ba prisma/migrations/20260816181000_version_itinerary_legs/migration.sql | sed -n '32,275p'\",\"workdir\":\"/home/scottdensmore/Developer/scottdensmore/travel-app\",\"yield_time_ms\":10000,\"max_output_tokens\":30000});\ntext(r.output);\n","internal_chat_message_metadata_passthrough":{"turn_id":"01a00bba-29dd-7100-8715-811d18e7c7e1"}}}
{"timestamp":"2026-08-16T18:39:00.981Z","ordinal":24885,"type":"event_msg","payload":{"type":"item_completed","thread_id":"019ffe5b-1054-7c22-8afc-e97cb84c7b73","turn_id":"01a00bba-29dd-7100-8715-811d18e7c7e1","item":{"type":"CommandExecution","id":"exec-83c18537-a63f-4ff1-9e86-38edbb36f732","process_id":"66927","command":["/bin/bash","-lc","nl -ba lib/bookingItinerary.ts | sed -n '18,52p'; nl -ba lib/flightLock.ts | sed -n '30,55p'; nl -ba app/profile/page.tsx | sed -n '34,50p'; nl -ba app/admin/page.tsx | sed -n '18,35p'; nl -ba app/admin/flights/page.tsx | sed -n '28,42p'; nl -ba app/actions.ts | sed -n '658,722p'; nl -ba app/actions.ts | sed -n '868,885p'; nl -ba app/actions.ts | sed -n '1420,1436p'; nl -ba lib/FlightBookingService.ts | sed -n '132,160p'; nl -ba lib/FlightBookingService.ts | sed -n '300,315p'; nl -ba prisma/migrations/20260816181000_version_itinerary_legs/migration.sql | sed -n '32,275p'"],"cwd":"file:///home/scottdensmore/Developer/scottdensmore/travel-app","parsed_cmd":[{"type":"read","cmd":"nl -ba lib/bookingItinerary.ts","name":"bookingItinerary.ts","path":"lib/bookingItinerary.ts"},{"type":"read","cmd":"nl -ba lib/flightLock.ts","name":"flightLock.ts","path":"lib/flightLock.ts"},{"type":"read","cmd":"nl -ba app/profile/page.tsx","name":"page.tsx","path":"app/profile/page.tsx"},{"type":"read","cmd":"nl -ba app/admin/page.tsx","name":"page.tsx","path":"app/admin/page.tsx"},{"type":"read","cmd":"nl -ba app/admin/flights/page.tsx","name":"page.tsx","path":"app/admin/flights/page.tsx"},{"type":"read","cmd":"nl -ba app/actions.ts","name":"actions.ts","path":"app/actions.ts"},{"type":"read","cmd":"nl -ba lib/FlightBookingService.ts","name":"FlightBookingService.ts","path":"lib/FlightBookingService.ts"},{"type":"read","cmd":"nl -ba prisma/migrations/20260816181000_version_itinerary_legs/migration.sql","name":"migration.sql","path":"prisma/migrations/20260816181000_version_itinerary_legs/migration.sql"}],"source":"unified_exec_startup","status":"completed","stdout":"    18\texport interface BookingLegs<TFlight> {\n    19\t    legs: Array<{\n    20\t        sequence: number;\n    21\t        flight: TFlight | null;\n    22\t        supersededAt?: Date | string | null;\n    23\t    }>;\n    24\t}\n    25\t\n    26\t/** The database half of the active-leg rule, shared by every relation read. */\n    27\texport const activeItineraryLegWhere = { supersededAt: null } as const;\n    28\t\n    29\t/**\n    30\t * The legs of a booking in itinerary order.\n    31\t *\n    32\t * Historical legs stay attached to the booking after a rebooking. Filter them\n    33\t * here as a final product-code guard, then sort rather than trusting the query:\n    34\t * a caller that forgets either database clause must not render two flights at\n    35\t * the same itinerary position or put the return first.\n    36\t */\n    37\texport function orderedLegs<TLeg extends {\n    38\t    sequence: number;\n    39\t    supersededAt?: Date | string | null;\n    40\t}>(\n    41\t    booking: { legs: TLeg[] }\n    42\t): TLeg[] {\n    43\t    return booking.legs\n    44\t        .filter(leg => leg.supersededAt === undefined || leg.supersededAt === null)\n    45\t        .sort((left, right) => left.sequence - right.sequence);\n    46\t}\n    47\t\n    48\t/**\n    49\t * The flights of a booking, in leg order. A leg whose flight was not loaded is\n    50\t * skipped rather than yielding a hole in the itinerary.\n    51\t */\n    52\texport function bookingFlights<TFlight>(booking: BookingLegs<TFlight>): TFlight[] {\n    30\t): Promise<number[]> {\n    31\t    const locked = await tx.$queryRaw<Array<{ id: number }>>`\n    32\t        SELECT b.\"id\"\n    33\t        FROM \"Booking\" b\n    34\t        WHERE EXISTS (\n    35\t            SELECT 1 FROM \"ItineraryLeg\" l\n    36\t            WHERE l.\"bookingId\" = b.\"id\"\n    37\t              AND l.\"flightId\" = ${flightId}\n    38\t              AND l.\"supersededAt\" IS NULL\n    39\t        )\n    40\t        AND b.\"status\" <> 'CANCELLED'\n    41\t        ORDER BY b.\"id\"\n    42\t        FOR UPDATE\n    43\t    `;\n    44\t    return locked.map(row => row.id);\n    45\t}\n    34\t  const userBookings = await prisma.booking.findMany({\n    35\t    where: { userId },\n    36\t    orderBy: { createdAt: \"desc\" },\n    37\t    include: {\n    38\t      // Read the itinerary through its legs, so a round trip needs no change\n    39\t      // here beyond rendering more than one (#69).\n    40\t      legs: {\n    41\t        where: activeItineraryLegWhere,\n    42\t        include: {\n    43\t          flight: { include: flightRouteInclude },\n    44\t          // The seat is held per leg, so a round trip has a different one on\n    45\t          // each; Passenger.seatNumber only ever described the outbound.\n    46\t          seatAssignments: {\n    47\t            select: {\n    48\t              passengerId: true,\n    49\t              seatNumber: true,\n    50\t              cabinClass: true,\n    18\t        include: {\n    19\t            user: {\n    20\t                select: {\n    21\t                    name: true,\n    22\t                    email: true,\n    23\t                },\n    24\t            },\n    25\t            legs: {\n    26\t                where: activeItineraryLegWhere,\n    27\t                include: { flight: { include: flightRouteInclude } },\n    28\t                orderBy: { sequence: 'asc' },\n    29\t            },\n    30\t        },\n    31\t    });\n    32\t\n    33\t    return (\n    34\t        <div className=\"page-container admin p-8\" style={{ marginTop: '100px', display: 'flex', flexDirection: 'column', gap: '2rem' }}>\n    35\t            <h1 className=\"text-3xl font-bold\" style={{ color: '#fff', margin: 0 }}>Admin Control Center</h1>\n    28\t                gte: utcToday,\n    29\t                lte: next7Days\n    30\t            }\n    31\t        },\n    32\t        include: {\n    33\t            ...flightRouteInclude,\n    34\t            itineraryLegs: {\n    35\t                where: activeItineraryLegWhere,\n    36\t                include: {\n    37\t                    // The seats held on this flight. A traveller on a round trip\n    38\t                    // sits somewhere else on the other leg, so the manifest has\n    39\t                    // to read the assignment rather than Passenger.seatNumber.\n    40\t                    seatAssignments: {\n    41\t                        select: {\n    42\t                            passengerId: true,\n   658\t    const parsed = parseActionInput(numericIdSchema, bookingId);\n   659\t    if (!parsed.ok) return parsed;\n   660\t    bookingId = parsed.data;\n   661\t    const booking = await prisma.booking.findUnique({\n   662\t        where: { id: bookingId },\n   663\t        include: {\n   664\t            legs: {\n   665\t                where: activeItineraryLegWhere,\n   666\t                include: {\n   667\t                    flight: true,\n   668\t                    // The cabin is held per traveller per leg, and the fee is a\n   669\t                    // percentage of each traveller's own fare (#76).\n   670\t                    seatAssignments: { select: { cabinClass: true } },\n   671\t                },\n   672\t                orderBy: { sequence: 'asc' },\n   673\t            },\n   674\t        }\n   675\t    });\n   676\t    if (!booking) throw new Error(\"Booking not found\");\n   677\t\n   678\t    if (!hasVerifiedStaffAccess(session) && booking.userId !== userId) {\n   679\t        throw new Error(\"Unauthorized\");\n   680\t    }\n   681\t\n   682\t    if (!cancellationOutcome(cancellableBooking(booking), new Date()).allowed) {\n   683\t        // A refusal the customer can act on rather than a thrown error: this is\n   684\t        // a policy answer, not a fault. Cancelling a flight that has departed\n   685\t        // would free a seat that was used and take back the status points for a\n   686\t        // trip they took (#76).\n   687\t        return actionValidationFailure(DEPARTED_MESSAGE);\n   688\t    }\n   689\t\n   690\t    let updated;\n   691\t    let refundId: string | null = null;\n   692\t    try {\n   693\t        const cancellation = await prisma.$transaction(async (tx) => {\n   694\t        // Lock in ascending flight order, matching FlightBookingService. Leg\n   695\t        // order would deadlock two itineraries that cover the same flights in\n   696\t        // opposite directions.\n   697\t        const lockOrder = bookingFlights(booking)\n   698\t            .map(flight => flight.id)\n   699\t            .sort((left, right) => left - right);\n   700\t        for (const flightId of lockOrder) {\n   701\t            await lockFlightForUpdate(tx, flightId);\n   702\t        }\n   703\t        // Re-read under the locks, and decide again from what is there now.\n   704\t        //\n   705\t        // The decision above was taken from an unlocked read, and staff can\n   706\t        // cancel a flight in between -- which moves this booking to DISRUPTED\n   707\t        // and makes it fully refundable. Deciding once, before the lock, would\n   708\t        // charge the customer a fee for the airline's cancellation. The read\n   709\t        // outside is what refuses early and cheaply; this is the one that\n   710\t        // counts (#76).\n   711\t        const lockedBooking = await tx.booking.findUnique({\n   712\t            where: { id: bookingId },\n   713\t            include: {\n   714\t                legs: {\n   715\t                    where: activeItineraryLegWhere,\n   716\t                    include: {\n   717\t                        flight: true,\n   718\t                        seatAssignments: { select: { cabinClass: true } },\n   719\t                    },\n   720\t                    orderBy: { sequence: 'asc' },\n   721\t                },\n   722\t            },\n   868\t    bookingId = parsed.data.bookingId;\n   869\t    seatChanges = parsed.data.seatChanges;\n   870\t\n   871\t    const booking = await prisma.booking.findUnique({\n   872\t        where: { id: bookingId },\n   873\t        include: {\n   874\t            legs: {\n   875\t                where: activeItineraryLegWhere,\n   876\t                include: { flight: true },\n   877\t                orderBy: { sequence: 'asc' },\n   878\t            },\n   879\t        }\n   880\t    });\n   881\t    if (!booking) throw new Error(\"Booking not found\");\n   882\t\n   883\t    if (!hasVerifiedStaffAccess(session) && booking.userId !== userId) {\n   884\t        throw new Error(\"Unauthorized\");\n   885\t    }\n  1420\t        const bookings = await tx.booking.findMany({\n  1421\t            where: { id: { in: bookingIds } },\n  1422\t            select: {\n  1423\t                id: true,\n  1424\t                status: true,\n  1425\t                userId: true,\n  1426\t                legs: {\n  1427\t                    where: activeItineraryLegWhere,\n  1428\t                    select: { flight: { select: { status: true } } },\n  1429\t                },\n  1430\t            },\n  1431\t        });\n  1432\t\n  1433\t        // Decided per booking from what its own legs now say, rather than by a\n  1434\t        // predicate over rows that may be mid-change. One cancelled leg\n  1435\t        // disrupts the whole itinerary: half a trip is not a usable trip.\n  1436\t        const changed = bookings.filter(booking => {\n   132\t                if (!flight) throw new Error(\"Flight not found\");\n   133\t                return flight;\n   134\t            });\n   135\t\n   136\t            const existingRequest = await tx.booking.findFirst({\n   137\t                where: { userId, idempotencyKey },\n   138\t                include: {\n   139\t                    legs: {\n   140\t                        where: activeItineraryLegWhere,\n   141\t                        include: { flight: true },\n   142\t                        orderBy: { sequence: 'asc' },\n   143\t                    },\n   144\t                    passengers: {\n   145\t                        select: {\n   146\t                            ...safePassengerSelect,\n   147\t                            dateOfBirthEncrypted: true,\n   148\t                            passportNumberEncrypted: true,\n   149\t                            seatAssignments: {\n   150\t                                where: { leg: activeItineraryLegWhere },\n   151\t                                select: {\n   152\t                                    seatNumber: true,\n   153\t                                    cabinClass: true,\n   154\t                                    leg: { select: { sequence: true } },\n   155\t                                },\n   156\t                            },\n   157\t                        }\n   158\t                    }\n   159\t                }\n   160\t            });\n   300\t                    idempotencyKey,\n   301\t                    passengers: {\n   302\t                        create: protectedPassengers\n   303\t                    }\n   304\t                },\n   305\t                include: {\n   306\t                    passengers: { select: safePassengerSelect },\n   307\t                    legs: {\n   308\t                        where: activeItineraryLegWhere,\n   309\t                        orderBy: { sequence: 'asc' },\n   310\t                    }\n   311\t                }\n   312\t            });\n   313\t\n   314\t            // Seat assignments need each leg's identity, so they follow the\n   315\t            // booking. Written from the same arrays the legs and passengers came\n    32\t-- without deleting audit history.\n    33\t\n    34\tCREATE TYPE \"RebookingFarePolicy\" AS ENUM ('DISRUPTION_WAIVER');\n    35\t\n    36\tALTER TABLE \"ItineraryLeg\"\n    37\t    ADD COLUMN \"supersededAt\" TIMESTAMP(3);\n    38\t\n    39\tDROP INDEX \"ItineraryLeg_bookingId_sequence_key\";\n    40\t\n    41\t-- Historical rows may share a position; exactly one current row may not.\n    42\tCREATE UNIQUE INDEX \"ItineraryLeg_active_booking_sequence_key\"\n    43\t    ON \"ItineraryLeg\"(\"bookingId\", \"sequence\")\n    44\t    WHERE \"supersededAt\" IS NULL;\n    45\t\n    46\tCREATE INDEX \"ItineraryLeg_bookingId_supersededAt_sequence_idx\"\n    47\t    ON \"ItineraryLeg\"(\"bookingId\", \"supersededAt\", \"sequence\");\n    48\t\n    49\tCREATE TABLE \"BookingRebooking\" (\n    50\t    \"id\" TEXT NOT NULL,\n    51\t    \"bookingId\" INTEGER NOT NULL,\n    52\t    \"bookingStatusChangeId\" TEXT NOT NULL,\n    53\t    \"farePolicy\" \"RebookingFarePolicy\" NOT NULL DEFAULT 'DISRUPTION_WAIVER',\n    54\t    \"createdAt\" TIMESTAMP(3) NOT NULL DEFAULT CURRENT_TIMESTAMP,\n    55\t\n    56\t    CONSTRAINT \"BookingRebooking_pkey\" PRIMARY KEY (\"id\")\n    57\t);\n    58\t\n    59\tCREATE UNIQUE INDEX \"BookingRebooking_bookingStatusChangeId_key\"\n    60\t    ON \"BookingRebooking\"(\"bookingStatusChangeId\");\n    61\tCREATE INDEX \"BookingRebooking_bookingId_createdAt_idx\"\n    62\t    ON \"BookingRebooking\"(\"bookingId\", \"createdAt\");\n    63\t\n    64\tALTER TABLE \"BookingRebooking\"\n    65\t    ADD CONSTRAINT \"BookingRebooking_bookingId_fkey\"\n    66\t        FOREIGN KEY (\"bookingId\") REFERENCES \"Booking\"(\"id\")\n    67\t        ON DELETE CASCADE ON UPDATE CASCADE,\n    68\t    ADD CONSTRAINT \"BookingRebooking_bookingStatusChangeId_fkey\"\n    69\t        FOREIGN KEY (\"bookingStatusChangeId\") REFERENCES \"BookingStatusChange\"(\"id\")\n    70\t        ON DELETE NO ACTION ON UPDATE CASCADE;\n    71\t\n    72\tCREATE TABLE \"BookingRebookingLeg\" (\n    73\t    \"rebookingId\" TEXT NOT NULL,\n    74\t    \"fromLegId\" INTEGER NOT NULL,\n    75\t    \"toLegId\" INTEGER NOT NULL,\n    76\t\n    77\t    CONSTRAINT \"BookingRebookingLeg_pkey\" PRIMARY KEY (\"rebookingId\", \"fromLegId\"),\n    78\t    CONSTRAINT \"BookingRebookingLeg_different_legs\" CHECK (\"fromLegId\" <> \"toLegId\")\n    79\t);\n    80\t\n    81\tCREATE UNIQUE INDEX \"BookingRebookingLeg_fromLegId_key\"\n    82\t    ON \"BookingRebookingLeg\"(\"fromLegId\");\n    83\tCREATE UNIQUE INDEX \"BookingRebookingLeg_toLegId_key\"\n    84\t    ON \"BookingRebookingLeg\"(\"toLegId\");\n    85\t\n    86\tALTER TABLE \"BookingRebookingLeg\"\n    87\t    ADD CONSTRAINT \"BookingRebookingLeg_rebookingId_fkey\"\n    88\t        FOREIGN KEY (\"rebookingId\") REFERENCES \"BookingRebooking\"(\"id\")\n    89\t        ON DELETE CASCADE ON UPDATE CASCADE,\n    90\t    ADD CONSTRAINT \"BookingRebookingLeg_fromLegId_fkey\"\n    91\t        FOREIGN KEY (\"fromLegId\") REFERENCES \"ItineraryLeg\"(\"id\")\n    92\t        ON DELETE NO ACTION ON UPDATE CASCADE,\n    93\t    ADD CONSTRAINT \"BookingRebookingLeg_toLegId_fkey\"\n    94\t        FOREIGN KEY (\"toLegId\") REFERENCES \"ItineraryLeg\"(\"id\")\n    95\t        ON DELETE NO ACTION ON UPDATE CASCADE;\n    96\t\n    97\t-- Every historical leg has to become historical through the recorded update\n    98\t-- below. Accepting a row that starts superseded would bypass that audit path.\n    99\tCREATE FUNCTION \"require_new_itinerary_leg_active\"()\n   100\tRETURNS TRIGGER AS $$\n   101\tBEGIN\n   102\t    IF NEW.\"supersededAt\" IS NOT NULL THEN\n   103\t        RAISE EXCEPTION\n   104\t            'A new ItineraryLeg must start active; supersede it through a recorded rebooking.';\n   105\t    END IF;\n   106\t    RETURN NEW;\n   107\tEND;\n   108\t$$ LANGUAGE plpgsql;\n   109\t\n   110\tCREATE TRIGGER \"ItineraryLeg_starts_active\"\n   111\t    BEFORE INSERT ON \"ItineraryLeg\"\n   112\t    FOR EACH ROW EXECUTE FUNCTION \"require_new_itinerary_leg_active\"();\n   113\t\n   114\t-- A leg is historical forever once replaced. Changing the timestamp would\n   115\t-- rewrite when it stopped being the customer's itinerary; clearing it would\n   116\t-- make two histories current again.\n   117\tCREATE FUNCTION \"refuse_itinerary_leg_unsupersession\"()\n   118\tRETURNS TRIGGER AS $$\n   119\tBEGIN\n   120\t    IF OLD.\"supersededAt\" IS NOT NULL\n   121\t       AND NEW.\"supersededAt\" IS DISTINCT FROM OLD.\"supersededAt\" THEN\n   122\t        RAISE EXCEPTION\n   123\t            'ItineraryLeg supersession is permanent: leg % cannot become active or change time.',\n   124\t            OLD.\"id\";\n   125\t    END IF;\n   126\t    RETURN NEW;\n   127\tEND;\n   128\t$$ LANGUAGE plpgsql;\n   129\t\n   130\tCREATE TRIGGER \"ItineraryLeg_supersession_is_permanent\"\n   131\t    BEFORE UPDATE OF \"supersededAt\" ON \"ItineraryLeg\"\n   132\t    FOR EACH ROW EXECUTE FUNCTION \"refuse_itinerary_leg_unsupersession\"();\n   133\t\n   134\t-- A superseded leg must be named by an immutable rebooking mapping before its\n   135\t-- transaction commits. Deferred because the event and replacement leg are\n   136\t-- naturally written after the original leg is marked historical.\n   137\tCREATE FUNCTION \"require_recorded_leg_supersession\"()\n   138\tRETURNS TRIGGER AS $$\n   139\tBEGIN\n   140\t    IF NOT EXISTS (SELECT 1 FROM \"ItineraryLeg\" WHERE \"id\" = NEW.\"id\") THEN\n   141\t        RETURN NULL;\n   142\t    END IF;\n   143\t    IF NOT EXISTS (\n   144\t        SELECT 1 FROM \"BookingRebookingLeg\" WHERE \"fromLegId\" = NEW.\"id\"\n   145\t    ) THEN\n   146\t        RAISE EXCEPTION\n   147\t            'Superseded ItineraryLeg % must be recorded by a BookingRebookingLeg.',\n   148\t            NEW.\"id\";\n   149\t    END IF;\n   150\t    RETURN NULL;\n   151\tEND;\n   152\t$$ LANGUAGE plpgsql;\n   153\t\n   154\tCREATE CONSTRAINT TRIGGER \"ItineraryLeg_supersession_is_recorded\"\n   155\t    AFTER UPDATE OF \"supersededAt\" ON \"ItineraryLeg\"\n   156\t    DEFERRABLE INITIALLY DEFERRED\n   157\t    FOR EACH ROW\n   158\t    WHEN (OLD.\"supersededAt\" IS NULL AND NEW.\"supersededAt\" IS NOT NULL)\n   159\t    EXECUTE FUNCTION \"require_recorded_leg_supersession\"();\n   160\t\n   161\t-- The status row is the booking-wide audit sequence. A rebooking can only be\n   162\t-- attached to the transition that resolves a disruption, for the same\n   163\t-- booking, and cannot simultaneously claim a refund.\n   164\tCREATE FUNCTION \"validate_booking_rebooking\"()\n   165\tRETURNS TRIGGER AS $$\n   166\tDECLARE\n   167\t    change \"BookingStatusChange\";\n   168\tBEGIN\n   169\t    SELECT * INTO change\n   170\t    FROM \"BookingStatusChange\"\n   171\t    WHERE \"id\" = NEW.\"bookingStatusChangeId\";\n   172\t\n   173\t    IF NOT FOUND\n   174\t       OR change.\"bookingId\" <> NEW.\"bookingId\"\n   175\t       OR change.\"from\" IS DISTINCT FROM 'DISRUPTED'::\"BookingStatus\"\n   176\t       OR change.\"to\" IS DISTINCT FROM 'CONFIRMED'::\"BookingStatus\"\n   177\t       OR change.\"refundCents\" IS NOT NULL THEN\n   178\t        RAISE EXCEPTION\n   179\t            'BookingRebooking must match one non-refunding DISRUPTED to CONFIRMED status change.';\n   180\t    END IF;\n   181\t    RETURN NEW;\n   182\tEND;\n   183\t$$ LANGUAGE plpgsql;\n   184\t\n   185\tCREATE TRIGGER \"BookingRebooking_is_consistent\"\n   186\t    BEFORE INSERT ON \"BookingRebooking\"\n   187\t    FOR EACH ROW EXECUTE FUNCTION \"validate_booking_rebooking\"();\n   188\t\n   189\t-- Both legs remain real rows. The old one must already be historical, the new\n   190\t-- one current, and both must occupy the same position in this booking.\n   191\tCREATE FUNCTION \"validate_booking_rebooking_leg\"()\n   192\tRETURNS TRIGGER AS $$\n   193\tDECLARE\n   194\t    event_booking_id INTEGER;\n   195\t    from_booking_id INTEGER;\n   196\t    from_sequence INTEGER;\n   197\t    from_superseded_at TIMESTAMP(3);\n   198\t    to_booking_id INTEGER;\n   199\t    to_sequence INTEGER;\n   200\t    to_superseded_at TIMESTAMP(3);\n   201\tBEGIN\n   202\t    SELECT \"bookingId\" INTO event_booking_id\n   203\t    FROM \"BookingRebooking\"\n   204\t    WHERE \"id\" = NEW.\"rebookingId\";\n   205\t    SELECT \"bookingId\", \"sequence\", \"supersededAt\"\n   206\t        INTO from_booking_id, from_sequence, from_superseded_at\n   207\t    FROM \"ItineraryLeg\" WHERE \"id\" = NEW.\"fromLegId\";\n   208\t    SELECT \"bookingId\", \"sequence\", \"supersededAt\"\n   209\t        INTO to_booking_id, to_sequence, to_superseded_at\n   210\t    FROM \"ItineraryLeg\" WHERE \"id\" = NEW.\"toLegId\";\n   211\t\n   212\t    IF event_booking_id IS NULL\n   213\t       OR from_booking_id IS NULL\n   214\t       OR to_booking_id IS NULL\n   215\t       OR from_booking_id <> event_booking_id\n   216\t       OR to_booking_id <> event_booking_id\n   217\t       OR from_sequence <> to_sequence\n   218\t       OR from_superseded_at IS NULL\n   219\t       OR to_superseded_at IS NOT NULL THEN\n   220\t        RAISE EXCEPTION\n   221\t            'BookingRebookingLeg must map superseded and active legs from the same booking and same itinerary position.';\n   222\t    END IF;\n   223\t    RETURN NEW;\n   224\tEND;\n   225\t$$ LANGUAGE plpgsql;\n   226\t\n   227\tCREATE TRIGGER \"BookingRebookingLeg_is_consistent\"\n   228\t    BEFORE INSERT ON \"BookingRebookingLeg\"\n   229\t    FOR EACH ROW EXECUTE FUNCTION \"validate_booking_rebooking_leg\"();\n   230\t\n   231\t-- An event with no leg mapping says a rebooking happened but cannot say what\n   232\t-- changed. Deferred so a normal transaction can insert the event first.\n   233\tCREATE FUNCTION \"require_rebooking_legs\"()\n   234\tRETURNS TRIGGER AS $$\n   235\tBEGIN\n   236\t    IF NOT EXISTS (SELECT 1 FROM \"BookingRebooking\" WHERE \"id\" = NEW.\"id\") THEN\n   237\t        RETURN NULL;\n   238\t    END IF;\n   239\t    IF NOT EXISTS (\n   240\t        SELECT 1 FROM \"BookingRebookingLeg\" WHERE \"rebookingId\" = NEW.\"id\"\n   241\t    ) THEN\n   242\t        RAISE EXCEPTION 'BookingRebooking % must map at least one itinerary leg.', NEW.\"id\";\n   243\t    END IF;\n   244\t    RETURN NULL;\n   245\tEND;\n   246\t$$ LANGUAGE plpgsql;\n   247\t\n   248\tCREATE CONSTRAINT TRIGGER \"BookingRebooking_has_legs\"\n   249\t    AFTER INSERT ON \"BookingRebooking\"\n   250\t    DEFERRABLE INITIALLY DEFERRED\n   251\t    FOR EACH ROW EXECUTE FUNCTION \"require_rebooking_legs\"();\n   252\t\n   253\t-- Updates rewrite audit history. Deletes remain available only through the\n   254\t-- booking cascade, matching BookingStatusChange and test-data cleanup.\n   255\tCREATE FUNCTION \"refuse_rebooking_audit_update\"()\n   256\tRETURNS TRIGGER AS $$\n   257\tBEGIN\n   258\t    RAISE EXCEPTION '% is append-only and cannot be modified.', TG_TABLE_NAME;\n   259\tEND;\n   260\t$$ LANGUAGE plpgsql;\n   261\t\n   262\tCREATE TRIGGER \"BookingRebooking_is_append_only\"\n   263\t    BEFORE UPDATE ON \"BookingRebooking\"\n   264\t    FOR EACH ROW EXECUTE FUNCTION \"refuse_rebooking_audit_update\"();\n   265\t\n   266\tCREATE TRIGGER \"BookingRebookingLeg_is_append_only\"\n   267\t    BEFORE UPDATE ON \"BookingRebookingLeg\"\n   268\t    FOR EACH ROW EXECUTE FUNCTION \"refuse_rebooking_audit_update\"();\n","stderr":"","aggregated_output":"    18\texport interface BookingLegs<TFlight> {\n    19\t    legs: Array<{\n    20\t        sequence: number;\n    21\t        flight: TFlight | null;\n    22\t        supersededAt?: Date | string | null;\n    23\t    }>;\n    24\t}\n    25\t\n    26\t/** The database half of the active-leg rule, shared by every relation read. */\n    27\texport const activeItineraryLegWhere = { supersededAt: null } as const;\n    28\t\n    29\t/**\n    30\t * The legs of a booking in itinerary order.\n    31\t *\n    32\t * Historical legs stay attached to the booking after a rebooking. Filter them\n    33\t * here as a final product-code guard, then sort rather than trusting the query:\n    34\t * a caller that forgets either database clause must not render two flights at\n    35\t * the same itinerary position or put the return first.\n    36\t */\n    37\texport function orderedLegs<TLeg extends {\n    38\t    sequence: number;\n    39\t    supersededAt?: Date | string | null;\n    40\t}>(\n    41\t    booking: { legs: TLeg[] }\n    42\t): TLeg[] {\n    43\t    return booking.legs\n    44\t        .filter(leg => leg.supersededAt === undefined || leg.supersededAt === null)\n    45\t        .sort((left, right) => left.sequence - right.sequence);\n    46\t}\n    47\t\n    48\t/**\n    49\t * The flights of a booking, in leg order. A leg whose flight was not loaded is\n    50\t * skipped rather than yielding a hole in the itinerary.\n    51\t */\n    52\texport function bookingFlights<TFlight>(booking: BookingLegs<TFlight>): TFlight[] {\n    30\t): Promise<number[]> {\n    31\t    const locked = await tx.$queryRaw<Array<{ id: number }>>`\n    32\t        SELECT b.\"id\"\n    33\t        FROM \"Booking\" b\n    34\t        WHERE EXISTS (\n    35\t            SELECT 1 FROM \"ItineraryLeg\" l\n    36\t            WHERE l.\"bookingId\" = b.\"id\"\n    37\t              AND l.\"flightId\" = ${flightId}\n    38\t              AND l.\"supersededAt\" IS NULL\n    39\t        )\n    40\t        AND b.\"status\" <> 'CANCELLED'\n    41\t        ORDER BY b.\"id\"\n    42\t        FOR UPDATE\n    43\t    `;\n    44\t    return locked.map(row => row.id);\n    45\t}\n    34\t  const userBookings = await prisma.booking.findMany({\n    35\t    where: { userId },\n    36\t    orderBy: { createdAt: \"desc\" },\n    37\t    include: {\n    38\t      // Read the itinerary through its legs, so a round trip needs no change\n    39\t      // here beyond rendering more than one (#69).\n    40\t      legs: {\n    41\t        where: activeItineraryLegWhere,\n    42\t        include: {\n    43\t          flight: { include: flightRouteInclude },\n    44\t          // The seat is held per leg, so a round trip has a different one on\n    45\t          // each; Passenger.seatNumber only ever described the outbound.\n    46\t          seatAssignments: {\n    47\t            select: {\n    48\t              passengerId: true,\n    49\t              seatNumber: true,\n    50\t              cabinClass: true,\n    18\t        include: {\n    19\t            user: {\n    20\t                select: {\n    21\t                    name: true,\n    22\t                    email: true,\n    23\t                },\n    24\t            },\n    25\t            legs: {\n    26\t                where: activeItineraryLegWhere,\n    27\t                include: { flight: { include: flightRouteInclude } },\n    28\t                orderBy: { sequence: 'asc' },\n    29\t            },\n    30\t        },\n    31\t    });\n    32\t\n    33\t    return (\n    34\t        <div className=\"page-container admin p-8\" style={{ marginTop: '100px', display: 'flex', flexDirection: 'column', gap: '2rem' }}>\n    35\t            <h1 className=\"text-3xl font-bold\" style={{ color: '#fff', margin: 0 }}>Admin Control Center</h1>\n    28\t                gte: utcToday,\n    29\t                lte: next7Days\n    30\t            }\n    31\t        },\n    32\t        include: {\n    33\t            ...flightRouteInclude,\n    34\t            itineraryLegs: {\n    35\t                where: activeItineraryLegWhere,\n    36\t                include: {\n    37\t                    // The seats held on this flight. A traveller on a round trip\n    38\t                    // sits somewhere else on the other leg, so the manifest has\n    39\t                    // to read the assignment rather than Passenger.seatNumber.\n    40\t                    seatAssignments: {\n    41\t                        select: {\n    42\t                            passengerId: true,\n   658\t    const parsed = parseActionInput(numericIdSchema, bookingId);\n   659\t    if (!parsed.ok) return parsed;\n   660\t    bookingId = parsed.data;\n   661\t    const booking = await prisma.booking.findUnique({\n   662\t        where: { id: bookingId },\n   663\t        include: {\n   664\t            legs: {\n   665\t                where: activeItineraryLegWhere,\n   666\t                include: {\n   667\t                    flight: true,\n   668\t                    // The cabin is held per traveller per leg, and the fee is a\n   669\t                    // percentage of each traveller's own fare (#76).\n   670\t                    seatAssignments: { select: { cabinClass: true } },\n   671\t                },\n   672\t                orderBy: { sequence: 'asc' },\n   673\t            },\n   674\t        }\n   675\t    });\n   676\t    if (!booking) throw new Error(\"Booking not found\");\n   677\t\n   678\t    if (!hasVerifiedStaffAccess(session) && booking.userId !== userId) {\n   679\t        throw new Error(\"Unauthorized\");\n   680\t    }\n   681\t\n   682\t    if (!cancellationOutcome(cancellableBooking(booking), new Date()).allowed) {\n   683\t        // A refusal the customer can act on rather than a thrown error: this is\n   684\t        // a policy answer, not a fault. Cancelling a flight that has departed\n   685\t        // would free a seat that was used and take back the status points for a\n   686\t        // trip they took (#76).\n   687\t        return actionValidationFailure(DEPARTED_MESSAGE);\n   688\t    }\n   689\t\n   690\t    let updated;\n   691\t    let refundId: string | null = null;\n   692\t    try {\n   693\t        const cancellation = await prisma.$transaction(async (tx) => {\n   694\t        // Lock in ascending flight order, matching FlightBookingService. Leg\n   695\t        // order would deadlock two itineraries that cover the same flights in\n   696\t        // opposite directions.\n   697\t        const lockOrder = bookingFlights(booking)\n   698\t            .map(flight => flight.id)\n   699\t            .sort((left, right) => left - right);\n   700\t        for (const flightId of lockOrder) {\n   701\t            await lockFlightForUpdate(tx, flightId);\n   702\t        }\n   703\t        // Re-read under the locks, and decide again from what is there now.\n   704\t        //\n   705\t        // The decision above was taken from an unlocked read, and staff can\n   706\t        // cancel a flight in between -- which moves this booking to DISRUPTED\n   707\t        // and makes it fully refundable. Deciding once, before the lock, would\n   708\t        // charge the customer a fee for the airline's cancellation. The read\n   709\t        // outside is what refuses early and cheaply; this is the one that\n   710\t        // counts (#76).\n   711\t        const lockedBooking = await tx.booking.findUnique({\n   712\t            where: { id: bookingId },\n   713\t            include: {\n   714\t                legs: {\n   715\t                    where: activeItineraryLegWhere,\n   716\t                    include: {\n   717\t                        flight: true,\n   718\t                        seatAssignments: { select: { cabinClass: true } },\n   719\t                    },\n   720\t                    orderBy: { sequence: 'asc' },\n   721\t                },\n   722\t            },\n   868\t    bookingId = parsed.data.bookingId;\n   869\t    seatChanges = parsed.data.seatChanges;\n   870\t\n   871\t    const booking = await prisma.booking.findUnique({\n   872\t        where: { id: bookingId },\n   873\t        include: {\n   874\t            legs: {\n   875\t                where: activeItineraryLegWhere,\n   876\t                include: { flight: true },\n   877\t                orderBy: { sequence: 'asc' },\n   878\t            },\n   879\t        }\n   880\t    });\n   881\t    if (!booking) throw new Error(\"Booking not found\");\n   882\t\n   883\t    if (!hasVerifiedStaffAccess(session) && booking.userId !== userId) {\n   884\t        throw new Error(\"Unauthorized\");\n   885\t    }\n  1420\t        const bookings = await tx.booking.findMany({\n  1421\t            where: { id: { in: bookingIds } },\n  1422\t            select: {\n  1423\t                id: true,\n  1424\t                status: true,\n  1425\t                userId: true,\n  1426\t                legs: {\n  1427\t                    where: activeItineraryLegWhere,\n  1428\t                    select: { flight: { select: { status: true } } },\n  1429\t                },\n  1430\t            },\n  1431\t        });\n  1432\t\n  1433\t        // Decided per booking from what its own legs now say, rather than by a\n  1434\t        // predicate over rows that may be mid-change. One cancelled leg\n  1435\t        // disrupts the whole itinerary: half a trip is not a usable trip.\n  1436\t        const changed = bookings.filter(booking => {\n   132\t                if (!flight) throw new Error(\"Flight not found\");\n   133\t                return flight;\n   134\t            });\n   135\t\n   136\t            const existingRequest = await tx.booking.findFirst({\n   137\t                where: { userId, idempotencyKey },\n   138\t                include: {\n   139\t                    legs: {\n   140\t                        where: activeItineraryLegWhere,\n   141\t                        include: { flight: true },\n   142\t                        orderBy: { sequence: 'asc' },\n   143\t                    },\n   144\t                    passengers: {\n   145\t                        select: {\n   146\t                            ...safePassengerSelect,\n   147\t                            dateOfBirthEncrypted: true,\n   148\t                            passportNumberEncrypted: true,\n   149\t                            seatAssignments: {\n   150\t                                where: { leg: activeItineraryLegWhere },\n   151\t                                select: {\n   152\t                                    seatNumber: true,\n   153\t                                    cabinClass: true,\n   154\t                                    leg: { select: { sequence: true } },\n   155\t                                },\n   156\t                            },\n   157\t                        }\n   158\t                    }\n   159\t                }\n   160\t            });\n   300\t                    idempotencyKey,\n   301\t                    passengers: {\n   302\t                        create: protectedPassengers\n   303\t                    }\n   304\t                },\n   305\t                include: {\n   306\t                    passengers: { select: safePassengerSelect },\n   307\t                    legs: {\n   308\t                        where: activeItineraryLegWhere,\n   309\t                        orderBy: { sequence: 'asc' },\n   310\t                    }\n   311\t                }\n   312\t            });\n   313\t\n   314\t            // Seat assignments need each leg's identity, so they follow the\n   315\t            // booking. Written from the same arrays the legs and passengers came\n    32\t-- without deleting audit history.\n    33\t\n    34\tCREATE TYPE \"RebookingFarePolicy\" AS ENUM ('DISRUPTION_WAIVER');\n    35\t\n    36\tALTER TABLE \"ItineraryLeg\"\n    37\t    ADD COLUMN \"supersededAt\" TIMESTAMP(3);\n    38\t\n    39\tDROP INDEX \"ItineraryLeg_bookingId_sequence_key\";\n    40\t\n    41\t-- Historical rows may share a position; exactly one current row may not.\n    42\tCREATE UNIQUE INDEX \"ItineraryLeg_active_booking_sequence_key\"\n    43\t    ON \"ItineraryLeg\"(\"bookingId\", \"sequence\")\n    44\t    WHERE \"supersededAt\" IS NULL;\n    45\t\n    46\tCREATE INDEX \"ItineraryLeg_bookingId_supersededAt_sequence_idx\"\n    47\t    ON \"ItineraryLeg\"(\"bookingId\", \"supersededAt\", \"sequence\");\n    48\t\n    49\tCREATE TABLE \"BookingRebooking\" (\n    50\t    \"id\" TEXT NOT NULL,\n    51\t    \"bookingId\" INTEGER NOT NULL,\n    52\t    \"bookingStatusChangeId\" TEXT NOT NULL,\n    53\t    \"farePolicy\" \"RebookingFarePolicy\" NOT NULL DEFAULT 'DISRUPTION_WAIVER',\n    54\t    \"createdAt\" TIMESTAMP(3) NOT NULL DEFAULT CURRENT_TIMESTAMP,\n    55\t\n    56\t    CONSTRAINT \"BookingRebooking_pkey\" PRIMARY KEY (\"id\")\n    57\t);\n    58\t\n    59\tCREATE UNIQUE INDEX \"BookingRebooking_bookingStatusChangeId_key\"\n    60\t    ON \"BookingRebooking\"(\"bookingStatusChangeId\");\n    61\tCREATE INDEX \"BookingRebooking_bookingId_createdAt_idx\"\n    62\t    ON \"BookingRebooking\"(\"bookingId\", \"createdAt\");\n    63\t\n    64\tALTER TABLE \"BookingRebooking\"\n    65\t    ADD CONSTRAINT \"BookingRebooking_bookingId_fkey\"\n    66\t        FOREIGN KEY (\"bookingId\") REFERENCES \"Booking\"(\"id\")\n    67\t        ON DELETE CASCADE ON UPDATE CASCADE,\n    68\t    ADD CONSTRAINT \"BookingRebooking_bookingStatusChangeId_fkey\"\n    69\t        FOREIGN KEY (\"bookingStatusChangeId\") REFERENCES \"BookingStatusChange\"(\"id\")\n    70\t        ON DELETE NO ACTION ON UPDATE CASCADE;\n    71\t\n    72\tCREATE TABLE \"BookingRebookingLeg\" (\n    73\t    \"rebookingId\" TEXT NOT NULL,\n    74\t    \"fromLegId\" INTEGER NOT NULL,\n    75\t    \"toLegId\" INTEGER NOT NULL,\n    76\t\n    77\t    CONSTRAINT \"BookingRebookingLeg_pkey\" PRIMARY KEY (\"rebookingId\", \"fromLegId\"),\n    78\t    CONSTRAINT \"BookingRebookingLeg_different_legs\" CHECK (\"fromLegId\" <> \"toLegId\")\n    79\t);\n    80\t\n    81\tCREATE UNIQUE INDEX \"BookingRebookingLeg_fromLegId_key\"\n    82\t    ON \"BookingRebookingLeg\"(\"fromLegId\");\n    83\tCREATE UNIQUE INDEX \"BookingRebookingLeg_toLegId_key\"\n    84\t    ON \"BookingRebookingLeg\"(\"toLegId\");\n    85\t\n    86\tALTER TABLE \"BookingRebookingLeg\"\n    87\t    ADD CONSTRAINT \"BookingRebookingLeg_rebookingId_fkey\"\n    88\t        FOREIGN KEY (\"rebookingId\") REFERENCES \"BookingRebooking\"(\"id\")\n    89\t        ON DELETE CASCADE ON UPDATE CASCADE,\n    90\t    ADD CONSTRAINT \"BookingRebookingLeg_fromLegId_fkey\"\n    91\t        FOREIGN KEY (\"fromLegId\") REFERENCES \"ItineraryLeg\"(\"id\")\n    92\t        ON DELETE NO ACTION ON UPDATE CASCADE,\n    93\t    ADD CONSTRAINT \"BookingRebookingLeg_toLegId_fkey\"\n    94\t        FOREIGN KEY (\"toLegId\") REFERENCES \"ItineraryLeg\"(\"id\")\n    95\t        ON DELETE NO ACTION ON UPDATE CASCADE;\n    96\t\n    97\t-- Every historical leg has to become historical through the recorded update\n    98\t-- below. Accepting a row that starts superseded would bypass that audit path.\n    99\tCREATE FUNCTION \"require_new_itinerary_leg_active\"()\n   100\tRETURNS TRIGGER AS $$\n   101\tBEGIN\n   102\t    IF NEW.\"supersededAt\" IS NOT NULL THEN\n   103\t        RAISE EXCEPTION\n   104\t            'A new ItineraryLeg must start active; supersede it through a recorded rebooking.';\n   105\t    END IF;\n   106\t    RETURN NEW;\n   107\tEND;\n   108\t$$ LANGUAGE plpgsql;\n   109\t\n   110\tCREATE TRIGGER \"ItineraryLeg_starts_active\"\n   111\t    BEFORE INSERT ON \"ItineraryLeg\"\n   112\t    FOR EACH ROW EXECUTE FUNCTION \"require_new_itinerary_leg_active\"();\n   113\t\n   114\t-- A leg is historical forever once replaced. Changing the timestamp would\n   115\t-- rewrite when it stopped being the customer's itinerary; clearing it would\n   116\t-- make two histories current again.\n   117\tCREATE FUNCTION \"refuse_itinerary_leg_unsupersession\"()\n   118\tRETURNS TRIGGER AS $$\n   119\tBEGIN\n   120\t    IF OLD.\"supersededAt\" IS NOT NULL\n   121\t       AND NEW.\"supersededAt\" IS DISTINCT FROM OLD.\"supersededAt\" THEN\n   122\t        RAISE EXCEPTION\n   123\t            'ItineraryLeg supersession is permanent: leg % cannot become active or change time.',\n   124\t            OLD.\"id\";\n   125\t    END IF;\n   126\t    RETURN NEW;\n   127\tEND;\n   128\t$$ LANGUAGE plpgsql;\n   129\t\n   130\tCREATE TRIGGER \"ItineraryLeg_supersession_is_permanent\"\n   131\t    BEFORE UPDATE OF \"supersededAt\" ON \"ItineraryLeg\"\n   132\t    FOR EACH ROW EXECUTE FUNCTION \"refuse_itinerary_leg_unsupersession\"();\n   133\t\n   134\t-- A superseded leg must be named by an immutable rebooking mapping before its\n   135\t-- transaction commits. Deferred because the event and replacement leg are\n   136\t-- naturally written after the original leg is marked historical.\n   137\tCREATE FUNCTION \"require_recorded_leg_supersession\"()\n   138\tRETURNS TRIGGER AS $$\n   139\tBEGIN\n   140\t    IF NOT EXISTS (SELECT 1 FROM \"ItineraryLeg\" WHERE \"id\" = NEW.\"id\") THEN\n   141\t        RETURN NULL;\n   142\t    END IF;\n   143\t    IF NOT EXISTS (\n   144\t        SELECT 1 FROM \"BookingRebookingLeg\" WHERE \"fromLegId\" = NEW.\"id\"\n   145\t    ) THEN\n   146\t        RAISE EXCEPTION\n   147\t            'Superseded ItineraryLeg % must be recorded by a BookingRebookingLeg.',\n   148\t            NEW.\"id\";\n   149\t    END IF;\n   150\t    RETURN NULL;\n   151\tEND;\n   152\t$$ LANGUAGE plpgsql;\n   153\t\n   154\tCREATE CONSTRAINT TRIGGER \"ItineraryLeg_supersession_is_recorded\"\n   155\t    AFTER UPDATE OF \"supersededAt\" ON \"ItineraryLeg\"\n   156\t    DEFERRABLE INITIALLY DEFERRED\n   157\t    FOR EACH ROW\n   158\t    WHEN (OLD.\"supersededAt\" IS NULL AND NEW.\"supersededAt\" IS NOT NULL)\n   159\t    EXECUTE FUNCTION \"require_recorded_leg_supersession\"();\n   160\t\n   161\t-- The status row is the booking-wide audit sequence. A rebooking can only be\n   162\t-- attached to the transition that resolves a disruption, for the same\n   163\t-- booking, and cannot simultaneously claim a refund.\n   164\tCREATE FUNCTION \"validate_booking_rebooking\"()\n   165\tRETURNS TRIGGER AS $$\n   166\tDECLARE\n   167\t    change \"BookingStatusChange\";\n   168\tBEGIN\n   169\t    SELECT * INTO change\n   170\t    FROM \"BookingStatusChange\"\n   171\t    WHERE \"id\" = NEW.\"bookingStatusChangeId\";\n   172\t\n   173\t    IF NOT FOUND\n   174\t       OR change.\"bookingId\" <> NEW.\"bookingId\"\n   175\t       OR change.\"from\" IS DISTINCT FROM 'DISRUPTED'::\"BookingStatus\"\n   176\t       OR change.\"to\" IS DISTINCT FROM 'CONFIRMED'::\"BookingStatus\"\n   177\t       OR change.\"refundCents\" IS NOT NULL THEN\n   178\t        RAISE EXCEPTION\n   179\t            'BookingRebooking must match one non-refunding DISRUPTED to CONFIRMED status change.';\n   180\t    END IF;\n   181\t    RETURN NEW;\n   182\tEND;\n   183\t$$ LANGUAGE plpgsql;\n   184\t\n   185\tCREATE TRIGGER \"BookingRebooking_is_consistent\"\n   186\t    BEFORE INSERT ON \"BookingRebooking\"\n   187\t    FOR EACH ROW EXECUTE FUNCTION \"validate_booking_rebooking\"();\n   188\t\n   189\t-- Both legs remain real rows. The old one must already be historical, the new\n   190\t-- one current, and both must occupy the same position in this booking.\n   191\tCREATE FUNCTION \"validate_booking_rebooking_leg\"()\n   192\tRETURNS TRIGGER AS $$\n   193\tDECLARE\n   194\t    event_booking_id INTEGER;\n   195\t    from_booking_id INTEGER;\n   196\t    from_sequence INTEGER;\n   197\t    from_superseded_at TIMESTAMP(3);\n   198\t    to_booking_id INTEGER;\n   199\t    to_sequence INTEGER;\n   200\t    to_superseded_at TIMESTAMP(3);\n   201\tBEGIN\n   202\t    SELECT \"bookingId\" INTO event_booking_id\n   203\t    FROM \"BookingRebooking\"\n   204\t    WHERE \"id\" = NEW.\"rebookingId\";\n   205\t    SELECT \"bookingId\", \"sequence\", \"supersededAt\"\n   206\t        INTO from_booking_id, from_sequence, from_superseded_at\n   207\t    FROM \"ItineraryLeg\" WHERE \"id\" = NEW.\"fromLegId\";\n   208\t    SELECT \"bookingId\", \"sequence\", \"supersededAt\"\n   209\t        INTO to_booking_id, to_sequence, to_superseded_at\n   210\t    FROM \"ItineraryLeg\" WHERE \"id\" = NEW.\"toLegId\";\n   211\t\n   212\t    IF event_booking_id IS NULL\n   213\t       OR from_booking_id IS NULL\n   214\t       OR to_booking_id IS NULL\n   215\t       OR from_booking_id <> event_booking_id\n   216\t       OR to_booking_id <> event_booking_id\n   217\t       OR from_sequence <> to_sequence\n   218\t       OR from_superseded_at IS NULL\n   219\t       OR to_superseded_at IS NOT NULL THEN\n   220\t        RAISE EXCEPTION\n   221\t            'BookingRebookingLeg must map superseded and active legs from the same booking and same itinerary position.';\n   222\t    END IF;\n   223\t    RETURN NEW;\n   224\tEND;\n   225\t$$ LANGUAGE plpgsql;\n   226\t\n   227\tCREATE TRIGGER \"BookingRebookingLeg_is_consistent\"\n   228\t    BEFORE INSERT ON \"BookingRebookingLeg\"\n   229\t    FOR EACH ROW EXECUTE FUNCTION \"validate_booking_rebooking_leg\"();\n   230\t\n   231\t-- An event with no leg mapping says a rebooking happened but cannot say what\n   232\t-- changed. Deferred so a normal transaction can insert the event first.\n   233\tCREATE FUNCTION \"require_rebooking_legs\"()\n   234\tRETURNS TRIGGER AS $$\n   235\tBEGIN\n   236\t    IF NOT EXISTS (SELECT 1 FROM \"BookingRebooking\" WHERE \"id\" = NEW.\"id\") THEN\n   237\t        RETURN NULL;\n   238\t    END IF;\n   239\t    IF NOT EXISTS (\n   240\t        SELECT 1 FROM \"BookingRebookingLeg\" WHERE \"rebookingId\" = NEW.\"id\"\n   241\t    ) THEN\n   242\t        RAISE EXCEPTION 'BookingRebooking % must map at least one itinerary leg.', NEW.\"id\";\n   243\t    END IF;\n   244\t    RETURN NULL;\n   245\tEND;\n   246\t$$ LANGUAGE plpgsql;\n   247\t\n   248\tCREATE CONSTRAINT TRIGGER \"BookingRebooking_has_legs\"\n   249\t    AFTER INSERT ON \"BookingRebooking\"\n   250\t    DEFERRABLE INITIALLY DEFERRED\n   251\t    FOR EACH ROW EXECUTE FUNCTION \"require_rebooking_legs\"();\n   252\t\n   253\t-- Updates rewrite audit history. Deletes remain available only through the\n   254\t-- booking cascade, matching BookingStatusChange and test-data cleanup.\n   255\tCREATE FUNCTION \"refuse_rebooking_audit_update\"()\n   256\tRETURNS TRIGGER AS $$\n   257\tBEGIN\n   258\t    RAISE EXCEPTION '% is append-only and cannot be modified.', TG_TABLE_NAME;\n   259\tEND;\n   260\t$$ LANGUAGE plpgsql;\n   261\t\n   262\tCREATE TRIGGER \"BookingRebooking_is_append_only\"\n   263\t    BEFORE UPDATE ON \"BookingRebooking\"\n   264\t    FOR EACH ROW EXECUTE FUNCTION \"refuse_rebooking_audit_update\"();\n   265\t\n   266\tCREATE TRIGGER \"BookingRebookingLeg_is_append_only\"\n   267\t    BEFORE UPDATE ON \"BookingRebookingLeg\"\n   268\t    FOR EACH ROW EXECUTE FUNCTION \"refuse_rebooking_audit_update\"();\n","exit_code":0,"duration":{"secs":0,"nanos":40142},"formatted_output":"    18\texport interface BookingLegs<TFlight> {\n    19\t    legs: Array<{\n    20\t        sequence: number;\n    21\t        flight: TFlight | null;\n    22\t        supersededAt?: Date | string | null;\n    23\t    }>;\n    24\t}\n    25\t\n    26\t/** The database half of the active-leg rule, shared by every relation read. */\n    27\texport const activeItineraryLegWhere = { supersededAt: null } as const;\n    28\t\n    29\t/**\n    30\t * The legs of a booking in itinerary order.\n    31\t *\n    32\t * Historical legs stay attached to the booking after a rebooking. Filter them\n    33\t * here as a final product-code guard, then sort rather than trusting the query:\n    34\t * a caller that forgets either database clause must not render two flights at\n    35\t * the same itinerary position or put the return first.\n    36\t */\n    37\texport function orderedLegs<TLeg extends {\n    38\t    sequence: number;\n    39\t    supersededAt?: Date | string | null;\n    40\t}>(\n    41\t    booking: { legs: TLeg[] }\n    42\t): TLeg[] {\n    43\t    return booking.legs\n    44\t        .filter(leg => leg.supersededAt === undefined || leg.supersededAt === null)\n    45\t        .sort((left, right) => left.sequence - right.sequence);\n    46\t}\n    47\t\n    48\t/**\n    49\t * The flights of a booking, in leg order. A leg whose flight was not loaded is\n    50\t * skipped rather than yielding a hole in the itinerary.\n    51\t */\n    52\texport function bookingFlights<TFlight>(booking: BookingLegs<TFlight>): TFlight[] {\n    30\t): Promise<number[]> {\n    31\t    const locked = await tx.$queryRaw<Array<{ id: number }>>`\n    32\t        SELECT b.\"id\"\n    33\t        FROM \"Booking\" b\n    34\t        WHERE EXISTS (\n    35\t            SELECT 1 FROM \"ItineraryLeg\" l\n    36\t            WHERE l.\"bookingId\" = b.\"id\"\n    37\t              AND l.\"flightId\" = ${flightId}\n    38\t              AND l.\"supersededAt\" IS NULL\n    39\t        )\n    40\t        AND b.\"status\" <> 'CANCELLED'\n    41\t        ORDER BY b.\"id\"\n    42\t        FOR UPDATE\n    43\t    `;\n    44\t    return locked.map(row => row.id);\n    45\t}\n    34\t  const userBookings = await prisma.booking.findMany({\n    35\t    where: { userId },\n    36\t    orderBy: { createdAt: \"desc\" },\n    37\t    include: {\n    38\t      // Read the itinerary through its legs, so a round trip needs no change\n    39\t      // here beyond rendering more than one (#69).\n    40\t      legs: {\n    41\t        where: activeItineraryLegWhere,\n    42\t        include: {\n    43\t          flight: { include: flightRouteInclude },\n    44\t          // The seat is held per leg, so a round trip has a different one on\n    45\t          // each; Passenger.seatNumber only ever described the outbound.\n    46\t          seatAssignments: {\n    47\t            select: {\n    48\t              passengerId: true,\n    49\t              seatNumber: true,\n    50\t              cabinClass: true,\n    18\t        include: {\n    19\t            user: {\n    20\t                select: {\n    21\t                    name: true,\n    22\t                    email: true,\n    23\t                },\n    24\t            },\n    25\t            legs: {\n    26\t                where: activeItineraryLegWhere,\n    27\t                include: { flight: { include: flightRouteInclude } },\n    28\t                orderBy: { sequence: 'asc' },\n    29\t            },\n    30\t        },\n    31\t    });\n    32\t\n    33\t    return (\n    34\t        <div className=\"page-container admin p-8\" style={{ marginTop: '100px', display: 'flex', flexDirection: 'column', gap: '2rem' }}>\n    35\t            <h1 className=\"text-3xl font-bold\" style={{ color: '#fff', margin: 0 }}>Admin Control Center</h1>\n    28\t                gte: utcToday,\n    29\t                lte: next7Days\n    30\t            }\n    31\t        },\n    32\t        include: {\n    33\t            ...flightRouteInclude,\n    34\t            itineraryLegs: {\n    35\t                where: activeItineraryLegWhere,\n    36\t                include: {\n    37\t                    // The seats held on this flight. A traveller on a round trip\n    38\t                    // sits somewhere else on the other leg, so the manifest has\n    39\t                    // to read the assignment rather than Passenger.seatNumber.\n    40\t                    seatAssignments: {\n    41\t                        select: {\n    42\t                            passengerId: true,\n   658\t    const parsed = parseActionInput(numericIdSchema, bookingId);\n   659\t    if (!parsed.ok) return parsed;\n   660\t    bookingId = parsed.data;\n   661\t    const booking = await prisma.booking.findUnique({\n   662\t        where: { id: bookingId },\n   663\t        include: {\n   664\t            legs: {\n   665\t                where: activeItineraryLegWhere,\n   666\t                include: {\n   667\t                    flight: true,\n   668\t                    // The cabin is held per traveller per leg, and the fee is a\n   669\t                    // percentage of each traveller's own fare (#76).\n   670\t                    seatAssignments: { select: { cabinClass: true } },\n   671\t                },\n   672\t                orderBy: { sequence: 'asc' },\n   673\t            },\n   674\t        }\n   675\t    });\n   676\t    if (!booking) throw new Error(\"Booking not found\");\n   677\t\n   678\t    if (!hasVerifiedStaffAccess(session) && booking.userId !== userId) {\n   679\t        throw new Error(\"Unauthorized\");\n   680\t    }\n   681\t\n   682\t    if (!cancellationOutcome(cancellableBooking(booking), new Date()).allowed) {\n   683\t        // A refusal the customer can act on rather than a thrown error: this is\n   684\t        // a policy answer, not a fault. Cancelling a flight that has departed\n   685\t        // would free a seat that was used and take back the status points for a\n   686\t        // trip they took (#76).\n   687\t        return actionValidationFailure(DEPARTED_MESSAGE);\n   688\t    }\n   689\t\n   690\t    let updated;\n   691\t    let refundId: string | null = null;\n   692\t    try {\n   693\t        const cancellation = await prisma.$transaction(async (tx) => {\n   694\t        // Lock in ascending flight order, matching FlightBookingService. Leg\n   695\t        // order would deadlock two itineraries that cover the same flights in\n   696\t        // opposite directions.\n   697\t        const lockOrder = bookingFlights(booking)\n   698\t            .map(flight => flight.id)\n   699\t            .sort((left, right) => left - right);\n   700\t        for (const flightId of lockOrder) {\n   701\t            await lockFlightForUpdate(tx, flightId);\n   702\t        }\n   703\t        // Re-read under the locks, and decide again from what is there now.\n   704\t        //\n   705\t        // The decision above was taken from an unlocked read, and staff can\n   706\t        // cancel a flight in between -- which moves this booking to DISRUPTED\n   707\t        // and makes it fully refundable. Deciding once, before the lock, would\n   708\t        // charge the customer a fee for the airline's cancellation. The read\n   709\t        // outside is what refuses early and cheaply; this is the one that\n   710\t        // counts (#76).\n   711\t        const lockedBooking = await tx.booking.findUnique({\n   712\t            where: { id: bookingId },\n   713\t            include: {\n   714\t                legs: {\n   715\t                    where: activeItineraryLegWhere,\n   716\t                    include: {\n   717\t                        flight: true,\n   718\t                        seatAssignments: { select: { cabinClass: true } },\n   719\t                    },\n   720\t                    orderBy: { sequence: 'asc' },\n   721\t                },\n   722\t            },\n   868\t    bookingId = parsed.data.bookingId;\n   869\t    seatChanges = parsed.data.seatChanges;\n   870\t\n   871\t    const booking = await prisma.booking.findUnique({\n   872\t        where: { id: bookingId },\n   873\t        include: {\n   874\t            legs: {\n   875\t                where: activeItineraryLegWhere,\n   876\t                include: { flight: true },\n   877\t                orderBy: { sequence: 'asc' },\n   878\t            },\n   879\t        }\n   880\t    });\n   881\t    if (!booking) throw new Error(\"Booking not found\");\n   882\t\n   883\t    if (!hasVerifiedStaffAccess(session) && booking.userId !== userId) {\n   884\t        throw new Error(\"Unauthorized\");\n   885\t    }\n  1420\t        const bookings = await tx.booking.findMany({\n  1421\t            where: { id: { in: bookingIds } },\n  1422\t            select: {\n  1423\t                id: true,\n  1424\t                status: true,\n  1425\t                userId: true,\n  1426\t                legs: {\n  1427\t                    where: activeItineraryLegWhere,\n  1428\t                    select: { flight: { select: { status: true } } },\n  1429\t                },\n  1430\t            },\n  1431\t        });\n  1432\t\n  1433\t        // Decided per booking from what its own legs now say, rather than by a\n  1434\t        // predicate over rows that may be mid-change. One cancelled leg\n  1435\t        // disrupts the whole itinerary: half a trip is not a usable trip.\n  1436\t        const changed = bookings.filter(booking => {\n   132\t                if (!flight) throw new Error(\"Flight not found\");\n   133\t                return flight;\n   134\t            });\n   135\t\n   136\t            const existingRequest = await tx.booking.findFirst({\n   137\t                where: { userId, idempotencyKey },\n   138\t                include: {\n   139\t                    legs: {\n   140\t                        where: activeItineraryLegWhere,\n   141\t                        include: { flight: true },\n   142\t                        orderBy: { sequence: 'asc' },\n   143\t                    },\n   144\t                    passengers: {\n   145\t                        select: {\n   146\t                            ...safePassengerSelect,\n   147\t                            dateOfBirthEncrypted: true,\n   148\t                            passportNumberEncrypted: true,\n   149\t                            seatAssignments: {\n   150\t                                where: { leg: activeItineraryLegWhere },\n   151\t                                select: {\n   152\t                                    seatNumber: true,\n   153\t                                    cabinClass: true,\n   154\t                                    leg: { select: { sequence: true } },\n   155\t                                },\n   156\t                            },\n   157\t                        }\n   158\t                    }\n   159\t                }\n   160\t            });\n   300\t                    idempotencyKey,\n   301\t                    passengers: {\n   302\t                        create: protectedPassengers\n   303\t                    }\n   304\t                },\n   305\t                include: {\n   306\t                    passengers: { select: safePassengerSelect },\n   307\t                    legs: {\n   308\t                        where: activeItineraryLegWhere,\n   309\t                        orderBy: { sequence: 'asc' },\n   310\t                    }\n   311\t                }\n   312\t            });\n   313\t\n   314\t            // Seat assignments need each leg's identity, so they follow the\n   315\t            // booking. Written from the same arrays the legs and passengers came\n    32\t-- without deleting audit history.\n    33\t\n    34\tCREATE TYPE \"RebookingFarePolicy\" AS ENUM ('DISRUPTION_WAIVER');\n    35\t\n    36\tALTER TABLE \"ItineraryLeg\"\n    37\t    ADD COLUMN \"supersededAt\" TIMESTAMP(3);\n    38\t\n    39\tDROP INDEX \"ItineraryLeg_bookingId_sequence_key\";\n    40\t\n    41\t-- Historical rows may share a position; exactly one current row may not.\n    42\tCREATE UNIQUE INDEX \"ItineraryLeg_active_booking_sequence_key\"\n    43\t    ON \"ItineraryLeg\"(\"bookingId\", \"sequence\")\n    44\t    WHERE \"supersededAt\" IS NULL;\n    45\t\n    46\tCREATE INDEX \"ItineraryLeg_bookingId_supersededAt_sequence_idx\"\n    47\t    ON \"ItineraryLeg\"(\"bookingId\", \"supersededAt\", \"sequence\");\n    48\t\n    49\tCREATE TABLE \"BookingRebooking\" (\n    50\t    \"id\" TEXT NOT NULL,\n    51\t    \"bookingId\" INTEGER NOT NULL,\n    52\t    \"bookingStatusChangeId\" TEXT NOT NULL,\n    53\t    \"farePolicy\" \"RebookingFarePolicy\" NOT NULL DEFAULT 'DISRUPTION_WAIVER',\n    54\t    \"createdAt\" TIMESTAMP(3) NOT NULL DEFAULT CURRENT_TIMESTAMP,\n    55\t\n    56\t    CONSTRAINT \"BookingRebooking_pkey\" PRIMARY KEY (\"id\")\n    57\t);\n    58\t\n    59\tCREATE UNIQUE INDEX \"BookingRebooking_bookingStatusChangeId_key\"\n    60\t    ON \"BookingRebooking\"(\"bookingStatusChangeId\");\n    61\tCREATE INDEX \"BookingRebooking_bookingId_createdAt_idx\"\n    62\t    ON \"BookingRebooking\"(\"bookingId\", \"createdAt\");\n    63\t\n    64\tALTER TABLE \"BookingRebooking\"\n    65\t    ADD CONSTRAINT \"BookingRebooking_bookingId_fkey\"\n    66\t        FOREIGN KEY (\"bookingId\") REFERENCES \"Booking\"(\"id\")\n    67\t        ON DELETE CASCADE ON UPDATE CASCADE,\n    68\t    ADD CONSTRAINT \"BookingRebooking_bookingStatusChangeId_fkey\"\n    69\t        FOREIGN KEY (\"bookingStatusChangeId\") REFERENCES \"BookingStatusChange\"(\"id\")\n    70\t        ON DELETE NO ACTION ON UPDATE CASCADE;\n    71\t\n    72\tCREATE TABLE \"BookingRebookingLeg\" (\n    73\t    \"rebookingId\" TEXT NOT NULL,\n    74\t    \"fromLegId\" INTEGER NOT NULL,\n    75\t    \"toLegId\" INTEGER NOT NULL,\n    76\t\n    77\t    CONSTRAINT \"BookingRebookingLeg_pkey\" PRIMARY KEY (\"rebookingId\", \"fromLegId\"),\n    78\t    CONSTRAINT \"BookingRebookingLeg_different_legs\" CHECK (\"fromLegId\" <> \"toLegId\")\n    79\t);\n    80\t\n    81\tCREATE UNIQUE INDEX \"BookingRebookingLeg_fromLegId_key\"\n    82\t    ON \"BookingRebookingLeg\"(\"fromLegId\");\n    83\tCREATE UNIQUE INDEX \"BookingRebookingLeg_toLegId_key\"\n    84\t    ON \"BookingRebookingLeg\"(\"toLegId\");\n    85\t\n    86\tALTER TABLE \"BookingRebookingLeg\"\n    87\t    ADD CONSTRAINT \"BookingRebookingLeg_rebookingId_fkey\"\n    88\t        FOREIGN KEY (\"rebookingId\") REFERENCES \"BookingRebooking\"(\"id\")\n    89\t        ON DELETE CASCADE ON UPDATE CASCADE,\n    90\t    ADD CONSTRAINT \"BookingRebookingLeg_fromLegId_fkey\"\n    91\t        FOREIGN KEY (\"fromLegId\") REFERENCES \"ItineraryLeg\"(\"id\")\n    92\t        ON DELETE NO ACTION ON UPDATE CASCADE,\n    93\t    ADD CONSTRAINT \"BookingRebookingLeg_toLegId_fkey\"\n    94\t        FOREIGN KEY (\"toLegId\") REFERENCES \"ItineraryLeg\"(\"id\")\n    95\t        ON DELETE NO ACTION ON UPDATE CASCADE;\n    96\t\n    97\t-- Every historical leg has to become historical through the recorded update\n    98\t-- below. Accepting a row that starts superseded would bypass that audit path.\n    99\tCREATE FUNCTION \"require_new_itinerary_leg_active\"()\n   100\tRETURNS TRIGGER AS $$\n   101\tBEGIN\n   102\t    IF NEW.\"supersededAt\" IS NOT NULL THEN\n   103\t        RAISE EXCEPTION\n   104\t            'A new ItineraryLeg must start active; supersede it through a recorded rebooking.';\n   105\t    END IF;\n   106\t    RETURN NEW;\n   107\tEND;\n   108\t$$ LANGUAGE plpgsql;\n   109\t\n   110\tCREATE TRIGGER \"ItineraryLeg_starts_active\"\n   111\t    BEFORE INSERT ON \"ItineraryLeg\"\n   112\t    FOR EACH ROW EXECUTE FUNCTION \"require_new_itinerary_leg_active\"();\n   113\t\n   114\t-- A leg is historical forever once replaced. Changing the timestamp would\n   115\t-- rewrite when it stopped being the customer's itinerary; clearing it would\n   116\t-- make two histories current again.\n   117\tCREATE FUNCTION \"refuse_itinerary_leg_unsupersession\"()\n   118\tRETURNS TRIGGER AS $$\n   119\tBEGIN\n   120\t    IF OLD.\"supersededAt\" IS NOT NULL\n   121\t       AND NEW.\"supersededAt\" IS DISTINCT FROM OLD.\"supersededAt\" THEN\n   122\t        RAISE EXCEPTION\n   123\t            'ItineraryLeg supersession is permanent: leg % cannot become active or change time.',\n   124\t            OLD.\"id\";\n   125\t    END IF;\n   126\t    RETURN NEW;\n   127\tEND;\n   128\t$$ LANGUAGE plpgsql;\n   129\t\n   130\tCREATE TRIGGER \"ItineraryLeg_supersession_is_permanent\"\n   131\t    BEFORE UPDATE OF \"supersededAt\" ON \"ItineraryLeg\"\n   132\t    FOR EACH ROW EXECUTE FUNCTION \"refuse_itinerary_leg_unsupersession\"();\n   133\t\n   134\t-- A superseded leg must be named by an immutable rebooking mapping before its\n   135\t-- transaction commits. Deferred because the event and replacement leg are\n   136\t-- naturally written after the original leg is marked historical.\n   137\tCREATE FUNCTION \"require_recorded_leg_supersession\"()\n   138\tRETURNS TRIGGER AS $$\n   139\tBEGIN\n   140\t    IF NOT EXISTS (SELECT 1 FROM \"ItineraryLeg\" WHERE \"id\" = NEW.\"id\") THEN\n   141\t        RETURN NULL;\n   142\t    END IF;\n   143\t    IF NOT EXISTS (\n   144\t        SELECT 1 FROM \"BookingRebookingLeg\" WHERE \"fromLegId\" = NEW.\"id\"\n   145\t    ) THEN\n   146\t        RAISE EXCEPTION\n   147\t            'Superseded ItineraryLeg % must be recorded by a BookingRebookingLeg.',\n   148\t            NEW.\"id\";\n   149\t    END IF;\n   150\t    RETURN NULL;\n   151\tEND;\n   152\t$$ LANGUAGE plpgsql;\n   153\t\n   154\tCREATE CONSTRAINT TRIGGER \"ItineraryLeg_supersession_is_recorded\"\n   155\t    AFTER UPDATE OF \"supersededAt\" ON \"ItineraryLeg\"\n   156\t    DEFERRABLE INITIALLY DEFERRED\n   157\t    FOR EACH ROW\n   158\t    WHEN (OLD.\"supersededAt\" IS NULL AND NEW.\"supersededAt\" IS NOT NULL)\n   159\t    EXECUTE FUNCTION \"require_recorded_leg_supersession\"();\n   160\t\n   161\t-- The status row is the booking-wide audit sequence. A rebooking can only be\n   162\t-- attached to the transition that resolves a disruption, for the same\n   163\t-- booking, and cannot simultaneously claim a refund.\n   164\tCREATE FUNCTION \"validate_booking_rebooking\"()\n   165\tRETURNS TRIGGER AS $$\n   166\tDECLARE\n   167\t    change \"BookingStatusChange\";\n   168\tBEGIN\n   169\t    SELECT * INTO change\n   170\t    FROM \"BookingStatusChange\"\n   171\t    WHERE \"id\" = NEW.\"bookingStatusChangeId\";\n   172\t\n   173\t    IF NOT FOUND\n   174\t       OR change.\"bookingId\" <> NEW.\"bookingId\"\n   175\t       OR change.\"from\" IS DISTINCT FROM 'DISRUPTED'::\"BookingStatus\"\n   176\t       OR change.\"to\" IS DISTINCT FROM 'CONFIRMED'::\"BookingStatus\"\n   177\t       OR change.\"refundCents\" IS NOT NULL THEN\n   178\t        RAISE EXCEPTION\n   179\t            'BookingRebooking must match one non-refunding DISRUPTED to CONFIRMED status change.';\n   180\t    END IF;\n   181\t    RETURN NEW;\n   182\tEND;\n   183\t$$ LANGUAGE plpgsql;\n   184\t\n   185\tCREATE TRIGGER \"BookingRebooking_is_consistent\"\n   186\t    BEFORE INSERT ON \"BookingRebooking\"\n   187\t    FOR EACH ROW EXECUTE FUNCTION \"validate_booking_rebooking\"();\n   188\t\n   189\t-- Both legs remain real rows. The old one must already be historical, the new\n   190\t-- one current, and both must occupy the same position in this booking.\n   191\tCREATE FUNCTION \"validate_booking_rebooking_leg\"()\n   192\tRETURNS TRIGGER AS $$\n   193\tDECLARE\n   194\t    event_booking_id INTEGER;\n   195\t    from_booking_id INTEGER;\n   196\t    from_sequence INTEGER;\n   197\t    from_superseded_at TIMESTAMP(3);\n   198\t    to_booking_id INTEGER;\n   199\t    to_sequence INTEGER;\n   200\t    to_superseded_at TIMESTAMP(3);\n   201\tBEGIN\n   202\t    SELECT \"bookingId\" INTO event_booking_id\n   203\t    FROM \"BookingRebooking\"\n   204\t    WHERE \"id\" = NEW.\"rebookingId\";\n   205\t    SELECT \"bookingId\", \"sequence\", \"supersededAt\"\n   206\t        INTO from_booking_id, from_sequence, from_superseded_at\n   207\t    FROM \"ItineraryLeg\" WHERE \"id\" = NEW.\"fromLegId\";\n   208\t    SELECT \"bookingId\", \"sequence\", \"supersededAt\"\n   209\t        INTO to_booking_id, to_sequence, to_superseded_at\n   210\t    FROM \"ItineraryLeg\" WHERE \"id\" = NEW.\"toLegId\";\n   211\t\n   212\t    IF event_booking_id IS NULL\n   213\t       OR from_booking_id IS NULL\n   214\t       OR to_booking_id IS NULL\n   215\t       OR from_booking_id <> event_booking_id\n   216\t       OR to_booking_id <> event_booking_id\n   217\t       OR from_sequence <> to_sequence\n   218\t       OR from_superseded_at IS NULL\n   219\t       OR to_superseded_at IS NOT NULL THEN\n   220\t        RAISE EXCEPTION\n   221\t            'BookingRebookingLeg must map superseded and active legs from the same booking and same itinerary position.';\n   222\t    END IF;\n   223\t    RETURN NEW;\n   224\tEND;\n   225\t$$ LANGUAGE plpgsql;\n   226\t\n   227\tCREATE TRIGGER \"BookingRebookingLeg_is_consistent\"\n   228\t    BEFORE INSERT ON \"BookingRebookingLeg\"\n   229\t    FOR EACH ROW EXECUTE FUNCTION \"validate_booking_rebooking_leg\"();\n   230\t\n   231\t-- An event with no leg mapping says a rebooking happened but cannot say what\n   232\t-- changed. Deferred so a normal transaction can insert the event first.\n   233\tCREATE FUNCTION \"require_rebooking_legs\"()\n   234\tRETURNS TRIGGER AS $$\n   235\tBEGIN\n   236\t    IF NOT EXISTS (SELECT 1 FROM \"BookingRebooking\" WHERE \"id\" = NEW.\"id\") THEN\n   237\t        RETURN NULL;\n   238\t    END IF;\n   239\t    IF NOT EXISTS (\n   240\t        SELECT 1 FROM \"BookingRebookingLeg\" WHERE \"rebookingId\" = NEW.\"id\"\n   241\t    ) THEN\n   242\t        RAISE EXCEPTION 'BookingRebooking % must map at least one itinerary leg.', NEW.\"id\";\n   243\t    END IF;\n   244\t    RETURN NULL;\n   245\tEND;\n   246\t$$ LANGUAGE plpgsql;\n   247\t\n   248\tCREATE CONSTRAINT TRIGGER \"BookingRebooking_has_legs\"\n   249\t    AFTER INSERT ON \"BookingRebooking\"\n   250\t    DEFERRABLE INITIALLY DEFERRED\n   251\t    FOR EACH ROW EXECUTE FUNCTION \"require_rebooking_legs\"();\n   252\t\n   253\t-- Updates rewrite audit history. Deletes remain available only through the\n   254\t-- booking cascade, matching BookingStatusChange and test-data cleanup.\n   255\tCREATE FUNCTION \"refuse_rebooking_audit_update\"()\n   256\tRETURNS TRIGGER AS $$\n   257\tBEGIN\n   258\t    RAISE EXCEPTION '% is append-only and cannot be modified.', TG_TABLE_NAME;\n   259\tEND;\n   260\t$$ LANGUAGE plpgsql;\n   261\t\n   262\tCREATE TRIGGER \"BookingRebooking_is_append_only\"\n   263\t    BEFORE UPDATE ON \"BookingRebooking\"\n   264\t    FOR EACH ROW EXECUTE FUNCTION \"refuse_rebooking_audit_update\"();\n   265\t\n   266\tCREATE TRIGGER \"BookingRebookingLeg_is_append_only\"\n   267\t    BEFORE UPDATE ON \"BookingRebookingLeg\"\n   268\t    FOR EACH ROW EXECUTE FUNCTION \"refuse_rebooking_audit_update\"();\n"},"started_at_ms":1786905540978,"completed_at_ms":1786905540980}}
{"timestamp":"2026-08-16T18:39:01.153Z","ordinal":24886,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a00bde-ba20-7733-837f-ce43236617d5","call_id":"call_mIbzckvTtrOYRhZS2BlR11dw","output":[{"type":"input_text","text":"Script completed\nWall time 0.4 seconds\nOutput:\n"},{"type":"input_text","text":"    18\texport interface BookingLegs<TFlight> {\n    19\t    legs: Array<{\n    20\t        sequence: number;\n    21\t        flight: TFlight | null;\n    22\t        supersededAt?: Date | string | null;\n    23\t    }>;\n    24\t}\n    25\t\n    26\t/** The database half of the active-leg rule, shared by every relation read. */\n    27\texport const activeItineraryLegWhere = { supersededAt: null } as const;\n    28\t\n    29\t/**\n    30\t * The legs of a booking in itinerary order.\n    31\t *\n    32\t * Historical legs stay attached to the booking after a rebooking. Filter them\n    33\t * here as a final product-code guard, then sort rather than trusting the query:\n    34\t * a caller that forgets either database clause must not render two flights at\n    35\t * the same itinerary position or put the return first.\n    36\t */\n    37\texport function orderedLegs<TLeg extends {\n    38\t    sequence: number;\n    39\t    supersededAt?: Date | string | null;\n    40\t}>(\n    41\t    booking: { legs: TLeg[] }\n    42\t): TLeg[] {\n    43\t    return booking.legs\n    44\t        .filter(leg => leg.supersededAt === undefined || leg.supersededAt === null)\n    45\t        .sort((left, right) => left.sequence - right.sequence);\n    46\t}\n    47\t\n    48\t/**\n    49\t * The flights of a booking, in leg order. A leg whose flight was not loaded is\n    50\t * skipped rather than yielding a hole in the itinerary.\n    51\t */\n    52\texport function bookingFlights<TFlight>(booking: BookingLegs<TFlight>): TFlight[] {\n    30\t): Promise<number[]> {\n    31\t    const locked = await tx.$queryRaw<Array<{ id: number }>>`\n    32\t        SELECT b.\"id\"\n    33\t        FROM \"Booking\" b\n    34\t        WHERE EXISTS (\n    35\t            SELECT 1 FROM \"ItineraryLeg\" l\n    36\t            WHERE l.\"bookingId\" = b.\"id\"\n    37\t              AND l.\"flightId\" = ${flightId}\n    38\t              AND l.\"supersededAt\" IS NULL\n    39\t        )\n    40\t        AND b.\"status\" <> 'CANCELLED'\n    41\t        ORDER BY b.\"id\"\n    42\t        FOR UPDATE\n    43\t    `;\n    44\t    return locked.map(row => row.id);\n    45\t}\n    34\t  const userBookings = await prisma.booking.findMany({\n    35\t    where: { userId },\n    36\t    orderBy: { createdAt: \"desc\" },\n    37\t    include: {\n    38\t      // Read the itinerary through its legs, so a round trip needs no change\n    39\t      // here beyond rendering more than one (#69).\n    40\t      legs: {\n    41\t        where: activeItineraryLegWhere,\n    42\t        include: {\n    43\t          flight: { include: flightRouteInclude },\n    44\t          // The seat is held per leg, so a round trip has a different one on\n    45\t          // each; Passenger.seatNumber only ever described the outbound.\n    46\t          seatAssignments: {\n    47\t            select: {\n    48\t              passengerId: true,\n    49\t              seatNumber: true,\n    50\t              cabinClass: true,\n    18\t        include: {\n    19\t            user: {\n    20\t                select: {\n    21\t                    name: true,\n    22\t                    email: true,\n    23\t                },\n    24\t            },\n    25\t            legs: {\n    26\t                where: activeItineraryLegWhere,\n    27\t                include: { flight: { include: flightRouteInclude } },\n    28\t                orderBy: { sequence: 'asc' },\n    29\t            },\n    30\t        },\n    31\t    });\n    32\t\n    33\t    return (\n    34\t        <div className=\"page-container admin p-8\" style={{ marginTop: '100px', display: 'flex', flexDirection: 'column', gap: '2rem' }}>\n    35\t            <h1 className=\"text-3xl font-bold\" style={{ color: '#fff', margin: 0 }}>Admin Control Center</h1>\n    28\t                gte: utcToday,\n    29\t                lte: next7Days\n    30\t            }\n    31\t        },\n    32\t        include: {\n    33\t            ...flightRouteInclude,\n    34\t            itineraryLegs: {\n    35\t                where: activeItineraryLegWhere,\n    36\t                include: {\n    37\t                    // The seats held on this flight. A traveller on a round trip\n    38\t                    // sits somewhere else on the other leg, so the manifest has\n    39\t                    // to read the assignment rather than Passenger.seatNumber.\n    40\t                    seatAssignments: {\n    41\t                        select: {\n    42\t                            passengerId: true,\n   658\t    const parsed = parseActionInput(numericIdSchema, bookingId);\n   659\t    if (!parsed.ok) return parsed;\n   660\t    bookingId = parsed.data;\n   661\t    const booking = await prisma.booking.findUnique({\n   662\t        where: { id: bookingId },\n   663\t        include: {\n   664\t            legs: {\n   665\t                where: activeItineraryLegWhere,\n   666\t                include: {\n   667\t                    flight: true,\n   668\t                    // The cabin is held per traveller per leg, and the fee is a\n   669\t                    // percentage of each traveller's own fare (#76).\n   670\t                    seatAssignments: { select: { cabinClass: true } },\n   671\t                },\n   672\t                orderBy: { sequence: 'asc' },\n   673\t            },\n   674\t        }\n   675\t    });\n   676\t    if (!booking) throw new Error(\"Booking not found\");\n   677\t\n   678\t    if (!hasVerifiedStaffAccess(session) && booking.userId !== userId) {\n   679\t        throw new Error(\"Unauthorized\");\n   680\t    }\n   681\t\n   682\t    if (!cancellationOutcome(cancellableBooking(booking), new Date()).allowed) {\n   683\t        // A refusal the customer can act on rather than a thrown error: this is\n   684\t        // a policy answer, not a fault. Cancelling a flight that has departed\n   685\t        // would free a seat that was used and take back the status points for a\n   686\t        // trip they took (#76).\n   687\t        return actionValidationFailure(DEPARTED_MESSAGE);\n   688\t    }\n   689\t\n   690\t    let updated;\n   691\t    let refundId: string | null = null;\n   692\t    try {\n   693\t        const cancellation = await prisma.$transaction(async (tx) => {\n   694\t        // Lock in ascending flight order, matching FlightBookingService. Leg\n   695\t        // order would deadlock two itineraries that cover the same flights in\n   696\t        // opposite directions.\n   697\t        const lockOrder = bookingFlights(booking)\n   698\t            .map(flight => flight.id)\n   699\t            .sort((left, right) => left - right);\n   700\t        for (const flightId of lockOrder) {\n   701\t            await lockFlightForUpdate(tx, flightId);\n   702\t        }\n   703\t        // Re-read under the locks, and decide again from what is there now.\n   704\t        //\n   705\t        // The decision above was taken from an unlocked read, and staff can\n   706\t        // cancel a flight in between -- which moves this booking to DISRUPTED\n   707\t        // and makes it fully refundable. Deciding once, before the lock, would\n   708\t        // charge the customer a fee for the airline's cancellation. The read\n   709\t        // outside is what refuses early and cheaply; this is the one that\n   710\t        // counts (#76).\n   711\t        const lockedBooking = await tx.booking.findUnique({\n   712\t            where: { id: bookingId },\n   713\t            include: {\n   714\t                legs: {\n   715\t                    where: activeItineraryLegWhere,\n   716\t                    include: {\n   717\t                        flight: true,\n   718\t                        seatAssignments: { select: { cabinClass: true } },\n   719\t                    },\n   720\t                    orderBy: { sequence: 'asc' },\n   721\t                },\n   722\t            },\n   868\t    bookingId = parsed.data.bookingId;\n   869\t    seatChanges = parsed.data.seatChanges;\n   870\t\n   871\t    const booking = await prisma.booking.findUnique({\n   872\t        where: { id: bookingId },\n   873\t        include: {\n   874\t            legs: {\n   875\t                where: activeItineraryLegWhere,\n   876\t                include: { flight: true },\n   877\t                orderBy: { sequence: 'asc' },\n   878\t            },\n   879\t        }\n   880\t    });\n   881\t    if (!booking) throw new Error(\"Booking not found\");\n   882\t\n   883\t    if (!hasVerifiedStaffAccess(session) && booking.userId !== userId) {\n   884\t        throw new Error(\"Unauthorized\");\n   885\t    }\n  1420\t        const bookings = await tx.booking.findMany({\n  1421\t            where: { id: { in: bookingIds } },\n  1422\t            select: {\n  1423\t                id: true,\n  1424\t                status: true,\n  1425\t                userId: true,\n  1426\t                legs: {\n  1427\t                    where: activeItineraryLegWhere,\n  1428\t                    select: { flight: { select: { status: true } } },\n  1429\t                },\n  1430\t            },\n  1431\t        });\n  1432\t\n  1433\t        // Decided per booking from what its own legs now say, rather than by a\n  1434\t        // predicate over rows that may be mid-change. One cancelled leg\n  1435\t        // disrupts the whole itinerary: half a trip is not a usable trip.\n  1436\t        const changed = bookings.filter(booking => {\n   132\t                if (!flight) throw new Error(\"Flight not found\");\n   133\t                return flight;\n   134\t            });\n   135\t\n   136\t            const existingRequest = await tx.booking.findFirst({\n   137\t                where: { userId, idempotencyKey },\n   138\t                include: {\n   139\t                    legs: {\n   140\t                        where: activeItineraryLegWhere,\n   141\t                        include: { flight: true },\n   142\t                        orderBy: { sequence: 'asc' },\n   143\t                    },\n   144\t                    passengers: {\n   145\t                        select: {\n   146\t                            ...safePassengerSelect,\n   147\t                            dateOfBirthEncrypted: true,\n   148\t                            passportNumberEncrypted: true,\n   149\t                            seatAssignments: {\n   150\t                                where: { leg: activeItineraryLegWhere },\n   151\t                                select: {\n   152\t                                    seatNumber: true,\n   153\t                                    cabinClass: true,\n   154\t                                    leg: { select: { sequence: true } },\n   155\t                                },\n   156\t                            },\n   157\t                        }\n   158\t                    }\n   159\t                }\n   160\t            });\n   300\t                    idempotencyKey,\n   301\t                    passengers: {\n   302\t                        create: protectedPassengers\n   303\t                    }\n   304\t                },\n   305\t                include: {\n   306\t                    passengers: { select: safePassengerSelect },\n   307\t                    legs: {\n   308\t                        where: activeItineraryLegWhere,\n   309\t                        orderBy: { sequence: 'asc' },\n   310\t                    }\n   311\t                }\n   312\t            });\n   313\t\n   314\t            // Seat assignments need each leg's identity, so they follow the\n   315\t            // booking. Written from the same arrays the legs and passengers came\n    32\t-- without deleting audit history.\n    33\t\n    34\tCREATE TYPE \"RebookingFarePolicy\" AS ENUM ('DISRUPTION_WAIVER');\n    35\t\n    36\tALTER TABLE \"ItineraryLeg\"\n    37\t    ADD COLUMN \"supersededAt\" TIMESTAMP(3);\n    38\t\n    39\tDROP INDEX \"ItineraryLeg_bookingId_sequence_key\";\n    40\t\n    41\t-- Historical rows may share a position; exactly one current row may not.\n    42\tCREATE UNIQUE INDEX \"ItineraryLeg_active_booking_sequence_key\"\n    43\t    ON \"ItineraryLeg\"(\"bookingId\", \"sequence\")\n    44\t    WHERE \"supersededAt\" IS NULL;\n    45\t\n    46\tCREATE INDEX \"ItineraryLeg_bookingId_supersededAt_sequence_idx\"\n    47\t    ON \"ItineraryLeg\"(\"bookingId\", \"supersededAt\", \"sequence\");\n    48\t\n    49\tCREATE TABLE \"BookingRebooking\" (\n    50\t    \"id\" TEXT NOT NULL,\n    51\t    \"bookingId\" INTEGER NOT NULL,\n    52\t    \"bookingStatusChangeId\" TEXT NOT NULL,\n    53\t    \"farePolicy\" \"RebookingFarePolicy\" NOT NULL DEFAULT 'DISRUPTION_WAIVER',\n    54\t    \"createdAt\" TIMESTAMP(3) NOT NULL DEFAULT CURRENT_TIMESTAMP,\n    55\t\n    56\t    CONSTRAINT \"BookingRebooking_pkey\" PRIMARY KEY (\"id\")\n    57\t);\n    58\t\n    59\tCREATE UNIQUE INDEX \"BookingRebooking_bookingStatusChangeId_key\"\n    60\t    ON \"BookingRebooking\"(\"bookingStatusChangeId\");\n    61\tCREATE INDEX \"BookingRebooking_bookingId_createdAt_idx\"\n    62\t    ON \"BookingRebooking\"(\"bookingId\", \"createdAt\");\n    63\t\n    64\tALTER TABLE \"BookingRebooking\"\n    65\t    ADD CONSTRAINT \"BookingRebooking_bookingId_fkey\"\n    66\t        FOREIGN KEY (\"bookingId\") REFERENCES \"Booking\"(\"id\")\n    67\t        ON DELETE CASCADE ON UPDATE CASCADE,\n    68\t    ADD CONSTRAINT \"BookingRebooking_bookingStatusChangeId_fkey\"\n    69\t        FOREIGN KEY (\"bookingStatusChangeId\") REFERENCES \"BookingStatusChange\"(\"id\")\n    70\t        ON DELETE NO ACTION ON UPDATE CASCADE;\n    71\t\n    72\tCREATE TABLE \"BookingRebookingLeg\" (\n    73\t    \"rebookingId\" TEXT NOT NULL,\n    74\t    \"fromLegId\" INTEGER NOT NULL,\n    75\t    \"toLegId\" INTEGER NOT NULL,\n    76\t\n    77\t    CONSTRAINT \"BookingRebookingLeg_pkey\" PRIMARY KEY (\"rebookingId\", \"fromLegId\"),\n    78\t    CONSTRAINT \"BookingRebookingLeg_different_legs\" CHECK (\"fromLegId\" <> \"toLegId\")\n    79\t);\n    80\t\n    81\tCREATE UNIQUE INDEX \"BookingRebookingLeg_fromLegId_key\"\n    82\t    ON \"BookingRebookingLeg\"(\"fromLegId\");\n    83\tCREATE UNIQUE INDEX \"BookingRebookingLeg_toLegId_key\"\n    84\t    ON \"BookingRebookingLeg\"(\"toLegId\");\n    85\t\n    86\tALTER TABLE \"BookingRebookingLeg\"\n    87\t    ADD CONSTRAINT \"BookingRebookingLeg_rebookingId_fkey\"\n    88\t        FOREIGN KEY (\"rebookingId\") REFERENCES \"BookingRebooking\"(\"id\")\n    89\t        ON DELETE CASCADE ON UPDATE CASCADE,\n    90\t    ADD CONSTRAINT \"BookingRebookingLeg_fromLegId_fkey\"\n    91\t        FOREIGN KEY (\"fromLegId\") REFERENCES \"ItineraryLeg\"(\"id\")\n    92\t        ON DELETE NO ACTION ON UPDATE CASCADE,\n    93\t    ADD CONSTRAINT \"BookingRebookingLeg_toLegId_fkey\"\n    94\t        FOREIGN KEY (\"toLegId\") REFERENCES \"ItineraryLeg\"(\"id\")\n    95\t        ON DELETE NO ACTION ON UPDATE CASCADE;\n    96\t\n    97\t-- Every historical leg has to become historical through the recorded update\n    98\t-- below. Accepting a row that starts superseded would bypass that audit path.\n    99\tCREATE FUNCTION \"require_new_itinerary_leg_active\"()\n   100\tRETURNS TRIGGER AS $$\n   101\tBEGIN\n   102\t    IF NEW.\"supersededAt\" IS NOT NULL THEN\n   103\t        RAISE EXCEPTION\n   104\t            'A new ItineraryLeg must start active; supersede it through a recorded rebooking.';\n   105\t    END IF;\n   106\t    RETURN NEW;\n   107\tEND;\n   108\t$$ LANGUAGE plpgsql;\n   109\t\n   110\tCREATE TRIGGER \"ItineraryLeg_starts_active\"\n   111\t    BEFORE INSERT ON \"ItineraryLeg\"\n   112\t    FOR EACH ROW EXECUTE FUNCTION \"require_new_itinerary_leg_active\"();\n   113\t\n   114\t-- A leg is historical forever once replaced. Changing the timestamp would\n   115\t-- rewrite when it stopped being the customer's itinerary; clearing it would\n   116\t-- make two histories current again.\n   117\tCREATE FUNCTION \"refuse_itinerary_leg_unsupersession\"()\n   118\tRETURNS TRIGGER AS $$\n   119\tBEGIN\n   120\t    IF OLD.\"supersededAt\" IS NOT NULL\n   121\t       AND NEW.\"supersededAt\" IS DISTINCT FROM OLD.\"supersededAt\" THEN\n   122\t        RAISE EXCEPTION\n   123\t            'ItineraryLeg supersession is permanent: leg % cannot become active or change time.',\n   124\t            OLD.\"id\";\n   125\t    END IF;\n   126\t    RETURN NEW;\n   127\tEND;\n   128\t$$ LANGUAGE plpgsql;\n   129\t\n   130\tCREATE TRIGGER \"ItineraryLeg_supersession_is_permanent\"\n   131\t    BEFORE UPDATE OF \"supersededAt\" ON \"ItineraryLeg\"\n   132\t    FOR EACH ROW EXECUTE FUNCTION \"refuse_itinerary_leg_unsupersession\"();\n   133\t\n   134\t-- A superseded leg must be named by an immutable rebooking mapping before its\n   135\t-- transaction commits. Deferred because the event and replacement leg are\n   136\t-- naturally written after the original leg is marked historical.\n   137\tCREATE FUNCTION \"require_recorded_leg_supersession\"()\n   138\tRETURNS TRIGGER AS $$\n   139\tBEGIN\n   140\t    IF NOT EXISTS (SELECT 1 FROM \"ItineraryLeg\" WHERE \"id\" = NEW.\"id\") THEN\n   141\t        RETURN NULL;\n   142\t    END IF;\n   143\t    IF NOT EXISTS (\n   144\t        SELECT 1 FROM \"BookingRebookingLeg\" WHERE \"fromLegId\" = NEW.\"id\"\n   145\t    ) THEN\n   146\t        RAISE EXCEPTION\n   147\t            'Superseded ItineraryLeg % must be recorded by a BookingRebookingLeg.',\n   148\t            NEW.\"id\";\n   149\t    END IF;\n   150\t    RETURN NULL;\n   151\tEND;\n   152\t$$ LANGUAGE plpgsql;\n   153\t\n   154\tCREATE CONSTRAINT TRIGGER \"ItineraryLeg_supersession_is_recorded\"\n   155\t    AFTER UPDATE OF \"supersededAt\" ON \"ItineraryLeg\"\n   156\t    DEFERRABLE INITIALLY DEFERRED\n   157\t    FOR EACH ROW\n   158\t    WHEN (OLD.\"supersededAt\" IS NULL AND NEW.\"supersededAt\" IS NOT NULL)\n   159\t    EXECUTE FUNCTION \"require_recorded_leg_supersession\"();\n   160\t\n   161\t-- The status row is the booking-wide audit sequence. A rebooking can only be\n   162\t-- attached to the transition that resolves a disruption, for the same\n   163\t-- booking, and cannot simultaneously claim a refund.\n   164\tCREATE FUNCTION \"validate_booking_rebooking\"()\n   165\tRETURNS TRIGGER AS $$\n   166\tDECLARE\n   167\t    change \"BookingStatusChange\";\n   168\tBEGIN\n   169\t    SELECT * INTO change\n   170\t    FROM \"BookingStatusChange\"\n   171\t    WHERE \"id\" = NEW.\"bookingStatusChangeId\";\n   172\t\n   173\t    IF NOT FOUND\n   174\t       OR change.\"bookingId\" <> NEW.\"bookingId\"\n   175\t       OR change.\"from\" IS DISTINCT FROM 'DISRUPTED'::\"BookingStatus\"\n   176\t       OR change.\"to\" IS DISTINCT FROM 'CONFIRMED'::\"BookingStatus\"\n   177\t       OR change.\"refundCents\" IS NOT NULL THEN\n   178\t        RAISE EXCEPTION\n   179\t            'BookingRebooking must match one non-refunding DISRUPTED to CONFIRMED status change.';\n   180\t    END IF;\n   181\t    RETURN NEW;\n   182\tEND;\n   183\t$$ LANGUAGE plpgsql;\n   184\t\n   185\tCREATE TRIGGER \"BookingRebooking_is_consistent\"\n   186\t    BEFORE INSERT ON \"BookingRebooking\"\n   187\t    FOR EACH ROW EXECUTE FUNCTION \"validate_booking_rebooking\"();\n   188\t\n   189\t-- Both legs remain real rows. The old one must already be historical, the new\n   190\t-- one current, and both must occupy the same position in this booking.\n   191\tCREATE FUNCTION \"validate_booking_rebooking_leg\"()\n   192\tRETURNS TRIGGER AS $$\n   193\tDECLARE\n   194\t    event_booking_id INTEGER;\n   195\t    from_booking_id INTEGER;\n   196\t    from_sequence INTEGER;\n   197\t    from_superseded_at TIMESTAMP(3);\n   198\t    to_booking_id INTEGER;\n   199\t    to_sequence INTEGER;\n   200\t    to_superseded_at TIMESTAMP(3);\n   201\tBEGIN\n   202\t    SELECT \"bookingId\" INTO event_booking_id\n   203\t    FROM \"BookingRebooking\"\n   204\t    WHERE \"id\" = NEW.\"rebookingId\";\n   205\t    SELECT \"bookingId\", \"sequence\", \"supersededAt\"\n   206\t        INTO from_booking_id, from_sequence, from_superseded_at\n   207\t    FROM \"ItineraryLeg\" WHERE \"id\" = NEW.\"fromLegId\";\n   208\t    SELECT \"bookingId\", \"sequence\", \"supersededAt\"\n   209\t        INTO to_booking_id, to_sequence, to_superseded_at\n   210\t    FROM \"ItineraryLeg\" WHERE \"id\" = NEW.\"toLegId\";\n   211\t\n   212\t    IF event_booking_id IS NULL\n   213\t       OR from_booking_id IS NULL\n   214\t       OR to_booking_id IS NULL\n   215\t       OR from_booking_id <> event_booking_id\n   216\t       OR to_booking_id <> event_booking_id\n   217\t       OR from_sequence <> to_sequence\n   218\t       OR from_superseded_at IS NULL\n   219\t       OR to_superseded_at IS NOT NULL THEN\n   220\t        RAISE EXCEPTION\n   221\t            'BookingRebookingLeg must map superseded and active legs from the same booking and same itinerary position.';\n   222\t    END IF;\n   223\t    RETURN NEW;\n   224\tEND;\n   225\t$$ LANGUAGE plpgsql;\n   226\t\n   227\tCREATE TRIGGER \"BookingRebookingLeg_is_consistent\"\n   228\t    BEFORE INSERT ON \"BookingRebookingLeg\"\n   229\t    FOR EACH ROW EXECUTE FUNCTION \"validate_booking_rebooking_leg\"();\n   230\t\n   231\t-- An event with no leg mapping says a rebooking happened but cannot say what\n   232\t-- changed. Deferred so a normal transaction can insert the event first.\n   233\tCREATE FUNCTION \"require_rebooking_legs\"()\n   234\tRETURNS TRIGGER AS $$\n   235\tBEGIN\n   236\t    IF NOT EXISTS (SELECT 1 FROM \"BookingRebooking\" WHERE \"id\" = NEW.\"id\") THEN\n   237\t        RETURN NULL;\n   238\t    END IF;\n   239\t    IF NOT EXISTS (\n   240\t        SELECT 1 FROM \"BookingRebookingLeg\" WHERE \"rebookingId\" = NEW.\"id\"\n   241\t    ) THEN\n   242\t        RAISE EXCEPTION 'BookingRebooking % must map at least one itinerary leg.', NEW.\"id\";\n   243\t    END IF;\n   244\t    RETURN NULL;\n   245\tEND;\n   246\t$$ LANGUAGE plpgsql;\n   247\t\n   248\tCREATE CONSTRAINT TRIGGER \"BookingRebooking_has_legs\"\n   249\t    AFTER INSERT ON \"BookingRebooking\"\n   250\t    DEFERRABLE INITIALLY DEFERRED\n   251\t    FOR EACH ROW EXECUTE FUNCTION \"require_rebooking_legs\"();\n   252\t\n   253\t-- Updates rewrite audit history. Deletes remain available only through the\n   254\t-- booking cascade, matching BookingStatusChange and test-data cleanup.\n   255\tCREATE FUNCTION \"refuse_rebooking_audit_update\"()\n   256\tRETURNS TRIGGER AS $$\n   257\tBEGIN\n   258\t    RAISE EXCEPTION '% is append-only and cannot be modified.', TG_TABLE_NAME;\n   259\tEND;\n   260\t$$ LANGUAGE plpgsql;\n   261\t\n   262\tCREATE TRIGGER \"BookingRebooking_is_append_only\"\n   263\t    BEFORE UPDATE ON \"BookingRebooking\"\n   264\t    FOR EACH ROW EXECUTE FUNCTION \"refuse_rebooking_audit_update\"();\n   265\t\n   266\tCREATE TRIGGER \"BookingRebookingLeg_is_append_only\"\n   267\t    BEFORE UPDATE ON \"BookingRebookingLeg\"\n   268\t    FOR EACH ROW EXECUTE FUNCTION \"refuse_rebooking_audit_update\"();\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a00bba-29dd-7100-8715-811d18e7c7e1"}}}
