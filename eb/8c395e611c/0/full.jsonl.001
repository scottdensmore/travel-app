rue)`;\n\n        // The seats are released by the status change below, not here: a\n        // cancelled booking never holds one, so the database does it rather\n        // than every caller that knows both facts. Releasing now sets\n        // `releasedAt` and keeps the seat number, where the old code overwrote\n        // the number with a placeholder and lost where the traveller sat (#76).\n        const updatedBooking = await tx.booking.update({\n            where: { id: bookingId },\n            data: { status: \"CANCELLED\" }\n        });\n        if (settled.refundCents <= 0 || !lockedBooking.paymentIntentId) {\n            return { updatedBooking, refundId: null };\n        }\n\n        // The status trigger wrote this row in the update above. Linking the\n        // refund request inside the same transaction means a committed\n        // cancellation can always be retried, even if Stripe is unavailable\n        // immediately afterwards.\n        const ch…4497 tokens truncated…app/actions.test.ts:1030:        await expect(startCheckoutPaymentAction(input)).resolves.toEqual({\n__tests__/app/actions.test.ts:1037:        expect(mockedCreateStripePaymentProvider).toHaveBeenCalledTimes(1);\n__tests__/app/actions.test.ts:1039:        expect(mockStartPayment).toHaveBeenCalledWith({\n__tests__/app/actions.test.ts:1049:        await expect(startCheckoutPaymentAction({\n__tests__/app/actions.test.ts:1059:        expect(mockedCreateStripePaymentProvider).not.toHaveBeenCalled();\n__tests__/app/actions.test.ts:1060:        expect(mockStartPayment).not.toHaveBeenCalled();\n__tests__/app/actions.test.ts:1066:        await expect(startCheckoutPaymentAction(input)).rejects.toThrow('Unauthorized');\n__tests__/app/actions.test.ts:1067:        expect(mockedCreateStripePaymentProvider).not.toHaveBeenCalled();\n__tests__/app/actions.test.ts:1068:        expect(mockStartPayment).not.toHaveBeenCalled();\n__tests__/app/actions.test.ts:1081:        mockStartPayment.mockRejectedValu