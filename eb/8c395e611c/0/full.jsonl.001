nct from the\napp/globals.css:1026:.booking-review-actions button:focus-visible {\napp/globals.css:1027:  outline: 3px solid #fbbf24;\napp/globals.css:1028:  outline-offset: 3px;\napp/globals.css:1214:  outline: 3px solid #fbbf24;\napp/globals.css:1215:  outline-offset: 3px;\n  opacity: 1;\n}\n\n.date-container div {\n  width: 48%;\n  margin-top: 0;\n}\n\n/* Degraded search result: one leg of a round trip could not be loaded.\n   Opaque on purpose -- the page has a photographic background, and a\n   translucent panel would make the warning's contrast depend on whatever\n   happens to be behind it. */\n.search-degraded {\n  background: #2a2412;\n  border: 1px solid rgba(251, 191, 36, 0.45);\n  border-radius: 12px;\n  padding: 1rem 1.5rem;\n  margin-top: 2.5rem;\n  color: #fde68a;\n}\n\n.search-degraded h3 {\n  color: #fbbf24;\n  font-size: 1.1rem;\n  font-weight: bold;\n  margin: 0 0 0.5rem;\n}\n\n.search-degraded p {\n  margin: 0 0 1rem;\n  font-size: 0.9rem;\n}\n\n.search-degraded button {\n  height: auto;\n  min-height: 44px;\n  width: auto;\n  padding: 10px 20px;\n  background: #4a3d14;\n  background-image: none;\n  border: 1px solid rgba(251, 191, 36, 0.6);\n  color: #fde68a;\n  box-shadow: none;\n}\n\n/* This app sets no focus style of its own, so the control added here brings\n   its own rather than inheriting a suppressed browser default (#80). */\n.search-degraded button:focus-visible {\n  outline: 3px solid #fbbf24;\n  outline-offset: 2px;\n}\n\n/* The travel guide's back control. A button, but it reads as the inline link\n   it replaced rather than as a call to action. */\n.guide-back {\n  height: auto;\n  width: auto;\n  padding: 0;\n  background: none;\n  background-image: none;\n  border: 0;\n  box-shadow: none;\n  color: inherit;\n  font: inherit;\n  font-weight: bold;\n  text-decoration: underline;\n  cursor: pointer;\n}\n\n.guide-back:hover {\n  transform: none;\n  box-shadow: none;\n}\n\n/* A flight that does not operate the cabin being shopped. Amber rather than\n   red: the flight is still bookable, just not in that cabin. Opaque because the\n   page background is photographic. */\n.cabin-unavailable {\n  display: inline-block;\n  padding: 3px 8px;\n  border-radius: 6px;\n  background: #3a3018;\n  border: 1px solid rgba(251, 191, 36, 0.45);\n  color: #fde68a;\n  font-size: 0.7rem;\n  font-weight: bold;\n  white-space: nowrap;\n}\n\n/* Footer detail that qualifies a value rather than stating it. */\n.footer-note {\n/**\n * @jest-environment node\n */\nimport fs from 'node:fs';\nimport path from 'node:path';\n\ndescribe('dashboard responsive layout rules', () => {\n    const css = fs.readFileSync(path.join(process.cwd(), 'app/globals.css'), 'utf8');\n\n    it('lets profile and admin flex/grid children shrink within the viewport', () => {\n        expect(css).toContain('.profile, .admin {\\n  min-width: 0;');\n        expect(css).toContain('.profile .content, .admin .content {\\n  min-width: 0;');\n        expect(css).toContain('.admin-flights-layout > * {\\n  min-width: 0;');\n        expect(css).toContain('.profile .profile-card, .admin .admin-card {\\n  min-width: 0;');\n    });\n\n    it('stacks the profile and uses viewport-safe padding on narrow screens', () => {\n        expect(css).toContain('@media (max-width: 900px) {\\n  .profile {\\n    flex-direction: column;');\n        expect(css).toContain('.profile .sidebar-menu {\\n    width: 100%;\\n    flex-basis: auto;');\n        expect(css).toContain('.page-container.admin {\\n    padding-left: 1rem !important;');\n    });\n\n    it('contains the shared titlebar navigation on phone-sized screens', () => {\n        expect(css).toContain('@media (max-width: 600px) {\\n  header {\\n    flex-wrap: wrap;');\n        expect(css).toContain('header nav {\\n    width: 100%;\\n    min-width: 0;\\n    overflow-x: auto;');\n        expect(css).toContain('header nav ul {\\n    width: max-content;\\n    gap: 1rem !important;');\n        expect(css).toContain('header na