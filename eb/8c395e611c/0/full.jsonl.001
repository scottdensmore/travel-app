edAt\" ON \"ItineraryLeg\"\nprisma/migrations/20260816181000_version_itinerary_legs/migration.sql:198:    WHEN (OLD.\"supersededAt\" IS NULL AND NEW.\"supersededAt\" IS NOT NULL)\nprisma/migrations/20260816181000_version_itinerary_legs/migration.sql:201:-- The status row is the booking-wide audit sequence. A rebooking can only be\nprisma/migrations/20260816181000_version_itinerary_legs/migration.sql:204:CREATE FUNCTION \"validate_booking_rebooking\"()\nprisma/migrations/20260816181000_version_itinerary_legs/migration.sql:219:            'BookingRebooking must match one non-refunding DISRUPTED to CONFIRMED status change.';\nprisma/migrations/20260816181000_version_itinerary_legs/migration.sql:225:CREATE TRIGGER \"BookingRebooking_is_consistent\"\nprisma/migrations/20260816181000_version_itinerary_legs/migration.sql:226:    BEFORE INSERT ON \"BookingRebooking\"\nprisma/migrations/20260816181000_version_itinerary_legs/migration.sql:227:    FOR EACH ROW EXECUTE FUNCTION \"validate_booking_rebooking\"();\nprisma/migrations/20260816181000_version_itinerary_legs/migration.sql:231:CREATE FUNCTION \"validate_booking_rebooking_leg\"()\nprisma/migrations/20260816181000_version_itinerary_legs/migration.sql:243:    FROM \"BookingRebooking\"\nprisma/migrations/20260816181000_version_itinerary_legs/migration.sql:244:    WHERE \"id\" = NEW.\"rebookingId\";\nprisma/migrations/20260816181000_version_itinerary_legs/migration.sql:245:    SELECT \"bookingId\", \"sequence\", \"supersededAt\"\nprisma/migrations/20260816181000_version_itinerary_legs/migration.sql:248:    SELECT \"bookingId\", \"sequence\", \"supersededAt\"\nprisma/migrations/20260816181000_version_itinerary_legs/migration.sql:261:            'BookingRebookingLeg must map superseded and active legs from the same booking and same itinerary position.';\nprisma/migrations/20260816181000_version_itinerary_legs/migration.sql:267:CREATE TRIGGER \"BookingRebookingLeg_is_consistent\"\nprisma/migrations/20260816181000_version_itiner