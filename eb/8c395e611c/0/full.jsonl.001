s/ui/ProfileClient.tsx:709:                                const refund = booking.statusChanges?.[0]?.paymentRefund ?? null;\napp/profile/page.tsx:58:      statusChanges: {\napp/profile/page.tsx:139:      paymentReceipt: capturedPayment\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a00bb5-84d2-75b2-a295-9f36c2da7b8e"}}}
