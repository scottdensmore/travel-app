 charge nor\n+/// a partial refund is created: the customer can still choose the full refund.\n+enum RebookingFarePolicy {\n+  DISRUPTION_WAIVER\n+}\n+\n /// The provider state of one checkout's payment session.\n ///\n /// `CREATING` closes the crash window between reserving a durable attempt and\n@@ -137,19 +144,19 @@ enum PaymentRefundStatus {\n /// secret is deliberately not stored here. The request fingerprint binds a\n /// checkout UUID to the itinerary, seats and cabins that produced its quote.\n model PaymentAttempt {\n-  id                   String               @id\n-  checkoutId           String\n-  userId               String?\n-  user                 User?                @relation(fields: [userId], references: [id], onDelete: SetNull)\n-  requestFingerprint   String\n-  amountCents          Int\n-  currency             String               @default(\"USD\")\n-  providerIntentId     String?              @unique\n-  status               PaymentAttemptStatus @default(CREATING)\n-  capturedAt           DateTime?\n-  createdAt            DateTime             @default(now())\n-  updatedAt            DateTime             @updatedAt\n-  webhookEvents        PaymentWebhookEvent[]\n+  id                 String                @id\n+  checkoutId         String\n+  userId             String?\n+  user               User?                 @relation(fields: [userId], references: [id], onDelete: SetNull)\n+  requestFingerprint String\n+  amountCents        Int\n+  currency           String                @default(\"USD\")\n+  providerIntentId   String?               @unique\n+  status             PaymentAttemptStatus  @default(CREATING)\n+  capturedAt         DateTime?\n+  createdAt          DateTime              @default(now())\n+  updatedAt          DateTime              @updatedAt\n+  webhookEvents      PaymentWebhookEvent[]\n \n   @@unique([userId, checkoutId])\n   @@index([status, updatedAt])\n@@ -160,12 +167,12 @@ model PaymentAttempt {\n /// The raw webhook body is deliberately absent: it may contain customer and\n /// payment-provider data that is unnecessary after signature verification.\n model PaymentWebhookEvent {\n-  id                 String         @id\n-  eventType          String\n-  providerIntentId   String\n-  paymentAttemptId   String\n-  paymentAttempt     PaymentAttempt @relation(fields: [paymentAttemptId], references: [id], onDelete: Cascade)\n-  createdAt          DateTime       @default(now())\n+  id               String         @id\n+  eventType        String\n+  providerIntentId String\n+  paymentAttemptId String\n+  paymentAttempt   PaymentAttempt @relation(fields: [paymentAttemptId], references: [id], onDelete: Cascade)\n+  createdAt        DateTime       @default(now())\n \n   @@index([providerIntentId])\n   @@index([paymentAttemptId])\n@@ -188,6 +195,7 @@ model Booking {\n   passengers    Passenger[]\n   legs          ItineraryLeg[]\n   statusChanges BookingStatusChange[]\n+  rebookings    BookingRebooking[]\n \n   @@unique([userId, idempotencyKey])\n }\n@@ -202,49 +210,81 @@ model Booking {\n /// exist has no subject, and blocking that cascade would make a booking\n /// undeletable.\n model BookingStatusChange {\n-  id          String         @id @default(cuid())\n-  bookingId   Int\n-  booking     Booking        @relation(fields: [bookingId], references: [id], onDelete: Cascade)\n+  id            String            @id @default(cuid())\n+  bookingId     Int\n+  booking       Booking           @relation(fields: [bookingId], references: [id], onDelete: Cascade)\n   /// Null for the row that records the booking coming into existence.\n-  from        BookingStatus?\n-  to          BookingStatus\n-  reason      String?\n+  from          BookingStatus?\n+  to            BookingStatus\n+  reason        String?\n   /// What this change owed the customer back, in minor units. Null where the\n   /// change did not refund; zero is a different and real answer, since a\n   /// cancellation inside the cut-off refunds nothing (#76).\n-  refundCents Int?\n+  refundCents   Int?\n   /// Orders changes made in the same transaction, which `createdAt` cannot:\n   /// it is transaction start time, so two changes there share an instant.\n   /// A `BigInt` in the client, so a row handed straight to a client component\n   /// fails to serialise -- select what you need rather than the whole row.\n-  sequence    BigInt         @default(autoincrement())\n+  sequence      BigInt            @default(autoincrement())\n   /// Who caused it. Null for a customer acting on their own booking, and for a\n   /// change nothing attributes.\n-  actorUserId String?\n-  actor       User?          @relation(fields: [actorUserId], references: [id], onDelete: SetNull)\n+  actorUserId   String?\n+  actor         User?             @relation(fields: [actorUserId], references: [id], onDelete: SetNull)\n   paymentRefund PaymentRefund?\n-  createdAt   DateTime       @default(now())\n+  rebooking     BookingRebooking?\n+  createdAt     DateTime          @default(now())\n \n   @@index([bookingId, createdAt])\n   @@index([bookingId, sequence])\n }\n \n+/// The immutable audit event for replacing one or more disrupted itinerary\n+/// legs while retaining the booking, passengers, reference and captured fare.\n+/// The status change records the customer-visible DISRUPTED -> CONFIRMED move;\n+/// this row records why it happened and which legs replaced which.\n+model BookingRebooking {\n+  id                    String                @id @default(cuid())\n+  bookingId             Int\n+  booking               Booking               @relation(fields: [bookingId], references: [id], onDelete: Cascade)\n+  bookingStatusChangeId String                @unique\n+  bookingStatusChange   BookingStatusChange   @relation(fields: [bookingStatusChangeId], references: [id], onDelete: NoAction)\n+  farePolicy            RebookingFarePolicy   @default(DISRUPTION_WAIVER)\n+  legs                  BookingRebookingLeg[]\n+  createdAt    