 relation read. */\n+export const activeItineraryLegWhere = { supersededAt: null } as const;\n+\n /**\n  * The legs of a booking in itinerary order.\n  *\n- * Sorted here rather than trusting the query, because a caller that forgets\n- * `orderBy` would otherwise render the return leg first.\n+ * Historical legs stay attached to the booking after a rebooking. Filter them\n+ * here as a final product-code guard, then sort rather than trusting the query:\n+ * a caller that forgets either database clause must not render two flights at\n+ * the same itinerary position or put the return first.\n  */\n-export function orderedLegs<TLeg extends { sequence: number }>(\n+export function orderedLegs<TLeg extends {\n+    sequence: number;\n+    supersededAt?: Date | string | null;\n+}>(\n     booking: { legs: TLeg[] }\n ): TLeg[] {\n-    return [...booking.legs].sort((left, right) => left.sequence - right.sequence);\n+    return booking.legs\n+        .filter(leg => leg.supersededAt === undefined || leg.supersededAt === null)\n+        .sort((left, right) => left.sequence - right.sequence);\n }\n \n /**\ndiff --git a/lib/flightLock.ts b/lib/flightLock.ts\nindex a028fba..d4c232d 100644\n--- a/lib/flightLock.ts\n+++ b/lib/flightLock.ts\n@@ -33,7 +33,9 @@ export async function lockBookingsOnFlightForUpdate(\n         FROM \"Booking\" b\n         WHERE EXISTS (\n             SELECT 1 FROM \"ItineraryLeg\" l\n-            WHERE l.\"bookingId\" = b.\"id\" AND l.\"flightId\" = ${flightId}\n+            WHERE l.\"bookingId\" = b.\"id\"\n+              AND l.\"flightId\" = ${flightId}\n+              AND l.\"supersededAt\" IS NULL\n         )\n         AND b.\"status\" <> 'CANCELLED'\n         ORDER BY b.\"id\"\ndiff --git a/prisma/schema.prisma b/prisma/schema.prisma\nindex fcc70f5..9ad46ac 100644\n--- a/prisma/schema.prisma\n+++ b/prisma/schema.prisma\n@@ -107,6 +107,13 @@ enum BookingStatus {\n   DISRUPTED\n }\n \n+/// An airline-caused replacement keeps the original captured fare. The\n+/// replacement may catalogue higher or lower, but neither an extra charge nor\n+/// a partial refund is created: the customer can still choose the full refund.\n+enum RebookingFarePolicy {\n+  DISRUPTION_WAIVER\n+}\n+\n /// The provider state of one checkout's payment session.\n ///\n /// `CREATING` closes the crash window between reserving a durable attempt and\n@@ -188,6 +195,7 @@ model Booking {\n   passengers    Passenger[]\n   legs          ItineraryLeg[]\n   statusChanges BookingStatusChange[]\n+  rebookings    BookingRebooking[]\n \n   @@unique([userId, idempotencyKey])\n }\n@@ -223,12 +231,44 @@ model BookingStatusChange {\n   actorUserId String?\n   actor       User?          @relation(fields: [actorUserId], references: [id], onDelete: SetNull)\n   paymentRefund PaymentRefund?\n+  rebooking   BookingRebooking?\n   createdAt   DateTime       @default(now())\n \n   @@index([bookingId, createdAt])\n   @@index([bookingId, sequence])\n }\n \n+/// The immutable audit event for replacing one or more disrupted itinerary\n+/// legs while retaining the booking, passengers, reference and captured fare.\n+/// The status change records the customer-visible DISRUPTED -> CONFIRMED move;\n+/// this row records why it happened and which legs replaced which.\n+model BookingRebooking {\n+  id                    String                @id @default(cuid())\n+  bookingId             Int\n+  booking               Booking               @relation(fields: [bookingId], references: [id], onDelete: Cascade)\n+  bookingStatusChangeId String                @unique\n+  bookingStatusChange   BookingStatusChange   @relation(fields: [bookingStatusChangeId], references: [id], onDelete: NoAction)\n+  farePolicy            RebookingFarePolicy   @default(DISRUPTION_WAIVER)\n+  legs                  BookingRebookingLeg[]\n+  createdAt             DateTime              @default(now())\n+\n+  @@index([bookingId, createdAt])\n+}\n+\n+/// One old-to-new leg mapping within a rebooking. PostgreSQL additionally\n+/// requires both legs to belong to the event's booking and occupy the same\n+/// itinerary position, with only the destination leg still active.\n+model BookingRebookingLeg {\n+  rebookingId String\n+  rebooking   BookingRebooking @relation(fields: [rebookingId], references: [id], onDelete: Cascade)\n+  fromLegId   Int              @unique\n+  fromLeg     ItineraryLeg     @relation(\"RebookingFromLeg\", fields: [fromLegId], references: [id], onDelete: Cascade)\n+  toLegId     Int              @unique\n+  toLeg       ItineraryLeg     @relation(\"RebookingToLeg\", fields: [toLegId], references: [id], onDelete: Cascade)\n+\n+  @@id([rebookingId, fromLegId])\n+}\n+\n /// One provider refund for the exact amount recorded by a cancellation.\n ///\n /// The immutable status-change row remains the policy decision; this row is\n@@ -425,13 +465,23 @@ model ItineraryLeg {\n   flightId  Int\n   flight    Flight  @relation(fields: [flightId], references: [id])\n \n-  seatAssignments SeatAssignment[]\n+  /// Set once this position is replaced. Historical legs and their released\n+  /// seats stay attached to the booking; every current reader selects only\n+  /// rows where this is null.\n+  supersededAt DateTime?\n+\n+  seatAssignments       SeatAssignment[]\n+  rebookingOrigins      BookingRebookingLeg[] @relation(\"RebookingFromLeg\")\n+  rebookingDestinations BookingRebookingLeg[] @relation(\"RebookingToLeg\")\n \n-  @@unique([bookingId, sequence])\n+  /// The one-active-leg-per-position rule is a partial unique index where\n+  /// supersededAt IS NULL, which Prisma cannot express. The rebooking\n+  /// migration creates it and replaces the former unconditional unique key.\n   /// Lets a seat assignment reference (legId, flightId) together, so its\n   /// denormalised flightId can never disagree with the leg's flight.\n   @@unique([id, flightId])\n   @@index([flightId])\n+  @@index([bookingId, supersededAt, sequence])\n }\n \n /// The cabins the airline sells.