ib/paymentAttemptIntegrity.database.test.ts:188:        ['non-ISO currency', { currency: 'usd' }, 'PaymentAttempt_iso_currency'],\n__tests__/lib/paymentAttemptIntegrity.database.test.ts:192:            'PaymentAttempt_sha256_fingerprint',\n__tests__/lib/bookingStatus.database.test.ts:23:async function aBooking(status?: 'CONFIRMED' | 'CANCELLED' | 'DISRUPTED') {\n__tests__/lib/bookingStatus.database.test.ts:67:        for (const status of ['CONFIRMED', 'CANCELLED', 'DISRUPTED'] as const) {\n__tests__/lib/bookingStatus.database.test.ts:180:            data: { bookingId: booking.id, from: 'CONFIRMED', to: 'DISRUPTED', actorUserId: staff.id },\n__tests__/lib/bookingStatus.database.test.ts:192:        expect(after).toMatchObject({ to: 'DISRUPTED', reason: null, actorUserId: staff.id });\n__tests__/lib/bookingStatus.database.test.ts:201:            data: { bookingId: booking.id, from: 'CONFIRMED', to: 'DISRUPTED', actorUserId: staff.id },\n__tests__/lib/bookingStatus.database.test.ts:209:        expect(after!.to).toBe('DISRUPTED');\n__tests__/lib/bookingStatus.database.test.ts:250:            await tx.booking.update({ where: { id: booking.id }, data: { status: 'DISRUPTED' } });\n__tests__/lib/bookingStatus.database.test.ts:254:            where: { bookingId: booking.id, to: 'DISRUPTED' },\n__tests__/lib/bookingStatus.database.test.ts:286:        expect(change!.refundCents).toBe(0);\n__tests__/lib/bookingStatus.database.test.ts:293:        expect(created!.refundCents).toBeNull();\n__tests__/lib/bookingStatus.database.test.ts:303:            await tx.booking.update({ where: { id: booking.id }, data: { status: 'DISRUPTED' } });\n__tests__/lib/bookingStatus.database.test.ts:312:        expect(history.map(entry => entry.to)).toEqual(['CONFIRMED', 'DISRUPTED', 'CANCELLED']);\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a00bb2-2acf-7d53-ab0c-ded966187af9"}}}
