 => {\n__tests__/app/actions.test.ts:995:    it('creates the confirmation notification when a retry recovers payment capture', async () => {\n__tests__/app/actions.test.ts:1035:    it('starts a server-owned payment for the authenticated checkout', async () => {\n__tests__/app/actions.test.ts:1061:    it('rejects card data and client prices before constructing a provider', async () => {\n__tests__/app/actions.test.ts:1078:    it('rejects an unauthenticated caller before constructing a provider', async () => {\n__tests__/app/actions.test.ts:1086:    it('returns recoverable field feedback when a payment checkout loses its hold', async () => {\n__tests__/app/actions.test.ts:1120:    it('lets verified staff refresh one payment attempt and revalidates the queue', async () => {\n__tests__/app/actions.test.ts:1145:    it('rejects callers without verified staff access before constructing Stripe', async () => {\n__tests__/app/actions.test.ts:1155:    it('rejects an invalid attempt ID before constructing Stripe', async () => {\n__tests__/app/actions.test.ts:1168:    it('returns safe recoverable feedback when Stripe reconciliation fails', async () => {\n__tests__/app/actions.test.ts:1199:    it('throws unauthorized if not logged in', async () => {\n__tests__/app/actions.test.ts:1204:    it('removes favorite if it already exists', async () => {\n__tests__/app/actions.test.ts:1219:    it('creates favorite if it does not exist', async () => {\n__tests__/app/actions.test.ts:1234:    it('rejects malformed favorite identifiers before database access', async () => {\n__tests__/app/actions.test.ts:1247:    it('throws unauthorized if not logged in', async () => {\n__tests__/app/actions.test.ts:1252:    it('creates a new review if logged in', async () => {\n__tests__/app/actions.test.ts:1269:    it('rejects oversized review content before database access', async () => {\n__tests__/app/actions.test.ts:1302:    it('rejects an unauthenticated user', async () => {\n__tests__/app/actions.test.ts:1307:    it('rejects a user trying to cancel another user\\'s booking', async () => {\n__tests__/app/actions.test.ts:1315:    it('allows a user to cancel their own booking', async () => {\n__tests__/app/actions.test.ts:1382:    it('leaves the seat assignment alone, because the database releases it', async () => {\n__tests__/app/actions.test.ts:1439:    it('records the refund the policy decided, on the transaction that cancels', async () => {\n__tests__/app/actions.test.ts:1501:    it('durably submits the recorded refund for a captured booking', async () => {\n__tests__/app/actions.test.ts:1540:    it('keeps a committed cancellation truthful when refund submission is unavailable', async () => {\n__tests__/app/actions.test.ts:1570:    it('does not create a provider refund when the cancellation refunds zero', async () => {\n__tests__/app/actions.test.ts:1594:    it('prices the cancellation from the read taken under the lock', async () => {\n__tests__/app/actions.test.ts:1630:    it('refuses to cancel a booking whose flight has departed', async () => {\n__tests__/app/actions.test.ts:1663:    it('allows an admin to cancel any booking', async () => {\n__tests__/app/actions.test.ts:1709:    it('lets the booking owner retry its durable refund', async () => {\n__tests__/app/actions.test.ts:1723:    it('does not reveal another customer\\'s refund', async () => {\n__tests__/app/actions.test.ts:1734:    it('returns a stable validation result when the booking has no refund', async () => {\n__tests__/app/actions.test.ts:1752:    it('maps provider failures to stable refund-safe copy', async () => {\n__tests__/app/actions.test.ts:1801:    it('rejects an unauthenticated user', async () => {\n__tests__/app/actions.test.ts:1806:    it('allows seat changes with valid inputs and transaction checks', async () => {\n__tests__/app/actions.test.ts:1852:    it('rejects if a seat is already occupied', async () => {\n__tests__/app/actions.test.ts:1880:    it('rejects a seat outside the passenger cabin layout', async () => {\n__tests__/app/actions.test.ts:1911:    it('rejects seat changes after a booking is cancelled', async () => {\n__tests__/app/actions.test.ts:1930:    it('rejects malformed seat changes before starting a transaction', async () => {\n__tests__/app/actions.test.ts:1943:    it('rejects an unauthenticated user', async () => {\n__tests__/app/actions.test.ts:1948:    it('rejects a user trying to delete another user\\'s review', async () => {\n__tests__/app/actions.test.ts:1956:    it('allows a user to delete their own review', async () => {\n__tests__/app/actions.test.ts:1968:    it('allows an admin to delete any review', async () => {\n__tests__/app/actions.test.ts:2003:        it('rejects unauthenticated user', async () => {\n__tests__/app/actions.test.ts:2008:        it('rejects non-admin user', async () => {\n__tests__/app/actions.test.ts:2013:        it('rejects an explicitly empty seat pattern', async () => {\n__tests__/app/actions.test.ts:2030:        it('refuses a place that is not an airport, before writing anything', async () => {\n__tests__/app/actions.test.ts:2051:        it('reports both ends at once rather than one round trip each', async () => {\n__tests__/app/actions.test.ts:2065:        it('allows admin to create a new flight schedule and generates flights', async () => {\n__tests__/app/actions.test.ts:2118:        it('normalizes schedule identifiers before persistence', async () => {\n__tests__/app/actions.test.ts:2132:        it('allows admin to update an existing flight schedule', async () => {\n__tests__/app/actions.test.ts:2161:        it('rejects unauthenticated user', async () => {\n__tests__/app/actions.test.ts:2166:        it('allows admin to delete schedule', async () => {\n__tests__/app/actions.test.ts:2179:        it('rejects unauthenticated user', async () => {\n__tests__/app/actions.test.ts:2184:        it('allows admin to update status and creates flight update notifications for affected users', async () => {\n__tests__/app/actions.test.ts:2271:            it('returns empty array if unauthenticated', async () => {\n__tests__/app/actions.test.ts:2277:            it('returns notifications for logged in user', async () => {\n__tests__/app/actions.test.ts:2294:            it('rejects if unauthenticated', async () => {\n__tests__/app/actions.test.ts:2299:            it('rejects if user does not own the notification', async () => {\n__tests__/app/actions.test.ts:2306:            it('updates notification isRead to true if owned', async () => {\n__tests__/app/actions.test.ts:2322:            it('rejects if unauthenticated', async () => {\n__tests__/app/actions.test.ts:2327:            it('marks all unread notifications as read for logged in user', async () => {\n__tests__/app/actions.test.ts:2342:            it('rejects if unauthenticated', async () => {\n__tests__/app/actions.test.ts:2347:            it('rejects if non-admin', async () => {\n__tests__/app/actions.test.ts:2352:            it('generates flight instances and updates existing ones', async () => {\n__tests__/app/actions.test.ts:2402:            it('rejects invalid seating configuration inputs', async () => {\n__tests__/app/actions.test.ts:2465:            it('normalizes seat patterns before persisting occurrences', async () => {\n__tests__/app/actions.test.ts:2489:            it('reports existing occurrences as updated', async () => {\n__tests__/app/actions.test.ts:2520:            it('applies the requested layout after a concurrent occurrence create', async () => {\n__tests__/app/actions.test.ts:2562:            it('rejects malformed or excessive occurrence date ranges', async () => {\n__tests__/app/actions.test.ts:2574:            it('does not invalidate seats already assigned to passengers', async () => {\n__tests__/app/actions.test.ts:2618:            it('does not move an occupied seat across cabin boundaries', async () => {\n__tests__/app/actions.test.ts:2668:    it('refuses an unauthenticated caller, without reaching the database', async () => {\n__tests__/app/actions.test.ts:2675:    it('refuses a session carrying no user id', async () => {\n__tests__/app/actions.test.ts:2682:    it('answers any signed-in traveller, for any flight', async () => {\n__tests__/app/actions.test.ts:2694:    it('still validates the flight id for a signed-in caller', async () => {\n__tests__/app/actions.test.ts:2701:    it('answers who is asking before what they asked for', async () => {\n__tests__/app/actions.test.ts:2714:    it('rejects a malformed checkout identifier before writing a hold', async () => {\n__tests__/app/actions.test.ts:2730:    it('propagates an unexpected hold storage failure', async () => {\n__tests__/app/activeItineraryReads.test.tsx:52:    it('loads only active legs for the customer profile', async () => {\n__tests__/app/activeItineraryReads.test.tsx:59:    it('loads only active legs for recent bookings on the admin dashboard', async () => {\n__tests__/app/activeItineraryReads.test.tsx:66:    it('loads only active booking legs for the admin flight manifest', async () => {\n__tests__/lib/itineraryRebooking.database.test.ts:151:    it('keeps the original leg and released seat while one replacement becomes active', async () => {\n__tests__/lib/itineraryRebooking.database.test.ts:192:    it('stops treating the superseded flight as part of the live booking', async () => {\n__tests__/lib/itineraryRebooking.database.test.ts:209:    it('allows only one active leg at an itinerary position', async () => {\n__tests__/lib/itineraryRebooking.database.test.ts:219:    it('requires every new leg to start active', async () => {\n__tests__/lib/itineraryRebooking.database.test.ts:235:    it('never lets a superseded leg become active again', async () => {\n__tests__/lib/itineraryRebooking.database.test.ts:243:    it('requires a new version instead of rewriting a leg in place', async () => {\n__tests__/lib/itineraryRebooking.database.test.ts:254:    it('refuses to delete a leg while its booking still exists', async () => {\n__tests__/lib/itineraryRebooking.database.test.ts:266:    it('does not let a cascading leg delete erase its rebooking mapping', async () => {\n__tests__/lib/itineraryRebooking.database.test.ts:278:    it('does not let a cascading replacement delete erase its rebooking mapping', async () => {\n__tests__/lib/itineraryRebooking.database.test.ts:290:    it('makes the rebooking event append-only', async () => {\n__tests__/lib/itineraryRebooking.database.test.ts:299:    it('makes the rebooking leg mapping append-only', async () => {\n__tests__/lib/itineraryRebooking.database.test.ts:309:    it('refuses to delete a leg mapping while its historical leg remains', async () => {\n__tests__/lib/itineraryRebooking.database.test.ts:331:    it('refuses to delete a rebooking event while its historical leg remains', async () => {\n__tests__/lib/itineraryRebooking.database.test.ts:346:    it('refuses a mapping between different itinerary positions', async () => {\n__tests__/lib/itineraryRebooking.database.test.ts:370:    it('refuses to supersede a leg without recording its replacement', async () => {\n__tests__/lib/itineraryRebooking.database.test.ts:380:    it('refuses to supersede a leg while its old seat is still live', async () => {\n__tests__/lib/itineraryRebooking.database.test.ts:387:    it('refuses a rebooking event with no leg replacement', async () => {\n__tests__/lib/itineraryRebooking.database.test.ts:402:    it('refuses a leg mapping that crosses booking references', async () => {\n__tests__/lib/itineraryRebooking.database.test.ts:421:    it('refuses an event whose status change also records a refund', async () => {\n__tests__/lib/itineraryRebooking.database.test.ts:433:    it('refuses an event that is not the resolution of a disruption', async () => {\n__tests__/lib/itineraryRebooking.database.test.ts:451:    it('cascades the immutable history when its booking is deleted', async () => {\n"}],"internal_chat_message_metadata_passthrou