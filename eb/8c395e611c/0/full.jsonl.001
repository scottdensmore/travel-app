,\nprisma/migrations/20260810060000_record_cancellation_refunds/migration.sql:74:CREATE INDEX \"BookingStatusChange_bookingId_sequence_idx\"\nprisma/migrations/20260810060000_record_cancellation_refunds/migration.sql:75:    ON \"BookingStatusChange\"(\"bookingId\", \"sequence\");\nprisma/migrations/20260810060000_record_cancellation_refunds/migration.sql:88:    reason TEXT := nullif(current_setting('app.booking_status_reason', true), '');\nprisma/migrations/20260810060000_record_cancellation_refunds/migration.sql:89:    actor TEXT := nullif(current_setting('app.booking_status_actor', true), '');\nprisma/migrations/20260810060000_record_cancellation_refunds/migration.sql:93:        INSERT INTO \"BookingStatusChange\"\nprisma/migrations/20260810060000_record_cancellation_refunds/migration.sql:99:        INSERT INTO \"BookingStatusChange\"\nprisma/migrations/20260810050000_release_seats_without_renaming/migration.sql:37:--     DROP INDEX \"SeatAssignment_flightId_releasedAt_idx\";\nprisma/migrations/20260810050000_release_seats_without_renaming/migration.sql:39:--         WHERE \"releasedAt\" IS NOT NULL;\nprisma/migrations/20260810050000_release_seats_without_renaming/migration.sql:43:--     ALTER TABLE \"SeatAssignment\" DROP COLUMN \"releasedAt\";\nprisma/migrations/20260810050000_release_seats_without_renaming/migration.sql:74:ALTER TABLE \"SeatAssignment\" ADD COLUMN \"releasedAt\" TIMESTAMP(3);\nprisma/migrations/20260810050000_release_seats_without_renaming/migration.sql:84:SET \"releasedAt\" = COALESCE(\nprisma/migrations/20260810050000_release_seats_without_renaming/migration.sql:88:        JOIN \"BookingStatusChange\" c ON c.\"bookingId\" = l.\"bookingId\"\nprisma/migrations/20260810050000_release_seats_without_renaming/migration.sql:115:    WHERE \"seatNumber\" LIKE 'CANCELLED-%' AND \"releasedAt\" IS NULL;\nprisma/migrations/20260810050000_release_seats_without_renaming/migration.sql:132:    WHERE \"releasedAt\" IS NULL;\nprisma/migrations/20260810050000_release_seats_without_renaming/migration.sql:136:CREATE INDEX \"SeatAssignment_flightId_releasedAt_idx\"\nprisma/migrations/20260810050000_release_seats_without_renaming/migration.sql:137:    ON \"SeatAssignment\"(\"flightId\", \"releasedAt\");\nprisma/migrations/20260810050000_release_seats_without_renaming/migration.sql:156:    SET \"releasedAt\" = CURRENT_TIMESTAMP\nprisma/migrations/20260810050000_release_seats_without_renaming/migration.sql:160:      AND sa.\"releasedAt\" IS NULL;\nprisma/migrations/20260810050000_release_seats_without_renaming/migration.sql:166:CREATE TRIGGER \"Booking_releases_seats_when_cancelled\"\nprisma/migrations/20260815210000_add_payment_refunds/migration.sql:8:--     DROP TABLE \"PaymentRefundAttempt\";\nprisma/migrations/20260815210000_add_payment_refunds/migration.sql:9:--     DROP TABLE \"PaymentRefund\";\nprisma/migrations/20260815210000_add_payment_refunds/migration.sql:10:--     DROP TYPE \"PaymentRefundStatus\";\nprisma/migrations/20260815210000_add_payment_refunds/migration.sql:17:CREATE TYPE \"PaymentRefundStatus\" AS ENUM (\nprisma/migrations/20260815210000_add_payment_refunds/migration.sql:25:CREATE TABLE \"PaymentRefund\" (\nprisma/migrations/20260815210000_add_payment_refunds/migration.sql:31:    \"status\"                \"PaymentRefundStatus\" NOT NULL DEFAULT 'PENDING',\nprisma/migrations/20260815210000_add_payment_refunds/migration.sql:35:    CONSTRAINT \"PaymentRefund_pkey\" PRIMARY KEY (\"id\"),\nprisma/migrations/20260815210000_add_payment_refunds/migration.sql:36:    CONSTRAINT \"PaymentRefund_positive_amount\" CHECK (\"amountCents\" > 0),\nprisma/migrations/20260815210000_add_payment_refunds/migration.sql:37:    CONSTRAINT \"PaymentRefund_nonempty_provider_intent\"\nprisma/migrations/20260815210000_add_payment_refunds/migration.sql:39:    CONSTRAINT \"PaymentRefund_currency_format\"\nprisma/migrations/20260815210000_add_payment_refunds/migration.sql:43:CREATE UNIQUE INDEX \"PaymentRefund_bookingStatusChangeId_key\"\nprisma/migrations/20260815210000_add_payment_refunds/migration.sql:44:    ON \"PaymentRefund\"(\"bookingStatusChangeId\");\nprisma/migrations/20260815210000_add_payment_refunds/migration.sql:45:CREATE INDEX \"PaymentRefund_providerIntentId_idx\"\nprisma/migrations/20260815210000_add_payment_refunds/migration.sql:46:    ON \"PaymentRefund\"(\"providerIntentId\");\nprisma/migrations/20260815210000_add_payment_refunds/migration.sql:47:CREATE INDEX \"PaymentRefund_status_updatedAt_idx\"\nprisma/migrations/20260815210000_add_payment_refunds/migration.sql:48:    ON \"PaymentRefund\"(\"status\", \"updatedAt\");\nprisma/migrations/20260815210000_add_payment_refunds/migration.sql:50:ALTER TABLE \"PaymentRefund\"\nprisma/migrations/20260815210000_add_payment_refunds/migration.sql:51:    ADD CONSTRAINT \"PaymentRefund_bookingStatusChangeId_fkey\"\nprisma/migrations/20260815210000_add_payment_refunds/migration.sql:52:    FOREIGN KEY (\"bookingStatusChangeId\") REFERENCES \"BookingStatusChange\"(\"id\")\nprisma/migrations/20260815210000_add_payment_refunds/migration.sql:55:CREATE TABLE \"PaymentRefundAttempt\" (\nprisma/migrations/20260815210000_add_payment_refunds/migration.sql:59:    \"status\"           \"PaymentRefundStatus\" NOT NULL DEFAULT 'PENDING',\nprisma/migrations/20260815210000_add_payment_refunds/migration.sql:64:    CONSTRAINT \"PaymentRefundAttempt_pkey\" PRIMARY KEY (\"id\"),\nprisma/migrations/20260815210000_add_payment_refunds/migration.sql:65:    CONSTRAINT \"PaymentRefundAttempt_nonempty_id\" CHECK (length(btrim(\"id\")) > 0),\nprisma/migrations/20260815210000_add_payment_refunds/migration.sql:66:    CONSTRAINT \"PaymentRefundAttempt_nonempty_provider_refund\"\nprisma/migrations/20260815210000_add_payment_refunds/migration.sql:70:CREATE UNIQUE INDEX \"PaymentRefundAttempt_providerRefundId_key\"\nprisma/migrations/20260815210000_add_payment_refunds/migration.sql:71:    ON \"PaymentRefundAttempt\"(\"providerRefundId\");\nprisma/migrations/20260815210000_add_