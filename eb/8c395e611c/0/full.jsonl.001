ts/auth/AuthEmailRequestForm.tsx:85:                disabled={pending}\ncomponents/auth/AuthEmailRequestForm.tsx:86:                aria-busy={pending}\ncomponents/auth/AuthEmailRequestForm.tsx:89:                {pending ? current.pending : current.button}\ncomponents/auth/AuthTokenPage.tsx:39:                <div role=\"status\" aria-live=\"polite\" className=\"text-sm text-zinc-300\">\ncomponents/auth/AuthTokenPage.tsx:46:                    <div role=\"alert\" className=\"text-red-400\">\ncomponents/auth/AuthTokenForms.tsx:13:        return <div role=\"status\" aria-live=\"polite\" className=\"text-sm text-green-400\">{feedback.message}</div>;\ncomponents/auth/AuthTokenForms.tsx:16:        <div ref={errorRef} role=\"alert\" tabIndex={-1}\ncomponents/auth/AuthTokenForms.tsx:24:    const [pending, setPending] = useState(false);\ncomponents/auth/AuthTokenForms.tsx:58:            {pending && (\ncomponents/auth/AuthTokenForms.tsx:59:                <div role=\"status\" aria-live=\"polite\" className=\"text-sm text-zinc-300\">\ncomponents/auth/AuthTokenForms.tsx:64:                <button type=\"button\" onClick={verify} disabled={pending} aria-busy={pending}\ncomponents/auth/AuthTokenForms.tsx:66:                    {pending ? 'Verifying email…' : 'Verify email'}\ncomponents/auth/AuthTokenForms.tsx:74:    const [pending, setPending] = useState(false);\ncomponents/auth/AuthTokenForms.tsx:123:                    minLength={8} maxLength={128} required disabled={pending}\ncomponents/auth/AuthTokenForms.tsx:129:                    autoComplete=\"new-password\" minLength={8} maxLength={128} required disabled={pending}\ncomponents/auth/AuthTokenForms.tsx:133:            {pending && <div role=\"status\" aria-live=\"polite\" className=\"text-sm text-zinc-300\">Resetting password…</div>}\ncomponents/auth/AuthTokenForms.tsx:134:            <button type=\"submit\" disabled={pending} aria-busy={pending}\ncomponents/auth/AuthTokenForms.tsx:136:                {pending ? 'Resetting