departure and would make this seeded journey miss the\n    // flight it just selected (#275).\n    await fillOneWayFlightSearch(page, targetFlight);\n\n    // Submit search\n    await page.click('button:has-text(\"Find your trip\")');\n\n62:  test('User can search, select cabin and seat, confirm booking, and view it on profile', async ({ page }) => {\n274:  test('legacy /book/:id links redirect to the itinerary checkout', async ({ page }) => {\n286:  test('expired seat holds recover before confirmation and can be selected again', async ({ page }) => {\n342:  test('two checkout tabs keep independent holds and a third is asked to finish one', async ({ page, context }) => {\n421:  test('User chooses both legs in search and carries them into checkout', async ({ page }) => {\n461:  test('User can book a round trip and both legs are seated and persisted', async ({ page }) => {\n","stderr":"","aggregated_output":"        await prisma.paymentAttempt.deleteMany({\n          where: { userId: user.id }\n        });\n        await prisma.user.delete({\n          where: { id: user.id }\n        });\n      } catch (e) {\n        console.error('Cleanup failed:', e);\n      }\n    }\n  });\n\n  test('User can search, select cabin and seat, confirm booking, and view it on profile', async ({ page }) => {\n    // Find an upcoming flight instance from the seeded database to make search reliable\n    const targetFlight = await prisma.flight.findFirst({\n      where: {\n        departureDate: {\n          // This journey proves a provider refund, so choose a departure that\n          // is unambiguously outside the 24-hour no-refund window.\n          gt: new Date(Date.now() + 48 * 60 * 60 * 1000)\n        }\n      },\n      // The route is on the airports now, not on the flight (#73).\n      include: flightRouteInclude,\n      orderBy: {\n        departureDate: 'asc'\n      }\n    });\n\n    if (!targetFlight) {\n      throw new Error('No upcoming flights found in the seeded database');