{"timestamp":"2026-08-16T19:07:49.208Z","ordinal":25370,"type":"event_msg","payload":{"type":"item_completed","thread_id":"019ffe5b-1054-7c22-8afc-e97cb84c7b73","turn_id":"01a00bba-29dd-7100-8715-811d18e7c7e1","item":{"type":"CommandExecution","id":"exec-4046c884-7991-417d-8627-f26e3172f997","process_id":"95184","command":["/bin/bash","-lc","nl -ba prisma/migrations/20260816181000_version_itinerary_legs/migration.sql | sed -n '38,200p;200,340p'"],"cwd":"file:///home/scottdensmore/Developer/scottdensmore/travel-app","parsed_cmd":[{"type":"read","cmd":"nl -ba prisma/migrations/20260816181000_version_itinerary_legs/migration.sql | sed -n '38,200p;200,340p'","name":"migration.sql","path":"prisma/migrations/20260816181000_version_itinerary_legs/migration.sql"}],"source":"unified_exec_startup","status":"completed","stdout":"    38\tCREATE TYPE \"RebookingFarePolicy\" AS ENUM ('DISRUPTION_WAIVER');\n    39\t\n    40\tALTER TABLE \"ItineraryLeg\"\n    41\t    ADD COLUMN \"supersededAt\" TIMESTAMP(3);\n    42\t\n    43\tDROP INDEX \"ItineraryLeg_bookingId_sequence_key\";\n    44\t\n    45\t-- Historical rows may share a position; exactly one current row may not.\n    46\tCREATE UNIQUE INDEX \"ItineraryLeg_active_booking_sequence_key\"\n    47\t    ON \"ItineraryLeg\"(\"bookingId\", \"sequence\")\n    48\t    WHERE \"supersededAt\" IS NULL;\n    49\t\n    50\tCREATE INDEX \"ItineraryLeg_bookingId_supersededAt_sequence_idx\"\n    51\t    ON \"ItineraryLeg\"(\"bookingId\", \"supersededAt\", \"sequence\");\n    52\t\n    53\tCREATE TABLE \"BookingRebooking\" (\n    54\t    \"id\" TEXT NOT NULL,\n    55\t    \"bookingId\" INTEGER NOT NULL,\n    56\t    \"bookingStatusChangeId\" TEXT NOT NULL,\n    57\t    \"farePolicy\" \"RebookingFarePolicy\" NOT NULL DEFAULT 'DISRUPTION_WAIVER',\n    58\t    \"createdAt\" TIMESTAMP(3) NOT NULL DEFAULT CURRENT_TIMESTAMP,\n    59\t\n    60\t    CONSTRAINT \"BookingRebooking_pkey\" PRIMARY KEY (\"id\")\n    61\t);\n    62\t\n    63\tCREATE UNIQUE INDEX \"BookingRebooking_bookingStatusChangeId_key\"\n    64\t    ON \"BookingRebooking\"(\"bookingStatusChangeId\");\n    65\tCREATE INDEX \"BookingRebooking_bookingId_createdAt_idx\"\n    66\t    ON \"BookingRebooking\"(\"bookingId\", \"createdAt\");\n    67\t\n    68\tALTER TABLE \"BookingRebooking\"\n    69\t    ADD CONSTRAINT \"BookingRebooking_bookingId_fkey\"\n    70\t        FOREIGN KEY (\"bookingId\") REFERENCES \"Booking\"(\"id\")\n    71\t        ON DELETE CASCADE ON UPDATE CASCADE,\n    72\t    ADD CONSTRAINT \"BookingRebooking_bookingStatusChangeId_fkey\"\n    73\t        FOREIGN KEY (\"bookingStatusChangeId\") REFERENCES \"BookingStatusChange\"(\"id\")\n    74\t        ON DELETE NO ACTION ON UPDATE CASCADE;\n    75\t\n    76\tCREATE TABLE \"BookingRebookingLeg\" (\n    77\t    \"rebookingId\" TEXT NOT NULL,\n    78\t    \"fromLegId\" INTEGER NOT NULL,\n    79\t    \"toLegId\" INTEGER NOT NULL,\n    80\t\n    81\t    CONSTRAINT \"BookingRebookingLeg_pkey\" PRIMARY KEY (\"rebookingId\", \"fromLegId\"),\n    82\t    CONSTRAINT \"BookingRebookingLeg_different_legs\" CHECK (\"fromLegId\" <> \"toLegId\")\n    83\t);\n    84\t\n    85\tCREATE UNIQUE INDEX \"BookingRebookingLeg_fromLegId_key\"\n    86\t    ON \"BookingRebookingLeg\"(\"fromLegId\");\n    87\tCREATE UNIQUE INDEX \"BookingRebookingLeg_toLegId_key\"\n    88\t    ON \"BookingRebookingLeg\"(\"toLegId\");\n    89\t\n    90\tALTER TABLE \"BookingRebookingLeg\"\n    91\t    ADD CONSTRAINT \"BookingRebookingLeg_rebookingId_fkey\"\n    92\t        FOREIGN KEY (\"rebookingId\") REFERENCES \"BookingRebooking\"(\"id\")\n    93\t        ON DELETE CASCADE ON UPDATE CASCADE,\n    94\t    ADD CONSTRAINT \"BookingRebookingLeg_fromLegId_fkey\"\n    95\t        FOREIGN KEY (\"fromLegId\") REFERENCES \"ItineraryLeg\"(\"id\")\n    96\t        ON DELETE CASCADE ON UPDATE CASCADE,\n    97\t    ADD CONSTRAINT \"BookingRebookingLeg_toLegId_fkey\"\n    98\t        FOREIGN KEY (\"toLegId\") REFERENCES \"ItineraryLeg\"(\"id\")\n    99\t        ON DELETE CASCADE ON UPDATE CASCADE;\n   100\t\n   101\t-- Every historical leg has to become historical through the recorded update\n   102\t-- below. Accepting a row that starts superseded would bypass that audit path.\n   103\tCREATE FUNCTION \"require_new_itinerary_leg_active\"()\n   104\tRETURNS TRIGGER AS $$\n   105\tBEGIN\n   106\t    IF NEW.\"supersededAt\" IS NOT NULL THEN\n   107\t        RAISE EXCEPTION\n   108\t            'A new ItineraryLeg must start active; supersede it through a recorded rebooking.';\n   109\t    END IF;\n   110\t    RETURN NEW;\n   111\tEND;\n   112\t$$ LANGUAGE plpgsql;\n   113\t\n   114\tCREATE TRIGGER \"ItineraryLeg_starts_active\"\n   115\t    BEFORE INSERT ON \"ItineraryLeg\"\n   116\t    FOR EACH ROW EXECUTE FUNCTION \"require_new_itinerary_leg_active\"();\n   117\t\n   118\t-- A leg disappears only when its whole booking does. Deferred so the booking\n   119\t-- cascade has removed the parent by the time this checks it; a direct leg\n   120\t-- delete, even beside deletion of its audit mapping, still sees the booking.\n   121\tCREATE FUNCTION \"require_itinerary_leg_booking_delete\"()\n   122\tRETURNS TRIGGER AS $$\n   123\tBEGIN\n   124\t    IF EXISTS (SELECT 1 FROM \"Booking\" WHERE \"id\" = OLD.\"bookingId\") THEN\n   125\t        RAISE EXCEPTION\n   126\t            'ItineraryLeg % cannot be deleted while booking % exists.',\n   127\t            OLD.\"id\", OLD.\"bookingId\";\n   128\t    END IF;\n   129\t    RETURN NULL;\n   130\tEND;\n   131\t$$ LANGUAGE plpgsql;\n   132\t\n   133\tCREATE CONSTRAINT TRIGGER \"ItineraryLeg_deletes_with_booking\"\n   134\t    AFTER DELETE ON \"ItineraryLeg\"\n   135\t    DEFERRABLE INITIALLY DEFERRED\n   136\t    FOR EACH ROW EXECUTE FUNCTION \"require_itinerary_leg_booking_delete\"();\n   137\t\n   138\t-- A leg's identity never changes in place: a different flight is a new version.\n   139\t-- Once superseded, its timestamp is permanent too. The sole state transition\n   140\t-- this permits is setting supersededAt on a currently active leg.\n   141\tCREATE FUNCTION \"refuse_itinerary_leg_rewrite\"()\n   142\tRETURNS TRIGGER AS $$\n   143\tBEGIN\n   144\t    IF NEW.\"id\" IS DISTINCT FROM OLD.\"id\"\n   145\t       OR NEW.\"bookingId\" IS DISTINCT FROM OLD.\"bookingId\"\n   146\t       OR NEW.\"sequence\" IS DISTINCT FROM OLD.\"sequence\"\n   147\t       OR NEW.\"flightId\" IS DISTINCT FROM OLD.\"flightId\" THEN\n   148\t        RAISE EXCEPTION\n   149\t            'ItineraryLeg identity is immutable: replace leg % with a new version.',\n   150\t            OLD.\"id\";\n   151\t    END IF;\n   152\t    IF OLD.\"supersededAt\" IS NOT NULL\n   153\t       AND NEW.\"supersededAt\" IS DISTINCT FROM OLD.\"supersededAt\" THEN\n   154\t        RAISE EXCEPTION\n   155\t            'ItineraryLeg supersession is permanent: leg % cannot become active or change time.',\n   156\t            OLD.\"id\";\n   157\t    END IF;\n   158\t    RETURN NEW;\n   159\tEND;\n   160\t$$ LANGUAGE plpgsql;\n   161\t\n   162\tCREATE TRIGGER \"ItineraryLeg_supersession_is_permanent\"\n   163\t    BEFORE UPDATE ON \"ItineraryLeg\"\n   164\t    FOR EACH ROW EXECUTE FUNCTION \"refuse_itinerary_leg_rewrite\"();\n   165\t\n   166\t-- A superseded leg must be named by an immutable rebooking mapping before its\n   167\t-- transaction commits. Deferred because the event and replacement leg are\n   168\t-- naturally written after the original leg is marked historical.\n   169\tCREATE FUNCTION \"require_recorded_leg_supersession\"()\n   170\tRETURNS TRIGGER AS $$\n   171\tBEGIN\n   172\t    IF NOT EXISTS (SELECT 1 FROM \"ItineraryLeg\" WHERE \"id\" = NEW.\"id\") THEN\n   173\t        RETURN NULL;\n   174\t    END IF;\n   175\t    IF NOT EXISTS (\n   176\t        SELECT 1 FROM \"BookingRebookingLeg\" WHERE \"fromLegId\" = NEW.\"id\"\n   177\t    ) THEN\n   178\t        RAISE EXCEPTION\n   179\t            'Superseded ItineraryLeg % must be recorded by a BookingRebookingLeg.',\n   180\t            NEW.\"id\";\n   181\t    END IF;\n   182\t    IF EXISTS (\n   183\t        SELECT 1 FROM \"SeatAssignment\"\n   184\t        WHERE \"legId\" = NEW.\"id\" AND \"releasedAt\" IS NULL\n   185\t    ) THEN\n   186\t        RAISE EXCEPTION\n   187\t            'Superseded ItineraryLeg % cannot retain live seat assignments.',\n   188\t            NEW.\"id\";\n   189\t    END IF;\n   190\t    RETURN NULL;\n   191\tEND;\n   192\t$$ LANGUAGE plpgsql;\n   193\t\n   194\tCREATE CONSTRAINT TRIGGER \"ItineraryLeg_supersession_is_recorded\"\n   195\t    AFTER UPDATE OF \"supersededAt\" ON \"ItineraryLeg\"\n   196\t    DEFERRABLE INITIALLY DEFERRED\n   197\t    FOR EACH ROW\n   198\t    WHEN (OLD.\"supersededAt\" IS NULL AND NEW.\"supersededAt\" IS NOT NULL)\n   199\t    EXECUTE FUNCTION \"require_recorded_leg_supersession\"();\n   200\t\n   200\t\n   201\t-- The status row is the booking-wide audit sequence. A rebooking can only be\n   202\t-- attached to the transition that resolves a disruption, for the same\n   203\t-- booking, and cannot simultaneously claim a refund.\n   204\tCREATE FUNCTION \"validate_booking_rebooking\"()\n   205\tRETURNS TRIGGER AS $$\n   206\tDECLARE\n   207\t    change \"BookingStatusChange\";\n   208\tBEGIN\n   209\t    SELECT * INTO change\n   210\t    FROM \"BookingStatusChange\"\n   211\t    WHERE \"id\" = NEW.\"bookingStatusChangeId\";\n   212\t\n   213\t    IF NOT FOUND\n   214\t       OR change.\"bookingId\" <> NEW.\"bookingId\"\n   215\t       OR change.\"from\" IS DISTINCT FROM 'DISRUPTED'::\"BookingStatus\"\n   216\t       OR change.\"to\" IS DISTINCT FROM 'CONFIRMED'::\"BookingStatus\"\n   217\t       OR change.\"refundCents\" IS NOT NULL THEN\n   218\t        RAISE EXCEPTION\n   219\t            'BookingRebooking must match one non-refunding DISRUPTED to CONFIRMED status change.';\n   220\t    END IF;\n   221\t    RETURN NEW;\n   222\tEND;\n   223\t$$ LANGUAGE plpgsql;\n   224\t\n   225\tCREATE TRIGGER \"BookingRebooking_is_consistent\"\n   226\t    BEFORE INSERT ON \"BookingRebooking\"\n   227\t    FOR EACH ROW EXECUTE FUNCTION \"validate_booking_rebooking\"();\n   228\t\n   229\t-- Both legs remain real rows. The old one must already be historical, the new\n   230\t-- one current, and both must occupy the same position in this booking.\n   231\tCREATE FUNCTION \"validate_booking_rebooking_leg\"()\n   232\tRETURNS TRIGGER AS $$\n   233\tDECLARE\n   234\t    event_booking_id INTEGER;\n   235\t    from_booking_id INTEGER;\n   236\t    from_sequence INTEGER;\n   237\t    from_superseded_at TIMESTAMP(3);\n   238\t    to_booking_id INTEGER;\n   239\t    to_sequence INTEGER;\n   240\t    to_superseded_at TIMESTAMP(3);\n   241\tBEGIN\n   242\t    SELECT \"bookingId\" INTO event_booking_id\n   243\t    FROM \"BookingRebooking\"\n   244\t    WHERE \"id\" = NEW.\"rebookingId\";\n   245\t    SELECT \"bookingId\", \"sequence\", \"supersededAt\"\n   246\t        INTO from_booking_id, from_sequence, from_superseded_at\n   247\t    FROM \"ItineraryLeg\" WHERE \"id\" = NEW.\"fromLegId\";\n   248\t    SELECT \"bookingId\", \"sequence\", \"supersededAt\"\n   249\t        INTO to_booking_id, to_sequence, to_superseded_at\n   250\t    FROM \"ItineraryLeg\" WHERE \"id\" = NEW.\"toLegId\";\n   251\t\n   252\t    IF event_booking_id IS NULL\n   253\t       OR from_booking_id IS NULL\n   254\t       OR to_booking_id IS NULL\n   255\t       OR from_booking_id <> event_booking_id\n   256\t       OR to_booking_id <> event_booking_id\n   257\t       OR from_sequence <> to_sequence\n   258\t       OR from_superseded_at IS NULL\n   259\t       OR to_superseded_at IS NOT NULL THEN\n   260\t        RAISE EXCEPTION\n   261\t            'BookingRebookingLeg must map superseded and active legs from the same booking and same itinerary position.';\n   262\t    END IF;\n   263\t    RETURN NEW;\n   264\tEND;\n   265\t$$ LANGUAGE plpgsql;\n   266\t\n   267\tCREATE TRIGGER \"BookingRebookingLeg_is_consistent\"\n   268\t    BEFORE INSERT ON \"BookingRebookingLeg\"\n   269\t    FOR EACH ROW EXECUTE FUNCTION \"validate_booking_rebooking_leg\"();\n   270\t\n   271\t-- An event with no leg mapping says a rebooking happened but cannot say what\n   272\t-- changed. Deferred so a normal transaction can insert the event first.\n   273\tCREATE FUNCTION \"require_rebooking_legs\"()\n   274\tRETURNS TRIGGER AS $$\n   275\tBEGIN\n   276\t    IF NOT EXISTS (SELECT 1 FROM \"BookingRebooking\" WHERE \"id\" = NEW.\"id\") THEN\n   277\t        RETURN NULL;\n   278\t    END IF;\n   279\t    IF NOT EXISTS (\n   280\t        SELECT 1 FROM \"BookingRebookingLeg\" WHERE \"rebookingId\" = NEW.\"id\"\n   281\t    ) THEN\n   282\t        RAISE EXCEPTION 'BookingRebooking % must map at least one itinerary leg.', NEW.\"id\";\n   283\t    END IF;\n   284\t    RETURN NULL;\n   285\tEND;\n   286\t$$ LANGUAGE plpgsql;\n   287\t\n   288\tCREATE CONSTRAINT TRIGGER \"BookingRebooking_has_legs\"\n   289\t    AFTER INSERT ON \"BookingRebooking\"\n   290\t    DEFERRABLE INITIALLY DEFERRED\n   291\t    FOR EACH ROW EXECUTE FUNCTION \"require_rebooking_legs\"();\n   292\t\n   293\t-- A direct mapping or event delete would leave its source leg historical with\n   294\t-- no record of what replaced it. Deferred so deleting the whole booking remains\n   295\t-- possible: that cascade also deletes the source leg before this check runs.\n   296\tCREATE FUNCTION \"require_supersession_mapping_after_delete\"()\n   297\tRETURNS TRIGGER AS $$\n   298\tBEGIN\n   299\t    IF EXISTS (\n   300\t        SELECT 1 FROM \"ItineraryLeg\"\n   301\t        WHERE \"id\" = OLD.\"fromLegId\" AND \"supersededAt\" IS NOT NULL\n   302\t    ) AND NOT EXISTS (\n   303\t        SELECT 1 FROM \"BookingRebookingLeg\" WHERE \"fromLegId\" = OLD.\"fromLegId\"\n   304\t    ) THEN\n   305\t        RAISE EXCEPTION\n   306\t            'BookingRebookingLeg for superseded ItineraryLeg % cannot be deleted directly.',\n   307\t            OLD.\"fromLegId\";\n   308\t    END IF;\n   309\t    RETURN NULL;\n   310\tEND;\n   311\t$$ LANGUAGE plpgsql;\n   312\t\n   313\tCREATE CONSTRAINT TRIGGER \"BookingRebookingLeg_preserves_supersession\"\n   314\t    AFTER DELETE ON \"BookingRebookingLeg\"\n   315\t    DEFERRABLE INITIALLY DEFERRED\n   316\t    FOR EACH ROW EXECUTE FUNCTION \"require_supersession_mapping_after_delete\"();\n   317\t\n   318\t-- Updates rewrite audit history. Deletes remain available only through the\n   319\t-- booking cascade, matching BookingStatusChange and test-data cleanup.\n   320\tCREATE FUNCTION \"refuse_rebooking_audit_update\"()\n   321\tRETURNS TRIGGER AS $$\n   322\tBEGIN\n   323\t    RAISE EXCEPTION '% is append-only and cannot be modified.', TG_TABLE_NAME;\n   324\tEND;\n   325\t$$ LANGUAGE plpgsql;\n   326\t\n   327\tCREATE TRIGGER \"BookingRebooking_is_append_only\"\n   328\t    BEFORE UPDATE ON \"BookingRebooking\"\n   329\t    FOR EACH ROW EXECUTE FUNCTION \"refuse_rebooking_audit_update\"();\n   330\t\n   331\tCREATE TRIGGER \"BookingRebookingLeg_is_append_only\"\n   332\t    BEFORE UPDATE ON \"BookingRebookingLeg\"\n   333\t    FOR EACH ROW EXECUTE FUNCTION \"refuse_rebooking_audit_update\"();\n","stderr":"","aggregated_output":"    38\tCREATE TYPE \"RebookingFarePolicy\" AS ENUM ('DISRUPTION_WAIVER');\n    39\t\n    40\tALTER TABLE \"ItineraryLeg\"\n    41\t    ADD COLUMN \"supersededAt\" TIMESTAMP(3);\n    42\t\n    43\tDROP INDEX \"ItineraryLeg_bookingId_sequence_key\";\n    44\t\n    45\t-- Historical rows may share a position; exactly one current row may not.\n    46\tCREATE UNIQUE INDEX \"ItineraryLeg_active_booking_sequence_key\"\n    47\t    ON \"ItineraryLeg\"(\"bookingId\", \"sequence\")\n    48\t    WHERE \"supersededAt\" IS NULL;\n    49\t\n    50\tCREATE INDEX \"ItineraryLeg_bookingId_supersededAt_sequence_idx\"\n    51\t    ON \"ItineraryLeg\"(\"bookingId\", \"supersededAt\", \"sequence\");\n    52\t\n    53\tCREATE TABLE \"BookingRebooking\" (\n    54\t    \"id\" TEXT NOT NULL,\n    55\t    \"bookingId\" INTEGER NOT NULL,\n    56\t    \"bookingStatusChangeId\" TEXT NOT NULL,\n    57\t    \"farePolicy\" \"RebookingFarePolicy\" NOT NULL DEFAULT 'DISRUPTION_WAIVER',\n    58\t    \"createdAt\" TIMESTAMP(3) NOT NULL DEFAULT CURRENT_TIMESTAMP,\n    59\t\n    60\t    CONSTRAINT \"BookingRebooking_pkey\" PRIMARY KEY (\"id\")\n    61\t);\n    62\t\n    63\tCREATE UNIQUE INDEX \"BookingRebooking_bookingStatusChangeId_key\"\n    64\t    ON \"BookingRebooking\"(\"bookingStatusChangeId\");\n    65\tCREATE INDEX \"BookingRebooking_bookingId_createdAt_idx\"\n    66\t    ON \"BookingRebooking\"(\"bookingId\", \"createdAt\");\n    67\t\n    68\tALTER TABLE \"BookingRebooking\"\n    69\t    ADD CONSTRAINT \"BookingRebooking_bookingId_fkey\"\n    70\t        FOREIGN KEY (\"bookingId\") REFERENCES \"Booking\"(\"id\")\n    71\t        ON DELETE CASCADE ON UPDATE CASCADE,\n    72\t    ADD CONSTRAINT \"BookingRebooking_bookingStatusChangeId_fkey\"\n    73\t        FOREIGN KEY (\"bookingStatusChangeId\") REFERENCES \"BookingStatusChange\"(\"id\")\n    74\t        ON DELETE NO ACTION ON UPDATE CASCADE;\n    75\t\n    76\tCREATE TABLE \"BookingRebookingLeg\" (\n    77\t    \"rebookingId\" TEXT NOT NULL,\n    78\t    \"fromLegId\" INTEGER NOT NULL,\n    79\t    \"toLegId\" INTEGER NOT NULL,\n    80\t\n    81\t    CONSTRAINT \"BookingRebookingLeg_pkey\" PRIMARY KEY (\"rebookingId\", \"fromLegId\"),\n    82\t    CONSTRAINT \"BookingRebookingLeg_different_legs\" CHECK (\"fromLegId\" <> \"toLegId\")\n    83\t);\n    84\t\n    85\tCREATE UNIQUE INDEX \"BookingRebookingLeg_fromLegId_key\"\n    86\t    ON \"BookingRebookingLeg\"(\"fromLegId\");\n    87\tCREATE UNIQUE INDEX \"BookingRebookingLeg_toLegId_key\"\n    88\t    ON \"BookingRebookingLeg\"(\"toLegId\");\n    89\t\n    90\tALTER TABLE \"BookingRebookingLeg\"\n    91\t    ADD CONSTRAINT \"BookingRebookingLeg_rebookingId_fkey\"\n    92\t        FOREIGN KEY (\"rebookingId\") REFERENCES \"BookingRebooking\"(\"id\")\n    93\t        ON DELETE CASCADE ON UPDATE CASCADE,\n    94\t    ADD CONSTRAINT \"BookingRebookingLeg_fromLegId_fkey\"\n    95\t        FOREIGN KEY (\"fromLegId\") REFERENCES \"ItineraryLeg\"(\"id\")\n    96\t        ON DELETE CASCADE ON UPDATE CASCADE,\n    97\t    ADD CONSTRAINT \"BookingRebookingLeg_toLegId_fkey\"\n    98\t        FOREIGN KEY (\"toLegId\") REFERENCES \"ItineraryLeg\"(\"id\")\n    99\t        ON DELETE CASCADE ON UPDATE CASCADE;\n   100\t\n   101\t-- Every historical leg has to become historical through the recorded update\n   102\t-- below. Accepting a row that starts superseded would bypass that audit path.\n   103\tCREATE FUNCTION \"require_new_itinerary_leg_active\"()\n   104\tRETURNS TRIGGER AS $$\n   105\tBEGIN\n   106\t    IF NEW.\"supersededAt\" IS NOT NULL THEN\n   107\t        RAISE EXCEPTION\n   108\t            'A new ItineraryLeg must start active; supersede it through a recorded rebooking.';\n   109\t    END IF;\n   110\t    RETURN NEW;\n   111\tEND;\n   112\t$$ LANGUAGE plpgsql;\n   113\t\n   114\tCREATE TRIGGER \"ItineraryLeg_starts_active\"\n   115\t    BEFORE INSERT ON \"ItineraryLeg\"\n   116\t    FOR EACH ROW EXECUTE FUNCTION \"require_new_itinerary_leg_active\"();\n   117\t\n   118\t-- A leg disappears only when its whole booking does. Deferred so the booking\n   119\t-- cascade has removed the parent by the time this checks it; a direct leg\n   120\t-- delete, even beside deletion of its audit mapping, still sees the booking.\n   121\tCREATE FUNCTION \"require_itinerary_leg_booking_delete\"()\n   122\tRETURNS TRIGGER AS $$\n   123\tBEGIN\n   124\t    IF EXISTS (SELECT 1 FROM \"Booking\" WHERE \"id\" = OLD.\"bookingId\") THEN\n   125\t        RAISE EXCEPTION\n   126\t            'ItineraryLeg % cannot be deleted while booking % exists.',\n   127\t            OLD.\"id\", OLD.\"bookingId\";\n   128\t    END IF;\n   129\t    RETURN NULL;\n   130\tEND;\n   131\t$$ LANGUAGE plpgsql;\n   132\t\n   133\tCREATE CONSTRAINT TRIGGER \"ItineraryLeg_deletes_with_booking\"\n   134\t    AFTER DELETE ON \"ItineraryLeg\"\n   135\t    DEFERRABLE INITIALLY DEFERRED\n   136\t    FOR EACH ROW EXECUTE FUNCTION \"require_itinerary_leg_booking_delete\"();\n   137\t\n   138\t-- A leg's identity never changes in place: a different flight is a new version.\n   139\t-- Once superseded, its timestamp is permanent too. The sole state transition\n   140\t-- this permits is setting supersededAt on a currently active leg.\n   141\tCREATE FUNCTION \"refuse_itinerary_leg_rewrite\"()\n   142\tRETURNS TRIGGER AS $$\n   143\tBEGIN\n   144\t    IF NEW.\"id\" IS DISTINCT FROM OLD.\"id\"\n   145\t       OR NEW.\"bookingId\" IS DISTINCT FROM OLD.\"bookingId\"\n   146\t       OR NEW.\"sequence\" IS DISTINCT FROM OLD.\"sequence\"\n   147\t       OR NEW.\"flightId\" IS DISTINCT FROM OLD.\"flightId\" THEN\n   148\t        RAISE EXCEPTION\n   149\t            'ItineraryLeg identity is immutable: replace leg % with a new version.',\n   150\t            OLD.\"id\";\n   151\t    END IF;\n   152\t    IF OLD.\"supersededAt\" IS NOT NULL\n   153\t       AND NEW.\"supersededAt\" IS DISTINCT FROM OLD.\"supersededAt\" THEN\n   154\t        RAISE EXCEPTION\n   155\t            'ItineraryLeg supersession is permanent: leg % cannot become active or change time.',\n   156\t            OLD.\"id\";\n   157\t    END IF;\n   158\t    RETURN NEW;\n   159\tEND;\n   160\t$$ LANGUAGE plpgsql;\n   161\t\n   162\tCREATE TRIGGER \"ItineraryLeg_supersession_is_permanent\"\n   163\t    BEFORE UPDATE ON \"ItineraryLeg\"\n   164\t    FOR EACH ROW EXECUTE FUNCTION \"refuse_itinerary_leg_rewrite\"();\n   165\t\n   166\t-- A superseded leg must be named by an immutable rebooking mapping before its\n   167\t-- transaction commits. Deferred because the event and replacement leg are\n   168\t-- naturally written after the original leg is marked historical.\n   169\tCREATE FUNCTION \"require_recorded_leg_supersession\"()\n   170\tRETURNS TRIGGER AS $$\n   171\tBEGIN\n   172\t    IF NOT EXISTS (SELECT 1 FROM \"ItineraryLeg\" WHERE \"id\" = NEW.\"id\") THEN\n   173\t        RETURN NULL;\n   174\t    END IF;\n   175\t    IF NOT EXISTS (\n   176\t        SELECT 1 FROM \"BookingRebookingLeg\" WHERE \"fromLegId\" = NEW.\"id\"\n   177\t    ) THEN\n   178\t        RAISE EXCEPTION\n   179\t            'Superseded ItineraryLeg % must be recorded by a BookingRebookingLeg.',\n   180\t            NEW.\"id\";\n   181\t    END IF;\n   182\t    IF EXISTS (\n   183\t        SELECT 1 FROM \"SeatAssignment\"\n   184\t        WHERE \"legId\" = NEW.\"id\" AND \"releasedAt\" IS NULL\n   185\t    ) THEN\n   186\t        RAISE EXCEPTION\n   187\t            'Superseded ItineraryLeg % cannot retain live seat assignments.',\n   188\t            NEW.\"id\";\n   189\t    END IF;\n   190\t    RETURN NULL;\n   191\tEND;\n   192\t$$ LANGUAGE plpgsql;\n   193\t\n   194\tCREATE CONSTRAINT TRIGGER \"ItineraryLeg_supersession_is_recorded\"\n   195\t    AFTER UPDATE OF \"supersededAt\" ON \"ItineraryLeg\"\n   196\t    DEFERRABLE INITIALLY DEFERRED\n   197\t    FOR EACH ROW\n   198\t    WHEN (OLD.\"supersededAt\" IS NULL AND NEW.\"supersededAt\" IS NOT NULL)\n   199\t    EXECUTE FUNCTION \"require_recorded_leg_supersession\"();\n   200\t\n   200\t\n   201\t-- The status row is the booking-wide audit sequence. A rebooking can only be\n   202\t-- attached to the transition that resolves a disruption, for the same\n   203\t-- booking, and cannot simultaneously claim a refund.\n   204\tCREATE FUNCTION \"validate_booking_rebooking\"()\n   205\tRETURNS TRIGGER AS $$\n   206\tDECLARE\n   207\t    change \"BookingStatusChange\";\n   208\tBEGIN\n   209\t    SELECT * INTO change\n   210\t    FROM \"BookingStatusChange\"\n   211\t    WHERE \"id\" = NEW.\"bookingStatusChangeId\";\n   212\t\n   213\t    IF NOT FOUND\n   214\t       OR change.\"bookingId\" <> NEW.\"bookingId\"\n   215\t       OR change.\"from\" IS DISTINCT FROM 'DISRUPTED'::\"BookingStatus\"\n   216\t       OR change.\"to\" IS DISTINCT FROM 'CONFIRMED'::\"BookingStatus\"\n   217\t       OR change.\"refundCents\" IS NOT NULL THEN\n   218\t        RAISE EXCEPTION\n   219\t            'BookingRebooking must match one non-refunding DISRUPTED to CONFIRMED status change.';\n   220\t    END IF;\n   221\t    RETURN NEW;\n   222\tEND;\n   223\t$$ LANGUAGE plpgsql;\n   224\t\n   225\tCREATE TRIGGER \"BookingRebooking_is_consistent\"\n   226\t    BEFORE INSERT ON \"BookingRebooking\"\n   227\t    FOR EACH ROW EXECUTE FUNCTION \"validate_booking_rebooking\"();\n   228\t\n   229\t-- Both legs remain real rows. The old one must already be historical, the new\n   230\t-- one current, and both must occupy the same position in this booking.\n   231\tCREATE FUNCTION \"validate_booking_rebooking_leg\"()\n   232\tRETURNS TRIGGER AS $$\n   233\tDECLARE\n   234\t    event_booking_id INTEGER;\n   235\t    from_booking_id INTEGER;\n   236\t    from_sequence INTEGER;\n   237\t    from_superseded_at TIMESTAMP(3);\n   238\t    to_booking_id INTEGER;\n   239\t    to_sequence INTEGER;\n   240\t    to_superseded_at TIMESTAMP(3);\n   241\tBEGIN\n   242\t    SELECT \"bookingId\" INTO event_booking_id\n   243\t    FROM \"BookingRebooking\"\n   244\t    WHERE \"id\" = NEW.\"rebookingId\";\n   245\t    SELECT \"bookingId\", \"sequence\", \"supersededAt\"\n   246\t        INTO from_booking_id, from_sequence, from_superseded_at\n   247\t    FROM \"ItineraryLeg\" WHERE \"id\" = NEW.\"fromLegId\";\n   248\t    SELECT \"bookingId\", \"sequence\", \"supersededAt\"\n   249\t        INTO to_booking_id, to_sequence, to_superseded_at\n   250\t    FROM \"ItineraryLeg\" WHERE \"id\" = NEW.\"toLegId\";\n   251\t\n   252\t    IF event_booking_id IS NULL\n   253\t       OR from_booking_id IS NULL\n   254\t       OR to_booking_id IS NULL\n   255\t       OR from_booking_id <> event_booking_id\n   256\t       OR to_booking_id <> event_booking_id\n   257\t       OR from_sequence <> to_sequence\n   258\t       OR from_superseded_at IS NULL\n   259\t       OR to_superseded_at IS NOT NULL THEN\n   260\t        RAISE EXCEPTION\n   261\t            'BookingRebookingLeg must map superseded and active legs from the same booking and same itinerary position.';\n   262\t    END IF;\n   263\t    RETURN NEW;\n   264\tEND;\n   265\t$$ LANGUAGE plpgsql;\n   266\t\n   267\tCREATE TRIGGER \"BookingRebookingLeg_is_consistent\"\n   268\t    BEFORE INSERT ON \"BookingRebookingLeg\"\n   269\t    FOR EACH ROW EXECUTE FUNCTION \"validate_booking_rebooking_leg\"();\n   270\t\n   271\t-- An event with no leg mapping says a rebooking happened but cannot say what\n   272\t-- changed. Deferred so a normal transaction can insert the event first.\n   273\tCREATE FUNCTION \"require_rebooking_legs\"()\n   274\tRETURNS TRIGGER AS $$\n   275\tBEGIN\n   276\t    IF NOT EXISTS (SELECT 1 FROM \"BookingRebooking\" WHERE \"id\" = NEW.\"id\") THEN\n   277\t        RETURN NULL;\n   278\t    END IF;\n   279\t    IF NOT EXISTS (\n   280\t        SELECT 1 FROM \"BookingRebookingLeg\" WHERE \"rebookingId\" = NEW.\"id\"\n   281\t    ) THEN\n   282\t        RAISE EXCEPTION 'BookingRebooking % must map at least one itinerary leg.', NEW.\"id\";\n   283\t    END IF;\n   284\t    RETURN NULL;\n   285\tEND;\n   286\t$$ LANGUAGE plpgsql;\n   287\t\n   288\tCREATE CONSTRAINT TRIGGER \"BookingRebooking_has_legs\"\n   289\t    AFTER INSERT ON \"BookingRebooking\"\n   290\t    DEFERRABLE INITIALLY DEFERRED\n   291\t    FOR EACH ROW EXECUTE FUNCTION \"require_rebooking_legs\"();\n   292\t\n   293\t-- A direct mapping or event delete would leave its source leg historical with\n   294\t-- no record of what replaced it. Deferred so deleting the whole booking remains\n   295\t-- possible: that cascade also deletes the source leg before this check runs.\n   296\tCREATE FUNCTION \"require_supersession_mapping_after_delete\"()\n   297\tRETURNS TRIGGER AS $$\n   298\tBEGIN\n   299\t    IF EXISTS (\n   300\t        SELECT 1 FROM \"ItineraryLeg\"\n   301\t        WHERE \"id\" = OLD.\"fromLegId\" AND \"supersededAt\" IS NOT NULL\n   302\t    ) AND NOT EXISTS (\n   303\t        SELECT 1 FROM \"BookingRebookingLeg\" WHERE \"fromLegId\" = OLD.\"fromLegId\"\n   304\t    ) THEN\n   305\t        RAISE EXCEPTION\n   306\t            'BookingRebookingLeg for superseded ItineraryLeg % cannot be deleted directly.',\n   307\t            OLD.\"fromLegId\";\n   308\t    END IF;\n   309\t    RETURN NULL;\n   310\tEND;\n   311\t$$ LANGUAGE plpgsql;\n   312\t\n   313\tCREATE CONSTRAINT TRIGGER \"BookingRebookingLeg_preserves_supersession\"\n   314\t    AFTER DELETE ON \"BookingRebookingLeg\"\n   315\t    DEFERRABLE INITIALLY DEFERRED\n   316\t    FOR EACH ROW EXECUTE FUNCTION \"require_supersession_mapping_after_delete\"();\n   317\t\n   318\t-- Updates rewrite audit history. Deletes remain available only through the\n   319\t-- booking cascade, matching BookingStatusChange and test-data cleanup.\n   320\tCREATE FUNCTION \"refuse_rebooking_audit_update\"()\n   321\tRETURNS TRIGGER AS $$\n   322\tBEGIN\n   323\t    RAISE EXCEPTION '% is append-only and cannot be modified.', TG_TABLE_NAME;\n   324\tEND;\n   325\t$$ LANGUAGE plpgsql;\n   326\t\n   327\tCREATE TRIGGER \"BookingRebooking_is_append_only\"\n   328\t    BEFORE UPDATE ON \"BookingRebooking\"\n   329\t    FOR EACH ROW EXECUTE FUNCTION \"refuse_rebooking_audit_update\"();\n   330\t\n   331\tCREATE TRIGGER \"BookingRebookingLeg_is_append_only\"\n   332\t    BEFORE UPDATE ON \"BookingRebookingLeg\"\n   333\t    FOR EACH ROW EXECUTE FUNCTION \"refuse_rebooking_audit_update\"();\n","exit_code":0,"duration":{"secs":0,"nanos":32402},"formatted_output":"    38\tCREATE TYPE \"RebookingFarePolicy\" AS ENUM ('DISRUPTION_WAIVER');\n    39\t\n    40\tALTER TABLE \"ItineraryLeg\"\n    41\t    ADD COLUMN \"supersededAt\" TIMESTAMP(3);\n    42\t\n    43\tDROP INDEX \"ItineraryLeg_bookingId_sequence_key\";\n    44\t\n    45\t-- Historical rows may share a position; exactly one current row may not.\n    46\tCREATE UNIQUE INDEX \"ItineraryLeg_active_booking_sequence_key\"\n    47\t    ON \"ItineraryLeg\"(\"bookingId\", \"sequence\")\n    48\t    WHERE \"supersededAt\" IS NULL;\n    49\t\n    50\tCREATE INDEX \"ItineraryLeg_bookingId_supersededAt_sequence_idx\"\n    51\t    ON \"ItineraryLeg\"(\"bookingId\", \"supersededAt\", \"sequence\");\n    52\t\n    53\tCREATE TABLE \"BookingRebooking\" (\n    54\t    \"id\" TEXT NOT NULL,\n    55\t    \"bookingId\" INTEGER NOT NULL,\n    56\t    \"bookingStatusChangeId\" TEXT NOT NULL,\n    57\t    \"farePolicy\" \"RebookingFarePolicy\" NOT NULL DEFAULT 'DISRUPTION_WAIVER',\n    58\t    \"createdAt\" TIMESTAMP(3) NOT NULL DEFAULT CURRENT_TIMESTAMP,\n    59\t\n    60\t    CONSTRAINT \"BookingRebooking_pkey\" PRIMARY KEY (\"id\")\n    61\t);\n    62\t\n    63\tCREATE UNIQUE INDEX \"BookingRebooking_bookingStatusChangeId_key\"\n    64\t    ON \"BookingRebooking\"(\"bookingStatusChangeId\");\n    65\tCREATE INDEX \"BookingRebooking_bookingId_createdAt_idx\"\n    66\t    ON \"BookingRebooking\"(\"bookingId\", \"createdAt\");\n    67\t\n    68\tALTER TABLE \"BookingRebooking\"\n    69\t    ADD CONSTRAINT \"BookingRebooking_bookingId_fkey\"\n    70\t        FOREIGN KEY (\"bookingId\") REFERENCES \"Booking\"(\"id\")\n    71\t        ON DELETE CASCADE ON UPDATE CASCADE,\n    72\t    ADD CONSTRAINT \"BookingRebooking_bookingStatusChangeId_fkey\"\n    73\t        FOREIGN KEY (\"bookingStatusChangeId\") REFERENCES \"BookingStatusChange\"(\"id\")\n    74\t        ON DELETE NO ACTION ON UPDATE CASCADE;\n    75\t\n    76\tCREATE TABLE \"BookingRebookingLeg\" (\n    77\t    \"rebookingId\" TEXT NOT NULL,\n    78\t    \"fromLegId\" INTEGER NOT NULL,\n    79\t    \"toLegId\" INTEGER NOT NULL,\n    80\t\n    81\t    CONSTRAINT \"BookingRebookingLeg_pkey\" PRIMARY KEY (\"rebookingId\", \"fromLegId\"),\n    82\t    CONSTRAINT \"BookingRebookingLeg_different_legs\" CHECK (\"fromLegId\" <> \"toLegId\")\n    83\t);\n    84\t\n    85\tCREATE UNIQUE INDEX \"BookingRebookingLeg_fromLegId_key\"\n    86\t    ON \"BookingRebookingLeg\"(\"fromLegId\");\n    87\tCREATE UNIQUE INDEX \"BookingRebookingLeg_toLegId_key\"\n    88\t    ON \"BookingRebookingLeg\"(\"toLegId\");\n    89\t\n    90\tALTER TABLE \"BookingRebookingLeg\"\n    91\t    ADD CONSTRAINT \"BookingRebookingLeg_rebookingId_fkey\"\n    92\t        FOREIGN KEY (\"rebookingId\") REFERENCES \"BookingRebooking\"(\"id\")\n    93\t        ON DELETE CASCADE ON UPDATE CASCADE,\n    94\t    ADD CONSTRAINT \"BookingRebookingLeg_fromLegId_fkey\"\n    95\t        FOREIGN KEY (\"fromLegId\") REFERENCES \"ItineraryLeg\"(\"id\")\n    96\t        ON DELETE CASCADE ON UPDATE CASCADE,\n    97\t    ADD CONSTRAINT \"BookingRebookingLeg_toLegId_fkey\"\n    98\t        FOREIGN KEY (\"toLegId\") REFERENCES \"ItineraryLeg\"(\"id\")\n    99\t        ON DELETE CASCADE ON UPDATE CASCADE;\n   100\t\n   101\t-- Every historical leg has to become historical through the recorded update\n   102\t-- below. Accepting a row that starts superseded would bypass that audit path.\n   103\tCREATE FUNCTION \"require_new_itinerary_leg_active\"()\n   104\tRETURNS TRIGGER AS $$\n   105\tBEGIN\n   106\t    IF NEW.\"supersededAt\" IS NOT NULL THEN\n   107\t        RAISE EXCEPTION\n   108\t            'A new ItineraryLeg must start active; supersede it through a recorded rebooking.';\n   109\t    END IF;\n   110\t    RETURN NEW;\n   111\tEND;\n   112\t$$ LANGUAGE plpgsql;\n   113\t\n   114\tCREATE TRIGGER \"ItineraryLeg_starts_active\"\n   115\t    BEFORE INSERT ON \"ItineraryLeg\"\n   116\t    FOR EACH ROW EXECUTE FUNCTION \"require_new_itinerary_leg_active\"();\n   117\t\n   118\t-- A leg disappears only when its whole booking does. Deferred so the booking\n   119\t-- cascade has removed the parent by the time this checks it; a direct leg\n   120\t-- delete, even beside deletion of its audit mapping, still sees the booking.\n   121\tCREATE FUNCTION \"require_itinerary_leg_booking_delete\"()\n   122\tRETURNS TRIGGER AS $$\n   123\tBEGIN\n   124\t    IF EXISTS (SELECT 1 FROM \"Booking\" WHERE \"id\" = OLD.\"bookingId\") THEN\n   125\t        RAISE EXCEPTION\n   126\t            'ItineraryLeg % cannot be deleted while booking % exists.',\n   127\t            OLD.\"id\", OLD.\"bookingId\";\n   128\t    END IF;\n   129\t    RETURN NULL;\n   130\tEND;\n   131\t$$ LANGUAGE plpgsql;\n   132\t\n   133\tCREATE CONSTRAINT TRIGGER \"ItineraryLeg_deletes_with_booking\"\n   134\t    AFTER DELETE ON \"ItineraryLeg\"\n   135\t    DEFERRABLE INITIALLY DEFERRED\n   136\t    FOR EACH ROW EXECUTE FUNCTION \"require_itinerary_leg_booking_delete\"();\n   137\t\n   138\t-- A leg's identity never changes in place: a different flight is a new version.\n   139\t-- Once superseded, its timestamp is permanent too. The sole state transition\n   140\t-- this permits is setting supersededAt on a currently active leg.\n   141\tCREATE FUNCTION \"refuse_itinerary_leg_rewrite\"()\n   142\tRETURNS TRIGGER AS $$\n   143\tBEGIN\n   144\t    IF NEW.\"id\" IS DISTINCT FROM OLD.\"id\"\n   145\t       OR NEW.\"bookingId\" IS DISTINCT FROM OLD.\"bookingId\"\n   146\t       OR NEW.\"sequence\" IS DISTINCT FROM OLD.\"sequence\"\n   147\t       OR NEW.\"flightId\" IS DISTINCT FROM OLD.\"flightId\" THEN\n   148\t        RAISE EXCEPTION\n   149\t            'ItineraryLeg identity is immutable: replace leg % with a new version.',\n   150\t            OLD.\"id\";\n   151\t    END IF;\n   152\t    IF OLD.\"supersededAt\" IS NOT NULL\n   153\t       AND NEW.\"supersededAt\" IS DISTINCT FROM OLD.\"supersededAt\" THEN\n   154\t        RAISE EXCEPTION\n   155\t            'ItineraryLeg supersession is permanent: leg % cannot become active or change time.',\n   156\t            OLD.\"id\";\n   157\t    END IF;\n   158\t    RETURN NEW;\n   159\tEND;\n   160\t$$ LANGUAGE plpgsql;\n   161\t\n   162\tCREATE TRIGGER \"ItineraryLeg_supersession_is_permanent\"\n   163\t    BEFORE UPDATE ON \"ItineraryLeg\"\n   164\t    FOR EACH ROW EXECUTE FUNCTION \"refuse_itinerary_leg_rewrite\"();\n   165\t\n   166\t-- A superseded leg must be named by an immutable rebooking mapping before its\n   167\t-- transaction commits. Deferred because the event and replacement leg are\n   168\t-- naturally written after the original leg is marked historical.\n   169\tCREATE FUNCTION \"require_recorded_leg_supersession\"()\n   170\tRETURNS TRIGGER AS $$\n   171\tBEGIN\n   172\t    IF NOT EXISTS (SELECT 1 FROM \"ItineraryLeg\" WHERE \"id\" = NEW.\"id\") THEN\n   173\t        RETURN NULL;\n   174\t    END IF;\n   175\t    IF NOT EXISTS (\n   176\t        SELECT 1 FROM \"BookingRebookingLeg\" WHERE \"fromLegId\" = NEW.\"id\"\n   177\t    ) THEN\n   178\t        RAISE EXCEPTION\n   179\t            'Superseded ItineraryLeg % must be recorded by a BookingRebookingLeg.',\n   180\t            NEW.\"id\";\n   181\t    END IF;\n   182\t    IF EXISTS (\n   183\t        SELECT 1 FROM \"SeatAssignment\"\n   184\t        WHERE \"legId\" = NEW.\"id\" AND \"releasedAt\" IS NULL\n   185\t    ) THEN\n   186\t        RAISE EXCEPTION\n   187\t            'Superseded ItineraryLeg % cannot retain live seat assignments.',\n   188\t            NEW.\"id\";\n   189\t    END IF;\n   190\t    RETURN NULL;\n   191\tEND;\n   192\t$$ LANGUAGE plpgsql;\n   193\t\n   194\tCREATE CONSTRAINT TRIGGER \"ItineraryLeg_supersession_is_recorded\"\n   195\t    AFTER UPDATE OF \"supersededAt\" ON \"ItineraryLeg\"\n   196\t    DEFERRABLE INITIALLY DEFERRED\n   197\t    FOR EACH ROW\n   198\t    WHEN (OLD.\"supersededAt\" IS NULL AND NEW.\"supersededAt\" IS NOT NULL)\n   199\t    EXECUTE FUNCTION \"require_recorded_leg_supersession\"();\n   200\t\n   200\t\n   201\t-- The status row is the booking-wide audit sequence. A rebooking can only be\n   202\t-- attached to the transition that resolves a disruption, for the same\n   203\t-- booking, and cannot simultaneously claim a refund.\n   204\tCREATE FUNCTION \"validate_booking_rebooking\"()\n   205\tRETURNS TRIGGER AS $$\n   206\tDECLARE\n   207\t    change \"BookingStatusChange\";\n   208\tBEGIN\n   209\t    SELECT * INTO change\n   210\t    FROM \"BookingStatusChange\"\n   211\t    WHERE \"id\" = NEW.\"bookingStatusChangeId\";\n   212\t\n   213\t    IF NOT FOUND\n   214\t       OR change.\"bookingId\" <> NEW.\"bookingId\"\n   215\t       OR change.\"from\" IS DISTINCT FROM 'DISRUPTED'::\"BookingStatus\"\n   216\t       OR change.\"to\" IS DISTINCT FROM 'CONFIRMED'::\"BookingStatus\"\n   217\t       OR change.\"refundCents\" IS NOT NULL THEN\n   218\t        RAISE EXCEPTION\n   219\t            'BookingRebooking must match one non-refunding DISRUPTED to CONFIRMED status change.';\n   220\t    END IF;\n   221\t    RETURN NEW;\n   222\tEND;\n   223\t$$ LANGUAGE plpgsql;\n   224\t\n   225\tCREATE TRIGGER \"BookingRebooking_is_consistent\"\n   226\t    BEFORE INSERT ON \"BookingRebooking\"\n   227\t    FOR EACH ROW EXECUTE FUNCTION \"validate_booking_rebooking\"();\n   228\t\n   229\t-- Both legs remain real rows. The old one must already be historical, the new\n   230\t-- one current, and both must occupy the same position in this booking.\n   231\tCREATE FUNCTION \"validate_booking_rebooking_leg\"()\n   232\tRETURNS TRIGGER AS $$\n   233\tDECLARE\n   234\t    event_booking_id INTEGER;\n   235\t    from_booking_id INTEGER;\n   236\t    from_sequence INTEGER;\n   237\t    from_superseded_at TIMESTAMP(3);\n   238\t    to_booking_id INTEGER;\n   239\t    to_sequence INTEGER;\n   240\t    to_superseded_at TIMESTAMP(3);\n   241\tBEGIN\n   242\t    SELECT \"bookingId\" INTO event_booking_id\n   243\t    FROM \"BookingRebooking\"\n   244\t    WHERE \"id\" = NEW.\"rebookingId\";\n   245\t    SELECT \"bookingId\", \"sequence\", \"supersededAt\"\n   246\t        INTO from_booking_id, from_sequence, from_superseded_at\n   247\t    FROM \"ItineraryLeg\" WHERE \"id\" = NEW.\"fromLegId\";\n   248\t    SELECT \"bookingId\", \"sequence\", \"supersededAt\"\n   249\t        INTO to_booking_id, to_sequence, to_superseded_at\n   250\t    FROM \"ItineraryLeg\" WHERE \"id\" = NEW.\"toLegId\";\n   251\t\n   252\t    IF event_booking_id IS NULL\n   253\t       OR from_booking_id IS NULL\n   254\t       OR to_booking_id IS NULL\n   255\t       OR from_booking_id <> event_booking_id\n   256\t       OR to_booking_id <> event_booking_id\n   257\t       OR from_sequence <> to_sequence\n   258\t       OR from_superseded_at IS NULL\n   259\t       OR to_superseded_at IS NOT NULL THEN\n   260\t        RAISE EXCEPTION\n   261\t            'BookingRebookingLeg must map superseded and active legs from the same booking and same itinerary position.';\n   262\t    END IF;\n   263\t    RETURN NEW;\n   264\tEND;\n   265\t$$ LANGUAGE plpgsql;\n   266\t\n   267\tCREATE TRIGGER \"BookingRebookingLeg_is_consistent\"\n   268\t    BEFORE INSERT ON \"BookingRebookingLeg\"\n   269\t    FOR EACH ROW EXECUTE FUNCTION \"validate_booking_rebooking_leg\"();\n   270\t\n   271\t-- An event with no leg mapping says a rebooking happened but cannot say what\n   272\t-- changed. Deferred so a normal transaction can insert the event first.\n   273\tCREATE FUNCTION \"require_rebooking_legs\"()\n   274\tRETURNS TRIGGER AS $$\n   275\tBEGIN\n   276\t    IF NOT EXISTS (SELECT 1 FROM \"BookingRebooking\" WHERE \"id\" = NEW.\"id\") THEN\n   277\t        RETURN NULL;\n   278\t    END IF;\n   279\t    IF NOT EXISTS (\n   280\t        SELECT 1 FROM \"BookingRebookingLeg\" WHERE \"rebookingId\" = NEW.\"id\"\n   281\t    ) THEN\n   282\t        RAISE EXCEPTION 'BookingRebooking % must map at least one itinerary leg.', NEW.\"id\";\n   283\t    END IF;\n   284\t    RETURN NULL;\n   285\tEND;\n   286\t$$ LANGUAGE plpgsql;\n   287\t\n   288\tCREATE CONSTRAINT TRIGGER \"BookingRebooking_has_legs\"\n   289\t    AFTER INSERT ON \"BookingRebooking\"\n   290\t    DEFERRABLE INITIALLY DEFERRED\n   291\t    FOR EACH ROW EXECUTE FUNCTION \"require_rebooking_legs\"();\n   292\t\n   293\t-- A direct mapping or event delete would leave its source leg historical with\n   294\t-- no record of what replaced it. Deferred so deleting the whole booking remains\n   295\t-- possible: that cascade also deletes the source leg before this check runs.\n   296\tCREATE FUNCTION \"require_supersession_mapping_after_delete\"()\n   297\tRETURNS TRIGGER AS $$\n   298\tBEGIN\n   299\t    IF EXISTS (\n   300\t        SELECT 1 FROM \"ItineraryLeg\"\n   301\t        WHERE \"id\" = OLD.\"fromLegId\" AND \"supersededAt\" IS NOT NULL\n   302\t    ) AND NOT EXISTS (\n   303\t        SELECT 1 FROM \"BookingRebookingLeg\" WHERE \"fromLegId\" = OLD.\"fromLegId\"\n   304\t    ) THEN\n   305\t        RAISE EXCEPTION\n   306\t            'BookingRebookingLeg for superseded ItineraryLeg % cannot be deleted directly.',\n   307\t            OLD.\"fromLegId\";\n   308\t    END IF;\n   309\t    RETURN NULL;\n   310\tEND;\n   311\t$$ LANGUAGE plpgsql;\n   312\t\n   313\tCREATE CONSTRAINT TRIGGER \"BookingRebookingLeg_preserves_supersession\"\n   314\t    AFTER DELETE ON \"BookingRebookingLeg\"\n   315\t    DEFERRABLE INITIALLY DEFERRED\n   316\t    FOR EACH ROW EXECUTE FUNCTION \"require_supersession_mapping_after_delete\"();\n   317\t\n   318\t-- Updates rewrite audit history. Deletes remain available only through the\n   319\t-- booking cascade, matching BookingStatusChange and test-data cleanup.\n   320\tCREATE FUNCTION \"refuse_rebooking_audit_update\"()\n   321\tRETURNS TRIGGER AS $$\n   322\tBEGIN\n   323\t    RAISE EXCEPTION '% is append-only and cannot be modified.', TG_TABLE_NAME;\n   324\tEND;\n   325\t$$ LANGUAGE plpgsql;\n   326\t\n   327\tCREATE TRIGGER \"BookingRebooking_is_append_only\"\n   328\t    BEFORE UPDATE ON \"BookingRebooking\"\n   329\t    FOR EACH ROW EXECUTE FUNCTION \"refuse_rebooking_audit_update\"();\n   330\t\n   331\tCREATE TRIGGER \"BookingRebookingLeg_is_append_only\"\n   332\t    BEFORE UPDATE ON \"BookingRebookingLeg\"\n   333\t    FOR EACH ROW EXECUTE FUNCTION \"refuse_rebooking_audit_update\"();\n"},"started_at_ms":1786907269206,"completed_at_ms":1786907269207}}
{"timestamp":"2026-08-16T19:07:49.367Z","ordinal":25371,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a00bf9-18f7-7222-9eb6-41f580ee3559","call_id":"call_xU3WDfBRHsRTuZlkXoKj6dWI","output":[{"type":"input_text","text":"Script completed\nWall time 0.4 seconds\nOutput:\n"},{"type":"input_text","text":"    38\tCREATE TYPE \"RebookingFarePolicy\" AS ENUM ('DISRUPTION_WAIVER');\n    39\t\n    40\tALTER TABLE \"ItineraryLeg\"\n    41\t    ADD COLUMN \"supersededAt\" TIMESTAMP(3);\n    42\t\n    43\tDROP INDEX \"ItineraryLeg_bookingId_sequence_key\";\n    44\t\n    45\t-- Historical rows may share a position; exactly one current row may not.\n    46\tCREATE UNIQUE INDEX \"ItineraryLeg_active_booking_sequence_key\"\n    47\t    ON \"ItineraryLeg\"(\"bookingId\", \"sequence\")\n    48\t    WHERE \"supersededAt\" IS NULL;\n    49\t\n    50\tCREATE INDEX \"ItineraryLeg_bookingId_supersededAt_sequence_idx\"\n    51\t    ON \"ItineraryLeg\"(\"bookingId\", \"supersededAt\", \"sequence\");\n    52\t\n    53\tCREATE TABLE \"BookingRebooking\" (\n    54\t    \"id\" TEXT NOT NULL,\n    55\t    \"bookingId\" INTEGER NOT NULL,\n    56\t    \"bookingStatusChangeId\" TEXT NOT NULL,\n    57\t    \"farePolicy\" \"RebookingFarePolicy\" NOT NULL DEFAULT 'DISRUPTION_WAIVER',\n    58\t    \"createdAt\" TIMESTAMP(3) NOT NULL DEFAULT CURRENT_TIMESTAMP,\n    59\t\n    60\t    CONSTRAINT \"BookingRebooking_pkey\" PRIMARY KEY (\"id\")\n    61\t);\n    62\t\n    63\tCREATE UNIQUE INDEX \"BookingRebooking_bookingStatusChangeId_key\"\n    64\t    ON \"BookingRebooking\"(\"bookingStatusChangeId\");\n    65\tCREATE INDEX \"BookingRebooking_bookingId_createdAt_idx\"\n    66\t    ON \"BookingRebooking\"(\"bookingId\", \"createdAt\");\n    67\t\n    68\tALTER TABLE \"BookingRebooking\"\n    69\t    ADD CONSTRAINT \"BookingRebooking_bookingId_fkey\"\n    70\t        FOREIGN KEY (\"bookingId\") REFERENCES \"Booking\"(\"id\")\n    71\t        ON DELETE CASCADE ON UPDATE CASCADE,\n    72\t    ADD CONSTRAINT \"BookingRebooking_bookingStatusChangeId_fkey\"\n    73\t        FOREIGN KEY (\"bookingStatusChangeId\") REFERENCES \"BookingStatusChange\"(\"id\")\n    74\t        ON DELETE NO ACTION ON UPDATE CASCADE;\n    75\t\n    76\tCREATE TABLE \"BookingRebookingLeg\" (\n    77\t    \"rebookingId\" TEXT NOT NULL,\n    78\t    \"fromLegId\" INTEGER NOT NULL,\n    79\t    \"toLegId\" INTEGER NOT NULL,\n    80\t\n    81\t    CONSTRAINT \"BookingRebookingLeg_pkey\" PRIMARY KEY (\"rebookingId\", \"fromLegId\"),\n    82\t    CONSTRAINT \"BookingRebookingLeg_different_legs\" CHECK (\"fromLegId\" <> \"toLegId\")\n    83\t);\n    84\t\n    85\tCREATE UNIQUE INDEX \"BookingRebookingLeg_fromLegId_key\"\n    86\t    ON \"BookingRebookingLeg\"(\"fromLegId\");\n    87\tCREATE UNIQUE INDEX \"BookingRebookingLeg_toLegId_key\"\n    88\t    ON \"BookingRebookingLeg\"(\"toLegId\");\n    89\t\n    90\tALTER TABLE \"BookingRebookingLeg\"\n    91\t    ADD CONSTRAINT \"BookingRebookingLeg_rebookingId_fkey\"\n    92\t        FOREIGN KEY (\"rebookingId\") REFERENCES \"BookingRebooking\"(\"id\")\n    93\t        ON DELETE CASCADE ON UPDATE CASCADE,\n    94\t    ADD CONSTRAINT \"BookingRebookingLeg_fromLegId_fkey\"\n    95\t        FOREIGN KEY (\"fromLegId\") REFERENCES \"ItineraryLeg\"(\"id\")\n    96\t        ON DELETE CASCADE ON UPDATE CASCADE,\n    97\t    ADD CONSTRAINT \"BookingRebookingLeg_toLegId_fkey\"\n    98\t        FOREIGN KEY (\"toLegId\") REFERENCES \"ItineraryLeg\"(\"id\")\n    99\t        ON DELETE CASCADE ON UPDATE CASCADE;\n   100\t\n   101\t-- Every historical leg has to become historical through the recorded update\n   102\t-- below. Accepting a row that starts superseded would bypass that audit path.\n   103\tCREATE FUNCTION \"require_new_itinerary_leg_active\"()\n   104\tRETURNS TRIGGER AS $$\n   105\tBEGIN\n   106\t    IF NEW.\"supersededAt\" IS NOT NULL THEN\n   107\t        RAISE EXCEPTION\n   108\t            'A new ItineraryLeg must start active; supersede it through a recorded rebooking.';\n   109\t    END IF;\n   110\t    RETURN NEW;\n   111\tEND;\n   112\t$$ LANGUAGE plpgsql;\n   113\t\n   114\tCREATE TRIGGER \"ItineraryLeg_starts_active\"\n   115\t    BEFORE INSERT ON \"ItineraryLeg\"\n   116\t    FOR EACH ROW EXECUTE FUNCTION \"require_new_itinerary_leg_active\"();\n   117\t\n   118\t-- A leg disappears only when its whole booking does. Deferred so the booking\n   119\t-- cascade has removed the parent by the time this checks it; a direct leg\n   120\t-- delete, even beside deletion of its audit mapping, still sees the booking.\n   121\tCREATE FUNCTION \"require_itinerary_leg_booking_delete\"()\n   122\tRETURNS TRIGGER AS $$\n   123\tBEGIN\n   124\t    IF EXISTS (SELECT 1 FROM \"Booking\" WHERE \"id\" = OLD.\"bookingId\") THEN\n   125\t        RAISE EXCEPTION\n   126\t            'ItineraryLeg % cannot be deleted while booking % exists.',\n   127\t            OLD.\"id\", OLD.\"bookingId\";\n   128\t    END IF;\n   129\t    RETURN NULL;\n   130\tEND;\n   131\t$$ LANGUAGE plpgsql;\n   132\t\n   133\tCREATE CONSTRAINT TRIGGER \"ItineraryLeg_deletes_with_booking\"\n   134\t    AFTER DELETE ON \"ItineraryLeg\"\n   135\t    DEFERRABLE INITIALLY DEFERRED\n   136\t    FOR EACH ROW EXECUTE FUNCTION \"require_itinerary_leg_booking_delete\"();\n   137\t\n   138\t-- A leg's identity never changes in place: a different flight is a new version.\n   139\t-- Once superseded, its timestamp is permanent too. The sole state transition\n   140\t-- this permits is setting supersededAt on a currently active leg.\n   141\tCREATE FUNCTION \"refuse_itinerary_leg_rewrite\"()\n   142\tRETURNS TRIGGER AS $$\n   143\tBEGIN\n   144\t    IF NEW.\"id\" IS DISTINCT FROM OLD.\"id\"\n   145\t       OR NEW.\"bookingId\" IS DISTINCT FROM OLD.\"bookingId\"\n   146\t       OR NEW.\"sequence\" IS DISTINCT FROM OLD.\"sequence\"\n   147\t       OR NEW.\"flightId\" IS DISTINCT FROM OLD.\"flightId\" THEN\n   148\t        RAISE EXCEPTION\n   149\t            'ItineraryLeg identity is immutable: replace leg % with a new version.',\n   150\t            OLD.\"id\";\n   151\t    END IF;\n   152\t    IF OLD.\"supersededAt\" IS NOT NULL\n   153\t       AND NEW.\"supersededAt\" IS DISTINCT FROM OLD.\"supersededAt\" THEN\n   154\t        RAISE EXCEPTION\n   155\t            'ItineraryLeg supersession is permanent: leg % cannot become active or change time.',\n   156\t            OLD.\"id\";\n   157\t    END IF;\n   158\t    RETURN NEW;\n   159\tEND;\n   160\t$$ LANGUAGE plpgsql;\n   161\t\n   162\tCREATE TRIGGER \"ItineraryLeg_supersession_is_permanent\"\n   163\t    BEFORE UPDATE ON \"ItineraryLeg\"\n   164\t    FOR EACH ROW EXECUTE FUNCTION \"refuse_itinerary_leg_rewrite\"();\n   165\t\n   166\t-- A superseded leg must be named by an immutable rebooking mapping before its\n   167\t-- transaction commits. Deferred because the event and replacement leg are\n   168\t-- naturally written after the original leg is marked historical.\n   169\tCREATE FUNCTION \"require_recorded_leg_supersession\"()\n   170\tRETURNS TRIGGER AS $$\n   171\tBEGIN\n   172\t    IF NOT EXISTS (SELECT 1 FROM \"ItineraryLeg\" WHERE \"id\" = NEW.\"id\") THEN\n   173\t        RETURN NULL;\n   174\t    END IF;\n   175\t    IF NOT EXISTS (\n   176\t        SELECT 1 FROM \"BookingRebookingLeg\" WHERE \"fromLegId\" = NEW.\"id\"\n   177\t    ) THEN\n   178\t        RAISE EXCEPTION\n   179\t            'Superseded ItineraryLeg % must be recorded by a BookingRebookingLeg.',\n   180\t            NEW.\"id\";\n   181\t    END IF;\n   182\t    IF EXISTS (\n   183\t        SELECT 1 FROM \"SeatAssignment\"\n   184\t        WHERE \"legId\" = NEW.\"id\" AND \"releasedAt\" IS NULL\n   185\t    ) THEN\n   186\t        RAISE EXCEPTION\n   187\t            'Superseded ItineraryLeg % cannot retain live seat assignments.',\n   188\t            NEW.\"id\";\n   189\t    END IF;\n   190\t    RETURN NULL;\n   191\tEND;\n   192\t$$ LANGUAGE plpgsql;\n   193\t\n   194\tCREATE CONSTRAINT TRIGGER \"ItineraryLeg_supersession_is_recorded\"\n   195\t    AFTER UPDATE OF \"supersededAt\" ON \"ItineraryLeg\"\n   196\t    DEFERRABLE INITIALLY DEFERRED\n   197\t    FOR EACH ROW\n   198\t    WHEN (OLD.\"supersededAt\" IS NULL AND NEW.\"supersededAt\" IS NOT NULL)\n   199\t    EXECUTE FUNCTION \"require_recorded_leg_supersession\"();\n   200\t\n   200\t\n   201\t-- The status row is the booking-wide audit sequence. A rebooking can only be\n   202\t-- attached to the transition that resolves a disruption, for the same\n   203\t-- booking, and cannot simultaneously claim a refund.\n   204\tCREATE FUNCTION \"validate_booking_rebooking\"()\n   205\tRETURNS TRIGGER AS $$\n   206\tDECLARE\n   207\t    change \"BookingStatusChange\";\n   208\tBEGIN\n   209\t    SELECT * INTO change\n   210\t    FROM \"BookingStatusChange\"\n   211\t    WHERE \"id\" = NEW.\"bookingStatusChangeId\";\n   212\t\n   213\t    IF NOT FOUND\n   214\t       OR change.\"bookingId\" <> NEW.\"bookingId\"\n   215\t       OR change.\"from\" IS DISTINCT FROM 'DISRUPTED'::\"BookingStatus\"\n   216\t       OR change.\"to\" IS DISTINCT FROM 'CONFIRMED'::\"BookingStatus\"\n   217\t       OR change.\"refundCents\" IS NOT NULL THEN\n   218\t        RAISE EXCEPTION\n   219\t            'BookingRebooking must match one non-refunding DISRUPTED to CONFIRMED status change.';\n   220\t    END IF;\n   221\t    RETURN NEW;\n   222\tEND;\n   223\t$$ LANGUAGE plpgsql;\n   224\t\n   225\tCREATE TRIGGER \"BookingRebooking_is_consistent\"\n   226\t    BEFORE INSERT ON \"BookingRebooking\"\n   227\t    FOR EACH ROW EXECUTE FUNCTION \"validate_booking_rebooking\"();\n   228\t\n   229\t-- Both legs remain real rows. The old one must already be historical, the new\n   230\t-- one current, and both must occupy the same position in this booking.\n   231\tCREATE FUNCTION \"validate_booking_rebooking_leg\"()\n   232\tRETURNS TRIGGER AS $$\n   233\tDECLARE\n   234\t    event_booking_id INTEGER;\n   235\t    from_booking_id INTEGER;\n   236\t    from_sequence INTEGER;\n   237\t    from_superseded_at TIMESTAMP(3);\n   238\t    to_booking_id INTEGER;\n   239\t    to_sequence INTEGER;\n   240\t    to_superseded_at TIMESTAMP(3);\n   241\tBEGIN\n   242\t    SELECT \"bookingId\" INTO event_booking_id\n   243\t    FROM \"BookingRebooking\"\n   244\t    WHERE \"id\" = NEW.\"rebookingId\";\n   245\t    SELECT \"bookingId\", \"sequence\", \"supersededAt\"\n   246\t        INTO from_booking_id, from_sequence, from_superseded_at\n   247\t    FROM \"ItineraryLeg\" WHERE \"id\" = NEW.\"fromLegId\";\n   248\t    SELECT \"bookingId\", \"sequence\", \"supersededAt\"\n   249\t        INTO to_booking_id, to_sequence, to_superseded_at\n   250\t    FROM \"ItineraryLeg\" WHERE \"id\" = NEW.\"toLegId\";\n   251\t\n   252\t    IF event_booking_id IS NULL\n   253\t       OR from_booking_id IS NULL\n   254\t       OR to_booking_id IS NULL\n   255\t       OR from_booking_id <> event_booking_id\n   256\t       OR to_booking_id <> event_booking_id\n   257\t       OR from_sequence <> to_sequence\n   258\t       OR from_superseded_at IS NULL\n   259\t       OR to_superseded_at IS NOT NULL THEN\n   260\t        RAISE EXCEPTION\n   261\t            'BookingRebookingLeg must map superseded and active legs from the same booking and same itinerary position.';\n   262\t    END IF;\n   263\t    RETURN NEW;\n   264\tEND;\n   265\t$$ LANGUAGE plpgsql;\n   266\t\n   267\tCREATE TRIGGER \"BookingRebookingLeg_is_consistent\"\n   268\t    BEFORE INSERT ON \"BookingRebookingLeg\"\n   269\t    FOR EACH ROW EXECUTE FUNCTION \"validate_booking_rebooking_leg\"();\n   270\t\n   271\t-- An event with no leg mapping says a rebooking happened but cannot say what\n   272\t-- changed. Deferred so a normal transaction can insert the event first.\n   273\tCREATE FUNCTION \"require_rebooking_legs\"()\n   274\tRETURNS TRIGGER AS $$\n   275\tBEGIN\n   276\t    IF NOT EXISTS (SELECT 1 FROM \"BookingRebooking\" WHERE \"id\" = NEW.\"id\") THEN\n   277\t        RETURN NULL;\n   278\t    END IF;\n   279\t    IF NOT EXISTS (\n   280\t        SELECT 1 FROM \"BookingRebookingLeg\" WHERE \"rebookingId\" = NEW.\"id\"\n   281\t    ) THEN\n   282\t        RAISE EXCEPTION 'BookingRebooking % must map at least one itinerary leg.', NEW.\"id\";\n   283\t    END IF;\n   284\t    RETURN NULL;\n   285\tEND;\n   286\t$$ LANGUAGE plpgsql;\n   287\t\n   288\tCREATE CONSTRAINT TRIGGER \"BookingRebooking_has_legs\"\n   289\t    AFTER INSERT ON \"BookingRebooking\"\n   290\t    DEFERRABLE INITIALLY DEFERRED\n   291\t    FOR EACH ROW EXECUTE FUNCTION \"require_rebooking_legs\"();\n   292\t\n   293\t-- A direct mapping or event delete would leave its source leg historical with\n   294\t-- no record of what replaced it. Deferred so deleting the whole booking remains\n   295\t-- possible: that cascade also deletes the source leg before this check runs.\n   296\tCREATE FUNCTION \"require_supersession_mapping_after_delete\"()\n   297\tRETURNS TRIGGER AS $$\n   298\tBEGIN\n   299\t    IF EXISTS (\n   300\t        SELECT 1 FROM \"ItineraryLeg\"\n   301\t        WHERE \"id\" = OLD.\"fromLegId\" AND \"supersededAt\" IS NOT NULL\n   302\t    ) AND NOT EXISTS (\n   303\t        SELECT 1 FROM \"BookingRebookingLeg\" WHERE \"fromLegId\" = OLD.\"fromLegId\"\n   304\t    ) THEN\n   305\t        RAISE EXCEPTION\n   306\t            'BookingRebookingLeg for superseded ItineraryLeg % cannot be deleted directly.',\n   307\t            OLD.\"fromLegId\";\n   308\t    END IF;\n   309\t    RETURN NULL;\n   310\tEND;\n   311\t$$ LANGUAGE plpgsql;\n   312\t\n   313\tCREATE CONSTRAINT TRIGGER \"BookingRebookingLeg_preserves_supersession\"\n   314\t    AFTER DELETE ON \"BookingRebookingLeg\"\n   315\t    DEFERRABLE INITIALLY DEFERRED\n   316\t    FOR EACH ROW EXECUTE FUNCTION \"require_supersession_mapping_after_delete\"();\n   317\t\n   318\t-- Updates rewrite audit history. Deletes remain available only through the\n   319\t-- booking cascade, matching BookingStatusChange and test-data cleanup.\n   320\tCREATE FUNCTION \"refuse_rebooking_audit_update\"()\n   321\tRETURNS TRIGGER AS $$\n   322\tBEGIN\n   323\t    RAISE EXCEPTION '% is append-only and cannot be modified.', TG_TABLE_NAME;\n   324\tEND;\n   325\t$$ LANGUAGE plpgsql;\n   326\t\n   327\tCREATE TRIGGER \"BookingRebooking_is_append_only\"\n   328\t    BEFORE UPDATE ON \"BookingRebooking\"\n   329\t    FOR EACH ROW EXECUTE FUNCTION \"refuse_rebooking_audit_update\"();\n   330\t\n   331\tCREATE TRIGGER \"BookingRebookingLeg_is_append_only\"\n   332\t    BEFORE UPDATE ON \"BookingRebookingLeg\"\n   333\t    FOR EACH ROW EXECUTE FUNCTION \"refuse_rebooking_audit_update\"();\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a00bba-29dd-7100-8715-811d18e7c7e1"}}}
