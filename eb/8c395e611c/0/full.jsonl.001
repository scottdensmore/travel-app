{"timestamp":"2026-08-16T04:29:04.339Z","ordinal":21919,"type":"response_item","payload":{"type":"custom_tool_call","id":"ctc_00fb20eee1c75140016a813c8df25c8198b53dbd80306e3252","status":"completed","call_id":"call_SavZ7LNz6GAxeIZKGSW7Fj9z","name":"exec","input":"const r = await tools.exec_command({\n  cmd: \"sed -n '1,240p' app/admin/layout.tsx && sed -n '1,240p' app/admin/page.tsx && sed -n '1,280p' app/admin/users/page.tsx && sed -n '1,380p' lib/paymentWebhookService.ts && sed -n '1,420p' lib/paymentRefundService.ts && sed -n '125,275p' prisma/schema.prisma\",\n  workdir: \"/home/scottdensmore/Developer/scottdensmore/travel-app\",\n  yield_time_ms: 10000,\n  max_output_tokens: 40000\n});\ntext(r.output);\n","internal_chat_message_metadata_passthrough":{"turn_id":"01a008d3-a8d1-70b1-a975-44bf5aea121d"}}}
{"timestamp":"2026-08-16T04:29:04.589Z","ordinal":21920,"type":"event_msg","payload":{"type":"item_completed","thread_id":"019ffe5b-1054-7c22-8afc-e97cb84c7b73","turn_id":"01a008d3-a8d1-70b1-a975-44bf5aea121d","item":{"type":"CommandExecution","id":"exec-ae495417-1089-46a3-b118-db2a39d52eab","process_id":"99543","command":["/bin/bash","-lc","sed -n '1,240p' app/admin/layout.tsx && sed -n '1,240p' app/admin/page.tsx && sed -n '1,280p' app/admin/users/page.tsx && sed -n '1,380p' lib/paymentWebhookService.ts && sed -n '1,420p' lib/paymentRefundService.ts && sed -n '125,275p' prisma/schema.prisma"],"cwd":"file:///home/scottdensmore/Developer/scottdensmore/travel-app","parsed_cmd":[{"type":"read","cmd":"sed -n '1,240p' app/admin/layout.tsx","name":"layout.tsx","path":"app/admin/layout.tsx"},{"type":"read","cmd":"sed -n '1,240p' app/admin/page.tsx","name":"page.tsx","path":"app/admin/page.tsx"},{"type":"read","cmd":"sed -n '1,280p' app/admin/users/page.tsx","name":"page.tsx","path":"app/admin/users/page.tsx"},{"type":"read","cmd":"sed -n '1,380p' lib/paymentWebhookService.ts","name":"paymentWebhookService.ts","path":"lib/paymentWebhookService.ts"},{"type":"read","cmd":"sed -n '1,420p' lib/paymentRefundService.ts","name":"paymentRefundService.ts","path":"lib/paymentRefundService.ts"},{"type":"read","cmd":"sed -n '125,275p' prisma/schema.prisma","name":"schema.prisma","path":"prisma/schema.prisma"}],"source":"unified_exec_startup","status":"completed","stdout":"import React from 'react';\nimport { getServerSession } from 'next-auth';\nimport { redirect } from 'next/navigation';\nimport { authOptions } from '@/lib/auth';\nimport { hasVerifiedStaffAccess } from '@/lib/staffAuthorization';\n\nexport default async function AdminLayout({ children }: { children: React.ReactNode }) {\n    const session = await getServerSession(authOptions);\n    if (!hasVerifiedStaffAccess(session)) {\n        if (session?.user?.role === 'ADMIN' && session.user.staffMfaEnrollmentRequired) {\n            redirect('/staff/mfa');\n        }\n        redirect('/login');\n    }\n    return children;\n}\nimport React from 'react';\nimport { prisma } from '@/lib/prisma';\nimport { flightRouteInclude, withLegRouteLabels } from '@/lib/flightRoute';\nimport Link from 'next/link';\nimport { outboundFlight } from '@/lib/bookingItinerary';\n\nexport const dynamic = 'force-dynamic';\n\nexport default async function AdminDashboard() {\n    const userCount = await prisma.user.count();\n    const bookingCount = await prisma.booking.count();\n    const cityGuideCount = await prisma.cityGuide.count();\n\n    // Recent bookings\n    const recentBookings = await prisma.booking.findMany({\n        take: 5,\n        orderBy: { createdAt: 'desc' },\n        include: {\n            user: {\n                select: {\n                    name: true,\n                    email: true,\n                },\n            },\n            legs: {\n                include: { flight: { include: flightRouteInclude } },\n                orderBy: { sequence: 'asc' },\n            },\n        },\n    });\n\n    return (\n        <div className=\"page-container admin p-8\" style={{ marginTop: '100px', display: 'flex', flexDirection: 'column', gap: '2rem' }}>\n            <h1 className=\"text-3xl font-bold\" style={{ color: '#fff', margin: 0 }}>Admin Control Center</h1>\n\n            {/* Quick Stats Grid */}\n            <div className=\"grid grid-cols-1 md:grid-cols-3 gap-6\" style={{ display: 'grid', gridTemplateColumns: 'repeat(3, 1fr)', gap: '1.5rem' }}>\n                <div className=\"admin-card\" style={{ marginBottom: 0, padding: '24px' }}>\n                    <h2 className=\"text-gray-400 font-semibold mb-2\" style={{ borderBottom: 'none', paddingBottom: 0, fontSize: '1rem', color: '#a78bfa' }}>Total Users</h2>\n                    <p className=\"text-4xl font-bold\" style={{ color: '#38bdf8', fontSize: '2.25rem', margin: '8px 0 0 0', fontWeight: 'bold' }}>{userCount}</p>\n                </div>\n                <div className=\"admin-card\" style={{ marginBottom: 0, padding: '24px' }}>\n                    <h2 className=\"text-gray-400 font-semibold mb-2\" style={{ borderBottom: 'none', paddingBottom: 0, fontSize: '1rem', color: '#a78bfa' }}>Total Bookings</h2>\n                    <p className=\"text-4xl font-bold\" style={{ color: '#34d399', fontSize: '2.25rem', margin: '8px 0 0 0', fontWeight: 'bold' }}>{bookingCount}</p>\n                </div>\n                <div className=\"admin-card\" style={{ marginBottom: 0, padding: '24px' }}>\n                    <h2 className=\"text-gray-400 font-semibold mb-2\" style={{ borderBottom: 'none', paddingBottom: 0, fontSize: '1rem', color: '#a78bfa' }}>City Guides</h2>\n                    <p className=\"text-4xl font-bold\" style={{ color: '#c084fc', fontSize: '2.25rem', margin: '8px 0 0 0', fontWeight: 'bold' }}>{cityGuideCount}</p>\n                </div>\n            </div>\n\n            {/* Admin Management Sections */}\n            <div style={{ display: 'flex', gap: '1.5rem', flexWrap: 'wrap' }}>\n                <Link href=\"/admin/travelguide\" className=\"admin-card hover:border-purple-500 transition-all\" style={{\n                    textDecoration: 'none',\n                    display: 'flex',\n                    flexDirection: 'column',\n                    gap: '0.5rem',\n                    flex: '1',\n                    minWidth: '250px',\n                    padding: '24px',\n                    marginBottom: 0,\n                    border: '1px solid rgba(255, 255, 255, 0.08)'\n                }}>\n                    <h3 style={{ color: '#c084fc', fontSize: '1.25rem', margin: 0, fontWeight: 'bold' }}>City Guides</h3>\n                    <p style={{ color: 'rgba(255, 255, 255, 0.6)', fontSize: '0.9rem', margin: 0 }}>\n                        Create, update, and manage travel guide locations, coordinates, and recommendations.\n                    </p>\n                </Link>\n                <Link href=\"/admin/flights\" className=\"admin-card hover:border-purple-500 transition-all\" style={{\n                    textDecoration: 'none',\n                    display: 'flex',\n                    flexDirection: 'column',\n                    gap: '0.5rem',\n                    flex: '1',\n                    minWidth: '250px',\n                    padding: '24px',\n                    marginBottom: 0,\n                    border: '1px solid rgba(255, 255, 255, 0.08)'\n                }}>\n                    <h3 style={{ color: '#c084fc', fontSize: '1.25rem', margin: 0, fontWeight: 'bold' }}>Flight & Schedule Manager</h3>\n                    <p style={{ color: 'rgba(255, 255, 255, 0.6)', fontSize: '0.9rem', margin: 0 }}>\n                        Create recurring schedules, automatically generate daily occurrences, and monitor/update live statuses.\n                    </p>\n                </Link>\n            </div>\n\n            {/* Recent Bookings List */}\n            <div className=\"admin-card\">\n                <h2 style={{ fontSize: '1.5rem', margin: '0 0 1rem 0', color: '#c084fc', borderBottom: '1px solid rgba(255, 255, 255, 0.08)', paddingBottom: '8px' }}>\n                    Recent Bookings\n                </h2>\n                <div style={{ overflowX: 'auto' }}>\n                    <table style={{ width: '100%', borderCollapse: 'collapse', textAlign: 'left' }}>\n                        <thead>\n                            <tr style={{ borderBottom: '2px solid rgba(255, 255, 255, 0.08)' }}>\n                                <th style={{ padding: '8px 12px', color: '#a78bfa', fontSize: '0.85rem', textTransform: 'uppercase' }}>User</th>\n                                <th style={{ padding: '8px 12px', color: '#a78bfa', fontSize: '0.85rem', textTransform: 'uppercase' }}>Flight</th>\n                                <th style={{ padding: '8px 12px', color: '#a78bfa', fontSize: '0.85rem', textTransform: 'uppercase' }}>Route</th>\n                                <th style={{ padding: '8px 12px', color: '#a78bfa', fontSize: '0.85rem', textTransform: 'uppercase' }}>Date</th>\n                            </tr>\n                        </thead>\n                        <tbody>\n                            {recentBookings.map((booking) => {\n                                const flight = outboundFlight({ ...booking, legs: booking.legs.map(withLegRouteLabels) });\n                                return (\n                                    <tr key={booking.id} style={{ borderBottom: '1px solid rgba(255, 255, 255, 0.04)' }}>\n                                        <td style={{ padding: '12px', fontSize: '0.9rem', color: '#fff' }}>\n                                            {booking.user?.name || booking.user?.email || 'Guest'}\n                                        </td>\n                                        <td style={{ padding: '12px', fontSize: '0.9rem', color: '#fff' }}>\n                                            {flight ? `${flight.airline} ${flight.flightNumber}` : '—'}\n                                        </td>\n                                        <td style={{ padding: '12px', fontSize: '0.9rem', color: '#fff' }}>\n                                            {flight ? `${flight.from} → ${flight.to}` : '—'}\n                                        </td>\n                                        <td style={{ padding: '12px', fontSize: '0.9rem', color: 'rgba(255, 255, 255, 0.6)' }}>\n                                            {new Date(booking.createdAt).toLocaleDateString()}\n                                        </td>\n                                    </tr>\n                                );\n                            })}\n                            {recentBookings.length === 0 && (\n                                <tr>\n                                    <td colSpan={4} style={{ padding: '24px', textAlign: 'center', color: 'rgba(255, 255, 255, 0.4)' }}>\n                                        No recent bookings.\n                                    </td>\n                                </tr>\n                            )}\n                        </tbody>\n                    </table>\n                </div>\n            </div>\n        </div>\n    );\n}\nimport React from 'react';\nimport { prisma } from '@/lib/prisma';\nimport Link from 'next/link';\n\nexport const dynamic = 'force-dynamic';\n\nexport default async function AdminUsersPage() {\n    const users = await prisma.user.findMany({\n        orderBy: { email: 'asc' },\n        select: {\n            id: true,\n            name: true,\n            email: true,\n            role: true,\n            _count: { select: { bookings: true, reviews: true, favorites: true } }\n        }\n    });\n\n    return (\n        <div className=\"page-container p-8\" style={{ marginTop: '100px' }}>\n            <div className=\"flex justify-between items-center mb-6\">\n                <h1 className=\"text-3xl font-bold\">Manage Users</h1>\n                <Link href=\"/admin\" className=\"text-blue-600 hover:underline\">← Back to Dashboard</Link>\n            </div>\n\n            <div className=\"bg-white rounded-lg shadow-md border border-gray-200 overflow-hidden\">\n                <div className=\"p-0\">\n                    <table className=\"min-w-full divide-y divide-gray-200\" style={{ width: '100%', textAlign: 'left', borderCollapse: 'collapse' }}>\n                        <thead className=\"bg-gray-50\">\n                            <tr>\n                                <th className=\"px-6 py-3 text-xs font-medium text-gray-500 uppercase tracking-wider border-b\">Name</th>\n                                <th className=\"px-6 py-3 text-xs font-medium text-gray-500 uppercase tracking-wider border-b\">Email</th>\n                                <th className=\"px-6 py-3 text-xs font-medium text-gray-500 uppercase tracking-wider border-b\">Role</th>\n                                <th className=\"px-6 py-3 text-xs font-medium text-gray-500 uppercase tracking-wider border-b\">Bookings</th>\n                                <th className=\"px-6 py-3 text-xs font-medium text-gray-500 uppercase tracking-wider border-b\">Reviews</th>\n                                <th className=\"px-6 py-3 text-xs font-medium text-gray-500 uppercase tracking-wider border-b\">Favorites</th>\n                            </tr>\n                        </thead>\n                        <tbody className=\"bg-white divide-y divide-gray-200\">\n                            {users.map((user) => (\n                                <tr key={user.id}>\n                                    <td className=\"px-6 py-4 whitespace-nowrap text-sm text-gray-900 border-b\">{user.name || 'N/A'}</td>\n                                    <td className=\"px-6 py-4 whitespace-nowrap text-sm text-gray-500 border-b\">{user.email}</td>\n                                    <td className=\"px-6 py-4 whitespace-nowrap text-sm text-gray-500 border-b\">\n                                        <span className={`px-2 py-1 rounded text-xs font-semibold ${user.role === 'ADMIN' ? 'bg-purple-100 text-purple-700' : 'bg-gray-100 text-gray-700'}`}>\n                                            {user.role}\n                                        </span>\n                                    </td>\n                                    <td className=\"px-6 py-4 whitespace-nowrap text-sm text-gray-500 border-b\">{user._count.bookings}</td>\n                                    <td className=\"px-6 py-4 whitespace-nowrap text-sm text-gray-500 border-b\">{user._count.reviews}</td>\n                                    <td className=\"px-6 py-4 whitespace-nowrap text-sm text-gray-500 border-b\">{user._count.favorites}</td>\n                                </tr>\n                            ))}\n                        </tbody>\n                    </table>\n                </div>\n            </div>\n        </div>\n    );\n}\nimport type { PaymentStateProvider } from '@/lib/stripePaymentProvider';\nimport type { VerifiedPaymentWebhookEvent } from '@/lib/stripeWebhook';\nimport { prisma } from '@/lib/prisma';\nimport { lockPaymentIntentForUpdate } from '@/lib/paymentIntentLock';\n\nexport interface PaymentWebhookReconciler {\n    reconcile(event: VerifiedPaymentWebhookEvent): Promise<void>;\n}\n\nexport class PaymentWebhookService implements PaymentWebhookReconciler {\n    constructor(private readonly provider: PaymentStateProvider) {}\n\n    async reconcile(event: VerifiedPaymentWebhookEvent): Promise<void> {\n        await prisma.$transaction(async tx => {\n            await lockPaymentIntentForUpdate(tx, event.providerIntentId);\n\n            const duplicate = await tx.paymentWebhookEvent.findUnique({\n                where: { id: event.eventId },\n                select: { id: true },\n            });\n            if (duplicate) return;\n\n            const state = await this.provider.retrievePaymentState(event.providerIntentId);\n            if (state.providerIntentId !== event.providerIntentId) {\n                throw new Error(\n                    'Stripe webhook PaymentIntent did not match the retrieved intent.',\n                );\n            }\n            if (!state.paymentAttemptId) {\n                throw new Error('Stripe PaymentIntent has no local payment attempt metadata.');\n            }\n\n            const [attempt, existingBinding] = await Promise.all([\n                tx.paymentAttempt.findUnique({ where: { id: state.paymentAttemptId } }),\n                tx.paymentAttempt.findUnique({\n                    where: { providerIntentId: event.providerIntentId },\n                    select: { id: true },\n                }),\n            ]);\n            if (!attempt) {\n                throw new Error('Payment attempt not found for Stripe webhook.');\n            }\n            if (\n                (attempt.providerIntentId && attempt.providerIntentId !== event.providerIntentId)\n                || (existingBinding && existingBinding.id !== attempt.id)\n            ) {\n                throw new Error('Stripe PaymentIntent is bound to a different payment attempt.');\n            }\n\n            await tx.paymentAttempt.update({\n                where: { id: attempt.id },\n                data: {\n                    providerIntentId: event.providerIntentId,\n                    status: state.status,\n                },\n            });\n            await tx.paymentWebhookEvent.create({\n                data: {\n                    id: event.eventId,\n                    eventType: event.eventType,\n                    providerIntentId: event.providerIntentId,\n                    paymentAttemptId: attempt.id,\n                },\n            });\n        }, { maxWait: 5_000, timeout: 15_000 });\n    }\n}\nimport { randomUUID } from 'node:crypto';\nimport { prisma } from '@/lib/prisma';\nimport type {\n    PaymentRefundState,\n    PaymentRefundStatus,\n    RefundProvider,\n} from '@/lib/stripePaymentProvider';\n\ninterface RefundSettlement {\n    status: PaymentRefundStatus;\n    wasSubmitted: boolean;\n}\n\nconst RETRYABLE_TERMINAL = new Set<PaymentRefundStatus>(['FAILED', 'CANCELLED']);\nconst PROVIDER_TERMINAL: PaymentRefundStatus[] = ['SUCCEEDED', 'FAILED', 'CANCELLED'];\n\nexport class PaymentRefundService {\n    constructor(private readonly provider: RefundProvider) {}\n\n    async settleRefund(refundId: string): Promise<RefundSettlement> {\n        const prepared = await prisma.$transaction(async tx => {\n            await tx.$executeRaw`SELECT pg_advisory_xact_lock(hashtext(${refundId}))`;\n            const refund = await tx.paymentRefund.findUniqueOrThrow({\n                where: { id: refundId },\n                include: {\n                    bookingStatusChange: { include: { booking: true } },\n                    attempts: { orderBy: { sequence: 'desc' }, take: 1 },\n                },\n            });\n            const change = refund.bookingStatusChange;\n            if (\n                change.to !== 'CANCELLED'\n                || change.refundCents !== refund.amountCents\n                || change.booking.paymentIntentId !== refund.providerIntentId\n                || change.booking.currency !== refund.currency\n            ) {\n                throw new Error('Refund does not match the cancelled booking payment.');\n            }\n            if (refund.status === 'SUCCEEDED') return { refund, attempt: null };\n\n            const current = refund.attempts[0];\n            const attempt = !current || RETRYABLE_TERMINAL.has(current.status)\n                ? await tx.paymentRefundAttempt.create({\n                    data: { id: randomUUID(), paymentRefundId: refund.id },\n                })\n                : current;\n            return { refund, attempt };\n        });\n\n        if (!prepared.attempt) return { status: 'SUCCEEDED', wasSubmitted: false };\n\n        const { refund, attempt } = prepared;\n        let state: PaymentRefundState | null;\n        let wasSubmitted = false;\n        if (attempt.providerRefundId) {\n            state = await this.provider.retrieveRefund(attempt.providerRefundId);\n        } else {\n            const lookup = {\n                refundId: refund.id,\n                refundAttemptId: attempt.id,\n                providerIntentId: refund.providerIntentId,\n            };\n            state = await this.provider.findRefund(lookup);\n            if (!state) {\n                try {\n                    wasSubmitted = true;\n                    state = await this.provider.createRefund({\n                        ...lookup,\n                        amountCents: refund.amountCents,\n                    });\n                } catch (error) {\n                    state = await this.provider.findRefund(lookup);\n                    if (!state) throw error;\n                }\n            }\n        }\n\n        if (\n            state.paymentRefundId !== refund.id\n            || state.refundAttemptId !== attempt.id\n            || (\n                attempt.providerRefundId !== null\n                && state.providerRefundId !== attempt.providerRefundId\n            )\n        ) {\n            throw new Error('Stripe refund metadata does not match the durable refund attempt.');\n        }\n\n        const persistedStatus = await prisma.$transaction(async tx => {\n            // A provider call cannot hold a database transaction open, so a\n            // concurrent reconciliation can finish while this response is in\n            // flight. The conditional write takes the attempt row lock and is\n            // re-evaluated after a concurrent writer commits, so an older\n            // non-terminal response cannot overwrite a terminal provider\n            // result made durable by that other call.\n            const updated = await tx.paymentRefundAttempt.updateMany({\n                where: {\n                    id: attempt.id,\n                    status: { notIn: PROVIDER_TERMINAL },\n                    OR: [\n                        { providerRefundId: null },\n                        { providerRefundId: state.providerRefundId },\n                    ],\n                },\n                data: {\n                    providerRefundId: state.providerRefundId,\n                    status: state.status,\n                },\n            });\n            if (updated.count === 0) {\n                const current = await tx.paymentRefundAttempt.findUniqueOrThrow({\n                    where: { id: attempt.id },\n                });\n                if (PROVIDER_TERMINAL.includes(current.status)) return current.status;\n                throw new Error('Stripe refund metadata does not match the durable refund attempt.');\n            }\n            await tx.paymentRefund.update({\n                where: { id: refund.id },\n                data: { status: state.status },\n            });\n            return state.status;\n        });\n\n        return { status: persistedStatus, wasSubmitted };\n    }\n}\n\nenum PaymentRefundStatus {\n  PENDING\n  REQUIRES_ACTION\n  SUCCEEDED\n  FAILED\n  CANCELLED\n}\n\n/// Safe server-side payment metadata for one checkout.\n///\n/// Card details stay in Stripe Elements, and even the PaymentIntent client\n/// secret is deliberately not stored here. The request fingerprint binds a\n/// checkout UUID to the itinerary, seats and cabins that produced its quote.\nmodel PaymentAttempt {\n  id                   String               @id\n  checkoutId           String\n  userId               String?\n  user                 User?                @relation(fields: [userId], references: [id], onDelete: SetNull)\n  requestFingerprint   String\n  amountCents          Int\n  currency             String               @default(\"USD\")\n  providerIntentId     String?              @unique\n  status               PaymentAttemptStatus @default(CREATING)\n  capturedAt           DateTime?\n  createdAt            DateTime             @default(now())\n  updatedAt            DateTime             @updatedAt\n  webhookEvents        PaymentWebhookEvent[]\n\n  @@unique([userId, checkoutId])\n  @@index([status, updatedAt])\n}\n\n/// One successfully reconciled Stripe event.\n///\n/// The raw webhook body is deliberately absent: it may contain customer and\n/// payment-provider data that is unnecessary after signature verification.\nmodel PaymentWebhookEvent {\n  id                 String         @id\n  eventType          String\n  providerIntentId   String\n  paymentAttemptId   String\n  paymentAttempt     PaymentAttempt @relation(fields: [paymentAttemptId], references: [id], onDelete: Cascade)\n  createdAt          DateTime       @default(now())\n\n  @@index([providerIntentId])\n  @@index([paymentAttemptId])\n}\n\nmodel Booking {\n  id              Int           @id @default(autoincrement())\n  createdAt       DateTime      @default(now())\n  status          BookingStatus @default(CONFIRMED)\n  paymentIntentId String?       @unique\n  /// The booking total in minor units. Null for bookings taken before this\n  /// column existed, which fall back to the flight's catalogue price.\n  totalPriceCents Int?\n  currency        String        @default(\"USD\")\n  idempotencyKey  String?\n\n  userId String?\n  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)\n\n  passengers    Passenger[]\n  legs          ItineraryLeg[]\n  statusChanges BookingStatusChange[]\n\n  @@unique([userId, idempotencyKey])\n}\n\n/// One move between booking states, and the only record of the ones a booking\n/// is no longer in.\n///\n/// Append-only, enforced by a trigger rather than by convention: cancellation,\n/// disruption and refunds all have to be auditable, and a table that reaches\n/// this state only while every caller cooperates is not an audit trail (#76).\n/// Rows go when their booking goes -- the history of a booking that does not\n/// exist has no subject, and blocking that cascade would make a booking\n/// undeletable.\nmodel BookingStatusChange {\n  id          String         @id @default(cuid())\n  bookingId   Int\n  booking     Booking        @relation(fields: [bookingId], references: [id], onDelete: Cascade)\n  /// Null for the row that records the booking coming into existence.\n  from        BookingStatus?\n  to          BookingStatus\n  reason      String?\n  /// What this change owed the customer back, in minor units. Null where the\n  /// change did not refund; zero is a different and real answer, since a\n  /// cancellation inside the cut-off refunds nothing (#76).\n  refundCents Int?\n  /// Orders changes made in the same transaction, which `createdAt` cannot:\n  /// it is transaction start time, so two changes there share an instant.\n  /// A `BigInt` in the client, so a row handed straight to a client component\n  /// fails to serialise -- select what you need rather than the whole row.\n  sequence    BigInt         @default(autoincrement())\n  /// Who caused it. Null for a customer acting on their own booking, and for a\n  /// change nothing attributes.\n  actorUserId String?\n  actor       User?          @relation(fields: [actorUserId], references: [id], onDelete: SetNull)\n  paymentRefund PaymentRefund?\n  createdAt   DateTime       @default(now())\n\n  @@index([bookingId, createdAt])\n  @@index([bookingId, sequence])\n}\n\n/// One provider refund for the exact amount recorded by a cancellation.\n///\n/// The immutable status-change row remains the policy decision; this row is\n/// the durable delivery state used to make Stripe retries idempotent without\n/// retaining provider payloads or customer payment data.\nmodel PaymentRefund {\n  id                    String              @id @default(cuid())\n  bookingStatusChangeId String              @unique\n  bookingStatusChange   BookingStatusChange @relation(fields: [bookingStatusChangeId], references: [id], onDelete: Cascade)\n  providerIntentId      String\n  amountCents           Int\n  currency              String              @default(\"USD\")\n  status                PaymentRefundStatus @default(PENDING)\n  attempts              PaymentRefundAttempt[]\n  createdAt             DateTime            @default(now())\n  updatedAt             DateTime            @updatedAt\n\n  @@index([providerIntentId])\n  @@index([status, updatedAt])\n}\n\n/// One durable provider submission. A terminally failed attempt is retained;\n/// a retry creates another row and therefore another stable idempotency key.\nmodel PaymentRefundAttempt {\n  id               String              @id\n  paymentRefundId  String\n  paymentRefund    PaymentRefund       @relation(fields: [paymentRefundId], references: [id], onDelete: Cascade)\n  providerRefundId String?             @unique\n  status           PaymentRefundStatus @default(PENDING)\n  sequence         BigInt              @default(autoincrement())\n  createdAt        DateTime            @default(now())\n  updatedAt        DateTime            @updatedAt\n\n  @@index([paymentRefundId, sequence])\n}\n\nmodel Passenger {\n  id                      String    @id @default(cuid())\n  firstName               String\n  lastName                String\n  dateOfBirthEncrypted    String?   @db.Text\n  passportNumberEncrypted String?   @db.Text\n  sensitiveDataExpiresAt  DateTime?\n  sensitiveDataDeletedAt  DateTime?\n","stderr":"","aggregated_output":"import React from 'react';\nimport { getServerSession } from 'next-auth';\nimport { redirect } from 'next/navigation';\nimport { authOptions } from '@/lib/auth';\nimport { hasVerifiedStaffAccess } from '@/lib/staffAuthorization';\n\nexport default async function AdminLayout({ children }: { children: React.ReactNode }) {\n    const session = await getServerSession(authOptions);\n    if (!hasVerifiedStaffAccess(session)) {\n        if (session?.user?.role === 'ADMIN' && session.user.staffMfaEnrollmentRequired) {\n            redirect('/staff/mfa');\n        }\n        redirect('/login');\n    }\n    return children;\n}\nimport React from 'react';\nimport { prisma } from '@/lib/prisma';\nimport { flightRouteInclude, withLegRouteLabels } from '@/lib/flightRoute';\nimport Link from 'next/link';\nimport { outboundFlight } from '@/lib/bookingItinerary';\n\nexport const dynamic = 'force-dynamic';\n\nexport default async function AdminDashboard() {\n    const userCount = await prisma.user.count();\n    const bookingCount = await prisma.booking.count();\n    const cityGuideCount = await prisma.cityGuide.count();\n\n    // Recent bookings\n    const recentBookings = await prisma.booking.findMany({\n        take: 5,\n        orderBy: { createdAt: 'desc' },\n        include: {\n            user: {\n                select: {\n                    name: true,\n                    email: true,\n                },\n            },\n            legs: {\n                include: { flight: { include: flightRouteInclude } },\n                orderBy: { sequence: 'asc' },\n            },\n        },\n    });\n\n    return (\n        <div className=\"page-container admin p-8\" style={{ marginTop: '100px', display: 'flex', flexDirection: 'column', gap: '2rem' }}>\n            <h1 className=\"text-3xl font-bold\" style={{ color: '#fff', margin: 0 }}>Admin Control Center</h1>\n\n            {/* Quick Stats Grid */}\n            <div className=\"grid grid-cols-1 md:grid-cols-3 gap-6\" style={{ display: 'grid', gridTemplateColumns: 'repeat(3, 1fr)', gap: '1.5rem' }}>\n                <div className=\"admin-card\" style={{ marginBottom: 0, padding: '24px' }}>\n                    <h2 className=\"text-gray-400 font-semibold mb-2\" style={{ borderBottom: 'none', paddingBottom: 0, fontSize: '1rem', color: '#a78bfa' }}>Total Users</h2>\n                    <p className=\"text-4xl font-bold\" style={{ color: '#38bdf8', fontSize: '2.25rem', margin: '8px 0 0 0', fontWeight: 'bold' }}>{userCount}</p>\n                </div>\n                <div className=\"admin-card\" style={{ marginBottom: 0, padding: '24px' }}>\n                    <h2 className=\"text-gray-400 font-semibold mb-2\" style={{ borderBottom: 'none', paddingBottom: 0, fontSize: '1rem', color: '#a78bfa' }}>Total Bookings</h2>\n                    <p className=\"text-4xl font-bold\" style={{ color: '#34d399', fontSize: '2.25rem', margin: '8px 0 0 0', fontWeight: 'bold' }}>{bookingCount}</p>\n                </div>\n                <div className=\"admin-card\" style={{ marginBottom: 0, padding: '24px' }}>\n                    <h2 className=\"text-gray-400 font-semibold mb-2\" style={{ borderBottom: 'none', paddingBottom: 0, fontSize: '1rem', color: '#a78bfa' }}>City Guides</h2>\n                    <p className=\"text-4xl font-bold\" style={{ color: '#c084fc', fontSize: '2.25rem', margin: '8px 0 0 0', fontWeight: 'bold' }}>{cityGuideCount}</p>\n                </div>\n            </div>\n\n            {/* Admin Management Sections */}\n            <div style={{ display: 'flex', gap: '1.5rem', flexWrap: 'wrap' }}>\n                <Link href=\"/admin/travelguide\" className=\"admin-card hover:border-purple-500 transition-all\" style={{\n                    textDecoration: 'none',\n                    display: 'flex',\n                    flexDirection: 'column',\n                    gap: '0.5rem',\n                    flex: '1',\n                    minWidth: '250px',\n                    padding: '24px',\n                    marginBottom: 0,\n                    border: '1px solid rgba(255, 255, 255, 0.08)'\n                }}>\n                    <h3 style={{ color: '#c084fc', fontSize: '1.25rem', margin: 0, fontWeight: 'bold' }}>City Guides</h3>\n                    <p style={{ color: 'rgba(255, 255, 255, 0.6)', fontSize: '0.9rem', margin: 0 }}>\n                        Create, update, and manage travel guide locations, coordinates, and recommendations.\n                    </p>\n                </Link>\n                <Link href=\"/admin/flights\" className=\"admin-card hover:border-purple-500 transition-all\" style={{\n                    textDecoration: 'none',\n                    display: 'flex',\n                    flexDirection: 'column',\n                    gap: '0.5rem',\n                    flex: '1',\n                    minWidth: '250px',\n                    padding: '24px',\n                    marginBottom: 0,\n                    border: '1px solid rgba(255, 255, 255, 0.08)'\n                }}>\n                    <h3 style={{ color: '#c084fc', fontSize: '1.25rem', margin: 0, fontWeight: 'bold' }}>Flight & Schedule Manager</h3>\n                    <p style={{ color: 'rgba(255, 255, 255, 0.6)', fontSize: '0.9rem', margin: 0 }}>\n                        Create recurring schedules, automatically generate daily occurrences, and monitor/update live statuses.\n                    </p>\n                </Link>\n            </div>\n\n            {/* Recent Bookings List */}\n            <div className=\"admin-card\">\n                <h2 style={{ fontSize: '1.5rem', margin: '0 0 1rem 0', color: '#c084fc', borderBottom: '1px solid rgba(255, 255, 255, 0.08)', paddingBottom: '8px' }}>\n                    Recent Bookings\n                </h2>\n                <div style={{ overflowX: 'auto' }}>\n                    <table style={{ width: '100%', borderCollapse: 'collapse', textAlign: 'left' }}>\n                        <thead>\n                            <tr style={{ borderBottom: '2px solid rgba(255, 255, 255, 0.08)' }}>\n                                <th style={{ padding: '8px 12px', color: '#a78bfa', fontSize: '0.85rem', textTransform: 'uppercase' }}>User</th>\n                                <th style={{ padding: '8px 12px', color: '#a78bfa', fontSize: '0.85rem', textTransform: 'uppercase' }}>Flight</th>\n                                <th style={{ padding: '8px 12px', color: '#a78bfa', fontSize: '0.85rem', textTransform: 'uppercase' }}>Route</th>\n                                <th style={{ padding: '8px 12px', color: '#a78bfa', fontSize: '0.85rem', textTransform: 'uppercase' }}>Date</th>\n                            </tr>\n                        </thead>\n                        <tbody>\n                            {recentBookings.map((booking) => {\n                                const flight = outboundFlight({ ...booking, legs: booking.legs.map(withLegRouteLabels) });\n                                return (\n                                    <tr key={booking.id} style={{ borderBottom: '1px solid rgba(255, 255, 255, 0.04)' }}>\n                                        <td style={{ padding: '12px', fontSize: '0.9rem', color: '#fff' }}>\n                                            {booking.user?.name || booking.user?.email || 'Guest'}\n                                        </td>\n                                        <td style={{ padding: '12px', fontSize: '0.9rem', color: '#fff' }}>\n                                            {flight ? `${flight.airline} ${flight.flightNumber}` : '—'}\n                                        </td>\n                                        <td style={{ padding: '12px', fontSize: '0.9rem', color: '#fff' }}>\n                                            {flight ? `${flight.from} → ${flight.to}` : '—'}\n                                        </td>\n                                        <td style={{ padding: '12px', fontSize: '0.9rem', color: 'rgba(255, 255, 255, 0.6)' }}>\n                                            {new Date(booking.createdAt).toLocaleDateString()}\n                                        </td>\n                                    </tr>\n                                );\n                            })}\n                            {recentBookings.length === 0 && (\n                                <tr>\n                                    <td colSpan={4} style={{ padding: '24px', textAlign: 'center', color: 'rgba(255, 255, 255, 0.4)' }}>\n                                        No recent bookings.\n                                    </td>\n                                </tr>\n                            )}\n                        </tbody>\n                    </table>\n                </div>\n            </div>\n        </div>\n    );\n}\nimport React from 'react';\nimport { prisma } from '@/lib/prisma';\nimport Link from 'next/link';\n\nexport const dynamic = 'force-dynamic';\n\nexport default async function AdminUsersPage() {\n    const users = await prisma.user.findMany({\n        orderBy: { email: 'asc' },\n        select: {\n            id: true,\n            name: true,\n            email: true,\n            role: true,\n            _count: { select: { bookings: true, reviews: true, favorites: true } }\n        }\n    });\n\n    return (\n        <div className=\"page-container p-8\" style={{ marginTop: '100px' }}>\n            <div className=\"flex justify-between items-center mb-6\">\n                <h1 className=\"text-3xl font-bold\">Manage Users</h1>\n                <Link href=\"/admin\" className=\"text-blue-600 hover:underline\">← Back to Dashboard</Link>\n            </div>\n\n            <div className=\"bg-white rounded-lg shadow-md border border-gray-200 overflow-hidden\">\n                <div className=\"p-0\">\n                    <table className=\"min-w-full divide-y divide-gray-200\" style={{ width: '100%', textAlign: 'left', borderCollapse: 'collapse' }}>\n                        <thead className=\"bg-gray-50\">\n                            <tr>\n                                <th className=\"px-6 py-3 text-xs font-medium text-gray-500 uppercase tracking-wider border-b\">Name</th>\n                                <th className=\"px-6 py-3 text-xs font-medium text-gray-500 uppercase tracking-wider border-b\">Email</th>\n                                <th className=\"px-6 py-3 text-xs font-medium text-gray-500 uppercase tracking-wider border-b\">Role</th>\n                                <th className=\"px-6 py-3 text-xs font-medium text-gray-500 uppercase tracking-wider border-b\">Bookings</th>\n                                <th className=\"px-6 py-3 text-xs font-medium text-gray-500 uppercase tracking-wider border-b\">Reviews</th>\n                                <th className=\"px-6 py-3 text-xs font-medium text-gray-500 uppercase tracking-wider border-b\">Favorites</th>\n                            </tr>\n                        </thead>\n                        <tbody className=\"bg-white divide-y divide-gray-200\">\n                            {users.map((user) => (\n                                <tr key={user.id}>\n                                    <td className=\"px-6 py-4 whitespace-nowrap text-sm text-gray-900 border-b\">{user.name || 'N/A'}</td>\n                                    <td className=\"px-6 py-4 whitespace-nowrap text-sm text-gray-500 border-b\">{user.email}</td>\n                                    <td className=\"px-6 py-4 whitespace-nowrap text-sm text-gray-500 border-b\">\n                                        <span className={`px-2 py-1 rounded text-xs font-semibold ${user.role === 'ADMIN' ? 'bg-purple-100 text-purple-700' : 'bg-gray-100 text-gray-700'}`}>\n                                            {user.role}\n                                        </span>\n                                    </td>\n                                    <td className=\"px-6 py-4 whitespace-nowrap text-sm text-gray-500 border-b\">{user._count.bookings}</td>\n                                    <td className=\"px-6 py-4 whitespace-nowrap text-sm text-gray-500 border-b\">{user._count.reviews}</td>\n                                    <td className=\"px-6 py-4 whitespace-nowrap text-sm text-gray-500 border-b\">{user._count.favorites}</td>\n                                </tr>\n                            ))}\n                        </tbody>\n                    </table>\n                </div>\n            </div>\n        </div>\n    );\n}\nimport type { PaymentStateProvider } from '@/lib/stripePaymentProvider';\nimport type { VerifiedPaymentWebhookEvent } from '@/lib/stripeWebhook';\nimport { prisma } from '@/lib/prisma';\nimport { lockPaymentIntentForUpdate } from '@/lib/paymentIntentLock';\n\nexport interface PaymentWebhookReconciler {\n    reconcile(event: VerifiedPaymentWebhookEvent): Promise<void>;\n}\n\nexport class PaymentWebhookService implements PaymentWebhookReconciler {\n    constructor(private readonly provider: PaymentStateProvider) {}\n\n    async reconcile(event: VerifiedPaymentWebhookEvent): Promise<void> {\n        await prisma.$transaction(async tx => {\n            await lockPaymentIntentForUpdate(tx, event.providerIntentId);\n\n            const duplicate = await tx.paymentWebhookEvent.findUnique({\n                where: { id: event.eventId },\n                select: { id: true },\n            });\n            if (duplicate) return;\n\n            const state = await this.provider.retrievePaymentState(event.providerIntentId);\n            if (state.providerIntentId !== event.providerIntentId) {\n                throw new Error(\n                    'Stripe webhook PaymentIntent did not match the retrieved intent.',\n                );\n            }\n            if (!state.paymentAttemptId) {\n                throw new Error('Stripe PaymentIntent has no local payment attempt metadata.');\n            }\n\n            const [attempt, existingBinding] = await Promise.all([\n                tx.paymentAttempt.findUnique({ where: { id: state.paymentAttemptId } }),\n                tx.paymentAttempt.findUnique({\n                    where: { providerIntentId: event.providerIntentId },\n                    select: { id: true },\n                }),\n            ]);\n            if (!attempt) {\n                throw new Error('Payment attempt not found for Stripe webhook.');\n            }\n            if (\n                (attempt.providerIntentId && attempt.providerIntentId !== event.providerIntentId)\n                || (existingBinding && existingBinding.id !== attempt.id)\n            ) {\n                throw new Error('Stripe PaymentIntent is bound to a different payment attempt.');\n            }\n\n            await tx.paymentAttempt.update({\n                where: { id: attempt.id },\n                data: {\n                    providerIntentId: event.providerIntentId,\n                    status: state.status,\n                },\n            });\n            await tx.paymentWebhookEvent.create({\n                data: {\n                    id: event.eventId,\n                    eventType: event.eventType,\n                    providerIntentId: event.providerIntentId,\n                    paymentAttemptId: attempt.id,\n                },\n            });\n        }, { maxWait: 5_000, timeout: 15_000 });\n    }\n}\nimport { randomUUID } from 'node:crypto';\nimport { prisma } from '@/lib/prisma';\nimport type {\n    PaymentRefundState,\n    PaymentRefundStatus,\n    RefundProvider,\n} from '@/lib/stripePaymentProvider';\n\ninterface RefundSettlement {\n    status: PaymentRefundStatus;\n    wasSubmitted: boolean;\n}\n\nconst RETRYABLE_TERMINAL = new Set<PaymentRefundStatus>(['FAILED', 'CANCELLED']);\nconst PROVIDER_TERMINAL: PaymentRefundStatus[] = ['SUCCEEDED', 'FAILED', 'CANCELLED'];\n\nexport class PaymentRefundService {\n    constructor(private readonly provider: RefundProvider) {}\n\n    async settleRefund(refundId: string): Promise<RefundSettlement> {\n        const prepared = await prisma.$transaction(async tx => {\n            await tx.$executeRaw`SELECT pg_advisory_xact_lock(hashtext(${refundId}))`;\n            const refund = await tx.paymentRefund.findUniqueOrThrow({\n                where: { id: refundId },\n                include: {\n                    bookingStatusChange: { include: { booking: true } },\n                    attempts: { orderBy: { sequence: 'desc' }, take: 1 },\n                },\n            });\n            const change = refund.bookingStatusChange;\n            if (\n                change.to !== 'CANCELLED'\n                || change.refundCents !== refund.amountCents\n                || change.booking.paymentIntentId !== refund.providerIntentId\n                || change.booking.currency !== refund.currency\n            ) {\n                throw new Error('Refund does not match the cancelled booking payment.');\n            }\n            if (refund.status === 'SUCCEEDED') return { refund, attempt: null };\n\n            const current = refund.attempts[0];\n            const attempt = !current || RETRYABLE_TERMINAL.has(current.status)\n                ? await tx.paymentRefundAttempt.create({\n                    data: { id: randomUUID(), paymentRefundId: refund.id },\n                })\n                : current;\n            return { refund, attempt };\n        });\n\n        if (!prepared.attempt) return { status: 'SUCCEEDED', wasSubmitted: false };\n\n        const { refund, attempt } = prepared;\n        let state: PaymentRefundState | null;\n        let wasSubmitted = false;\n        if (attempt.providerRefundId) {\n            state = await this.provider.retrieveRefund(attempt.providerRefundId);\n        } else {\n            const lookup = {\n                refundId: refund.id,\n                refundAttemptId: attempt.id,\n                providerIntentId: refund.providerIntentId,\n            };\n            state = await this.provider.findRefund(lookup);\n            if (!state) {\n                try {\n                    wasSubmitted = true;\n                    state = await this.provider.createRefund({\n                        ...lookup,\n                        amountCents: refund.amountCents,\n                    });\n                } catch (error) {\n                    state = await this.provider.findRefund(lookup);\n                    if (!state) throw error;\n                }\n            }\n        }\n\n        if (\n            state.paymentRefundId !== refund.id\n            || state.refundAttemptId !== attempt.id\n            || (\n                attempt.providerRefundId !== null\n                && state.providerRefundId !== attempt.providerRefundId\n            )\n        ) {\n            throw new Error('Stripe refund metadata does not match the durable refund attempt.');\n        }\n\n        const persistedStatus = await prisma.$transaction(async tx => {\n            // A provider call cannot hold a database transaction open, so a\n            // concurrent reconciliation can finish while this response is in\n            // flight. The conditional write takes the attempt row lock and is\n            // re-evaluated after a concurrent writer commits, so an older\n            // non-terminal response cannot overwrite a terminal provider\n            // result made durable by that other call.\n            const updated = await tx.paymentRefundAttempt.updateMany({\n                where: {\n                    id: attempt.id,\n                    status: { notIn: PROVIDER_TERMINAL },\n                    OR: [\n                        { providerRefundId: null },\n                        { providerRefundId: state.providerRefundId },\n                    ],\n                },\n                data: {\n                    providerRefundId: state.providerRefundId,\n                    status: state.status,\n                },\n            });\n            if (updated.count === 0) {\n                const current = await tx.paymentRefundAttempt.findUniqueOrThrow({\n                    where: { id: attempt.id },\n                });\n                if (PROVIDER_TERMINAL.includes(current.status)) return current.status;\n                throw new Error('Stripe refund metadata does not match the durable refund attempt.');\n            }\n            await tx.paymentRefund.update({\n                where: { id: refund.id },\n                data: { status: state.status },\n            });\n            return state.status;\n        });\n\n        return { status: persistedStatus, wasSubmitted };\n    }\n}\n\nenum PaymentRefundStatus {\n  PENDING\n  REQUIRES_ACTION\n  SUCCEEDED\n  FAILED\n  CANCELLED\n}\n\n/// Safe server-side payment metadata for one checkout.\n///\n/// Card details stay in Stripe Elements, and even the PaymentIntent client\n/// secret is deliberately not stored here. The request fingerprint binds a\n/// checkout UUID to the itinerary, seats and cabins that produced its quote.\nmodel PaymentAttempt {\n  id                   String               @id\n  checkoutId           String\n  userId               String?\n  user                 User?                @relation(fields: [userId], references: [id], onDelete: SetNull)\n  requestFingerprint   String\n  amountCents          Int\n  currency             String               @default(\"USD\")\n  providerIntentId     String?              @unique\n  status               PaymentAttemptStatus @default(CREATING)\n  capturedAt           DateTime?\n  createdAt            DateTime             @default(now())\n  updatedAt            DateTime             @updatedAt\n  webhookEvents        PaymentWebhookEvent[]\n\n  @@unique([userId, checkoutId])\n  @@index([status, updatedAt])\n}\n\n/// One successfully reconciled Stripe event.\n///\n/// The raw webhook body is deliberately absent: it may contain customer and\n/// payment-provider data that is unnecessary after signature verification.\nmodel PaymentWebhookEvent {\n  id                 String         @id\n  eventType          String\n  providerIntentId   String\n  paymentAttemptId   String\n  paymentAttempt     PaymentAttempt @relation(fields: [paymentAttemptId], references: [id], onDelete: Cascade)\n  createdAt          DateTime       @default(now())\n\n  @@index([providerIntentId])\n  @@index([paymentAttemptId])\n}\n\nmodel Booking {\n  id              Int           @id @default(autoincrement())\n  createdAt       DateTime      @default(now())\n  status          BookingStatus @default(CONFIRMED)\n  paymentIntentId String?       @unique\n  /// The booking total in minor units. Null for bookings taken before this\n  /// column existed, which fall back to the flight's catalogue price.\n  totalPriceCents Int?\n  currency        String        @default(\"USD\")\n  idempotencyKey  String?\n\n  userId String?\n  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)\n\n  passengers    Passenger[]\n  legs          ItineraryLeg[]\n  statusChanges BookingStatusChange[]\n\n  @@unique([userId, idempotencyKey])\n}\n\n/// One move between booking states, and the only record of the ones a booking\n/// is no longer in.\n///\n/// Append-only, enforced by a trigger rather than by convention: cancellation,\n/// disruption and refunds all have to be auditable, and a table that reaches\n/// this state only while every caller cooperates is not an audit trail (#76).\n/// Rows go when their booking goes -- the history of a booking that does not\n/// exist has no subject, and blocking that cascade would make a booking\n/// undeletable.\nmodel BookingStatusChange {\n  id          String         @id @default(cuid())\n  bookingId   Int\n  booking     Booking        @relation(fields: [bookingId], references: [id], onDelete: Cascade)\n  /// Null for the row that records the booking coming into existence.\n  from        BookingStatus?\n  to          BookingStatus\n  reason      String?\n  /// What this change owed the customer back, in minor units. Null where the\n  /// change did not refund; zero is a different and real answer, since a\n  /// cancellation inside the cut-off refunds nothing (#76).\n  refundCents Int?\n  /// Orders changes made in the same transaction, which `createdAt` cannot:\n  /// it is transaction start time, so two changes there share an instant.\n  /// A `BigInt` in the client, so a row handed straight to a client component\n  /// fails to serialise -- select what you need rather than the whole row.\n  sequence    BigInt         @default(autoincrement())\n  /// Who caused it. Null for a customer acting on their own booking, and for a\n  /// change nothing attributes.\n  actorUserId String?\n  actor       User?          @relation(fields: [actorUserId], references: [id], onDelete: SetNull)\n  paymentRefund PaymentRefund?\n  createdAt   DateTime       @default(now())\n\n  @@index([bookingId, createdAt])\n  @@index([bookingId, sequence])\n}\n\n/// One provider refund for the exact amount recorded by a cancellation.\n///\n/// The immutable status-change row remains the policy decision; this row is\n/// the durable delivery state used to make Stripe retries idempotent without\n/// retaining provider payloads or customer payment data.\nmodel PaymentRefund {\n  id                    String              @id @default(cuid())\n  bookingStatusChangeId String              @unique\n  bookingStatusChange   BookingStatusChange @relation(fields: [bookingStatusChangeId], references: [id], onDelete: Cascade)\n  providerIntentId      String\n  amountCents           Int\n  currency              String              @default(\"USD\")\n  status                PaymentRefundStatus @default(PENDING)\n  attempts              PaymentRefundAttempt[]\n  createdAt             DateTime            @default(now())\n  updatedAt             DateTime            @updatedAt\n\n  @@index([providerIntentId])\n  @@index([status, updatedAt])\n}\n\n/// One durable provider submission. A terminally failed attempt is retained;\n/// a retry creates another row and therefore another stable idempotency key.\nmodel PaymentRefundAttempt {\n  id               String              @id\n  paymentRefundId  String\n  paymentRefund    PaymentRefund       @relation(fields: [paymentRefundId], references: [id], onDelete: Cascade)\n  providerRefundId String?             @unique\n  status           PaymentRefundStatus @default(PENDING)\n  sequence         BigInt              @default(autoincrement())\n  createdAt        DateTime            @default(now())\n  updatedAt        DateTime            @updatedAt\n\n  @@index([paymentRefundId, sequence])\n}\n\nmodel Passenger {\n  id                      String    @id @default(cuid())\n  firstName               String\n  lastName                String\n  dateOfBirthEncrypted    String?   @db.Text\n  passportNumberEncrypted String?   @db.Text\n  sensitiveDataExpiresAt  DateTime?\n  sensitiveDataDeletedAt  DateTime?\n","exit_code":0,"duration":{"secs":0,"nanos":47441},"formatted_output":"import React from 'react';\nimport { getServerSession } from 'next-auth';\nimport { redirect } from 'next/navigation';\nimport { authOptions } from '@/lib/auth';\nimport { hasVerifiedStaffAccess } from '@/lib/staffAuthorization';\n\nexport default async function AdminLayout({ children }: { children: React.ReactNode }) {\n    const session = await getServerSession(authOptions);\n    if (!hasVerifiedStaffAccess(session)) {\n        if (session?.user?.role === 'ADMIN' && session.user.staffMfaEnrollmentRequired) {\n            redirect('/staff/mfa');\n        }\n        redirect('/login');\n    }\n    return children;\n}\nimport React from 'react';\nimport { prisma } from '@/lib/prisma';\nimport { flightRouteInclude, withLegRouteLabels } from '@/lib/flightRoute';\nimport Link from 'next/link';\nimport { outboundFlight } from '@/lib/bookingItinerary';\n\nexport const dynamic = 'force-dynamic';\n\nexport default async function AdminDashboard() {\n    const userCount = await prisma.user.count();\n    const bookingCount = await prisma.booking.count();\n    const cityGuideCount = await prisma.cityGuide.count();\n\n    // Recent bookings\n    const recentBookings = await prisma.booking.findMany({\n        take: 5,\n        orderBy: { createdAt: 'desc' },\n        include: {\n            user: {\n                select: {\n                    name: true,\n                    email: true,\n                },\n            },\n            legs: {\n                include: { flight: { include: flightRouteInclude } },\n                orderBy: { sequence: 'asc' },\n            },\n        },\n    });\n\n    return (\n        <div className=\"page-container admin p-8\" style={{ marginTop: '100px', display: 'flex', flexDirection: 'column', gap: '2rem' }}>\n            <h1 className=\"text-3xl font-bold\" style={{ color: '#fff', margin: 0 }}>Admin Control Center</h1>\n\n            {/* Quick Stats Grid */}\n            <div className=\"grid grid-cols-1 md:grid-cols-3 gap-6\" style={{ display: 'grid', gridTemplateColumns: 'repeat(3, 1fr)', gap: '1.5rem' }}>\n                <div className=\"admin-card\" style={{ marginBottom: 0, padding: '24px' }}>\n                    <h2 className=\"text-gray-400 font-semibold mb-2\" style={{ borderBottom: 'none', paddingBottom: 0, fontSize: '1rem', color: '#a78bfa' }}>Total Users</h2>\n                    <p className=\"text-4xl font-bold\" style={{ color: '#38bdf8', fontSize: '2.25rem', margin: '8px 0 0 0', fontWeight: 'bold' }}>{userCount}</p>\n                </div>\n                <div className=\"admin-card\" style={{ marginBottom: 0, padding: '24px' }}>\n                    <h2 className=\"text-gray-400 font-semibold mb-2\" style={{ borderBottom: 'none', paddingBottom: 0, fontSize: '1rem', color: '#a78bfa' }}>Total Bookings</h2>\n                    <p className=\"text-4xl font-bold\" style={{ color: '#34d399', fontSize: '2.25rem', margin: '8px 0 0 0', fontWeight: 'bold' }}>{bookingCount}</p>\n                </div>\n                <div className=\"admin-card\" style={{ marginBottom: 0, padding: '24px' }}>\n                    <h2 className=\"text-gray-400 font-semibold mb-2\" style={{ borderBottom: 'none', paddingBottom: 0, fontSize: '1rem', color: '#a78bfa' }}>City Guides</h2>\n                    <p className=\"text-4xl font-bold\" style={{ color: '#c084fc', fontSize: '2.25rem', margin: '8px 0 0 0', fontWeight: 'bold' }}>{cityGuideCount}</p>\n                </div>\n            </div>\n\n            {/* Admin Management Sections */}\n            <div style={{ display: 'flex', gap: '1.5rem', flexWrap: 'wrap' }}>\n                <Link href=\"/admin/travelguide\" className=\"admin-card hover:border-purple-500 transition-all\" style={{\n                    textDecoration: 'none',\n                    display: 'flex',\n                    flexDirection: 'column',\n                    gap: '0.5rem',\n                    flex: '1',\n                    minWidth: '250px',\n                    padding: '24px',\n                    marginBottom: 0,\n                    border: '1px solid rgba(255, 255, 255, 0.08)'\n                }}>\n                    <h3 style={{ color: '#c084fc', fontSize: '1.25rem', margin: 0, fontWeight: 'bold' }}>City Guides</h3>\n                    <p style={{ color: 'rgba(255, 255, 255, 0.6)', fontSize: '0.9rem', margin: 0 }}>\n                        Create, update, and manage travel guide locations, coordinates, and recommendations.\n                    </p>\n                </Link>\n                <Link href=\"/admin/flights\" className=\"admin-card hover:border-purple-500 transition-all\" style={{\n                    textDecoration: 'none',\n                    display: 'flex',\n                    flexDirection: 'column',\n                    gap: '0.5rem',\n                    flex: '1',\n                    minWidth: '250px',\n                    padding: '24px',\n                    marginBottom: 0,\n                    border: '1px solid rgba(255, 255, 255, 0.08)'\n                }}>\n                    <h3 style={{ color: '#c084fc', fontSize: '1.25rem', margin: 0, fontWeight: 'bold' }}>Flight & Schedule Manager</h3>\n                    <p style={{ color: 'rgba(255, 255, 255, 0.6)', fontSize: '0.9rem', margin: 0 }}>\n                        Create recurring schedules, automatically generate daily occurrences, and monitor/update live statuses.\n                    </p>\n                </Link>\n            </div>\n\n            {/* Recent Bookings List */}\n            <div className=\"admin-card\">\n                <h2 style={{ fontSize: '1.5rem', margin: '0 0 1rem 0', color: '#c084fc', borderBottom: '1px solid rgba(255, 255, 255, 0.08)', paddingBottom: '8px' }}>\n                    Recent Bookings\n                </h2>\n                <div style={{ overflowX: 'auto' }}>\n                    <table style={{ width: '100%', borderCollapse: 'collapse', textAlign: 'left' }}>\n                        <thead>\n                            <tr style={{ borderBottom: '2px solid rgba(255, 255, 255, 0.08)' }}>\n                                <th style={{ padding: '8px 12px', color: '#a78bfa', fontSize: '0.85rem', textTransform: 'uppercase' }}>User</th>\n                                <th style={{ padding: '8px 12px', color: '#a78bfa', fontSize: '0.85rem', textTransform: 'uppercase' }}>Flight</th>\n                                <th style={{ padding: '8px 12px', color: '#a78bfa', fontSize: '0.85rem', textTransform: 'uppercase' }}>Route</th>\n                                <th style={{ padding: '8px 12px', color: '#a78bfa', fontSize: '0.85rem', textTransform: 'uppercase' }}>Date</th>\n                            </tr>\n                        </thead>\n                        <tbody>\n                            {recentBookings.map((booking) => {\n                                const flight = outboundFlight({ ...booking, legs: booking.legs.map(withLegRouteLabels) });\n                                return (\n                                    <tr key={booking.id} style={{ borderBottom: '1px solid rgba(255, 255, 255, 0.04)' }}>\n                                        <td style={{ padding: '12px', fontSize: '0.9rem', color: '#fff' }}>\n                                            {booking.user?.name || booking.user?.email || 'Guest'}\n                                        </td>\n                                        <td style={{ padding: '12px', fontSize: '0.9rem', color: '#fff' }}>\n                                            {flight ? `${flight.airline} ${flight.flightNumber}` : '—'}\n                                        </td>\n                                        <td style={{ padding: '12px', fontSize: '0.9rem', color: '#fff' }}>\n                                            {flight ? `${flight.from} → ${flight.to}` : '—'}\n                                        </td>\n                                        <td style={{ padding: '12px', fontSize: '0.9rem', color: 'rgba(255, 255, 255, 0.6)' }}>\n                                            {new Date(booking.createdAt).toLocaleDateString()}\n                                        </td>\n                                    </tr>\n                                );\n                            })}\n                            {recentBookings.length === 0 && (\n                                <tr>\n                                    <td colSpan={4} style={{ padding: '24px', textAlign: 'center', color: 'rgba(255, 255, 255, 0.4)' }}>\n                                        No recent bookings.\n                                    </td>\n                                </tr>\n                            )}\n                        </tbody>\n                    </table>\n                </div>\n            </div>\n        </div>\n    );\n}\nimport React from 'react';\nimport { prisma } from '@/lib/prisma';\nimport Link from 'next/link';\n\nexport const dynamic = 'force-dynamic';\n\nexport default async function AdminUsersPage() {\n    const users = await prisma.user.findMany({\n        orderBy: { email: 'asc' },\n        select: {\n            id: true,\n            name: true,\n            email: true,\n            role: true,\n            _count: { select: { bookings: true, reviews: true, favorites: true } }\n        }\n    });\n\n    return (\n        <div className=\"page-container p-8\" style={{ marginTop: '100px' }}>\n            <div className=\"flex justify-between items-center mb-6\">\n                <h1 className=\"text-3xl font-bold\">Manage Users</h1>\n                <Link href=\"/admin\" className=\"text-blue-600 hover:underline\">← Back to Dashboard</Link>\n            </div>\n\n            <div className=\"bg-white rounded-lg shadow-md border border-gray-200 overflow-hidden\">\n                <div className=\"p-0\">\n                    <table className=\"min-w-full divide-y divide-gray-200\" style={{ width: '100%', textAlign: 'left', borderCollapse: 'collapse' }}>\n                        <thead className=\"bg-gray-50\">\n                            <tr>\n                                <th className=\"px-6 py-3 text-xs font-medium text-gray-500 uppercase tracking-wider border-b\">Name</th>\n                                <th className=\"px-6 py-3 text-xs font-medium text-gray-500 uppercase tracking-wider border-b\">Email</th>\n                                <th className=\"px-6 py-3 text-xs font-medium text-gray-500 uppercase tracking-wider border-b\">Role</th>\n                                <th className=\"px-6 py-3 text-xs font-medium text-gray-500 uppercase tracking-wider border-b\">Bookings</th>\n                                <th className=\"px-6 py-3 text-xs font-medium text-gray-500 uppercase tracking-wider border-b\">Reviews</th>\n                                <th className=\"px-6 py-3 text-xs font-medium text-gray-500 uppercase tracking-wider border-b\">Favorites</th>\n                            </tr>\n                        </thead>\n                        <tbody className=\"bg-white divide-y divide-gray-200\">\n                            {users.map((user) => (\n                                <tr key={user.id}>\n                                    <td className=\"px-6 py-4 whitespace-nowrap text-sm text-gray-900 border-b\">{user.name || 'N/A'}</td>\n                                    <td className=\"px-6 py-4 whitespace-nowrap text-sm text-gray-500 border-b\">{user.email}</td>\n                                    <td className=\"px-6 py-4 whitespace-nowrap text-sm text-gray-500 border-b\">\n                                        <span className={`px-2 py-1 rounded text-xs font-semibold ${user.role === 'ADMIN' ? 'bg-purple-100 text-purple-700' : 'bg-gray-100 text-gray-700'}`}>\n                                            {user.role}\n                                        </span>\n                                    </td>\n                                    <td className=\"px-6 py-4 whitespace-nowrap text-sm text-gray-500 border-b\">{user._count.bookings}</td>\n                                    <td className=\"px-6 py-4 whitespace-nowrap text-sm text-gray-500 border-b\">{user._count.reviews}</td>\n                                    <td className=\"px-6 py-4 whitespace-nowrap text-sm text-gray-500 border-b\">{user._count.favorites}</td>\n                                </tr>\n                            ))}\n                        </tbody>\n                    </table>\n                </div>\n            </div>\n        </div>\n    );\n}\nimport type { PaymentStateProvider } from '@/lib/stripePaymentProvider';\nimport type { VerifiedPaymentWebhookEvent } from '@/lib/stripeWebhook';\nimport { prisma } from '@/lib/prisma';\nimport { lockPaymentIntentForUpdate } from '@/lib/paymentIntentLock';\n\nexport interface PaymentWebhookReconciler {\n    reconcile(event: VerifiedPaymentWebhookEvent): Promise<void>;\n}\n\nexport class PaymentWebhookService implements PaymentWebhookReconciler {\n    constructor(private readonly provider: PaymentStateProvider) {}\n\n    async reconcile(event: VerifiedPaymentWebhookEvent): Promise<void> {\n        await prisma.$transaction(async tx => {\n            await lockPaymentIntentForUpdate(tx, event.providerIntentId);\n\n            const duplicate = await tx.paymentWebhookEvent.findUnique({\n                where: { id: event.eventId },\n                select: { id: true },\n            });\n            if (duplicate) return;\n\n            const state = await this.provider.retrievePaymentState(event.providerIntentId);\n            if (state.providerIntentId !== event.providerIntentId) {\n                throw new Error(\n                    'Stripe webhook PaymentIntent did not match the retrieved intent.',\n                );\n            }\n            if (!state.paymentAttemptId) {\n                throw new Error('Stripe PaymentIntent has no local payment attempt metadata.');\n            }\n\n            const [attempt, existingBinding] = await Promise.all([\n                tx.paymentAttempt.findUnique({ where: { id: state.paymentAttemptId } }),\n                tx.paymentAttempt.findUnique({\n                    where: { providerIntentId: event.providerIntentId },\n                    select: { id: true },\n                }),\n            ]);\n            if (!attempt) {\n                throw new Error('Payment attempt not found for Stripe webhook.');\n            }\n            if (\n                (attempt.providerIntentId && attempt.providerIntentId !== event.providerIntentId)\n                || (existingBinding && existingBinding.id !== attempt.id)\n            ) {\n                throw new Error('Stripe PaymentIntent is bound to a different payment attempt.');\n            }\n\n            await tx.paymentAttempt.update({\n                where: { id: attempt.id },\n                data: {\n                    providerIntentId: event.providerIntentId,\n                    status: state.status,\n                },\n            });\n            await tx.paymentWebhookEvent.create({\n                data: {\n                    id: event.eventId,\n                    eventType: event.eventType,\n                    providerIntentId: event.providerIntentId,\n                    paymentAttemptId: attempt.id,\n                },\n            });\n        }, { maxWait: 5_000, timeout: 15_000 });\n    }\n}\nimport { randomUUID } from 'node:crypto';\nimport { prisma } from '@/lib/prisma';\nimport type {\n    PaymentRefundState,\n    PaymentRefundStatus,\n    RefundProvider,\n} from '@/lib/stripePaymentProvider';\n\ninterface RefundSettlement {\n    status: PaymentRefundStatus;\n    wasSubmitted: boolean;\n}\n\nconst RETRYABLE_TERMINAL = new Set<PaymentRefundStatus>(['FAILED', 'CANCELLED']);\nconst PROVIDER_TERMINAL: PaymentRefundStatus[] = ['SUCCEEDED', 'FAILED', 'CANCELLED'];\n\nexport class PaymentRefundService {\n    constructor(private readonly provider: RefundProvider) {}\n\n    async settleRefund(refundId: string): Promise<RefundSettlement> {\n        const prepared = await prisma.$transaction(async tx => {\n            await tx.$executeRaw`SELECT pg_advisory_xact_lock(hashtext(${refundId}))`;\n            const refund = await tx.paymentRefund.findUniqueOrThrow({\n                where: { id: refundId },\n                include: {\n                    bookingStatusChange: { include: { booking: true } },\n                    attempts: { orderBy: { sequence: 'desc' }, take: 1 },\n                },\n            });\n            const change = refund.bookingStatusChange;\n            if (\n                change.to !== 'CANCELLED'\n                || change.refundCents !== refund.amountCents\n                || change.booking.paymentIntentId !== refund.providerIntentId\n                || change.booking.currency !== refund.currency\n            ) {\n                throw new Error('Refund does not match the cancelled booking payment.');\n            }\n            if (refund.status === 'SUCCEEDED') return { refund, attempt: null };\n\n            const current = refund.attempts[0];\n            const attempt = !current || RETRYABLE_TERMINAL.has(current.status)\n                ? await tx.paymentRefundAttempt.create({\n                    data: { id: randomUUID(), paymentRefundId: refund.id },\n                })\n                : current;\n            return { refund, attempt };\n        });\n\n        if (!prepared.attempt) return { status: 'SUCCEEDED', wasSubmitted: false };\n\n        const { refund, attempt } = prepared;\n        let state: PaymentRefundState | null;\n        let wasSubmitted = false;\n        if (attempt.providerRefundId) {\n            state = await this.provider.retrieveRefund(attempt.providerRefundId);\n        } else {\n            const lookup = {\n                refundId: refund.id,\n                refundAttemptId: attempt.id,\n                providerIntentId: refund.providerIntentId,\n            };\n            state = await this.provider.findRefund(lookup);\n            if (!state) {\n                try {\n                    wasSubmitted = true;\n                    state = await this.provider.createRefund({\n                        ...lookup,\n                        amountCents: refund.amountCents,\n                    });\n                } catch (error) {\n                    state = await this.provider.findRefund(lookup);\n                    if (!state) throw error;\n                }\n            }\n        }\n\n        if (\n            state.paymentRefundId !== refund.id\n            || state.refundAttemptId !== attempt.id\n            || (\n                attempt.providerRefundId !== null\n                && state.providerRefundId !== attempt.providerRefundId\n            )\n        ) {\n            throw new Error('Stripe refund metadata does not match the durable refund attempt.');\n        }\n\n        const persistedStatus = await prisma.$transaction(async tx => {\n            // A provider call cannot hold a database transaction open, so a\n            // concurrent reconciliation can finish while this response is in\n            // flight. The conditional write takes the attempt row lock and is\n            // re-evaluated after a concurrent writer commits, so an older\n            // non-terminal response cannot overwrite a terminal provider\n            // result made durable by that other call.\n            const updated = await tx.paymentRefundAttempt.updateMany({\n                where: {\n                    id: attempt.id,\n                    status: { notIn: PROVIDER_TERMINAL },\n                    OR: [\n                        { providerRefundId: null },\n                        { providerRefundId: state.providerRefundId },\n                    ],\n                },\n                data: {\n                    providerRefundId: state.providerRefundId,\n                    status: state.status,\n                },\n            });\n            if (updated.count === 0) {\n                const current = await tx.paymentRefundAttempt.findUniqueOrThrow({\n                    where: { id: attempt.id },\n                });\n                if (PROVIDER_TERMINAL.includes(current.status)) return current.status;\n                throw new Error('Stripe refund metadata does not match the durable refund attempt.');\n            }\n            await tx.paymentRefund.update({\n                where: { id: refund.id },\n                data: { status: state.status },\n            });\n            return state.status;\n        });\n\n        return { status: persistedStatus, wasSubmitted };\n    }\n}\n\nenum PaymentRefundStatus {\n  PENDING\n  REQUIRES_ACTION\n  SUCCEEDED\n  FAILED\n  CANCELLED\n}\n\n/// Safe server-side payment metadata for one checkout.\n///\n/// Card details stay in Stripe Elements, and even the PaymentIntent client\n/// secret is deliberately not stored here. The request fingerprint binds a\n/// checkout UUID to the itinerary, seats and cabins that produced its quote.\nmodel PaymentAttempt {\n  id                   String               @id\n  checkoutId           String\n  userId               String?\n  user                 User?                @relation(fields: [userId], references: [id], onDelete: SetNull)\n  requestFingerprint   String\n  amountCents          Int\n  currency             String               @default(\"USD\")\n  providerIntentId     String?              @unique\n  status               PaymentAttemptStatus @default(CREATING)\n  capturedAt           DateTime?\n  createdAt            DateTime             @default(now())\n  updatedAt            DateTime             @updatedAt\n  webhookEvents        PaymentWebhookEvent[]\n\n  @@unique([userId, checkoutId])\n  @@index([status, updatedAt])\n}\n\n/// One successfully reconciled Stripe event.\n///\n/// The raw webhook body is deliberately absent: it may contain customer and\n/// payment-provider data that is unnecessary after signature verification.\nmodel PaymentWebhookEvent {\n  id                 String         @id\n  eventType          String\n  providerIntentId   String\n  paymentAttemptId   String\n  paymentAttempt     PaymentAttempt @relation(fields: [paymentAttemptId], references: [id], onDelete: Cascade)\n  createdAt          DateTime       @default(now())\n\n  @@index([providerIntentId])\n  @@index([paymentAttemptId])\n}\n\nmodel Booking {\n  id              Int           @id @default(autoincrement())\n  createdAt       DateTime      @default(now())\n  status          BookingStatus @default(CONFIRMED)\n  paymentIntentId String?       @unique\n  /// The booking total in minor units. Null for bookings taken before this\n  /// column existed, which fall back to the flight's catalogue price.\n  totalPriceCents Int?\n  currency        String        @default(\"USD\")\n  idempotencyKey  String?\n\n  userId String?\n  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)\n\n  passengers    Passenger[]\n  legs          ItineraryLeg[]\n  statusChanges BookingStatusChange[]\n\n  @@unique([userId, idempotencyKey])\n}\n\n/// One move between booking states, and the only record of the ones a booking\n/// is no longer in.\n///\n/// Append-only, enforced by a trigger rather than by convention: cancellation,\n/// disruption and refunds all have to be auditable, and a table that reaches\n/// this state only while every caller cooperates is not an audit trail (#76).\n/// Rows go when their booking goes -- the history of a booking that does not\n/// exist has no subject, and blocking that cascade would make a booking\n/// undeletable.\nmodel BookingStatusChange {\n  id          String         @id @default(cuid())\n  bookingId   Int\n  booking     Booking        @relation(fields: [bookingId], references: [id], onDelete: Cascade)\n  /// Null for the row that records the booking coming into existence.\n  from        BookingStatus?\n  to          BookingStatus\n  reason      String?\n  /// What this change owed the customer back, in minor units. Null where the\n  /// change did not refund; zero is a different and real answer, since a\n  /// cancellation inside the cut-off refunds nothing (#76).\n  refundCents Int?\n  /// Orders changes made in the same transaction, which `createdAt` cannot:\n  /// it is transaction start time, so two changes there share an instant.\n  /// A `BigInt` in the client, so a row handed straight to a client component\n  /// fails to serialise -- select what you need rather than the whole row.\n  sequence    BigInt         @default(autoincrement())\n  /// Who caused it. Null for a customer acting on their own booking, and for a\n  /// change nothing attributes.\n  actorUserId String?\n  actor       User?          @relation(fields: [actorUserId], references: [id], onDelete: SetNull)\n  paymentRefund PaymentRefund?\n  createdAt   DateTime       @default(now())\n\n  @@index([bookingId, createdAt])\n  @@index([bookingId, sequence])\n}\n\n/// One provider refund for the exact amount recorded by a cancellation.\n///\n/// The immutable status-change row remains the policy decision; this row is\n/// the durable delivery state used to make Stripe retries idempotent without\n/// retaining provider payloads or customer payment data.\nmodel PaymentRefund {\n  id                    String              @id @default(cuid())\n  bookingStatusChangeId String              @unique\n  bookingStatusChange   BookingStatusChange @relation(fields: [bookingStatusChangeId], references: [id], onDelete: Cascade)\n  providerIntentId      String\n  amountCents           Int\n  currency              String              @default(\"USD\")\n  status                PaymentRefundStatus @default(PENDING)\n  attempts              PaymentRefundAttempt[]\n  createdAt             DateTime            @default(now())\n  updatedAt             DateTime            @updatedAt\n\n  @@index([providerIntentId])\n  @@index([status, updatedAt])\n}\n\n/// One durable provider submission. A terminally failed attempt is retained;\n/// a retry creates another row and therefore another stable idempotency key.\nmodel PaymentRefundAttempt {\n  id               String              @id\n  paymentRefundId  String\n  paymentRefund    PaymentRefund       @relation(fields: [paymentRefundId], references: [id], onDelete: Cascade)\n  providerRefundId String?             @unique\n  status           PaymentRefundStatus @default(PENDING)\n  sequence         BigInt              @default(autoincrement())\n  createdAt        DateTime            @default(now())\n  updatedAt        DateTime            @updatedAt\n\n  @@index([paymentRefundId, sequence])\n}\n\nmodel Passenger {\n  id                      String    @id @default(cuid())\n  firstName               String\n  lastName                String\n  dateOfBirthEncrypted    String?   @db.Text\n  passportNumberEncrypted String?   @db.Text\n  sensitiveDataExpiresAt  DateTime?\n  sensitiveDataDeletedAt  DateTime?\n"},"started_at_ms":1786854544586,"completed_at_ms":1786854544588}}
{"timestamp":"2026-08-16T04:29:04.785Z","ordinal":21921,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a008d4-9590-7f61-8d05-aa2379a7ad03","call_id":"call_SavZ7LNz6GAxeIZKGSW7Fj9z","output":[{"type":"input_text","text":"Script completed\nWall time 0.4 seconds\nOutput:\n"},{"type":"input_text","text":"import React from 'react';\nimport { getServerSession } from 'next-auth';\nimport { redirect } from 'next/navigation';\nimport { authOptions } from '@/lib/auth';\nimport { hasVerifiedStaffAccess } from '@/lib/staffAuthorization';\n\nexport default async function AdminLayout({ children }: { children: React.ReactNode }) {\n    const session = await getServerSession(authOptions);\n    if (!hasVerifiedStaffAccess(session)) {\n        if (session?.user?.role === 'ADMIN' && session.user.staffMfaEnrollmentRequired) {\n            redirect('/staff/mfa');\n        }\n        redirect('/login');\n    }\n    return children;\n}\nimport React from 'react';\nimport { prisma } from '@/lib/prisma';\nimport { flightRouteInclude, withLegRouteLabels } from '@/lib/flightRoute';\nimport Link from 'next/link';\nimport { outboundFlight } from '@/lib/bookingItinerary';\n\nexport const dynamic = 'force-dynamic';\n\nexport default async function AdminDashboard() {\n    const userCount = await prisma.user.count();\n    const bookingCount = await prisma.booking.count();\n    const cityGuideCount = await prisma.cityGuide.count();\n\n    // Recent bookings\n    const recentBookings = await prisma.booking.findMany({\n        take: 5,\n        orderBy: { createdAt: 'desc' },\n        include: {\n            user: {\n                select: {\n                    name: true,\n                    email: true,\n                },\n            },\n            legs: {\n                include: { flight: { include: flightRouteInclude } },\n                orderBy: { sequence: 'asc' },\n            },\n        },\n    });\n\n    return (\n        <div className=\"page-container admin p-8\" style={{ marginTop: '100px', display: 'flex', flexDirection: 'column', gap: '2rem' }}>\n            <h1 className=\"text-3xl font-bold\" style={{ color: '#fff', margin: 0 }}>Admin Control Center</h1>\n\n            {/* Quick Stats Grid */}\n            <div className=\"grid grid-cols-1 md:grid-cols-3 gap-6\" style={{ display: 'grid', gridTemplateColumns: 'repeat(3, 1fr)', gap: '1.5rem' }}>\n                <div className=\"admin-card\" style={{ marginBottom: 0, padding: '24px' }}>\n                    <h2 className=\"text-gray-400 font-semibold mb-2\" style={{ borderBottom: 'none', paddingBottom: 0, fontSize: '1rem', color: '#a78bfa' }}>Total Users</h2>\n                    <p className=\"text-4xl font-bold\" style={{ color: '#38bdf8', fontSize: '2.25rem', margin: '8px 0 0 0', fontWeight: 'bold' }}>{userCount}</p>\n                </div>\n                <div className=\"admin-card\" style={{ marginBottom: 0, padding: '24px' }}>\n                    <h2 className=\"text-gray-400 font-semibold mb-2\" style={{ borderBottom: 'none', paddingBottom: 0, fontSize: '1rem', color: '#a78bfa' }}>Total Bookings</h2>\n                    <p className=\"text-4xl font-bold\" style={{ color: '#34d399', fontSize: '2.25rem', margin: '8px 0 0 0', fontWeight: 'bold' }}>{bookingCount}</p>\n                </div>\n                <div className=\"admin-card\" style={{ marginBottom: 0, padding: '24px' }}>\n                    <h2 className=\"text-gray-400 font-semibold mb-2\" style={{ borderBottom: 'none', paddingBottom: 0, fontSize: '1rem', color: '#a78bfa' }}>City Guides</h2>\n                    <p className=\"text-4xl font-bold\" style={{ color: '#c084fc', fontSize: '2.25rem', margin: '8px 0 0 0', fontWeight: 'bold' }}>{cityGuideCount}</p>\n                </div>\n            </div>\n\n            {/* Admin Management Sections */}\n            <div style={{ display: 'flex', gap: '1.5rem', flexWrap: 'wrap' }}>\n                <Link href=\"/admin/travelguide\" className=\"admin-card hover:border-purple-500 transition-all\" style={{\n                    textDecoration: 'none',\n                    display: 'flex',\n                    flexDirection: 'column',\n                    gap: '0.5rem',\n                    flex: '1',\n                    minWidth: '250px',\n                    padding: '24px',\n                    marginBottom: 0,\n                    border: '1px solid rgba(255, 255, 255, 0.08)'\n                }}>\n                    <h3 style={{ color: '#c084fc', fontSize: '1.25rem', margin: 0, fontWeight: 'bold' }}>City Guides</h3>\n                    <p style={{ color: 'rgba(255, 255, 255, 0.6)', fontSize: '0.9rem', margin: 0 }}>\n                        Create, update, and manage travel guide locations, coordinates, and recommendations.\n                    </p>\n                </Link>\n                <Link href=\"/admin/flights\" className=\"admin-card hover:border-purple-500 transition-all\" style={{\n                    textDecoration: 'none',\n                    display: 'flex',\n                    flexDirection: 'column',\n                    gap: '0.5rem',\n                    flex: '1',\n                    minWidth: '250px',\n                    padding: '24px',\n                    marginBottom: 0,\n                    border: '1px solid rgba(255, 255, 255, 0.08)'\n                }}>\n                    <h3 style={{ color: '#c084fc', fontSize: '1.25rem', margin: 0, fontWeight: 'bold' }}>Flight & Schedule Manager</h3>\n                    <p style={{ color: 'rgba(255, 255, 255, 0.6)', fontSize: '0.9rem', margin: 0 }}>\n                        Create recurring schedules, automatically generate daily occurrences, and monitor/update live statuses.\n                    </p>\n                </Link>\n            </div>\n\n            {/* Recent Bookings List */}\n            <div className=\"admin-card\">\n                <h2 style={{ fontSize: '1.5rem', margin: '0 0 1rem 0', color: '#c084fc', borderBottom: '1px solid rgba(255, 255, 255, 0.08)', paddingBottom: '8px' }}>\n                    Recent Bookings\n                </h2>\n                <div style={{ overflowX: 'auto' }}>\n                    <table style={{ width: '100%', borderCollapse: 'collapse', textAlign: 'left' }}>\n                        <thead>\n                            <tr style={{ borderBottom: '2px solid rgba(255, 255, 255, 0.08)' }}>\n                                <th style={{ padding: '8px 12px', color: '#a78bfa', fontSize: '0.85rem', textTransform: 'uppercase' }}>User</th>\n                                <th style={{ padding: '8px 12px', color: '#a78bfa', fontSize: '0.85rem', textTransform: 'uppercase' }}>Flight</th>\n                                <th style={{ padding: '8px 12px', color: '#a78bfa', fontSize: '0.85rem', textTransform: 'uppercase' }}>Route</th>\n                                <th style={{ padding: '8px 12px', color: '#a78bfa', fontSize: '0.85rem', textTransform: 'uppercase' }}>Date</th>\n                            </tr>\n                        </thead>\n                        <tbody>\n                            {recentBookings.map((booking) => {\n                                const flight = outboundFlight({ ...booking, legs: booking.legs.map(withLegRouteLabels) });\n                                return (\n                                    <tr key={booking.id} style={{ borderBottom: '1px solid rgba(255, 255, 255, 0.04)' }}>\n                                        <td style={{ padding: '12px', fontSize: '0.9rem', color: '#fff' }}>\n                                            {booking.user?.name || booking.user?.email || 'Guest'}\n                                        </td>\n                                        <td style={{ padding: '12px', fontSize: '0.9rem', color: '#fff' }}>\n                                            {flight ? `${flight.airline} ${flight.flightNumber}` : '—'}\n                                        </td>\n                                        <td style={{ padding: '12px', fontSize: '0.9rem', color: '#fff' }}>\n                                            {flight ? `${flight.from} → ${flight.to}` : '—'}\n                                        </td>\n                                        <td style={{ padding: '12px', fontSize: '0.9rem', color: 'rgba(255, 255, 255, 0.6)' }}>\n                                            {new Date(booking.createdAt).toLocaleDateString()}\n                                        </td>\n                                    </tr>\n                                );\n                            })}\n                            {recentBookings.length === 0 && (\n                                <tr>\n                                    <td colSpan={4} style={{ padding: '24px', textAlign: 'center', color: 'rgba(255, 255, 255, 0.4)' }}>\n                                        No recent bookings.\n                                    </td>\n                                </tr>\n                            )}\n                        </tbody>\n                    </table>\n                </div>\n            </div>\n        </div>\n    );\n}\nimport React from 'react';\nimport { prisma } from '@/lib/prisma';\nimport Link from 'next/link';\n\nexport const dynamic = 'force-dynamic';\n\nexport default async function AdminUsersPage() {\n    const users = await prisma.user.findMany({\n        orderBy: { email: 'asc' },\n        select: {\n            id: true,\n            name: true,\n            email: true,\n            role: true,\n            _count: { select: { bookings: true, reviews: true, favorites: true } }\n        }\n    });\n\n    return (\n        <div className=\"page-container p-8\" style={{ marginTop: '100px' }}>\n            <div className=\"flex justify-between items-center mb-6\">\n                <h1 className=\"text-3xl font-bold\">Manage Users</h1>\n                <Link href=\"/admin\" className=\"text-blue-600 hover:underline\">← Back to Dashboard</Link>\n            </div>\n\n            <div className=\"bg-white rounded-lg shadow-md border border-gray-200 overflow-hidden\">\n                <div className=\"p-0\">\n                    <table className=\"min-w-full divide-y divide-gray-200\" style={{ width: '100%', textAlign: 'left', borderCollapse: 'collapse' }}>\n                        <thead className=\"bg-gray-50\">\n                            <tr>\n                                <th className=\"px-6 py-3 text-xs font-medium text-gray-500 uppercase tracking-wider border-b\">Name</th>\n                                <th className=\"px-6 py-3 text-xs font-medium text-gray-500 uppercase tracking-wider border-b\">Email</th>\n                                <th className=\"px-6 py-3 text-xs font-medium text-gray-500 uppercase tracking-wider border-b\">Role</th>\n                                <th className=\"px-6 py-3 text-xs font-medium text-gray-500 uppercase tracking-wider border-b\">Bookings</th>\n                                <th className=\"px-6 py-3 text-xs font-medium text-gray-500 uppercase tracking-wider border-b\">Reviews</th>\n                                <th className=\"px-6 py-3 text-xs font-medium text-gray-500 uppercase tracking-wider border-b\">Favorites</th>\n                            </tr>\n                        </thead>\n                        <tbody className=\"bg-white divide-y divide-gray-200\">\n                            {users.map((user) => (\n                                <tr key={user.id}>\n                                    <td className=\"px-6 py-4 whitespace-nowrap text-sm text-gray-900 border-b\">{user.name || 'N/A'}</td>\n                                    <td className=\"px-6 py-4 whitespace-nowrap text-sm text-gray-500 border-b\">{user.email}</td>\n                                    <td className=\"px-6 py-4 whitespace-nowrap text-sm text-gray-500 border-b\">\n                                        <span className={`px-2 py-1 rounded text-xs font-semibold ${user.role === 'ADMIN' ? 'bg-purple-100 text-purple-700' : 'bg-gray-100 text-gray-700'}`}>\n                                            {user.role}\n                                        </span>\n                                    </td>\n                                    <td className=\"px-6 py-4 whitespace-nowrap text-sm text-gray-500 border-b\">{user._count.bookings}</td>\n                                    <td className=\"px-6 py-4 whitespace-nowrap text-sm text-gray-500 border-b\">{user._count.reviews}</td>\n                                    <td className=\"px-6 py-4 whitespace-nowrap text-sm text-gray-500 border-b\">{user._count.favorites}</td>\n                                </tr>\n                            ))}\n                        </tbody>\n                    </table>\n                </div>\n            </div>\n        </div>\n    );\n}\nimport type { PaymentStateProvider } from '@/lib/stripePaymentProvider';\nimport type { VerifiedPaymentWebhookEvent } from '@/lib/stripeWebhook';\nimport { prisma } from '@/lib/prisma';\nimport { lockPaymentIntentForUpdate } from '@/lib/paymentIntentLock';\n\nexport interface PaymentWebhookReconciler {\n    reconcile(event: VerifiedPaymentWebhookEvent): Promise<void>;\n}\n\nexport class PaymentWebhookService implements PaymentWebhookReconciler {\n    constructor(private readonly provider: PaymentStateProvider) {}\n\n    async reconcile(event: VerifiedPaymentWebhookEvent): Promise<void> {\n        await prisma.$transaction(async tx => {\n            await lockPaymentIntentForUpdate(tx, event.providerIntentId);\n\n            const duplicate = await tx.paymentWebhookEvent.findUnique({\n                where: { id: event.eventId },\n                select: { id: true },\n            });\n            if (duplicate) return;\n\n            const state = await this.provider.retrievePaymentState(event.providerIntentId);\n            if (state.providerIntentId !== event.providerIntentId) {\n                throw new Error(\n                    'Stripe webhook PaymentIntent did not match the retrieved intent.',\n                );\n            }\n            if (!state.paymentAttemptId) {\n                throw new Error('Stripe PaymentIntent has no local payment attempt metadata.');\n            }\n\n            const [attempt, existingBinding] = await Promise.all([\n                tx.paymentAttempt.findUnique({ where: { id: state.paymentAttemptId } }),\n                tx.paymentAttempt.findUnique({\n                    where: { providerIntentId: event.providerIntentId },\n                    select: { id: true },\n                }),\n            ]);\n            if (!attempt) {\n                throw new Error('Payment attempt not found for Stripe webhook.');\n            }\n            if (\n                (attempt.providerIntentId && attempt.providerIntentId !== event.providerIntentId)\n                || (existingBinding && existingBinding.id !== attempt.id)\n            ) {\n                throw new Error('Stripe PaymentIntent is bound to a different payment attempt.');\n            }\n\n            await tx.paymentAttempt.update({\n                where: { id: attempt.id },\n                data: {\n                    providerIntentId: event.providerIntentId,\n                    status: state.status,\n                },\n            });\n            await tx.paymentWebhookEvent.create({\n                data: {\n                    id: event.eventId,\n                    eventType: event.eventType,\n                    providerIntentId: event.providerIntentId,\n                    paymentAttemptId: attempt.id,\n                },\n            });\n        }, { maxWait: 5_000, timeout: 15_000 });\n    }\n}\nimport { randomUUID } from 'node:crypto';\nimport { prisma } from '@/lib/prisma';\nimport type {\n    PaymentRefundState,\n    PaymentRefundStatus,\n    RefundProvider,\n} from '@/lib/stripePaymentProvider';\n\ninterface RefundSettlement {\n    status: PaymentRefundStatus;\n    wasSubmitted: boolean;\n}\n\nconst RETRYABLE_TERMINAL = new Set<PaymentRefundStatus>(['FAILED', 'CANCELLED']);\nconst PROVIDER_TERMINAL: PaymentRefundStatus[] = ['SUCCEEDED', 'FAILED', 'CANCELLED'];\n\nexport class PaymentRefundService {\n    constructor(private readonly provider: RefundProvider) {}\n\n    async settleRefund(refundId: string): Promise<RefundSettlement> {\n        const prepared = await prisma.$transaction(async tx => {\n            await tx.$executeRaw`SELECT pg_advisory_xact_lock(hashtext(${refundId}))`;\n            const refund = await tx.paymentRefund.findUniqueOrThrow({\n                where: { id: refundId },\n                include: {\n                    bookingStatusChange: { include: { booking: true } },\n                    attempts: { orderBy: { sequence: 'desc' }, take: 1 },\n                },\n            });\n            const change = refund.bookingStatusChange;\n            if (\n                change.to !== 'CANCELLED'\n                || change.refundCents !== refund.amountCents\n                || change.booking.paymentIntentId !== refund.providerIntentId\n                || change.booking.currency !== refund.currency\n            ) {\n                throw new Error('Refund does not match the cancelled booking payment.');\n            }\n            if (refund.status === 'SUCCEEDED') return { refund, attempt: null };\n\n            const current = refund.attempts[0];\n            const attempt = !current || RETRYABLE_TERMINAL.has(current.status)\n                ? await tx.paymentRefundAttempt.create({\n                    data: { id: randomUUID(), paymentRefundId: refund.id },\n                })\n                : current;\n            return { refund, attempt };\n        });\n\n        if (!prepared.attempt) return { status: 'SUCCEEDED', wasSubmitted: false };\n\n        const { refund, attempt } = prepared;\n        let state: PaymentRefundState | null;\n        let wasSubmitted = false;\n        if (attempt.providerRefundId) {\n            state = await this.provider.retrieveRefund(attempt.providerRefundId);\n        } else {\n            const lookup = {\n                refundId: refund.id,\n                refundAttemptId: attempt.id,\n                providerIntentId: refund.providerIntentId,\n            };\n            state = await this.provider.findRefund(lookup);\n            if (!state) {\n                try {\n                    wasSubmitted = true;\n                    state = await this.provider.createRefund({\n                        ...lookup,\n                        amountCents: refund.amountCents,\n                    });\n                } catch (error) {\n                    state = await this.provider.findRefund(lookup);\n                    if (!state) throw error;\n                }\n            }\n        }\n\n        if (\n            state.paymentRefundId !== refund.id\n            || state.refundAttemptId !== attempt.id\n            || (\n                attempt.providerRefundId !== null\n                && state.providerRefundId !== attempt.providerRefundId\n            )\n        ) {\n            throw new Error('Stripe refund metadata does not match the durable refund attempt.');\n        }\n\n        const persistedStatus = await prisma.$transaction(async tx => {\n            // A provider call cannot hold a database transaction open, so a\n            // concurrent reconciliation can finish while this response is in\n            // flight. The conditional write takes the attempt row lock and is\n            // re-evaluated after a concurrent writer commits, so an older\n            // non-terminal response cannot overwrite a terminal provider\n            // result made durable by that other call.\n            const updated = await tx.paymentRefundAttempt.updateMany({\n                where: {\n                    id: attempt.id,\n                    status: { notIn: PROVIDER_TERMINAL },\n                    OR: [\n                        { providerRefundId: null },\n                        { providerRefundId: state.providerRefundId },\n                    ],\n                },\n                data: {\n                    providerRefundId: state.providerRefundId,\n                    status: state.status,\n                },\n            });\n            if (updated.count === 0) {\n                const current = await tx.paymentRefundAttempt.findUniqueOrThrow({\n                    where: { id: attempt.id },\n                });\n                if (PROVIDER_TERMINAL.includes(current.status)) return current.status;\n                throw new Error('Stripe refund metadata does not match the durable refund attempt.');\n            }\n            await tx.paymentRefund.update({\n                where: { id: refund.id },\n                data: { status: state.status },\n            });\n            return state.status;\n        });\n\n        return { status: persistedStatus, wasSubmitted };\n    }\n}\n\nenum PaymentRefundStatus {\n  PENDING\n  REQUIRES_ACTION\n  SUCCEEDED\n  FAILED\n  CANCELLED\n}\n\n/// Safe server-side payment metadata for one checkout.\n///\n/// Card details stay in Stripe Elements, and even the PaymentIntent client\n/// secret is deliberately not stored here. The request fingerprint binds a\n/// checkout UUID to the itinerary, seats and cabins that produced its quote.\nmodel PaymentAttempt {\n  id                   String               @id\n  checkoutId           String\n  userId               String?\n  user                 User?                @relation(fields: [userId], references: [id], onDelete: SetNull)\n  requestFingerprint   String\n  amountCents          Int\n  currency             String               @default(\"USD\")\n  providerIntentId     String?              @unique\n  status               PaymentAttemptStatus @default(CREATING)\n  capturedAt           DateTime?\n  createdAt            DateTime             @default(now())\n  updatedAt            DateTime             @updatedAt\n  webhookEvents        PaymentWebhookEvent[]\n\n  @@unique([userId, checkoutId])\n  @@index([status, updatedAt])\n}\n\n/// One successfully reconciled Stripe event.\n///\n/// The raw webhook body is deliberately absent: it may contain customer and\n/// payment-provider data that is unnecessary after signature verification.\nmodel PaymentWebhookEvent {\n  id                 String         @id\n  eventType          String\n  providerIntentId   String\n  paymentAttemptId   String\n  paymentAttempt     PaymentAttempt @relation(fields: [paymentAttemptId], references: [id], onDelete: Cascade)\n  createdAt          DateTime       @default(now())\n\n  @@index([providerIntentId])\n  @@index([paymentAttemptId])\n}\n\nmodel Booking {\n  id              Int           @id @default(autoincrement())\n  createdAt       DateTime      @default(now())\n  status          BookingStatus @default(CONFIRMED)\n  paymentIntentId String?       @unique\n  /// The booking total in minor units. Null for bookings taken before this\n  /// column existed, which fall back to the flight's catalogue price.\n  totalPriceCents Int?\n  currency        String        @default(\"USD\")\n  idempotencyKey  String?\n\n  userId String?\n  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)\n\n  passengers    Passenger[]\n  legs          ItineraryLeg[]\n  statusChanges BookingStatusChange[]\n\n  @@unique([userId, idempotencyKey])\n}\n\n/// One move between booking states, and the only record of the ones a booking\n/// is no longer in.\n///\n/// Append-only, enforced by a trigger rather than by convention: cancellation,\n/// disruption and refunds all have to be auditable, and a table that reaches\n/// this state only while every caller cooperates is not an audit trail (#76).\n/// Rows go when their booking goes -- the history of a booking that does not\n/// exist has no subject, and blocking that cascade would make a booking\n/// undeletable.\nmodel BookingStatusChange {\n  id          String         @id @default(cuid())\n  bookingId   Int\n  booking     Booking        @relation(fields: [bookingId], references: [id], onDelete: Cascade)\n  /// Null for the row that records the booking coming into existence.\n  from        BookingStatus?\n  to          BookingStatus\n  reason      String?\n  /// What this change owed the customer back, in minor units. Null where the\n  /// change did not refund; zero is a different and real answer, since a\n  /// cancellation inside the cut-off refunds nothing (#76).\n  refundCents Int?\n  /// Orders changes made in the same transaction, which `createdAt` cannot:\n  /// it is transaction start time, so two changes there share an instant.\n  /// A `BigInt` in the client, so a row handed straight to a client component\n  /// fails to serialise -- select what you need rather than the whole row.\n  sequence    BigInt         @default(autoincrement())\n  /// Who caused it. Null for a customer acting on their own booking, and for a\n  /// change nothing attributes.\n  actorUserId String?\n  actor       User?          @relation(fields: [actorUserId], references: [id], onDelete: SetNull)\n  paymentRefund PaymentRefund?\n  createdAt   DateTime       @default(now())\n\n  @@index([bookingId, createdAt])\n  @@index([bookingId, sequence])\n}\n\n/// One provider refund for the exact amount recorded by a cancellation.\n///\n/// The immutable status-change row remains the policy decision; this row is\n/// the durable delivery state used to make Stripe retries idempotent without\n/// retaining provider payloads or customer payment data.\nmodel PaymentRefund {\n  id                    String              @id @default(cuid())\n  bookingStatusChangeId String              @unique\n  bookingStatusChange   BookingStatusChange @relation(fields: [bookingStatusChangeId], references: [id], onDelete: Cascade)\n  providerIntentId      String\n  amountCents           Int\n  currency              String              @default(\"USD\")\n  status                PaymentRefundStatus @default(PENDING)\n  attempts              PaymentRefundAttempt[]\n  createdAt             DateTime            @default(now())\n  updatedAt             DateTime            @updatedAt\n\n  @@index([providerIntentId])\n  @@index([status, updatedAt])\n}\n\n/// One durable provider submission. A terminally failed attempt is retained;\n/// a retry creates another row and therefore another stable idempotency key.\nmodel PaymentRefundAttempt {\n  id               String              @id\n  paymentRefundId  String\n  paymentRefund    PaymentRefund       @relation(fields: [paymentRefundId], references: [id], onDelete: Cascade)\n  providerRefundId String?             @unique\n  status           PaymentRefundStatus @default(PENDING)\n  sequence         BigInt              @default(autoincrement())\n  createdAt        DateTime            @default(now())\n  updatedAt        DateTime            @updatedAt\n\n  @@index([paymentRefundId, sequence])\n}\n\nmodel Passenger {\n  id                      String    @id @default(cuid())\n  firstName               String\n  lastName                String\n  dateOfBirthEncrypted    String?   @db.Text\n  passportNumberEncrypted String?   @db.Text\n  sensitiveDataExpiresAt  DateTime?\n  sensitiveDataDeletedAt  DateTime?\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a008d3-a8d1-70b1-a975-44bf5aea121d"}}}
