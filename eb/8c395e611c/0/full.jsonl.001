ached to the booking after a rebooking. Filter them\n+ * here as a final product-code guard, then sort rather than trusting the query:\n+ * a caller that forgets either database clause must not render two flights at\n+ * the same itinerary position or put the return first.\n  */\n-export function orderedLegs<TLeg extends { sequence: number }>(\n+export function orderedLegs<TLeg extends {\n+    sequence: number;\n+    supersededAt?: Date | string | null;\n+}>(\n     booking: { legs: TLeg[] }\n ): TLeg[] {\n-    return [...booking.legs].sort((left, right) => left.sequence - right.sequence);\n+    return booking.legs\n+        .filter(leg => leg.supersededAt === undefined || leg.supersededAt === null)\n+        .sort((left, right) => left.sequence - right.sequence);\n }\n \n /**\ndiff --git a/prisma/schema.prisma b/prisma/schema.prisma\nindex fcc70f5..1473f05 100644\n--- a/prisma/schema.prisma\n+++ b/prisma/schema.prisma\n@@ -107,6 +107,13 @@ enum BookingStatus {\n   DISRUPTED\n }\n \n+/// An airline-caused replacement keeps the original captured fare. The\n+/// replacement may catalogue higher or lower, but neither an extra charge nor\n+/// a partial refund is created: the customer can still choose the full refund.\n+enum RebookingFarePolicy {\n+  DISRUPTION_WAIVER\n+}\n+\n /// The provider state of one checkout's payment session.\n ///\n /// `CREATING` closes the crash window between reserving a durable attempt and\n@@ -137,19 +144,19 @@ enum PaymentRefundStatus {\n /// secret is deliberately not stored here. The request fingerprint binds a\n /// checkout UUID to the itinerary, seats and cabins that produced its quote.\n model PaymentAttempt {\n-  id                   String               @id\n-  checkoutId           String\n-  userId               String?\n-  user                 User?                @relation(fields: [userId], references: [id], onDelete: SetNull)\n-  requestFingerprint   String\n-  amountCents          Int\n-  currency             String               @default(\"USD\")\n-  providerIntentId     String?              @unique\n-  status               PaymentAttemptStatus @default(CREATING)\n-  capturedAt           DateTime?\n-  createdAt            DateTime             @default(now())\n-  updatedAt            DateTime             @updatedAt\n-  webhookEvents        PaymentWebhookEvent[]\n+  id                 String                @id\n+  checkoutId         String\n+  userId             String?\n+  user               User?                 @relation(fields: [userId], references: [id], onDelete: SetNull)\n+  requestFingerprint String\n+  amountCents        Int\n+  currency           String                @default(\"USD\")\n+  providerIntentId   String?               @unique\n+  status             PaymentAttemptStatus  @default(CREATING)\n+  capturedAt         DateTime?\n+  createdAt          DateTime              @default(now())\n+  updatedAt          DateTime              @updatedAt\n+  webhookEvents      PaymentWebhookEvent[]\n \n   @@unique([userId, checkoutId])\n   @@index([status, updatedAt])\n@@ -160,12 +167,12 @@ model PaymentAttempt {\n /// The raw webhook body is deliberately absent: it may contain customer and\n /// payment-provider data that is unnecessary after signature verification.\n model PaymentWebhookEvent {\n-  id                 String         @id\n-  eventType          String\n-  providerIntentId   String\n-  paymentAttemptId   String\n-  paymentAttempt     PaymentAttempt @relation(fields: [paymentAttemptId], references: [id], onDelete: Cascade)\n-  createdAt          DateTime       @default(now())\n+  id               String         @id\n+  eventType        String\n+  providerIntentId String\n+  paymentAttemptId String\n+  paymentAttempt   PaymentAttempt @relation(fields: [paymentAttemptId], references: [id], onDelete: Cascade)\n+  createdAt        DateTime       @default(now())\n \n   @@index([providerIntentId])\n   @@index([paymentAttemptId])\n@@ -188,6 +195,7 @@ model Booking {\n   passengers    Passenger[]\n   legs          ItineraryLeg[]\n   statusChanges BookingStatusChange[]\n+  rebookings    BookingRebooking[]\n \n   @@unique([userId, idempotencyKey])\n }\n@@ -202,49 +210,81 @@ model Booking {\n /// exist has no subject, and blocking that cascade would make a booking\n /// undeletable.\n model BookingStatusChange {\n-  id          String         @id @default(cuid())\n-  bookingId   Int\n-  booking     Booking        @relation(fields: [bookingId], references: [id], onDelete: Cascade)\n+  id            String            @id @default(cuid())\n+  bookingId     Int\n+  booking       Booking           @relation(fields: [bookingId], references: [id], onDelete: Cascade)\n   /// Null for the row that records the booking coming into existence.\n-  from        BookingStatus?\n-  to          BookingStatus\n-  reason      String?\n+  from          BookingStatus?\n+  to            BookingStatus\n+  reason        String?\n   /// What this change owed the customer back, in minor units. Null where the\n   /// change did not refund; zero is a different and real answer, since a\n   /// cancellation inside the cut-off refunds nothing (#76).\n-  refundCents Int?\n+  refundCents   Int?\n   /// Orders changes made in the same transaction, which `createdAt` cannot:\n   /// it is transaction start time, so two changes there share an instant.\n   /// A `BigInt` in the client, so a row handed straight to a client component\n   /// fails to serialise -- select what you need rather than the whole row.\n-  sequence    BigInt         @default(autoincrement())\n+  sequence      BigInt            @default(autoincrement())\n   /// Who caused it. Null for a customer acting on their own booking, and for a\n   /// change nothing attributes.\n-  actorUserId String?\n-  actor       User?          @relation(fields: [actorUserId], references: [id], onDelete: SetNull)\n+  actorUserId   String?\n+  actor         User?             @relation(fields: [actorUserId], references: [id], onDelete: SetNull)\n   paymentRefund PaymentRefund?\n-  createdAt   DateTime       @default(now())\n+  rebooking     BookingRebooking?\n+  createdAt     DateTime          @default(now())\n \n   @@index([bookingId, createdAt])\n   @@index([bookingId, sequence])\n }\n \n+/// The immutable audit event for replacing one or more disrupted itinerary\n+/// legs while retaining the booking, passengers, reference and captured fare.\n+/// The status change records the customer-visible DISRUPTED -> CONFIRMED move;\n+/// this row records why it happened and which legs replaced which.\n+model BookingRebooking {\n+  id                    String                @id @default(cuid())\n+  bookingId             Int\n+  booking               Booking               @relation(fields: [bookingId], references: [id], onDelete: Cascade)\n+  bookingStatusChangeId String                @unique\n+  bookingStatusChange   BookingStatusChange   @relation(fields: [bookingStatusChangeId], references: [id], onDelete: NoAction)\n+  farePolicy            RebookingFarePolicy   @default(DISRUPTION_WAIVER)\n+  legs                  BookingRebookingLeg[]\n+  createdAt             DateTime              @default(now())\n+\n+  @@index([bookingId, createdAt])\n+}\n+\n+/// One old-to-new leg mapping within a rebooking. PostgreSQL additionally\n+/// requires both legs to belong to the event's booking and occupy the same\n+/// itinerary position, with only the destination leg still active.\n+model BookingRebookingLeg {\n+  rebookingId String\n+  rebooking   BookingRebooking @relation(fields: [rebookingId], references: [id], onDelete: Cascade)\n+  fromLegId   Int              @unique\n+  fromLeg     ItineraryLeg     @relation(\"RebookingFromLeg\", fields: [fromLegId], references: [id], onDelete: NoAction)\n+  toLegId     Int              @unique\n+  toLeg       ItineraryLeg     @relation(\"RebookingToLeg\", fields: [toLegId], references: [id], onDelete: NoAction)\n+\n+  @@id([rebookingId, fromLegId])\n+}\n+\n /// One provider refund for the exact amount recorded by a cancellation.\n ///\n /// The immutable status-change row remains the policy decision; this row is\n /// the durable delivery state used to make Stripe retries idempotent without\n /// retaining provider payloads or customer payment data.\n model PaymentRefund {\n-  id                    String              @id @default(cuid())\n-  bookingStatusChangeId String              @unique\n-  bookingStatusChange   BookingStatusChange @relation(fields: [bookingStatusChangeId], references: [id], onDelete: Cascade)\n+  id                    String                 @id @default(cuid())\n+  bookingStatusChangeId String                 @unique\n+  bookingStatusChange   BookingStatusChange    @relation(fields: [bookingStatusChangeId], references: [id], onDelete: Cascade)\n   providerIntentId      String\n   amountCents           Int\n-  currency              String              @default(\"USD\")\n-  status                PaymentRefundStatus @default(PENDING)\n+  currency              String                 @default(\"USD\")\n+  status                PaymentRefundStatus    @default(PENDING)\n   attempts              PaymentRefundAttempt[]\n-  createdAt             DateTime            @default(now())\n-  updatedAt             DateTime            @updatedAt\n+  createdAt             DateTime               @default(now())\n+  updatedAt             DateTime               @updatedAt\n \n   @@index([providerIntentId])\n   @@index([status, updatedAt])\n@@ -425,13 +465,23 @@ model ItineraryLeg {\n   flightId  Int\n   flight    Flight  @relation(fields: [flightId], references: [id])\n \n-  seatAssignments SeatAssignment[]\n+  /// Set once this position is replaced. Historical legs and their released\n+  /// seats stay attached to the booking; every current reader selects only\n+  /// rows where this is null.\n+  supersededAt DateTime?\n+\n+  seatAssignments       SeatAssignment[]\n+  rebookingOrigins      BookingRebookingLeg[] @relation(\"RebookingFromLeg\")\n+  rebookingDestinations BookingRebookingLeg[] @relation(\"RebookingToLeg\")\n \n-  @@unique([bookingId, sequence])\n+  /// The one-active-leg-per-position rule is a partial unique index where\n+  /// supersededAt IS NULL, which Prisma cannot express. The rebooking\n+  /// migration creates it and replaces the former unconditional unique key.\n   /// Lets a seat assignment reference (legId, flightId) together, so its\n   /// denormalised flightId can never disagree with the leg's flight.\n   @@unique([id, flightId])\n   @@index([flightId])\n+  @@index([bookingId, supersededAt, sequence])\n }\n \n /// The cabins the airline sells.\nlib/FlightBookingService.ts:139:                    legs: {\nlib/FlightBookingService.ts:293:                    legs: {\nlib/FlightBookingService.ts:307:                    legs: {\napp/actions.ts:664:            legs: {\napp/actions.ts:714:                legs: {\napp/actions.ts:874:            legs: {\napp/actions.ts:1426:                legs: {\nlib/bookingItinerary.ts:10: *     include: { legs: { include: { flight: true }, orderBy: { sequence: 'asc' } } }\napp/profile/page.tsx:40:      legs: {\napp/admin/page.tsx:25:            legs: {\nlib/cancellationPolicy.ts:155:    const flownLegs = booking.legs.filter(leg => leg.flight !== null);\nlib/bookingItinerary.ts:39:    return booking.legs\napp/actions.ts:890:    const legsById = new Map(booking.legs.map(leg => [leg.id, leg]));\napp/actions.ts:1437:            const grounded = booking.legs.some(leg => leg.flight?.status === 'CANCELLED');\napp/actions.ts:1442:            const grounded = booking.legs.some(leg => leg.flight?.status === 'CANCELLED');\napp/actions.ts:1463:                    const stillGrounded = booking.legs.some(\nlib/FlightBookingService.ts:318:                data: booking.legs.flatMap((leg, legIndex) => (\napp/admin/page.tsx:122:                                const flight = outboundFlight({ ...booking, legs: booking.legs.map(withLegRouteLabels) });\napp/admin/flights/page.tsx:34:            itineraryLegs: {\napp/admin/flights/page.tsx:66:    const flightsWithBookings = flights.map(({ itineraryLegs, ...flight }) => ({\napp/admin/flights/page.tsx:68:        bookings: itineraryLegs.map((leg) => ({\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a00bba-29dd-7100-8715-811d18e7c7e1"}}}
