\"PaymentRefund\" (\n    26\t    \"id\"                    TEXT NOT NULL,\n    27\t    \"bookingStatusChangeId\" TEXT NOT NULL,\n    28\t    \"providerIntentId\"      TEXT NOT NULL,\n    29\t    \"amountCents\"           INTEGER NOT NULL,\n    30\t    \"currency\"              TEXT NOT NULL DEFAULT 'USD',\n    31\t    \"status\"                \"PaymentRefundStatus\" NOT NULL DEFAULT 'PENDING',\n    32\t    \"createdAt\"             TIMESTAMP(3) NOT NULL DEFAULT CURRENT_TIMESTAMP,\n    33\t    \"updatedAt\"             TIMESTAMP(3) NOT NULL,\n    34\t\n    35\t    CONSTRAINT \"PaymentRefund_pkey\" PRIMARY KEY (\"id\"),\n    36\t    CONSTRAINT \"PaymentRefund_positive_amount\" CHECK (\"amountCents\" > 0),\n    37\t    CONSTRAINT \"PaymentRefund_nonempty_provider_intent\"\n    38\t        CHECK (length(btrim(\"providerIntentId\")) > 0),\n    39\t    CONSTRAINT \"PaymentRefund_currency_format\"\n    40\t        CHECK (\"currency\" ~ '^[A-Z]{3}$')\n    41\t);\n    42\t\n    43\tCREATE UNIQUE INDEX \"PaymentRefund_bookingStatusChangeId_key\"\n    44\t    ON \"PaymentRefund\"(\"bookingStatusChangeId\");\n    45\tCREATE INDEX \"PaymentRefund_providerIntentId_idx\"\n    46\t    ON \"PaymentRefund\"(\"providerIntentId\");\n    47\tCREATE INDEX \"PaymentRefund_status_updatedAt_idx\"\n    48\t    ON \"PaymentRefund\"(\"status\", \"updatedAt\");\n    49\t\n    50\tALTER TABLE \"PaymentRefund\"\n    51\t    ADD CONSTRAINT \"PaymentRefund_bookingStatusChangeId_fkey\"\n    52\t    FOREIGN KEY (\"bookingStatusChangeId\") REFERENCES \"BookingStatusChange\"(\"id\")\n    53\t    ON DELETE CASCADE ON UPDATE CASCADE;\n    54\t\n    55\tCREATE TABLE \"PaymentRefundAttempt\" (\n    56\t    \"id\"               TEXT NOT NULL,\n    57\t    \"paymentRefundId\"  TEXT NOT NULL,\n    58\t    \"providerRefundId\" TEXT,\n    59\t    \"status\"           \"PaymentRefundStatus\" NOT NULL DEFAULT 'PENDING',\n    60\t    \"sequence\"         BIGSERIAL NOT NULL,\n    61\t    \"createdAt\"        TIMES