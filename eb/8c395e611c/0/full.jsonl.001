T JOIN \"User\" AS customer ON customer.\"id\" = attempt.\"userId\"\n    41\t        WHERE attempt.\"providerIntentId\" IS NOT NULL\n    42\t          AND attempt.\"status\" NOT IN ('CAPTURED', 'CANCELLED')\n    43\t          AND attempt.\"updatedAt\" <= statement_timestamp()\n    44\t              - make_interval(mins => ${HOLD_MINUTES}::int)\n    45\t        ORDER BY attempt.\"updatedAt\" ASC, attempt.\"id\" ASC\n    46\t        LIMIT ${PAYMENT_RECOVERY_LIMIT}\n    47\t    `;\n    48\t}\n    20\t    tx: Prisma.TransactionClient,\n    21\t    provider: PaymentStateProvider,\n    22\t    providerIntentId: string,\n    23\t    expectedAttemptId?: string,\n    24\t): Promise<PaymentAttemptReconciliationResult> {\n    25\t    const state = await provider.retrievePaymentState(providerIntentId);\n    26\t    if (state.providerIntentId !== providerIntentId) {\n    27\t        throw new Error(\n    28\t            'Stripe webhook PaymentIntent did not match the retrieved intent.',\n    29\t        );\n    30\t    }\n    31\t    if (!state.paymentAttemptId) {\n    32\t        throw new Error('Stripe PaymentIntent has no local payment attempt metadata.');\n    33\t    }\n    34\t    if (expectedAttemptId && state.paymentAttemptId !== expectedAttemptId) {\n    35\t        throw new Error('Stripe PaymentIntent is bound to a different payment attempt.');\n    36\t    }\n    37\t    const [attempt, existingBinding] = await Promise.all([\n    38\t        tx.paymentAttempt.findUnique({ where: { id: state.paymentAttemptId } }),\n    39\t        tx.paymentAttempt.findUnique({\n    40\t            where: { providerIntentId },\n    41\t            select: { id: true },\n    42\t        }),\n    43\t    ]);\n    44\t    if (!attempt) {\n    45\t        throw new Error('Payment attempt not found for Stripe webhook.');\n    46\t    }\n    47\t    if (\n    48\t        (attempt.providerIntentId && attempt.providerIntentId !== providerIntentId)\n    49\t        || (existingBinding && existingBinding.id !== attempt.id)\n    50\t    ) {\n    51\t        throw new Error('Stripe PaymentIntent is bound to a different payment attempt.');\n    52\t    }\n    53\t\n    54\t    const updated = await tx.paymentAttempt.update({\n    55\t        where: { id: attempt.id },\n    56\t        data: {\n    57\t            providerIntentId,\n    58\t            status: state.status,\n    59\t        },\n    60\t    });\n    61\t    return {\n    62\t        attemptId: attempt.id,\n    63\t        previousStatus: attempt.status,\n    64\t        status: state.status,\n    65\t        changed: attempt.status !== state.status,\n    66\t        updatedAt: updated.updatedAt,\n    67\t    };\n    68\t}\n    69\t\n    70\t/**\n    71\t * Re-read one durable attempt from Stripe without fabricating a webhook event.\n    72\t *\n    73\t * Staff use this after an expected webhook or provider response is missing.\n    74\t * The provider intent lock is shared with checkout and webhook processing, so\n    75\t * an older read cannot overwrite a newer result that is still in flight.\n    76\t */\n    77\texport class PaymentAttemptReconciliationService {\n    78\t    constructor(private readonly provider: PaymentStateProvider) {}\n    79\t\n    80\t    async reconcileAttempt(attemptId: string): Promise<PaymentAttemptReconciliationResult> {\n    81\t        const initial = await prisma.paymentAttempt.findUnique({\n    82\t            where: { id: attemptId },\n    83\t            select: { providerIntentId: true },\n    84\t        });\n    85\t        if (!initial?.providerIntentId) {\n    86\t            throw new Error('Payment attempt cannot be reconciled without a provider intent.');\n    87\t        }\n    88\t        const providerIntentId = initial.providerIntentId;\n    89\t\n    90\t        return prisma.$transaction(async tx => {\n    91\t            await lockPaymentIntentForUpdate(tx, providerIntentId);\n    92\t            const current = await tx.paymentAttempt.findUnique({\n    93\t                where: { id: attemptId },\n    94\t                select: { providerIntentId: true },\n    95\t            });\n    96\t            if (current?.providerIntentId !== providerIntentId) {\n    97\t                throw new Error('Payment attempt provider binding changed during reconciliation.');\n    98\t            }\n    99\t            return reconcilePaymentIntent(\n   100\t                tx,\n   101\t                this.provider,\n   102\t                providerIntentId,\n   103\t                attemptId,\n   104\t            );\n   105\t        }, { maxWait: 5_000, timeout: 15_000 });\n   466\t    }\n   467\t}\n   468\t\n   469\texport async function reconcilePaymentAttemptAction(paymentAttemptId: string) {\n   470\t    const session = await getServerSession(authOptions);\n   471\t    if (!hasVerifiedStaffAccess(session)) throw new Error('Unauthorized');\n   472\t\n   473\t    const parsed = parseActionInput(stringIdSchema, paymentAttemptId);\n   474\t    if (!parsed.ok) return parsed;\n   475\t\n   476\t    try {\n   477\t        const result = await new PaymentAttemptReconciliationService(\n   478\t            createStripePaymentProvider(),\n   479\t        ).reconcileAttempt(parsed.data);\n   480\t        revalidatePath('/admin/payments');\n   481\t        return {\n   482\t            ok: true as const,\n   483\t            ...result,\n   484\t            updatedAt: result.updatedAt.toISOString(),\n   485\t        };\n   486\t    } catch {\n   487\t        // Provider messages can include Stripe request details. Staff need a\n   488\t        // retryable outcome, while logs keep only the local identifier needed\n   489\t        // to investigate it.\n   490\t        console.error({\n   491\t            message: 'Staff payment reconciliation failed.',\n   492\t            paymentAttemptId: parsed.data,\n   493\t        });\n   494\t        return actionValidationFailure(\n   495\t            'Payment status could not be refreshed. Try again later.',\n   496\t            'paymentAttemptId',\n   497\t        );\n   498\t    }\n   499\t}\n   500\t\n   501\t/**\n   502\t * Which seats are taken on a flight, for the seat maps in checkout and in the\n   503\t * profile's seat change.\n   504\t *\n   505\t * Both of those routes are behind the middleware matcher, but a server action\n    42\t    const [pendingId, setPendingId] = useState<string | null>(null);\n    43\t    const [feedback, setFeedback] = useState<Feedback | null>(null);\n    44\t    const [, startTransition] = useTransition();\n    45\t    const feedbackRef = useRef<HTMLDivElement>(null);\n    46\t\n    47\t    useEffect(() => {\n    48\t        if (feedback) feedbackRef.current?.focus();\n    49\t    }, [feedback]);\n    50\t\n    51\t    const reconcile = (attemptId: string) => {\n    52\t        setFeedback(null);\n    53\t        setPendingId(attemptId);\n    54\t        startTransition(async () => {\n    55\t            try {\n    56\t                const result = await reconcilePaymentAttemptAction(attemptId);\n    57\t                if (isActionValidationFailure(result)) {\n    58\t                    setFeedback({ kind: 'error', message: result.error.message });\n    59\t                    return;\n    60\t                }\n    61\t\n    62\t                setAttempts(current => current.map(attempt => (\n    63\t                    attempt.id === result.attemptId\n    64\t                        ? { ...attempt, status: result.status, updatedAt: result.updatedAt }\n    65\t                        : attempt\n    66\t                )));\n    67\t                setFeedback({\n    68\t                    kind: 'success',\n    69\t                    message: result.changed\n    70\t                        ? `Payment status refreshed from ${result.previousStatus} to ${result.status}.`\n    71\t                        : `Payment status is still ${result.status}.`,\n    72\t                });\n    73\t            } catch {\n    74\t                setFeedback({\n    75\t                    kind: 'error',\n    76\t                    message: 'Payment status could not be refreshed. Try again later.',\n    77\t                });\n    78\t            } finally {\n    79\t                setPendingId(null);\n    80\t            }\n    81\t        });\n    82\t    };\n    83\t\n    84\t    return (\n    85\t        <section aria-labelledby=\"payment-recovery-heading\" className=\"admin-card\">\n    86\t            <h2 id=\"payment-recovery-heading\" style={{ marginTop: 0, color: '#c084fc' }}>\n    87\t                Stale payment attempts\n    88\t            </h2>\n    89\t            <p style={{ color: 'rgba(255, 255, 255, 0.72)' }}>\n    90\t                Provider-backed checkouts appear here after ten minutes without a local payment update.\n    91\t                Refreshing reads Stripe&apos;s current state; it does not charge or cancel the payment.\n    92\t            </p>\n    93\t\n    94\t            {feedback && (\n    95\t                <div\n    96\t                    ref={feedbackRef}\n    97\t                    role={feedback.kind === 'error' ? 'alert' : 'status'}\n    98\t                    tabIndex={-1}\n    99\t                    className={`payment-recovery-feedback payment-recovery-feedback--${feedback.kind}`}\n   100\t                >\n   101\t                    {feedback.message}\n   102\t                </div>\n   103\t            )}\n   104\t\n   105\t            {attempts.length === 0 ? (\n   106\t                <p style={{ color: 'rgba(255, 255, 255, 0.6)', marginBottom: 0 }}>\n   107\t                    No stale payment attempts need review.\n   108\t                </p>\n   109\t            ) : (\n   110\t                <div className=\"payment-recovery-list\">\n   111\t                    {attempts.map(attempt => {\n   112\t                        const isPending = pendingId === attempt.id;\n   113\t                        const isTerminal = TERMINAL_STATUSES.has(attempt.status);\n   114\t                        return (\n   115\t                            <article\n   116\t                                key={attempt.id}\n   117\t                                aria-label={`Payment attempt ${attempt.id}`}\n   118\t                                className=\"payment-recovery-card\"\n   119\t                            >\n   120\t                                <div className=\"payment-recovery-details\">\n   121\t                                    <div>\n   122\t                                        <span className=\"payment-recovery-label\">Customer</span>\n   123\t                                        <strong>{attempt.userName ?? 'Account unavailable'}</strong>\n   124\t                                        {attempt.userEmail && <span>{attempt.userEmail}</span>}\n   125\t                                    </div>\n   126\t                                    <div>\n   127\t                                        <span className=\"payment-recovery-label\">Amount</span>\n   128\t                                        <strong>{formatPrice(attempt.amountCents)} {attempt.currency}</strong>\n   129\t                                    </div>\n   130\t                                    <div>\n   131\t                                        <span className=\"payment-recovery-label\">Local status</span>\n   132\t                                        <strong>{attempt.status}</strong>\n   133\t                                    </div>\n   134\t                                    <div>\n   135\t                                        <span className=\"payment-recovery-label\">Last local update</span>\n   136\t                                        <span>{formattedUpdatedAt(attempt.updatedAt)} UTC</span>\n   137\t                                    </div>\n   138\t                                    <div>\n   139\t                                        <span className=\"payment-recovery-label\">Stripe intent</span>\n   140\t                                        <code>{attempt.providerIntentId}</code>\n   141\t                                    </div>\n   142\t                                    <div>\n   143\t                                        <span className=\"payment-recovery-label\">Checkout</span>\n   144\t                                        <code>{attempt.checkoutId}</code>\n   145\t                                    </div>\n   146\t                                </div>\n   147\t                                <button\n   148\t                                    type=\"button\"\n   149\t                                    onClick={() => reconcile(attempt.id)}\n   150\t                                    disabled={pendingId !== null || isTerminal}\n    24\t                    ← Admin control center\n    25\t                </Link>\n    26\t                <h1 style={{ color: '#fff', margin: '0.75rem 0 0' }}>\n    27\t                    Payment recovery\n    28\t                </h1>\n    29\t            </div>\n    30\t            <PaymentRecoveryQueue\n    31\t                initialAttempts={attempts.map(attempt => ({\n    32\t                    ...attempt,\n    33\t                    updatedAt: attempt.updatedAt.toISOString(),\n    34\t                }))}\n    35\t            />\n    36\t        </main>\n    37\t    );\n    38\t}\n  1232\t  background: rgba(239, 68, 68, 0.15);\n  1233\t  border: 1px solid rgba(239, 68, 68, 0.45);\n  1234\t  color: #fca5a5;\n  1235\t}\n  1236\t\n  1237\t.payment-recovery-feedback:focus {\n  1238\t  outline: 3px solid #fbbf24;\n  1239\t  outline-offset: 3px;\n  1240\t  box-shadow: 0 0 0 5px rgba(251, 191, 36, 0.28);\n  1241\t}\n  1242\t\n  1243\t.payment-recovery-list {\n  1244\t  display: grid;\n"},"started_at_ms":1786856918787,"completed_at_ms":1786856918788}}
