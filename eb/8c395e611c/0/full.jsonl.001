'pi_authorized',\n__tests__/app/actions.test.ts:940:            paymentIntentId: 'forged-payment'\n__tests__/app/actions.test.ts:1054:            paymentIntentId: 'pi_forged',\n__tests__/app/actions.test.ts:1204:        mockTx.paymentRefund.create.mockResolvedValue({ id: 'refund-1' });\n__tests__/app/actions.test.ts:1235:                    // Comfortably past the refund cut-off, so this exercises\n__tests__/app/actions.test.ts:1331:    it('records the refund the policy decided, on the transaction that cancels', async () => {\n__tests__/app/actions.test.ts:1335:        // cancellation was written down as refunding nothing (#76).\n__tests__/app/actions.test.ts:1381:        const refund = settings.find(setting => setting.sql.includes('app.booking_refund_cents'));\n__tests__/app/actions.test.ts:1382:        expect(refund).toBeDefined();\n__tests__/app/actions.test.ts:1383:        expect(refund!.values).toContain('8000');\n__tests__/app/actions.test.ts:1393:    it('durably submits the recorded refund for a captured booking', async () => {\n__tests__/app/actions.test.ts:1398:            paymentIntentId: 'pi_captured',\n__tests__/app/actions.test.ts:1429:        expect(mockSettleRefund).toHaveBeenCalledWith('refund-1');\n__tests__/app/actions.test.ts:1432:    it('keeps a committed cancellation truthful when refund submission is unavailable', async () => {\n__tests__/app/actions.test.ts:1435:            id: 1, userId: 'user-123', paymentIntentId: 'pi_captured', currency: 'USD',\n__tests__/app/actions.test.ts:1456:            message: 'Booking refund submission is still pending.',\n__tests__/app/actions.test.ts:1457:            refundId: 'refund-1',\n__tests__/app/actions.test.ts:1462:    it('does not create a provider refund when the cancellation refunds zero', async () => {\n__tests__/app/actions.test.ts:1465:            id: 1, userId: 'user-123', paymentIntentId: 'pi_captured', currency: 'USD',\n__tests__/app/actions.test.ts:1488:        // which moves the booking to DISRUPTED and makes it fully refundable.\n__tests__/app/actions.test.ts:1516:        const refund = mockTx.$executeRaw.mock.calls\n__tests__/app/actions.test.ts:1518:            .find(setting => setting.sql.includes('app.booking_refund_cents'));\n__tests__/app/actions.test.ts:1519:        expect(refund!.values).toContain('10000');\n__tests__/app/actions.test.ts:1601:    it('lets the booking owner retry its durable refund', async () => {\n__tests__/app/actions.test.ts:1605:            statusChanges: [{ paymentRefund: { id: 'refund-1' } }],\n__tests__/app/actions.test.ts:1612:        expect(mockSettleRefund).toHaveBeenCalledWith('refund-1');\n__tests__/app/actions.test.ts:1615:    it('does not reveal another customer\\'s refund', async () => {\n__tests__/app/actions.test.ts:1619:            statusChanges: [{ paymentRefund: { id: 'refund-1' } }],\n__tests__/app/actions.test.ts:1626:    it('returns a stable validation result when the booking has no refund', async () => {\n__tests__/app/actions.test.ts:1637:                message: 'This booking has no refund to retry.',\n__tests__/app/actions.test.ts:1638:                fields: { _root: ['This booking has no refund to retry.'] },\n__tests__/app/actions.test.ts:1644:    it('maps provider failures to stable refund-safe copy', async () => {\n__tests__/app/actions.test.ts:1648:            statusChanges: [{ paymentRefund: { id: 'refund-1' } }],\n__tests__/app/actions.test.ts:1658:                message: 'Your refund is still pending. Please try again later.',\n__tests__/app/actions.test.ts:1660:                    'payment.refund': ['Your refund is still pending. Please try again later.'],\napp/profile/page.tsx:63:          refundCents: true,\nlib/paymentRefundService.ts:20:    async settleRefund(refundId: string): Promise<RefundSettlement> {\nlib/paymentRefundService.ts:22:            await tx.$executeRaw`SELECT pg_advisory_xact_lock(hashtext(${refundId}))`;\nlib/paymentRefundService.ts:23:            const refund = await tx.paymentRefund.findUniqueOrThrow({\nlib/paymentRefundService.ts:24:                where: { id: refundId },\nlib/paymentRefundService.ts:30:            const change = refund.bookingStatusChange;\nlib/paymentRefundService.ts:33:                || change.refundCents !== refund.amountCents\nlib/paymentRefundService.ts:34:                || change.booking.paymentIntentId !== refund.providerIntentId\nlib/paymentRefundService.ts:35:                || change.booking.currency !== refund.currency\nlib/paymentRefundService.ts:39:            if (refund.status === 'SUCCEEDED') return { refund, attempt: null };\nlib/paymentRefundService.ts:41:            const current = refund.attempts[0];\nlib/paymentRefundService.ts:44:                    data: { id: randomUUID(), paymentRefundId: refund.id },\nlib/paymentRefundService.ts:47:            return { refund, attempt };\nlib/paymentRefundService.ts:52:        const { refund, attempt } = prepared;\nlib/paymentRefundService.ts:59:                refundId: refund.id,\nlib/paymentRefundService.ts:60:                refundAttemptId: attempt.id,\nlib/paymentRefundService.ts:61:                providerIntentId: refund.providerIntentId,\nlib/paymentRefundService.ts:69:                        amountCents: refund.amountCents,\nlib/paymentRefundService.ts:79:            state.paymentRefundId !== refund.id\nlib/paymentRefundService.ts:80:            || state.refundAttemptId !== attempt.id\nlib/paymentRefundService.ts:86:            throw new Error('Stripe refund metadata does not match the durable refund attempt.');\nlib/paymentRefundService.ts:115:                throw new Error('Stripe refund metadata does not match the durable refund attempt.');\nlib/paymentRefundService.ts:118:                where: { id: refund.id },\nlib/validation.ts:353:    paymentIntentId: requiredText('Payment intent ID', 255).nullable().default(null),\nlib/checkoutPaymentService.ts:2:import type { PaymentAttempt } from '@prisma/client';\nlib/checkoutPaymentService.ts:73:    attempt: Pick<PaymentAttempt, 'amountCents' | 'currency'>,\nlib/checkoutPaymentService.ts:118:            const existing = await tx.paymentAttempt.findUnique({\nlib/checkoutPaymentService.ts:132:                        paymentIntentId: existing.providerIntentId,\nlib/checkoutPaymentService.ts:161:            return tx.paymentAttempt.create({\nlib/checkoutPaymentService.ts:186:            await tx.paymentAttempt.update({\nlib/checkoutPaymentService.ts:204:            const initial = await tx.paymentAttempt.findUnique({\nlib/checkoutPaymentService.ts:219:                tx.paymentAttempt.findUniqueOrThrow({ where: { id: initial.id } }),\nlib/checkoutPaymentService.ts:226:                    select: { paymentIntentId: true },\nlib/checkoutPaymentService.ts:229:            if (!booking || booking.paymentIntentId !== attempt.providerIntentId) {\nlib/checkoutPaymentService.ts:258:            await tx.paymentAttempt.update({\nlib/checkoutPaymentService.ts:271:            const initial = await tx.paymentAttempt.findUnique({\nlib/checkoutPaymentService.ts:286:                tx.paymentAttempt.findUniqueOrThrow({ where: { id: initial.id } }),\nlib/checkoutPaymentService.ts:288:                    where: { paymentIntentId: providerIntentId },\nlib/checkoutPaymentService.ts:317:            await tx.paymentAttempt.update({\nlib/paymentWebhookService.ts:29:            if (!state.paymentAttemptId) {\nlib/paymentWebhookService.ts:34:                tx.paymentAttempt.findUnique({ where: { id: state.paymentAttemptId } }),\nlib/paymentWebhookService.ts:35:                tx.paymentAttempt.findUnique({\nlib/paymentWebhookService.ts:50:            await tx.paymentAttempt.update({\nlib/paymentWebhookService.ts:62:                    paymentAttemptId: attempt.id,\nlib/FlightBookingService.ts:110:        paymentIntentId?: string | null;\nlib/FlightBookingService.ts:112:        const { flightIds, userId, passengers, idempotencyKey, paymentIntentId } = parseInput(\nlib/FlightBookingService.ts:160:                if (existingRequest.paymentIntentId !== paymentIntentId) {\nlib/FlightBookingService.ts:297:                    paymentIntentId,\nlib/cancellationPolicy.ts:13: * | First, Business          | Full refund        | Cancel, no refund  | Refused  |\nlib/cancellationPolicy.ts:14: * | Premium Economy, Economy | Refund less a fee  | Cancel, no refund  | Refused  |\nlib/cancellationPolicy.ts:15: * | Any, airline disrupted   | Full refund, no fee, no cut-off        | Refused  |\nlib/cancellationPolicy.ts:26:/** How long before departure a refund stops being available. */\nlib/cancellationPolicy.ts:57:    refundCents: number;\nlib/cancellationPolicy.ts:58:    /** What the airline keeps out of that refund. Never a charge on its own. */\nlib/cancellationPolicy.ts:82: * the total was stored, and the amount charged is the one that may be refunded.\nlib/cancellationPolicy.ts:85: * more. The remainder is not refunded; refunding it would mean paying out more\nlib/cancellationPolicy.ts:97:        // dividing by zero. A zero-fare booking lands here and refunds zero.\nlib/cancellationPolicy.ts:112: * Why the refund came to what it did, in one line, for the history row.\nlib/cancellationPolicy.ts:115: * refund of zero next year has to be readable as \"cancelled inside the 24-hour\nlib/cancellationPolicy.ts:121:            return 'Cancelled after the airline disrupted the flight; refunded in full.';\nlib/cancellationPolicy.ts:123:            return `Cancelled within ${REFUND_CUTOFF_HOURS} hours of departure; no refund due.`;\nlib/cancellationPolicy.ts:125:            // On the fee, not on the refund: \"no fee\" and \"refunded in full\"\nlib/cancellationPolicy.ts:126:            // are different claims, and a booking that refunds nothing without\nlib/cancellationPolicy.ts:127:            // charging a fee would otherwise be recorded as refunded in full.\nlib/cancellationPolicy.ts:129:                ? 'Cancelled before the refund cut-off; no cancellation fee applied.'\nlib/cancellationPolicy.ts:130:                : `Cancelled before the refund cut-off; ${outcome.feeCents} minor units of the booking currency retained as the cancellation fee.`;\nlib/cancellationPolicy.ts:164:    // reach here, and apportioning by an empty list would silently refund\nlib/cancellationPolicy.ts:177:        // catalogue fare; reading it as zero here would refund nothing while\nlib/cancellationPolicy.ts:207:        return { allowed: false, reason: 'ALREADY_DEPARTED', refundCents: 0, feeCents: 0 };\nlib/cancellationPolicy.ts:215:            refundCents: booking.totalPriceCents,\nlib/cance…602 tokens truncated…                  paymentRefundId: refund.refundId,\nlib/stripePaymentProvider.ts:250:                    refundAttemptId: refund.refundAttemptId,\nlib/stripePaymentProvider.ts:251:                    status: refund.status,\nlib/stripePaymentProvider.ts:277:function paymentRefund(refund: Stripe.Refund): PaymentRefundState {\nlib/stripePaymentProvider.ts:278:    if (!refund.status) throw new Error('Stripe did not return a refund status.');\nlib/stripePaymentProvider.ts:280:        providerRefundId: refund.id,\nlib/stripePaymentProvider.ts:281:        paymentRefundId: refund.metadata?.paymentRefundId || null,\nlib/stripePaymentProvider.ts:282:        refundAttemptId: refund.metadata?.refundAttemptId || null,\nlib/stripePaymentProvider.ts:283:        status: REFUND_STATUS[refund.status],\nlib/stripePaymentProvider.ts:312:            metadata: { paymentAttemptId: input.attemptId },\nlib/stripePaymentProvider.ts:346:        refundId: string;\nlib/stripePaymentProvider.ts:347:        refundAttemptId: string;\nlib/stripePaymentProvider.ts:351:        return paymentRefund(await this.stripe.refunds.create({\nlib/stripePaymentProvider.ts:356:                paymentRefundId: input.refundId,\nlib/stripePaymentProvider.ts:357:                refundAttemptId: input.refundAttemptId,\nlib/stripePaymentProvider.ts:359:        }, { idempotencyKey: `payment-refund:${input.refundAttemptId}` }));\nlib/stripePaymentProvider.ts:363:        return paymentRefund(await this.stripe.refunds.retrieve(providerRefundId));\nlib/stripePaymentProvider.ts:367:        refundId: string;\nlib/stripePaymentProvider.ts:368:        refundAttemptId: string;\nlib/stripePaymentProvider.ts:371:        for await (const refund of this.stripe.refunds.list({\nlib/stripePaymentProvider.ts:375:                refund.metadata?.paymentRefundId === input.refundId\nlib/stripePaymentProvider.ts:376:                && refund.metadata?.refundAttemptId === input.refundAttemptId\nlib/stripePaymentProvider.ts:377:            ) return paymentRefund(refund);\nlib/stripePaymentProvider.ts:386:            paymentAttemptId: intent.metadata.paymentAttemptId || null,\n  PROCESSING\n  AUTHORIZED\n  CAPTURED\n  CANCELLED\n}\n\nenum PaymentRefundStatus {\n  PENDING\n  REQUIRES_ACTION\n  SUCCEEDED\n  FAILED\n  CANCELLED\n}\n\n/// Safe server-side payment metadata for one checkout.\n///\n/// Card details stay in Stripe Elements, and even the PaymentIntent client\n/// secret is deliberately not stored here. The request fingerprint binds a\n/// checkout UUID to the itinerary, seats and cabins that produced its quote.\nmodel PaymentAttempt {\n  id                   String               @id\n  checkoutId           String\n  userId               String?\n  user                 User?                @relation(fields: [userId], references: [id], onDelete: SetNull)\n  requestFingerprint   String\n  amountCents          Int\n  currency             String               @default(\"USD\")\n  providerIntentId     String?              @unique\n  status               PaymentAttemptStatus @default(CREATING)\n  createdAt            DateTime             @default(now())\n  updatedAt            DateTime             @updatedAt\n  webhookEvents        PaymentWebhookEvent[]\n\n  @@unique([userId, checkoutId])\n  @@index([status, updatedAt])\n}\n\n/// One successfully reconciled Stripe event.\n///\n/// The raw webhook body is deliberately absent: it may contain customer and\n/// payment-provider data that is unnecessary after signature verification.\nmodel PaymentWebhookEvent {\n  id                 String         @id\n  eventType          String\n  providerIntentId   String\n  paymentAttemptId   String\n  paymentAttempt     PaymentAttempt @relation(fields: [paymentAttemptId], references: [id], onDelete: Cascade)\n  createdAt          DateTime       @default(now())\n\n  @@index([providerIntentId])\n  @@index([paymentAttemptId])\n}\n\nmodel Booking {\n  id              Int           @id @default(autoincrement())\n  createdAt       DateTime      @default(now())\n  status          BookingStatus @default(CONFIRMED)\n  paymentIntentId String?       @unique\n  /// The booking total in minor units. Null for bookings taken before this\n  /// column existed, which fall back to the flight's catalogue price.\n  totalPriceCents Int?\n  currency        String        @default(\"USD\")\n  idempotencyKey  String?\n\n  userId String?\n  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)\n\n  passengers    Passenger[]\n  legs          ItineraryLeg[]\n  statusChanges BookingStatusChange[]\n\n  @@unique([userId, idempotencyKey])\n}\n\n/// One move between booking states, and the only record of the ones a booking\n/// is no longer in.\n///\n/// Append-only, enforced by a trigger rather than by convention: cancellation,\n/// disruption and refunds all have to be auditable, and a table that reaches\n/// this state only while every caller cooperates is not an audit trail (#76).\n/// Rows go when their booking goes -- the history of a booking that does not\n/// exist has no subject, and blocking that cascade would make a booking\n/// undeletable.\nmodel BookingStatusChange {\n  id          String         @id @default(cuid())\n  bookingId   Int\n  booking     Booking        @relation(fields: [bookingId], references: [id], onDelete: Cascade)\n  /// Null for the row that records the booking coming into existence.\n  from        BookingStatus?\n  to          BookingStatus\n  reason      String?\n  /// What this change owed the customer back, in minor units. Null where the\n  /// change did not refund; zero is a different and real answer, since a\n  /// cancellation inside the cut-off refunds nothing (#76).\n  refundCents Int?\n  /// Orders changes made in the same transaction, which `createdAt` cannot:\n  /// it is transaction start time, so two changes there share an instant.\n  /// A `BigInt` in the client, so a row handed straight to a client component\n  /// fails to serialise -- select what you need rather than the whole row.\n  sequence    BigInt         @default(autoincrement())\n  /// Who caused it. Null for a customer acting on their own booking, and for a\n  /// change nothing attributes.\n  actorUserId String?\n  actor       User?          @relation(fields: [actorUserId], references: [id], onDelete: SetNull)\n  paymentRefund PaymentRefund?\n  createdAt   DateTime       @default(now())\n\n  @@index([bookingId, createdAt])\n  @@index([bookingId, sequence])\n}\n\n/// One provider refund for the exact amount recorded by a cancellation.\n///\n/// The immutable status-change row remains the policy decision; this row is\n/// the durable delivery state used to make Stripe retries idempotent without\n/// retaining provider payloads or customer payment data.\nmodel PaymentRefund {\n  id                    String              @id @default(cuid())\n  bookingStatusChangeId String              @unique\n  bookingStatusChange   BookingStatusChange @relation(fields: [bookingStatusChangeId], references: [id], onDelete: Cascade)\n  providerIntentId      String\nimport type { Metadata } from 'next';\nimport React from \"react\";\nimport PointsActivityService from \"@/lib/PointsActivityService\";\nimport { getServerSession } from \"next-auth\";\nimport { authOptions } from \"@/lib/auth\";\nimport { prisma } from \"@/lib/prisma\";\nimport { flightRouteInclude, withLegRouteLabels } from \"@/lib/flightRoute\";\nimport ProfileClient from \"@/components/ui/ProfileClient\";\nimport { serverRenderTime } from \"@/lib/serverClock\";\nimport { safePassengerSelect } from \"@/lib/passengerDataAccess\";\n\nexport const metadata: Metadata = {\n    title: 'Your profile',\n    description: 'Your bookings, seats, status points and saved travel guides.',\n};\n\nexport const dynamic = 'force-dynamic';\n\nexport default async function ProfilePage() {\n  const session = await getServerSession(authOptions);\n  // Read rather than called in the markup below: see lib/serverClock.\n  const renderedAt = await serverRenderTime();\n\n  if (!session?.user) {\n    return <div className=\"p-8 text-center text-xl\" style={{ marginTop: '100px', color: 'black' }}>Please log in to view your profile.</div>;\n  }\n\n  const user = session.user;\n  const userId = user.id;\n  const userName = user.name || \"Traveler\";\n  const userAvatar = user.image || \"https://i.pravatar.cc/150?u=\" + userId;\n\n  const userBookings = await prisma.booking.findMany({\n    where: { userId },\n    orderBy: { createdAt: \"desc\" },\n    include: {\n      // Read the itinerary through its legs, so a round trip needs no change\n      // here beyond rendering more than one (#69).\n      legs: {\n        include: {\n          flight: { include: flightRouteInclude },\n          // The seat is held per leg, so a round trip has a different one on\n          // each; Passenger.seatNumber only ever described the outbound.\n          seatAssignments: {\n            select: {\n              passengerId: true,\n              seatNumber: true,\n              cabinClass: true,\n              // A released seat shows as released rather than as a number that\n              // is no longer this customer's (#76).\n              releasedAt: true,\n            },\n          },\n        },\n        orderBy: { sequence: 'asc' },\n      },\n      passengers: { select: safePassengerSelect },\n      statusChanges: {\n        where: { to: 'CANCELLED' },\n        orderBy: { sequence: 'desc' },\n        take: 1,\n        select: {\n          refundCents: true,\n          paymentRefund: {\n            select: { amountCents: true, status: true },\n          },\n        },\n      },\n    },\n  });\n\n  const userFavorites = await prisma.userFavorite.findMany({\n    where: { userId },\n    include: { cityGuide: true },\n    orderBy: { createdAt: \"desc\" }\n  });\n\n  const userReviews = await prisma.review.findMany({\n    where: { userId },\n    include: { cityGuide: true },\n    orderBy: { createdAt: \"desc\" }\n  });\n\n  // The route each leg renders comes from the airports its flight references.\n  // Resolved once here so the client component and the points activity both\n  // keep receiving a flight with `from` and `to` on it (#73).\n  const bookings = userBookings.map(booking => ({\n    ...booking,\n    legs: booking.legs.map(withLegRouteLabels),\n  }));\n\n  const pointsActivityService = new PointsActivityService(bookings);\n  const activityData = pointsActivityService.getPointsActivity();\n  const currentPoints = pointsActivityService.getCurrentPoints();\n  const currentStatus = pointsActivityService.getCurrentStatus();\n  const monthlyHistory = pointsActivityService.getMonthlyPointsActivity();\n\n  return (\n    <ProfileClient \n      userName={userName}\n      userAvatar={userAvatar}\n      currentStatus={currentStatus}\n      currentPoints={currentPoints}\n      bookings={bookings}\n      favorites={userFavorites}\n      reviews={userReviews}\n      activityData={activityData}\n      monthlyHistory={monthlyHistory}\n      renderedAt={renderedAt}\n    />\n  );\n}\n\"use client\"\n\nimport React, { useState, useEffect, useRef, useTransition } from 'react';\nimport { useRouter } from 'next/navigation';\nimport PointsActivityTable from \"@/components/ui/pointsActivityTable\";\nimport NextStatusChart from \"@/components/ui/charts/nextStatusChart\";\nimport PointsHistoryChart from \"@/components/ui/charts/pointsHistoryChart\";\nimport { flightFareCents, formatPrice } from '@/lib/bookingPricing';\nimport { cabinLabel, legDirectionLabel, orderedLegs, outboundFlight, seatLabel } from '@/lib/bookingItinerary';\nimport { cancelBookingAction, deleteReviewAction, toggleFavoriteCityGuideAction, changeBookingSeatsAction, getOccupiedSeatsAction, retryBookingRefundAction } from '@/app/actions';\nimport { isActionValidationFailure } from '@/lib/actionResult';\nimport { PointsActivityDisplayData } from '@/lib/types/PointsActivity';\nimport { flightDeparture } from '@/lib/flightTime';\n\ninterface Flight {\n    id: number;\n    flightNumber: string;\n    airline: string;\n    from: string;\n    to: string;\n    departureDate: Date | string;\n    priceCents: number;\n    /// Whether this leg is operating. A disrupted booking names the leg the\n    /// airline cancelled, which on a round trip is often not the first (#76).\n    status?: string;\n    firstClassRows?: number | null;\n    businessRows?: number | null;\n    premiumEconomyRows?: number | null;\n    economyRows?: number | null;\n    seatPattern?: string | null;\n}\n\ninterface Passenger {\n    id: string;\n    firstName: string;\n    lastName: string;\n    gender: string;\n}\n\ninterface SeatAssignment {\n    passengerId: string;\n    seatNumber: string;\n    cabinClass: string;\n    releasedAt?: Date | string | null;\n}\n\ninterface BookingLeg {\n    id: number;\n    sequence: number;\n    flight: Flight | null;\n    seatAssignments?: SeatAssignment[];\n}\n\ninterface Booking {\n    id: number;\n    createdAt: Date | string;\n    status: string; // \"CONFIRMED\", \"DISRUPTED\" or \"CANCELLED\"\n    totalPriceCents: number | null;\n    // The itinerary. One leg today; a round trip adds the inbound (#69).\n    legs: BookingLeg[];\n    passengers: Passenger[];\n    statusChanges?: Array<{\n        refundCents: number | null;\n        paymentRefund: {\n            amountCents: number;\n            status: 'PENDING' | 'REQUIRES_ACTION' | 'SUCCEEDED' | 'FAILED' | 'CANCELLED';\n        } | null;\n    }>;\n}\n\ninterface CityGuide {\n    id: number;\n    city: string;\n    country: string;\n    description: string;\n    coverImage: string | null;\n}\n\ninterface UserFavorite {\n    id: string;\n    cityGuideId: number;\n    cityGuide: CityGuide;\n}\n\ninterface Review {\n    id: string;\n    content: string;\n    rating: number;\n    cityGuide: CityGuide;\n    createdAt: Date | string;\n}\n\ninterface ProfileClientProps {\n    userName: string;\n    userAvatar: string;\n    currentStatus: string;\n    currentPoints: number;\n    bookings: Booking[];\n    favorites: UserFavorite[];\n    reviews: Review[];\n    activityData: PointsActivityDisplayData[];\n    monthlyHistory: PointsActivityDisplayData[];\n    /// The server's clock at render time. Deciding \"has this departed\" from\n    /// `Date.now()` in the component would make the first client render\n    /// disagree with the markup it hydrates. Required rather than defaulted:\n    /// a default of zero makes every flight look upcoming, which is the\n    /// departed guard quietly switched off with nothing to notice it.\n    renderedAt: number;\n}\n\n/**\n * Everything a booking row shows, derived once.\n *\n * Lifted out of the JSX rather than duplicated into a second markup tree: the\n * narrow layout is the same DOM restyled by CSS (#240), so there is exactly one\n * rendering and nothing here can disagree with a copy of itself. Keeping the\n * derivation separate from the markup is what makes that possible -- a second\n * tree would have to recompute the status text and the cancelled leg, and\n * deriving those twice is how one surface came to name a different flight from\n * another.\n */\n/**\n * The column heading, repeated inside the cell for the stacked layout.\n *\n * A real `aria-hidden` element rather than `content: attr(data-label)`. The\n * generated-content form is folded into the cell's accessible name -- that is\n * the accname spec, not a browser quirk -- so a screen reader announced the\n * column header and then heard it again from the cell: \"Status ... STATUS MA404\n * cancelled by airline\". That is exactly the say-it-twice defect the duplicate\n * status in #229 created, and in CSS no test counting rendered text can see it.\n * The header row is still there and still read; this is for eyes only.\n */\nfunction CellLabel({ children }: { children: string }) {\n    return <span className=\"cell-label\" aria-hidden=\"true\">{children}</span>;\n}\n\nfunction bookingPresentation(booking: Booking, renderedAt: number) {\n    const legs = orderedLegs(booking).filter(leg => leg.flight);\n    const isCancelled = booking.status === 'CANCELLED';\n    // The airline cancelled the flight. The seat is still held and the choice\n    // is the customer's, so both layouts say what happened and what cancelling\n    // now is worth (#76).\n    const isDisrupted = booking.status === 'DISRUPTED';\n    // The leg that was actually cancelled, which on a round trip is often not\n    // the first one: marking leg 1 told a customer their outbound was cancelled\n    // when it was the return, the exact inverse of the truth.\n    const cancelledLeg = legs.find(leg => leg.flight?.status === 'CANCELLED') ?? legs[0];\n    // Decided from a clock the server sent, so the first render agrees with the\n    // markup it hydrates.\n    const departed = legs[0]?.flight\n        ? new Date(legs[0].flight.departureDate).getTime() <= renderedAt\n        : false;\n    const refund = booking.statusChanges?.[0]?.paymentRefund ?? null;\n    const refundText = refund\n        ? refund.status === 'SUCCEEDED'\n            ? `${formatPrice(refund.amountCents)} refund sent.`\n            : refund.status === 'PENDING'\n                ? `${formatPrice(refund.amountCents)} refund is pending.`\n                : `${formatPrice(refund.amountCents)} refund needs attention.`\n        : null;\n\n    return {\n        legs,\n        // One row per leg in the table; the card walks the same list.\n        legRows: legs.length > 0 ? legs : [null as BookingLeg | null],\n        isCancelled,\n        isDisrupted,\n        cancelledLeg,\n        departed,\n        cancellable: !isCancelled && !departed,\n        statusText: isCancelled\n            ? 'Cancelled'\n            : isDisrupted\n                ? `${cancelledLeg?.flight?.flightNumber ?? 'Flight'} cancelled by airline`\n                : 'Confirmed',\n        statusColour: isCancelled ? '#f87171' : isDisrupted ? '#fbbf24' : '#34d399',\n        // Said once, for the same reason. The departed wording promises no\n        // refund: the flight did not operate and the date has passed, so\n        // cancelling is refused and a promise here is one nothing can keep.\n        disruptionNote: departed\n            ? 'This flight did not operate. Contact support about a refund.'\n            : 'Your seat is held. Cancel for a full refund, with no cancellation fee.',\n        refundText,\n        refundRetryable: Boolean(refund && refund.status !== 'SUCCEEDED'),\n        priceLabel: booking.totalPriceCents !== null && booking.totalPriceCents !== undefined\n            ? formatPrice(booking.totalPriceCents)\n            : legs[0]?.flight ? formatPrice(flightFareCents(legs[0].flight)) : '\\u2014',\n        seatFor: (leg: BookingLeg | null, passengerId: string) =>\n            seatLabel(leg?.seatAssignments?.find(seat => seat.passengerId === passengerId)),\n    };\n}\n\nexport default function ProfileClient({\n    userName,\n    userAvatar,\n    currentStatus,\n    currentPoints,\n    bookings,\n    favorites,\n    reviews,\n    activityData,\n    monthlyHistory,\n    renderedAt,\n}: ProfileClientProps) {\n    const router = useRouter();\n    const [isPending, startTransition] = useTransition();\n    const [activeRefundBookingId, setActiveRefundBookingId] = useState<number | null>(null);\n    const [refundFeedback, setRefundFeedback] = useState<{\n        bookingId: number;\n        message: string;\n        focus: boolean;\n    } | null>(null);\n    const refundFeedbackRef = useRef<HTMLParagraphElement | null>(null);\n    const bookingsRegionRef = useRef<HTMLDivElement | null>(null);\n\n    useEffect(() => {\n        if (refundFeedback?.focus) refundFeedbackRef.current?.focus();\n    }, [refundFeedback]);\n    /**\n     * Whether the region still scrolls sideways.\n     *\n     * At 767px and below the table lays each booking out as a stacked card and\n     * nothing overflows, which is what put the Cancel button back inside a\n     * phone's viewport (#240). 767 rather than 640 because the table wants\n     * 590px inside a region narrower than the window: a breakpoint under that\n     * left 641-699px still scrolling, which is where the defect went the first\n     * time. This is the residue above the breakpoint: content wider than it\n     * anticipated -- a long airline name beside a long passenger list -- can\n     * still overflow on a small laptop, and a scroller carrying focusable\n     * children is not focusable on its own.\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a007af-dc2d-7273-a829-7d59e29dc4f8"}}}
