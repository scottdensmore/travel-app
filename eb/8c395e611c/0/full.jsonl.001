{"timestamp":"2026-08-16T19:29:38.404Z","ordinal":25612,"type":"event_msg","payload":{"type":"token_count","info":{"total_token_usage":{"input_tokens":45614583,"cached_input_tokens":44831744,"cache_write_input_tokens":0,"output_tokens":109747,"reasoning_output_tokens":42969,"total_tokens":45724330},"last_token_usage":{"input_tokens":83697,"cached_input_tokens":82688,"cache_write_input_tokens":0,"output_tokens":62,"reasoning_output_tokens":6,"total_tokens":83759},"model_context_window":258400},"rate_limits":{"limit_id":"codex","limit_name":null,"primary":{"used_percent":38.0,"window_minutes":10080,"resets_at":1787197964},"secondary":null,"credits":{"has_credits":false,"unlimited":false,"balance":"0"},"individual_limit":null,"spend_control_reached":null,"plan_type":"pro","rate_limit_reached_type":null}}}
