        });\n    96\t            if (current?.providerIntentId !== providerIntentId) {\n    97\t                throw new Error('Payment attempt provider binding changed during reconciliation.');\n    98\t            }\n    99\t            return reconcilePaymentIntent(\n   100\t                tx,\n   101\t                this.provider,\n   102\t                providerIntentId,\n   103\t                attemptId,\n   104\t            );\n   105\t        }, { maxWait: 5_000, timeout: 15_000 });\n   466\t    }\n   467\t}\n   468\t\n   469\texport async function reconcilePaymentAttemptAction(paymentAttemptId: string) {\n   470\t    const session = await getServerSession(authOptions);\n   471\t    if (!hasVerifiedStaffAccess(session)) throw new Error('Unauthorized');\n   472\t\n   473\t    const parsed = parseActionInput(stringIdSchema, paymentAttemptId);\n   474\t    if (!parsed.ok) return parsed;\n   475\t\n   476\t    try {\n   477\t        const result = await new PaymentAttemptReconciliationService(\n   478\t            createStripePaymentProvider(),\n   479\t        ).reconcileAttempt(parsed.data);\n   480\t        revalidatePath('/admin/payments');\n   481\t        return {\n   482\t            ok: true as const,\n   483\t            ...result,\n   484\t            updatedAt: result.updatedAt.toISOString(),\n   485\t        };\n   486\t    } catch {\n   487\t        // Provider messages can include Stripe request details. Staff need a\n   488\t        // retryable outcome, while logs keep only the local identifier needed\n   489\t        // to investigate it.\n   490\t        console.error({\n   491\t            message: 'Staff payment reconciliation failed.',\n   492\t            paymentAttemptId: parsed.data,\n   493\t        });\n   494\t        return actionValidationFailure(\n   495\t            'Payment status could not be refreshed. Try again later.',\n   496\t            'paymentAttemptId',\n   497\t        );\n   498\t    }\n   499\t}\n   500\t\n   501