{"timestamp":"2026-08-16T03:16:04.576Z","ordinal":21116,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a00891-bf60-7350-8943-16186b49dd93","call_id":"call_8fExI1S5rUgDWNm4ucpWc1KK","output":[{"type":"input_text","text":"Script completed\nWall time 0.6 seconds\nOutput:\n"},{"type":"input_text","text":"prisma/migrations/20260803160000_flight_price_minor_units/migration.sql:14:-- backfill has been observed in a deployed environment.\nprisma/migrations/20260811040000_flight_elapsed_duration/migration.sql:30:--     DELETE FROM _prisma_migrations WHERE migration_name = '20260811040000_flight_elapsed_duration';\nprisma/migrations/20260810050000_release_seats_without_renaming/migration.sql:44:--     DELETE FROM _prisma_migrations WHERE migration_name = '20260810050000_release_seats_without_renaming';\nprisma/migrations/20260810050000_release_seats_without_renaming/migration.sql:80:-- cancelled before #228 is itself the backfilled row carrying the booking's\nprisma/migrations/20260810050000_release_seats_without_renaming/migration.sql:106:-- the backfill above being weakened or removed, which is the change somebody is\nprisma/migrations/20260810050000_release_seats_without_renaming/migration.sql:120:            'they would stay held under a seat number nobody can be given. Either the backfill '\nprisma/migrations/20260801140000_booking_total_minor_units/migration.sql:10:-- backfill has been observed in a deployed environment.\nprisma/migrations/20260804090000_drop_price_strings/migration.sql:8:-- Any row the original backfill could not parse is filled here rather than\nprisma/migrations/20260801160000_add_itinerary_legs/migration.sql:8:-- round trips actually produce a second leg and the backfill has been observed\nprisma/migrations/20260814193000_stripe_webhook_events/migration.sql:12:--     DELETE FROM _prisma_migrations\nprisma/migrations/20260814120000_checkout_payment_attempts/migration.sql:18:--     DELETE FROM _prisma_migrations\nprisma/migrations/20260811120000_seat_holds/migration.sql:41:--     DELETE FROM _prisma_migrations WHERE migration_name = '20260811120000_seat_holds';\nprisma/migrations/20260816030000_add_payment_capture_time/migration.sql:14:--     DELETE FROM _prisma_migrations\nprisma/migrations/20260810040000_type_booking_status/migration.sql:35:--     DELETE FROM _prisma_migrations WHERE migration_name = '20260810040000_type_booking_status';\nprisma/migrations/20260810040000_type_booking_status/migration.sql:44:-- `_prisma_migrations` row is never reached, `migrate deploy` reports nothing\nprisma/migrations/20260810210000_flight_departure_instants/migration.sql:40:--     DELETE FROM _prisma_migrations WHERE migration_name = '20260810210000_flight_departure_instants';\nprisma/migrations/20260810060000_record_cancellation_refunds/migration.sql:27:--     DELETE FROM _prisma_migrations WHERE migration_name = '20260810060000_record_cancellation_refunds';\nprisma/migrations/20260810060000_record_cancellation_refunds/migration.sql:47:-- Added, backfilled and only then defaulted, rather than as a bare BIGSERIAL.\nprisma/migrations/20260808120000_drop_flight_route_text/migration.sql:21:--     DELETE FROM _prisma_migrations WHERE migration_name = '20260808120000_drop_flight_route_text';\nprisma/migrations/20260815190000_capture_booking_payments/migration.sql:10:--     DELETE FROM _prisma_migrations\nprisma/migrations/20260815210000_add_payment_refunds/migration.sql:11:--     DELETE FROM _prisma_migrations\nprisma/migrations/20260807210000_flight_airport_references/migration.sql:20:--     DELETE FROM _prisma_migrations WHERE migration_name = '20260807210000_flight_airport_references';\nprisma/migrations/20260807210000_flight_airport_references/migration.sql:34:-- Nullable first, so the backfill has somewhere to write.\n__tests__/lib/itineraryLegs.database.test.ts:28:        // What made the one-off backfill safe to re-run, and what keeps an\nprisma/migrations/20260807120000_type_cabin_class/migration.sql:18:--     DELETE FROM _prisma_migrations WHERE migration_name = '20260807120000_type_cabin_class';\n__tests__/lib/seatingMigration.test.ts:6:    it('backfills the legacy 3/3/4/20 cabin boundaries', () => {\n__tests__/lib/seatingMigration.test.ts:10:                'prisma/migrations/20260703184208_add_seating_configurations/migration.sql'\n__tests__/lib/bookingStatus.database.test.ts:319:        // The invariant the backfill exists to make true. Asserted over the\n__tests__/lib/seatAssignmentCoverage.database.test.ts:12: * taken before #118 backfilled `SeatAssignment`. Removing that fallback is only\n__tests__/lib/authTokens.database.test.ts:33:            'prisma/migrations/20260713051000_unique_auth_token_identifier/migration.sql'\nprisma/migrations/20260807170000_type_flight_status/migration.sql:19:--     DELETE FROM _prisma_migrations WHERE migration_name = '20260807170000_type_flight_status';\nprisma/migrations/20260802120000_drop_booking_flight_id/migration.sql:12:-- Every booking has a leg: the #109 migration backfilled one per existing\n__tests__/security/passengerDataSchema.test.ts:27:            'prisma/migrations/20260714010000_protect_passenger_data/migration.sql',\n__tests__/security/passengerDataSchema.test.ts:35:            'prisma/migrations/20260714011000_enforce_passenger_data_state/migration.sql',\n__tests__/security/staffMfaSchema.test.ts:10:        'prisma/migrations/20260714020000_add_staff_mfa/migration.sql'\n__tests__/lib/paymentRefundIntegrity.database.test.ts\n__tests__/lib/bookingPaymentIntegrity.database.test.ts\n__tests__/lib/paymentAttemptIntegrity.database.test.ts\n__tests__/lib/paymentWebhookEventIntegrity.database.test.ts\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a007af-dc2d-7273-a829-7d59e29dc4f8"}}}
