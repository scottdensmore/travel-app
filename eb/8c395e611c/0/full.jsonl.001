{"timestamp":"2026-08-16T18:06:31.270Z","ordinal":23848,"type":"response_item","payload":{"type":"custom_tool_call","id":"ctc_00fb20eee1c75140016a81fbef8dd4819891346d4250be9523","status":"completed","call_id":"call_cmbNB19MsL1mwOzW1NTTYNU9","name":"exec","input":"const patch = \"*** Begin Patch\\n*** Add File: /home/scottdensmore/Developer/scottdensmore/travel-app/prisma/migrations/20260816181000_version_itinerary_legs/migration.sql\\n+-- Preserve every itinerary a booking has held while allowing one position to\\n+-- be replaced after an airline disruption.\\n+--\\n+-- Reversal (there are no automated down migrations):\\n+--\\n+--     DROP TRIGGER \\\"BookingRebookingLeg_is_append_only\\\" ON \\\"BookingRebookingLeg\\\";\\n+--     DROP TRIGGER \\\"BookingRebooking_is_append_only\\\" ON \\\"BookingRebooking\\\";\\n+--     DROP TRIGGER \\\"BookingRebooking_has_legs\\\" ON \\\"BookingRebooking\\\";\\n+--     DROP TRIGGER \\\"BookingRebookingLeg_is_consistent\\\" ON \\\"BookingRebookingLeg\\\";\\n+--     DROP TRIGGER \\\"BookingRebooking_is_consistent\\\" ON \\\"BookingRebooking\\\";\\n+--     DROP TRIGGER \\\"ItineraryLeg_supersession_is_recorded\\\" ON \\\"ItineraryLeg\\\";\\n+--     DROP TRIGGER \\\"ItineraryLeg_supersession_is_permanent\\\" ON \\\"ItineraryLeg\\\";\\n+--     DROP FUNCTION \\\"refuse_rebooking_audit_update\\\"();\\n+--     DROP FUNCTION \\\"require_rebooking_legs\\\"();\\n+--     DROP FUNCTION \\\"validate_booking_rebooking_leg\\\"();\\n+--     DROP FUNCTION \\\"validate_booking_rebooking\\\"();\\n+--     DROP FUNCTION \\\"require_recorded_leg_supersession\\\"();\\n+--     DROP FUNCTION \\\"refuse_itinerary_leg_unsupersession\\\"();\\n+--     DROP TABLE \\\"BookingRebookingLeg\\\";\\n+--     DROP TABLE \\\"BookingRebooking\\\";\\n+--     DROP TYPE \\\"RebookingFarePolicy\\\";\\n+--     DROP INDEX \\\"ItineraryLeg_active_booking_sequence_key\\\";\\n+--     DROP INDEX \\\"ItineraryLeg_bookingId_supersededAt_sequence_idx\\\";\\n+--     ALTER TABLE \\\"ItineraryLeg\\\" DROP COLUMN \\\"supersededAt\\\";\\n+--     CREATE UNIQUE INDEX \\\"ItineraryLeg_bookingId_sequence_key\\\"\\n+--         ON \\\"ItineraryLeg\\\"(\\\"bookingId\\\", \\\"sequence\\\");\\n+--\\n+-- The reversal is safe only before a rebooking exists. Once two historical\\n+-- rows share a sequence, restoring the unconditional unique key is impossible\\n+-- without deleting audit history.\\n+\\n+CREATE TYPE \\\"RebookingFarePolicy\\\" AS ENUM ('DISRUPTION_WAIVER');\\n+\\n+ALTER TABLE \\\"ItineraryLeg\\\"\\n+    ADD COLUMN \\\"supersededAt\\\" TIMESTAMP(3);\\n+\\n+DROP INDEX \\\"ItineraryLeg_bookingId_sequence_key\\\";\\n+\\n+-- Historical rows may share a position; exactly one current row may not.\\n+CREATE UNIQUE INDEX \\\"ItineraryLeg_active_booking_sequence_key\\\"\\n+    ON \\\"ItineraryLeg\\\"(\\\"bookingId\\\", \\\"sequence\\\")\\n+    WHERE \\\"supersededAt\\\" IS NULL;\\n+\\n+CREATE INDEX \\\"ItineraryLeg_bookingId_supersededAt_sequence_idx\\\"\\n+    ON \\\"ItineraryLeg\\\"(\\\"bookingId\\\", \\\"supersededAt\\\", \\\"sequence\\\");\\n+\\n+CREATE TABLE \\\"BookingRebooking\\\" (\\n+    \\\"id\\\" TEXT NOT NULL,\\n+    \\\"bookingId\\\" INTEGER NOT NULL,\\n+    \\\"bookingStatusChangeId\\\" TEXT NOT NULL,\\n+    \\\"farePolicy\\\" \\\"RebookingFarePolicy\\\" NOT NULL DEFAULT 'DISRUPTION_WAIVER',\\n+    \\\"createdAt\\\" TIMESTAMP(3) NOT NULL DEFAULT CURRENT_TIMESTAMP,\\n+\\n+    CONSTRAINT \\\"BookingRebooking_pkey\\\" PRIMARY KEY (\\\"id\\\")\\n+);\\n+\\n+CREATE UNIQUE INDEX \\\"BookingRebooking_bookingStatusChangeId_key\\\"\\n+    ON \\\"BookingRebooking\\\"(\\\"bookingStatusChangeId\\\");\\n+CREATE INDEX \\\"BookingRebooking_bookingId_createdAt_idx\\\"\\n+    ON \\\"BookingRebooking\\\"(\\\"bookingId\\\", \\\"createdAt\\\");\\n+\\n+ALTER TABLE \\\"BookingRebooking\\\"\\n+    ADD CONSTRAINT \\\"BookingRebooking_bookingId_fkey\\\"\\n+        FOREIGN KEY (\\\"bookingId\\\") REFERENCES \\\"Booking\\\"(\\\"id\\\")\\n+        ON DELETE CASCADE ON UPDATE CASCADE,\\n+    ADD CONSTRAINT \\\"BookingRebooking_bookingStatusChangeId_fkey\\\"\\n+        FOREIGN KEY (\\\"bookingStatusChangeId\\\") REFERENCES \\\"BookingStatusChange\\\"(\\\"id\\\")\\n+        ON DELETE NO ACTION ON UPDATE CASCADE;\\n+\\n+CREATE TABLE \\\"BookingRebookingLeg\\\" (\\n+    \\\"rebookingId\\\" TEXT NOT NULL,\\n+    \\\"fromLegId\\\" INTEGER NOT NULL,\\n+    \\\"toLegId\\\" INTEGER NOT NULL,\\n+\\n+    CONSTRAINT \\\"BookingRebookingLeg_pkey\\\" PRIMARY KEY (\\\"rebookingId\\\", \\\"fromLegId\\\"),\\n+    CONSTRAINT \\\"BookingRebookingLeg_different_legs\\\" CHECK (\\\"fromLegId\\\" <> \\\"toLegId\\\")\\n+);\\n+\\n+CREATE UNIQUE INDEX \\\"BookingRebookingLeg_fromLegId_key\\\"\\n+    ON \\\"BookingRebookingLeg\\\"(\\\"fromLegId\\\");\\n+CREATE UNIQUE INDEX \\\"BookingRebookingLeg_toLegId_key\\\"\\n+    ON \\\"BookingRebookingLeg\\\"(\\\"toLegId\\\");\\n+\\n+ALTER TABLE \\\"BookingRebookingLeg\\\"\\n+    ADD CONSTRAINT \\\"BookingRebookingLeg_rebookingId_fkey\\\"\\n+        FOREIGN KEY (\\\"rebookingId\\\") REFERENCES \\\"BookingRebooking\\\"(\\\"id\\\")\\n+        ON DELETE CASCADE ON UPDATE CASCADE,\\n+    ADD CONSTRAINT \\\"BookingRebookingLeg_fromLegId_fkey\\\"\\n+        FOREIGN KEY (\\\"fromLegId\\\") REFERENCES \\\"ItineraryLeg\\\"(\\\"id\\\")\\n+        ON DELETE NO ACTION ON UPDATE CASCADE,\\n+    ADD CONSTRAINT \\\"BookingRebookingLeg_toLegId_fkey\\\"\\n+        FOREIGN KEY (\\\"toLegId\\\") REFERENCES \\\"ItineraryLeg\\\"(\\\"id\\\")\\n+        ON DELETE NO ACTION ON UPDATE CASCADE;\\n+\\n+-- A leg is historical forever once replaced. Changing the timestamp would\\n+-- rewrite when it stopped being the customer's itinerary; clearing it would\\n+-- make two histories current again.\\n+CREATE FUNCTION \\\"refuse_itinerary_leg_unsupersession\\\"()\\n+RETURNS TRIGGER AS $$\\n+BEGIN\\n+    IF OLD.\\\"supersededAt\\\" IS NOT NULL\\n+       AND NEW.\\\"supersededAt\\\" IS DISTINCT FROM OLD.\\\"supersededAt\\\" THEN\\n+        RAISE EXCEPTION\\n+            'ItineraryLeg supersession is permanent: leg % cannot become active or change time.',\\n+            OLD.\\\"id\\\";\\n+    END IF;\\n+    RETURN NEW;\\n+END;\\n+$$ LANGUAGE plpgsql;\\n+\\n+CREATE TRIGGER \\\"ItineraryLeg_supersession_is_permanent\\\"\\n+    BEFORE UPDATE OF \\\"supersededAt\\\" ON \\\"ItineraryLeg\\\"\\n+    FOR EACH ROW EXECUTE FUNCTION \\\"refuse_itinerary_leg_unsupersession\\\"();\\n+\\n+-- A superseded leg must be named by an immutable rebooking mapping before its\\n+-- transaction commits. Deferred because the event and replacement leg are\\n+-- naturally written after the original leg is marked historical.\\n+CREATE FUNCTION \\\"require_recorded_leg_supersession\\\"()\\n+RETURNS TRIGGER AS $$\\n+BEGIN\\n+    IF NOT EXISTS (SELECT 1 FROM \\\"ItineraryLeg\\\" WHERE \\\"id\\\" = NEW.\\\"id\\\") THEN\\n+        RETURN NULL;\\n+    END IF;\\n+    IF NOT EXISTS (\\n+        SELECT 1 FROM \\\"BookingRebookingLeg\\\" WHERE \\\"fromLegId\\\" = NEW.\\\"id\\\"\\n+    ) THEN\\n+        RAISE EXCEPTION\\n+            'Superseded ItineraryLeg % must be recorded by a BookingRebookingLeg.',\\n+            NEW.\\\"id\\\";\\n+    END IF;\\n+    RETURN NULL;\\n+END;\\n+$$ LANGUAGE plpgsql;\\n+\\n+CREATE CONSTRAINT TRIGGER \\\"ItineraryLeg_supersession_is_recorded\\\"\\n+    AFTER UPDATE OF \\\"supersededAt\\\" ON \\\"ItineraryLeg\\\"\\n+    DEFERRABLE INITIALLY DEFERRED\\n+    FOR EACH ROW\\n+    WHEN (OLD.\\\"supersededAt\\\" IS NULL AND NEW.\\\"supersededAt\\\" IS NOT NULL)\\n+    EXECUTE FUNCTION \\\"require_recorded_leg_supersession\\\"();\\n+\\n+-- The status row is the booking-wide audit sequence. A rebooking can only be\\n+-- attached to the transition that resolves a disruption, for the same\\n+-- booking, and cannot simultaneously claim a refund.\\n+CREATE FUNCTION \\\"validate_booking_rebooking\\\"()\\n+RETURNS TRIGGER AS $$\\n+DECLARE\\n+    change \\\"BookingStatusChange\\\";\\n+BEGIN\\n+    SELECT * INTO change\\n+    FROM \\\"BookingStatusChange\\\"\\n+    WHERE \\\"id\\\" = NEW.\\\"bookingStatusChangeId\\\";\\n+\\n+    IF NOT FOUND\\n+       OR change.\\\"bookingId\\\" <> NEW.\\\"bookingId\\\"\\n+       OR change.\\\"from\\\" IS DISTINCT FROM 'DISRUPTED'::\\\"BookingStatus\\\"\\n+       OR change.\\\"to\\\" IS DISTINCT FROM 'CONFIRMED'::\\\"BookingStatus\\\"\\n+       OR change.\\\"refundCents\\\" IS NOT NULL THEN\\n+        RAISE EXCEPTION\\n+            'BookingRebooking must match one non-refunding DISRUPTED to CONFIRMED status change.';\\n+    END IF;\\n+    RETURN NEW;\\n+END;\\n+$$ LANGUAGE plpgsql;\\n+\\n+CREATE TRIGGER \\\"BookingRebooking_is_consistent\\\"\\n+    BEFORE INSERT ON \\\"BookingRebooking\\\"\\n+    FOR EACH ROW EXECUTE FUNCTION \\\"validate_booking_rebooking\\\"();\\n+\\n+-- Both legs remain real rows. The old one must already be historical, the new\\n+-- one current, and both must occupy the same position in this booking.\\n+CREATE FUNCTION \\\"validate_booking_rebooking_leg\\\"()\\n+RETURNS TRIGGER AS $$\\n+DECLARE\\n+    event_booking_id INTEGER;\\n+    from_booking_id INTEGER;\\n+    from_sequence INTEGER;\\n+    from_superseded_at TIMESTAMP(3);\\n+    to_booking_id INTEGER;\\n+    to_sequence INTEGER;\\n+    to_superseded_at TIMESTAMP(3);\\n+BEGIN\\n+    SELECT \\\"bookingId\\\" INTO event_booking_id\\n+    FROM \\\"BookingRebooking\\\"\\n+    WHERE \\\"id\\\" = NEW.\\\"rebookingId\\\";\\n+    SELECT \\\"bookingId\\\", \\\"sequence\\\", \\\"supersededAt\\\"\\n+        INTO from_booking_id, from_sequence, from_superseded_at\\n+    FROM \\\"ItineraryLeg\\\" WHERE \\\"id\\\" = NEW.\\\"fromLegId\\\";\\n+    SELECT \\\"bookingId\\\", \\\"sequence\\\", \\\"supersededAt\\\"\\n+        INTO to_booking_id, to_sequence, to_superseded_at\\n+    FROM \\\"ItineraryLeg\\\" WHERE \\\"id\\\" = NEW.\\\"toLegId\\\";\\n+\\n+    IF event_booking_id IS NULL\\n+       OR from_booking_id IS NULL\\n+       OR to_booking_id IS NULL\\n+       OR from_booking_id <> event_booking_id\\n+       OR to_booking_id <> event_booking_id\\n+       OR from_sequence <> to_sequence\\n+       OR from_superseded_at IS NULL\\n+       OR to_superseded_at IS NOT NULL THEN\\n+        RAISE EXCEPTION\\n+            'BookingRebookingLeg must map superseded and active legs from the same booking and same itinerary position.';\\n+    END IF;\\n+    RETURN NEW;\\n+END;\\n+$$ LANGUAGE plpgsql;\\n+\\n+CREATE TRIGGER \\\"BookingRebookingLeg_is_consistent\\\"\\n+    BEFORE INSERT ON \\\"BookingRebookingLeg\\\"\\n+    FOR EACH ROW EXECUTE FUNCTION \\\"validate_booking_rebooking_leg\\\"();\\n+\\n+-- An event with no leg mapping says a rebooking happened but cannot say what\\n+-- changed. Deferred so a normal transaction can insert the event first.\\n+CREATE FUNCTION \\\"require_rebooking_legs\\\"()\\n+RETURNS TRIGGER AS $$\\n+BEGIN\\n+    IF NOT EXISTS (SELECT 1 FROM \\\"BookingRebooking\\\" WHERE \\\"id\\\" = NEW.\\\"id\\\") THEN\\n+        RETURN NULL;\\n+    END IF;\\n+    IF NOT EXISTS (\\n+        SELECT 1 FROM \\\"BookingRebookingLeg\\\" WHERE \\\"rebookingId\\\" = NEW.\\\"id\\\"\\n+    ) THEN\\n+        RAISE EXCEPTION 'BookingRebooking % must map at least one itinerary leg.', NEW.\\\"id\\\";\\n+    END IF;\\n+    RETURN NULL;\\n+END;\\n+$$ LANGUAGE plpgsql;\\n+\\n+CREATE CONSTRAINT TRIGGER \\\"BookingRebooking_has_legs\\\"\\n+    AFTER INSERT ON \\\"BookingRebooking\\\"\\n+    DEFERRABLE INITIALLY DEFERRED\\n+    FOR EACH ROW EXECUTE FUNCTION \\\"require_rebooking_legs\\\"();\\n+\\n+-- Updates rewrite audit history. Deletes remain available only through the\\n+-- booking cascade, matching BookingStatusChange and test-data cleanup.\\n+CREATE FUNCTION \\\"refuse_rebooking_audit_update\\\"()\\n+RETURNS TRIGGER AS $$\\n+BEGIN\\n+    RAISE EXCEPTION '% is append-only and cannot be modified.', TG_TABLE_NAME;\\n+END;\\n+$$ LANGUAGE plpgsql;\\n+\\n+CREATE TRIGGER \\\"BookingRebooking_is_append_only\\\"\\n+    BEFORE UPDATE ON \\\"BookingRebooking\\\"\\n+    FOR EACH ROW EXECUTE FUNCTION \\\"refuse_rebooking_audit_update\\\"();\\n+\\n+CREATE TRIGGER \\\"BookingRebookingLeg_is_append_only\\\"\\n+    BEFORE UPDATE ON \\\"BookingRebookingLeg\\\"\\n+    FOR EACH ROW EXECUTE FUNCTION \\\"refuse_rebooking_audit_update\\\"();\\n*** End Patch\";\ntext(await tools.apply_patch(patch));","internal_chat_message_metadata_passthrough":{"turn_id":"01a00bba-29dd-7100-8715-811d18e7c7e1"}}}
{"timestamp":"2026-08-16T18:06:31.646Z","ordinal":23849,"type":"event_msg","payload":{"type":"item_completed","thread_id":"019ffe5b-1054-7c22-8afc-e97cb84c7b73","turn_id":"01a00bba-29dd-7100-8715-811d18e7c7e1","item":{"type":"FileChange","id":"exec-af1823da-d8bf-4910-b0c7-a302775bf17c","changes":{"/home/scottdensmore/Developer/scottdensmore/travel-app/prisma/migrations/20260816181000_version_itinerary_legs/migration.sql":{"type":"add","content":"-- Preserve every itinerary a booking has held while allowing one position to\n-- be replaced after an airline disruption.\n--\n-- Reversal (there are no automated down migrations):\n--\n--     DROP TRIGGER \"BookingRebookingLeg_is_append_only\" ON \"BookingRebookingLeg\";\n--     DROP TRIGGER \"BookingRebooking_is_append_only\" ON \"BookingRebooking\";\n--     DROP TRIGGER \"BookingRebooking_has_legs\" ON \"BookingRebooking\";\n--     DROP TRIGGER \"BookingRebookingLeg_is_consistent\" ON \"BookingRebookingLeg\";\n--     DROP TRIGGER \"BookingRebooking_is_consistent\" ON \"BookingRebooking\";\n--     DROP TRIGGER \"ItineraryLeg_supersession_is_recorded\" ON \"ItineraryLeg\";\n--     DROP TRIGGER \"ItineraryLeg_supersession_is_permanent\" ON \"ItineraryLeg\";\n--     DROP FUNCTION \"refuse_rebooking_audit_update\"();\n--     DROP FUNCTION \"require_rebooking_legs\"();\n--     DROP FUNCTION \"validate_booking_rebooking_leg\"();\n--     DROP FUNCTION \"validate_booking_rebooking\"();\n--     DROP FUNCTION \"require_recorded_leg_supersession\"();\n--     DROP FUNCTION \"refuse_itinerary_leg_unsupersession\"();\n--     DROP TABLE \"BookingRebookingLeg\";\n--     DROP TABLE \"BookingRebooking\";\n--     DROP TYPE \"RebookingFarePolicy\";\n--     DROP INDEX \"ItineraryLeg_active_booking_sequence_key\";\n--     DROP INDEX \"ItineraryLeg_bookingId_supersededAt_sequence_idx\";\n--     ALTER TABLE \"ItineraryLeg\" DROP COLUMN \"supersededAt\";\n--     CREATE UNIQUE INDEX \"ItineraryLeg_bookingId_sequence_key\"\n--         ON \"ItineraryLeg\"(\"bookingId\", \"sequence\");\n--\n-- The reversal is safe only before a rebooking exists. Once two historical\n-- rows share a sequence, restoring the unconditional unique key is impossible\n-- without deleting audit history.\n\nCREATE TYPE \"RebookingFarePolicy\" AS ENUM ('DISRUPTION_WAIVER');\n\nALTER TABLE \"ItineraryLeg\"\n    ADD COLUMN \"supersededAt\" TIMESTAMP(3);\n\nDROP INDEX \"ItineraryLeg_bookingId_sequence_key\";\n\n-- Historical rows may share a position; exactly one current row may not.\nCREATE UNIQUE INDEX \"ItineraryLeg_active_booking_sequence_key\"\n    ON \"ItineraryLeg\"(\"bookingId\", \"sequence\")\n    WHERE \"supersededAt\" IS NULL;\n\nCREATE INDEX \"ItineraryLeg_bookingId_supersededAt_sequence_idx\"\n    ON \"ItineraryLeg\"(\"bookingId\", \"supersededAt\", \"sequence\");\n\nCREATE TABLE \"BookingRebooking\" (\n    \"id\" TEXT NOT NULL,\n    \"bookingId\" INTEGER NOT NULL,\n    \"bookingStatusChangeId\" TEXT NOT NULL,\n    \"farePolicy\" \"RebookingFarePolicy\" NOT NULL DEFAULT 'DISRUPTION_WAIVER',\n    \"createdAt\" TIMESTAMP(3) NOT NULL DEFAULT CURRENT_TIMESTAMP,\n\n    CONSTRAINT \"BookingRebooking_pkey\" PRIMARY KEY (\"id\")\n);\n\nCREATE UNIQUE INDEX \"BookingRebooking_bookingStatusChangeId_key\"\n    ON \"BookingRebooking\"(\"bookingStatusChangeId\");\nCREATE INDEX \"BookingRebooking_bookingId_createdAt_idx\"\n    ON \"BookingRebooking\"(\"bookingId\", \"createdAt\");\n\nALTER TABLE \"BookingRebooking\"\n    ADD CONSTRAINT \"BookingRebooking_bookingId_fkey\"\n        FOREIGN KEY (\"bookingId\") REFERENCES \"Booking\"(\"id\")\n        ON DELETE CASCADE ON UPDATE CASCADE,\n    ADD CONSTRAINT \"BookingRebooking_bookingStatusChangeId_fkey\"\n        FOREIGN KEY (\"bookingStatusChangeId\") REFERENCES \"BookingStatusChange\"(\"id\")\n        ON DELETE NO ACTION ON UPDATE CASCADE;\n\nCREATE TABLE \"BookingRebookingLeg\" (\n    \"rebookingId\" TEXT NOT NULL,\n    \"fromLegId\" INTEGER NOT NULL,\n    \"toLegId\" INTEGER NOT NULL,\n\n    CONSTRAINT \"BookingRebookingLeg_pkey\" PRIMARY KEY (\"rebookingId\", \"fromLegId\"),\n    CONSTRAINT \"BookingRebookingLeg_different_legs\" CHECK (\"fromLegId\" <> \"toLegId\")\n);\n\nCREATE UNIQUE INDEX \"BookingRebookingLeg_fromLegId_key\"\n    ON \"BookingRebookingLeg\"(\"fromLegId\");\nCREATE UNIQUE INDEX \"BookingRebookingLeg_toLegId_key\"\n    ON \"BookingRebookingLeg\"(\"toLegId\");\n\nALTER TABLE \"BookingRebookingLeg\"\n    ADD CONSTRAINT \"BookingRebookingLeg_rebookingId_fkey\"\n        FOREIGN KEY (\"rebookingId\") REFERENCES \"BookingRebooking\"(\"id\")\n        ON DELETE CASCADE ON UPDATE CASCADE,\n    ADD CONSTRAINT \"BookingRebookingLeg_fromLegId_fkey\"\n        FOREIGN KEY (\"fromLegId\") REFERENCES \"ItineraryLeg\"(\"id\")\n        ON DELETE NO ACTION ON UPDATE CASCADE,\n    ADD CONSTRAINT \"BookingRebookingLeg_toLegId_fkey\"\n        FOREIGN KEY (\"toLegId\") REFERENCES \"ItineraryLeg\"(\"id\")\n        ON DELETE NO ACTION ON UPDATE CASCADE;\n\n-- A leg is historical forever once replaced. Changing the timestamp would\n-- rewrite when it stopped being the customer's itinerary; clearing it would\n-- make two histories current again.\nCREATE FUNCTION \"refuse_itinerary_leg_unsupersession\"()\nRETURNS TRIGGER AS $$\nBEGIN\n    IF OLD.\"supersededAt\" IS NOT NULL\n       AND NEW.\"supersededAt\" IS DISTINCT FROM OLD.\"supersededAt\" THEN\n        RAISE EXCEPTION\n            'ItineraryLeg supersession is permanent: leg % cannot become active or change time.',\n            OLD.\"id\";\n    END IF;\n    RETURN NEW;\nEND;\n$$ LANGUAGE plpgsql;\n\nCREATE TRIGGER \"ItineraryLeg_supersession_is_permanent\"\n    BEFORE UPDATE OF \"supersededAt\" ON \"ItineraryLeg\"\n    FOR EACH ROW EXECUTE FUNCTION \"refuse_itinerary_leg_unsupersession\"();\n\n-- A superseded leg must be named by an immutable rebooking mapping before its\n-- transaction commits. Deferred because the event and replacement leg are\n-- naturally written after the original leg is marked historical.\nCREATE FUNCTION \"require_recorded_leg_supersession\"()\nRETURNS TRIGGER AS $$\nBEGIN\n    IF NOT EXISTS (SELECT 1 FROM \"ItineraryLeg\" WHERE \"id\" = NEW.\"id\") THEN\n        RETURN NULL;\n    END IF;\n    IF NOT EXISTS (\n        SELECT 1 FROM \"BookingRebookingLeg\" WHERE \"fromLegId\" = NEW.\"id\"\n    ) THEN\n        RAISE EXCEPTION\n            'Superseded ItineraryLeg % must be recorded by a BookingRebookingLeg.',\n            NEW.\"id\";\n    END IF;\n    RETURN NULL;\nEND;\n$$ LANGUAGE plpgsql;\n\nCREATE CONSTRAINT TRIGGER \"ItineraryLeg_supersession_is_recorded\"\n    AFTER UPDATE OF \"supersededAt\" ON \"ItineraryLeg\"\n    DEFERRABLE INITIALLY DEFERRED\n    FOR EACH ROW\n    WHEN (OLD.\"supersededAt\" IS NULL AND NEW.\"supersededAt\" IS NOT NULL)\n    EXECUTE FUNCTION \"require_recorded_leg_supersession\"();\n\n-- The status row is the booking-wide audit sequence. A rebooking can only be\n-- attached to the transition that resolves a disruption, for the same\n-- booking, and cannot simultaneously claim a refund.\nCREATE FUNCTION \"validate_booking_rebooking\"()\nRETURNS TRIGGER AS $$\nDECLARE\n    change \"BookingStatusChange\";\nBEGIN\n    SELECT * INTO change\n    FROM \"BookingStatusChange\"\n    WHERE \"id\" = NEW.\"bookingStatusChangeId\";\n\n    IF NOT FOUND\n       OR change.\"bookingId\" <> NEW.\"bookingId\"\n       OR change.\"from\" IS DISTINCT FROM 'DISRUPTED'::\"BookingStatus\"\n       OR change.\"to\" IS DISTINCT FROM 'CONFIRMED'::\"BookingStatus\"\n       OR change.\"refundCents\" IS NOT NULL THEN\n        RAISE EXCEPTION\n            'BookingRebooking must match one non-refunding DISRUPTED to CONFIRMED status change.';\n    END IF;\n    RETURN NEW;\nEND;\n$$ LANGUAGE plpgsql;\n\nCREATE TRIGGER \"BookingRebooking_is_consistent\"\n    BEFORE INSERT ON \"BookingRebooking\"\n    FOR EACH ROW EXECUTE FUNCTION \"validate_booking_rebooking\"();\n\n-- Both legs remain real rows. The old one must already be historical, the new\n-- one current, and both must occupy the same position in this booking.\nCREATE FUNCTION \"validate_booking_rebooking_leg\"()\nRETURNS TRIGGER AS $$\nDECLARE\n    event_booking_id INTEGER;\n    from_booking_id INTEGER;\n    from_sequence INTEGER;\n    from_superseded_at TIMESTAMP(3);\n    to_booking_id INTEGER;\n    to_sequence INTEGER;\n    to_superseded_at TIMESTAMP(3);\nBEGIN\n    SELECT \"bookingId\" INTO event_booking_id\n    FROM \"BookingRebooking\"\n    WHERE \"id\" = NEW.\"rebookingId\";\n    SELECT \"bookingId\", \"sequence\", \"supersededAt\"\n        INTO from_booking_id, from_sequence, from_superseded_at\n    FROM \"ItineraryLeg\" WHERE \"id\" = NEW.\"fromLegId\";\n    SELECT \"bookingId\", \"sequence\", \"supersededAt\"\n        INTO to_booking_id, to_sequence, to_superseded_at\n    FROM \"ItineraryLeg\" WHERE \"id\" = NEW.\"toLegId\";\n\n    IF event_booking_id IS NULL\n       OR from_booking_id IS NULL\n       OR to_booking_id IS NULL\n       OR from_booking_id <> event_booking_id\n       OR to_booking_id <> event_booking_id\n       OR from_sequence <> to_sequence\n       OR from_superseded_at IS NULL\n       OR to_superseded_at IS NOT NULL THEN\n        RAISE EXCEPTION\n            'BookingRebookingLeg must map superseded and active legs from the same booking and same itinerary position.';\n    END IF;\n    RETURN NEW;\nEND;\n$$ LANGUAGE plpgsql;\n\nCREATE TRIGGER \"BookingRebookingLeg_is_consistent\"\n    BEFORE INSERT ON \"BookingRebookingLeg\"\n    FOR EACH ROW EXECUTE FUNCTION \"validate_booking_rebooking_leg\"();\n\n-- An event with no leg mapping says a rebooking happened but cannot say what\n-- changed. Deferred so a normal transaction can insert the event first.\nCREATE FUNCTION \"require_rebooking_legs\"()\nRETURNS TRIGGER AS $$\nBEGIN\n    IF NOT EXISTS (SELECT 1 FROM \"BookingRebooking\" WHERE \"id\" = NEW.\"id\") THEN\n        RETURN NULL;\n    END IF;\n    IF NOT EXISTS (\n        SELECT 1 FROM \"BookingRebookingLeg\" WHERE \"rebookingId\" = NEW.\"id\"\n    ) THEN\n        RAISE EXCEPTION 'BookingRebooking % must map at least one itinerary leg.', NEW.\"id\";\n    END IF;\n    RETURN NULL;\nEND;\n$$ LANGUAGE plpgsql;\n\nCREATE CONSTRAINT TRIGGER \"BookingRebooking_has_legs\"\n    AFTER INSERT ON \"BookingRebooking\"\n    DEFERRABLE INITIALLY DEFERRED\n    FOR EACH ROW EXECUTE FUNCTION \"require_rebooking_legs\"();\n\n-- Updates rewrite audit history. Deletes remain available only through the\n-- booking cascade, matching BookingStatusChange and test-data cleanup.\nCREATE FUNCTION \"refuse_rebooking_audit_update\"()\nRETURNS TRIGGER AS $$\nBEGIN\n    RAISE EXCEPTION '% is append-only and cannot be modified.', TG_TABLE_NAME;\nEND;\n$$ LANGUAGE plpgsql;\n\nCREATE TRIGGER \"BookingRebooking_is_append_only\"\n    BEFORE UPDATE ON \"BookingRebooking\"\n    FOR EACH ROW EXECUTE FUNCTION \"refuse_rebooking_audit_update\"();\n\nCREATE TRIGGER \"BookingRebookingLeg_is_append_only\"\n    BEFORE UPDATE ON \"BookingRebookingLeg\"\n    FOR EACH ROW EXECUTE FUNCTION \"refuse_rebooking_audit_update\"();\n"}},"status":"completed","stdout":"Success. Updated the following files:\nA /home/scottdensmore/Developer/scottdensmore/travel-app/prisma/migrations/20260816181000_version_itinerary_legs/migration.sql\n","stderr":""},"started_at_ms":1786903591382,"completed_at_ms":1786903591646}}
