{"timestamp":"2026-08-16T19:02:24.116Z","ordinal":25304,"type":"event_msg","payload":{"type":"item_completed","thread_id":"019ffe5b-1054-7c22-8afc-e97cb84c7b73","turn_id":"01a00bba-29dd-7100-8715-811d18e7c7e1","item":{"type":"CommandExecution","id":"exec-74256ff7-d886-43a7-90b4-c9ec1e2bb515","process_id":"52913","command":["/bin/bash","-lc","git status --short && git diff --check && nl -ba prisma/migrations/20260816181000_version_itinerary_legs/migration.sql | sed -n '35,350p' && nl -ba __tests__/lib/itineraryRebooking.database.test.ts | sed -n '150,470p'"],"cwd":"file:///home/scottdensmore/Developer/scottdensmore/travel-app","parsed_cmd":[{"type":"unknown","cmd":"git status --short && git diff --check && nl -ba prisma/migrations/20260816181000_version_itinerary_legs/migration.sql | sed -n '35,350p' && nl -ba __tests__/lib/itineraryRebooking.database.test.ts | sed -n '150,470p'"}],"source":"unified_exec_startup","status":"completed","stdout":" M __tests__/app/actions.test.ts\n M __tests__/lib/FlightBookingService.test.ts\n M __tests__/lib/bookingItinerary.test.ts\n M app/actions.ts\n M app/admin/flights/page.tsx\n M app/admin/page.tsx\n M app/profile/page.tsx\n M lib/FlightBookingService.ts\n M lib/bookingItinerary.ts\n M lib/flightLock.ts\n M prisma/schema.prisma\n?? __tests__/app/activeItineraryReads.test.tsx\n?? __tests__/lib/itineraryRebooking.database.test.ts\n?? prisma/migrations/20260816181000_version_itinerary_legs/\n    35\t-- rows share a sequence, restoring the unconditional unique key is impossible\n    36\t-- without deleting audit history.\n    37\t\n    38\tCREATE TYPE \"RebookingFarePolicy\" AS ENUM ('DISRUPTION_WAIVER');\n    39\t\n    40\tALTER TABLE \"ItineraryLeg\"\n    41\t    ADD COLUMN \"supersededAt\" TIMESTAMP(3);\n    42\t\n    43\tDROP INDEX \"ItineraryLeg_bookingId_sequence_key\";\n    44\t\n    45\t-- Historical rows may share a position; exactly one current row may not.\n    46\tCREATE UNIQUE INDEX \"ItineraryLeg_active_booking_sequence_key\"\n    47\t    ON \"ItineraryLeg\"(\"bookingId\", \"sequence\")\n    48\t    WHERE \"supersededAt\" IS NULL;\n    49\t\n    50\tCREATE INDEX \"ItineraryLeg_bookingId_supersededAt_sequence_idx\"\n    51\t    ON \"ItineraryLeg\"(\"bookingId\", \"supersededAt\", \"sequence\");\n    52\t\n    53\tCREATE TABLE \"BookingRebooking\" (\n    54\t    \"id\" TEXT NOT NULL,\n    55\t    \"bookingId\" INTEGER NOT NULL,\n    56\t    \"bookingStatusChangeId\" TEXT NOT NULL,\n    57\t    \"farePolicy\" \"RebookingFarePolicy\" NOT NULL DEFAULT 'DISRUPTION_WAIVER',\n    58\t    \"createdAt\" TIMESTAMP(3) NOT NULL DEFAULT CURRENT_TIMESTAMP,\n    59\t\n    60\t    CONSTRAINT \"BookingRebooking_pkey\" PRIMARY KEY (\"id\")\n    61\t);\n    62\t\n    63\tCREATE UNIQUE INDEX \"BookingRebooking_bookingStatusChangeId_key\"\n    64\t    ON \"BookingRebooking\"(\"bookingStatusChangeId\");\n    65\tCREATE INDEX \"BookingRebooking_bookingId_createdAt_idx\"\n    66\t    ON \"BookingRebooking\"(\"bookingId\", \"createdAt\");\n    67\t\n    68\tALTER TABLE \"BookingRebooking\"\n    69\t    ADD CONSTRAINT \"BookingRebooking_bookingId_fkey\"\n    70\t        FOREIGN KEY (\"bookingId\") REFERENCES \"Booking\"(\"id\")\n    71\t        ON DELETE CASCADE ON UPDATE CASCADE,\n    72\t    ADD CONSTRAINT \"BookingRebooking_bookingStatusChangeId_fkey\"\n    73\t        FOREIGN KEY (\"bookingStatusChangeId\") REFERENCES \"BookingStatusChange\"(\"id\")\n    74\t        ON DELETE NO ACTION ON UPDATE CASCADE;\n    75\t\n    76\tCREATE TABLE \"BookingRebookingLeg\" (\n    77\t    \"rebookingId\" TEXT NOT NULL,\n    78\t    \"fromLegId\" INTEGER NOT NULL,\n    79\t    \"toLegId\" INTEGER NOT NULL,\n    80\t\n    81\t    CONSTRAINT \"BookingRebookingLeg_pkey\" PRIMARY KEY (\"rebookingId\", \"fromLegId\"),\n    82\t    CONSTRAINT \"BookingRebookingLeg_different_legs\" CHECK (\"fromLegId\" <> \"toLegId\")\n    83\t);\n    84\t\n    85\tCREATE UNIQUE INDEX \"BookingRebookingLeg_fromLegId_key\"\n    86\t    ON \"BookingRebookingLeg\"(\"fromLegId\");\n    87\tCREATE UNIQUE INDEX \"BookingRebookingLeg_toLegId_key\"\n    88\t    ON \"BookingRebookingLeg\"(\"toLegId\");\n    89\t\n    90\tALTER TABLE \"BookingRebookingLeg\"\n    91\t    ADD CONSTRAINT \"BookingRebookingLeg_rebookingId_fkey\"\n    92\t        FOREIGN KEY (\"rebookingId\") REFERENCES \"BookingRebooking\"(\"id\")\n    93\t        ON DELETE CASCADE ON UPDATE CASCADE,\n    94\t    ADD CONSTRAINT \"BookingRebookingLeg_fromLegId_fkey\"\n    95\t        FOREIGN KEY (\"fromLegId\") REFERENCES \"ItineraryLeg\"(\"id\")\n    96\t        ON DELETE CASCADE ON UPDATE CASCADE,\n    97\t    ADD CONSTRAINT \"BookingRebookingLeg_toLegId_fkey\"\n    98\t        FOREIGN KEY (\"toLegId\") REFERENCES \"ItineraryLeg\"(\"id\")\n    99\t        ON DELETE CASCADE ON UPDATE CASCADE;\n   100\t\n   101\t-- Every historical leg has to become historical through the recorded update\n   102\t-- below. Accepting a row that starts superseded would bypass that audit path.\n   103\tCREATE FUNCTION \"require_new_itinerary_leg_active\"()\n   104\tRETURNS TRIGGER AS $$\n   105\tBEGIN\n   106\t    IF NEW.\"supersededAt\" IS NOT NULL THEN\n   107\t        RAISE EXCEPTION\n   108\t            'A new ItineraryLeg must start active; supersede it through a recorded rebooking.';\n   109\t    END IF;\n   110\t    RETURN NEW;\n   111\tEND;\n   112\t$$ LANGUAGE plpgsql;\n   113\t\n   114\tCREATE TRIGGER \"ItineraryLeg_starts_active\"\n   115\t    BEFORE INSERT ON \"ItineraryLeg\"\n   116\t    FOR EACH ROW EXECUTE FUNCTION \"require_new_itinerary_leg_active\"();\n   117\t\n   118\t-- A leg disappears only when its whole booking does. Deferred so the booking\n   119\t-- cascade has removed the parent by the time this checks it; a direct leg\n   120\t-- delete, even beside deletion of its audit mapping, still sees the booking.\n   121\tCREATE FUNCTION \"require_itinerary_leg_booking_delete\"()\n   122\tRETURNS TRIGGER AS $$\n   123\tBEGIN\n   124\t    IF EXISTS (SELECT 1 FROM \"Booking\" WHERE \"id\" = OLD.\"bookingId\") THEN\n   125\t        RAISE EXCEPTION\n   126\t            'ItineraryLeg % cannot be deleted while booking % exists.',\n   127\t            OLD.\"id\", OLD.\"bookingId\";\n   128\t    END IF;\n   129\t    RETURN NULL;\n   130\tEND;\n   131\t$$ LANGUAGE plpgsql;\n   132\t\n   133\tCREATE CONSTRAINT TRIGGER \"ItineraryLeg_deletes_with_booking\"\n   134\t    AFTER DELETE ON \"ItineraryLeg\"\n   135\t    DEFERRABLE INITIALLY DEFERRED\n   136\t    FOR EACH ROW EXECUTE FUNCTION \"require_itinerary_leg_booking_delete\"();\n   137\t\n   138\t-- A leg's identity never changes in place: a different flight is a new version.\n   139\t-- Once superseded, its timestamp is permanent too. The sole state transition\n   140\t-- this permits is setting supersededAt on a currently active leg.\n   141\tCREATE FUNCTION \"refuse_itinerary_leg_rewrite\"()\n   142\tRETURNS TRIGGER AS $$\n   143\tBEGIN\n   144\t    IF NEW.\"id\" IS DISTINCT FROM OLD.\"id\"\n   145\t       OR NEW.\"bookingId\" IS DISTINCT FROM OLD.\"bookingId\"\n   146\t       OR NEW.\"sequence\" IS DISTINCT FROM OLD.\"sequence\"\n   147\t       OR NEW.\"flightId\" IS DISTINCT FROM OLD.\"flightId\" THEN\n   148\t        RAISE EXCEPTION\n   149\t            'ItineraryLeg identity is immutable: replace leg % with a new version.',\n   150\t            OLD.\"id\";\n   151\t    END IF;\n   152\t    IF OLD.\"supersededAt\" IS NOT NULL\n   153\t       AND NEW.\"supersededAt\" IS DISTINCT FROM OLD.\"supersededAt\" THEN\n   154\t        RAISE EXCEPTION\n   155\t            'ItineraryLeg supersession is permanent: leg % cannot become active or change time.',\n   156\t            OLD.\"id\";\n   157\t    END IF;\n   158\t    RETURN NEW;\n   159\tEND;\n   160\t$$ LANGUAGE plpgsql;\n   161\t\n   162\tCREATE TRIGGER \"ItineraryLeg_supersession_is_permanent\"\n   163\t    BEFORE UPDATE ON \"ItineraryLeg\"\n   164\t    FOR EACH ROW EXECUTE FUNCTION \"refuse_itinerary_leg_rewrite\"();\n   165\t\n   166\t-- A superseded leg must be named by an immutable rebooking mapping before its\n   167\t-- transaction commits. Deferred because the event and replacement leg are\n   168\t-- naturally written after the original leg is marked historical.\n   169\tCREATE FUNCTION \"require_recorded_leg_supersession\"()\n   170\tRETURNS TRIGGER AS $$\n   171\tBEGIN\n   172\t    IF NOT EXISTS (SELECT 1 FROM \"ItineraryLeg\" WHERE \"id\" = NEW.\"id\") THEN\n   173\t        RETURN NULL;\n   174\t    END IF;\n   175\t    IF NOT EXISTS (\n   176\t        SELECT 1 FROM \"BookingRebookingLeg\" WHERE \"fromLegId\" = NEW.\"id\"\n   177\t    ) THEN\n   178\t        RAISE EXCEPTION\n   179\t            'Superseded ItineraryLeg % must be recorded by a BookingRebookingLeg.',\n   180\t            NEW.\"id\";\n   181\t    END IF;\n   182\t    IF EXISTS (\n   183\t        SELECT 1 FROM \"SeatAssignment\"\n   184\t        WHERE \"legId\" = NEW.\"id\" AND \"releasedAt\" IS NULL\n   185\t    ) THEN\n   186\t        RAISE EXCEPTION\n   187\t            'Superseded ItineraryLeg % cannot retain live seat assignments.',\n   188\t            NEW.\"id\";\n   189\t    END IF;\n   190\t    RETURN NULL;\n   191\tEND;\n   192\t$$ LANGUAGE plpgsql;\n   193\t\n   194\tCREATE CONSTRAINT TRIGGER \"ItineraryLeg_supersession_is_recorded\"\n   195\t    AFTER UPDATE OF \"supersededAt\" ON \"ItineraryLeg\"\n   196\t    DEFERRABLE INITIALLY DEFERRED\n   197\t    FOR EACH ROW\n   198\t    WHEN (OLD.\"supersededAt\" IS NULL AND NEW.\"supersededAt\" IS NOT NULL)\n   199\t    EXECUTE FUNCTION \"require_recorded_leg_supersession\"();\n   200\t\n   201\t-- The status row is the booking-wide audit sequence. A rebooking can only be\n   202\t-- attached to the transition that resolves a disruption, for the same\n   203\t-- booking, and cannot simultaneously claim a refund.\n   204\tCREATE FUNCTION \"validate_booking_rebooking\"()\n   205\tRETURNS TRIGGER AS $$\n   206\tDECLARE\n   207\t    change \"BookingStatusChange\";\n   208\tBEGIN\n   209\t    SELECT * INTO change\n   210\t    FROM \"BookingStatusChange\"\n   211\t    WHERE \"id\" = NEW.\"bookingStatusChangeId\";\n   212\t\n   213\t    IF NOT FOUND\n   214\t       OR change.\"bookingId\" <> NEW.\"bookingId\"\n   215\t       OR change.\"from\" IS DISTINCT FROM 'DISRUPTED'::\"BookingStatus\"\n   216\t       OR change.\"to\" IS DISTINCT FROM 'CONFIRMED'::\"BookingStatus\"\n   217\t       OR change.\"refundCents\" IS NOT NULL THEN\n   218\t        RAISE EXCEPTION\n   219\t            'BookingRebooking must match one non-refunding DISRUPTED to CONFIRMED status change.';\n   220\t    END IF;\n   221\t    RETURN NEW;\n   222\tEND;\n   223\t$$ LANGUAGE plpgsql;\n   224\t\n   225\tCREATE TRIGGER \"BookingRebooking_is_consistent\"\n   226\t    BEFORE INSERT ON \"BookingRebooking\"\n   227\t    FOR EACH ROW EXECUTE FUNCTION \"validate_booking_rebooking\"();\n   228\t\n   229\t-- Both legs remain real rows. The old one must already be historical, the new\n   230\t-- one current, and both must occupy the same position in this booking.\n   231\tCREATE FUNCTION \"validate_booking_rebooking_leg\"()\n   232\tRETURNS TRIGGER AS $$\n   233\tDECLARE\n   234\t    event_booking_id INTEGER;\n   235\t    from_booking_id INTEGER;\n   236\t    from_sequence INTEGER;\n   237\t    from_superseded_at TIMESTAMP(3);\n   238\t    to_booking_id INTEGER;\n   239\t    to_sequence INTEGER;\n   240\t    to_superseded_at TIMESTAMP(3);\n   241\tBEGIN\n   242\t    SELECT \"bookingId\" INTO event_booking_id\n   243\t    FROM \"BookingRebooking\"\n   244\t    WHERE \"id\" = NEW.\"rebookingId\";\n   245\t    SELECT \"bookingId\", \"sequence\", \"supersededAt\"\n   246\t        INTO from_booking_id, from_sequence, from_superseded_at\n   247\t    FROM \"ItineraryLeg\" WHERE \"id\" = NEW.\"fromLegId\";\n   248\t    SELECT \"bookingId\", \"sequence\", \"supersededAt\"\n   249\t        INTO to_booking_id, to_sequence, to_superseded_at\n   250\t    FROM \"ItineraryLeg\" WHERE \"id\" = NEW.\"toLegId\";\n   251\t\n   252\t    IF event_booking_id IS NULL\n   253\t       OR from_booking_id IS NULL\n   254\t       OR to_booking_id IS NULL\n   255\t       OR from_booking_id <> event_booking_id\n   256\t       OR to_booking_id <> event_booking_id\n   257\t       OR from_sequence <> to_sequence\n   258\t       OR from_superseded_at IS NULL\n   259\t       OR to_superseded_at IS NOT NULL THEN\n   260\t        RAISE EXCEPTION\n   261\t            'BookingRebookingLeg must map superseded and active legs from the same booking and same itinerary position.';\n   262\t    END IF;\n   263\t    RETURN NEW;\n   264\tEND;\n   265\t$$ LANGUAGE plpgsql;\n   266\t\n   267\tCREATE TRIGGER \"BookingRebookingLeg_is_consistent\"\n   268\t    BEFORE INSERT ON \"BookingRebookingLeg\"\n   269\t    FOR EACH ROW EXECUTE FUNCTION \"validate_booking_rebooking_leg\"();\n   270\t\n   271\t-- An event with no leg mapping says a rebooking happened but cannot say what\n   272\t-- changed. Deferred so a normal transaction can insert the event first.\n   273\tCREATE FUNCTION \"require_rebooking_legs\"()\n   274\tRETURNS TRIGGER AS $$\n   275\tBEGIN\n   276\t    IF NOT EXISTS (SELECT 1 FROM \"BookingRebooking\" WHERE \"id\" = NEW.\"id\") THEN\n   277\t        RETURN NULL;\n   278\t    END IF;\n   279\t    IF NOT EXISTS (\n   280\t        SELECT 1 FROM \"BookingRebookingLeg\" WHERE \"rebookingId\" = NEW.\"id\"\n   281\t    ) THEN\n   282\t        RAISE EXCEPTION 'BookingRebooking % must map at least one itinerary leg.', NEW.\"id\";\n   283\t    END IF;\n   284\t    RETURN NULL;\n   285\tEND;\n   286\t$$ LANGUAGE plpgsql;\n   287\t\n   288\tCREATE CONSTRAINT TRIGGER \"BookingRebooking_has_legs\"\n   289\t    AFTER INSERT ON \"BookingRebooking\"\n   290\t    DEFERRABLE INITIALLY DEFERRED\n   291\t    FOR EACH ROW EXECUTE FUNCTION \"require_rebooking_legs\"();\n   292\t\n   293\t-- A direct mapping or event delete would leave its source leg historical with\n   294\t-- no record of what replaced it. Deferred so deleting the whole booking remains\n   295\t-- possible: that cascade also deletes the source leg before this check runs.\n   296\tCREATE FUNCTION \"require_supersession_mapping_after_delete\"()\n   297\tRETURNS TRIGGER AS $$\n   298\tBEGIN\n   299\t    IF EXISTS (\n   300\t        SELECT 1 FROM \"ItineraryLeg\"\n   301\t        WHERE \"id\" = OLD.\"fromLegId\" AND \"supersededAt\" IS NOT NULL\n   302\t    ) AND NOT EXISTS (\n   303\t        SELECT 1 FROM \"BookingRebookingLeg\" WHERE \"fromLegId\" = OLD.\"fromLegId\"\n   304\t    ) THEN\n   305\t        RAISE EXCEPTION\n   306\t            'BookingRebookingLeg for superseded ItineraryLeg % cannot be deleted directly.',\n   307\t            OLD.\"fromLegId\";\n   308\t    END IF;\n   309\t    RETURN NULL;\n   310\tEND;\n   311\t$$ LANGUAGE plpgsql;\n   312\t\n   313\tCREATE CONSTRAINT TRIGGER \"BookingRebookingLeg_preserves_supersession\"\n   314\t    AFTER DELETE ON \"BookingRebookingLeg\"\n   315\t    DEFERRABLE INITIALLY DEFERRED\n   316\t    FOR EACH ROW EXECUTE FUNCTION \"require_supersession_mapping_after_delete\"();\n   317\t\n   318\t-- Updates rewrite audit history. Deletes remain available only through the\n   319\t-- booking cascade, matching BookingStatusChange and test-data cleanup.\n   320\tCREATE FUNCTION \"refuse_rebooking_audit_update\"()\n   321\tRETURNS TRIGGER AS $$\n   322\tBEGIN\n   323\t    RAISE EXCEPTION '% is append-only and cannot be modified.', TG_TABLE_NAME;\n   324\tEND;\n   325\t$$ LANGUAGE plpgsql;\n   326\t\n   327\tCREATE TRIGGER \"BookingRebooking_is_append_only\"\n   328\t    BEFORE UPDATE ON \"BookingRebooking\"\n   329\t    FOR EACH ROW EXECUTE FUNCTION \"refuse_rebooking_audit_update\"();\n   330\t\n   331\tCREATE TRIGGER \"BookingRebookingLeg_is_append_only\"\n   332\t    BEFORE UPDATE ON \"BookingRebookingLeg\"\n   333\t    FOR EACH ROW EXECUTE FUNCTION \"refuse_rebooking_audit_update\"();\n   150\tdescribe('immutable itinerary rebooking records', () => {\n   151\t    it('keeps the original leg and released seat while one replacement becomes active', async () => {\n   152\t        const saved = await recordRebooking();\n   153\t\n   154\t        const legs = await prisma.$queryRaw<Array<{\n   155\t            id: number;\n   156\t            supersededAt: Date | null;\n   157\t        }>>`\n   158\t            SELECT \"id\", \"supersededAt\"\n   159\t            FROM \"ItineraryLeg\"\n   160\t            WHERE \"bookingId\" = ${saved.booking.id}\n   161\t            ORDER BY \"id\"\n   162\t        `;\n   163\t        const seats = await prisma.seatAssignment.findMany({\n   164\t            where: { passengerId: saved.passengerId },\n   165\t            orderBy: { id: 'asc' },\n   166\t        });\n   167\t        const currentBooking = await prisma.booking.findUniqueOrThrow({\n   168\t            where: { id: saved.booking.id },\n   169\t            include: { rebookings: true },\n   170\t        });\n   171\t\n   172\t        expect(legs).toEqual([\n   173\t            { id: saved.oldLeg.id, supersededAt: expect.any(Date) },\n   174\t            { id: saved.newLegId, supersededAt: null },\n   175\t        ]);\n   176\t        expect(seats).toEqual(expect.arrayContaining([\n   177\t            expect.objectContaining({ legId: saved.oldLeg.id, seatNumber: '11A', releasedAt: expect.any(Date) }),\n   178\t            expect.objectContaining({ legId: saved.newLegId, seatNumber: '14C', releasedAt: null }),\n   179\t        ]));\n   180\t        expect(currentBooking).toMatchObject({\n   181\t            status: 'CONFIRMED',\n   182\t            paymentIntentId: saved.booking.paymentIntentId,\n   183\t            totalPriceCents: 30_000,\n   184\t            rebookings: [expect.objectContaining({\n   185\t                id: saved.rebookingId,\n   186\t                farePolicy: 'DISRUPTION_WAIVER',\n   187\t            })],\n   188\t        });\n   189\t        expect(saved.replacementFlight.priceCents).toBe(45_000);\n   190\t    });\n   191\t\n   192\t    it('stops treating the superseded flight as part of the live booking', async () => {\n   193\t        const saved = await recordRebooking();\n   194\t\n   195\t        const locked = await prisma.$transaction(async tx => ({\n   196\t            oldFlight: await lockBookingsOnFlightForUpdate(tx, saved.oldLeg.flightId),\n   197\t            replacementFlight: await lockBookingsOnFlightForUpdate(\n   198\t                tx,\n   199\t                saved.replacementFlight.id,\n   200\t            ),\n   201\t        }));\n   202\t\n   203\t        expect(locked).toEqual({\n   204\t            oldFlight: [],\n   205\t            replacementFlight: [saved.booking.id],\n   206\t        });\n   207\t    });\n   208\t\n   209\t    it('allows only one active leg at an itinerary position', async () => {\n   210\t        const saved = await recordRebooking();\n   211\t        const anotherFlight = await flight('THIRD');\n   212\t\n   213\t        await expect(prisma.$executeRaw`\n   214\t            INSERT INTO \"ItineraryLeg\" (\"bookingId\", \"sequence\", \"flightId\")\n   215\t            VALUES (${saved.booking.id}, 1, ${anotherFlight.id})\n   216\t        `).rejects.toThrow(/Key \\(\\\"bookingId\\\", sequence\\)=\\(.+, 1\\) already exists/);\n   217\t    });\n   218\t\n   219\t    it('requires every new leg to start active', async () => {\n   220\t        const scenario = await disruptedBooking();\n   221\t        const anotherFlight = await flight('PRE-SUPERSEDED');\n   222\t\n   223\t        await expect(prisma.$executeRaw`\n   224\t            INSERT INTO \"ItineraryLeg\"\n   225\t                (\"bookingId\", \"sequence\", \"flightId\", \"supersededAt\")\n   226\t            VALUES (\n   227\t                ${scenario.booking.id},\n   228\t                2,\n   229\t                ${anotherFlight.id},\n   230\t                statement_timestamp()\n   231\t            )\n   232\t        `).rejects.toThrow(/new ItineraryLeg must start active/);\n   233\t    });\n   234\t\n   235\t    it('never lets a superseded leg become active again', async () => {\n   236\t        const saved = await recordRebooking();\n   237\t\n   238\t        await expect(prisma.$executeRaw`\n   239\t            UPDATE \"ItineraryLeg\" SET \"supersededAt\" = NULL WHERE \"id\" = ${saved.oldLeg.id}\n   240\t        `).rejects.toThrow(/ItineraryLeg supersession is permanent/);\n   241\t    });\n   242\t\n   243\t    it('requires a new version instead of rewriting a leg in place', async () => {\n   244\t        const scenario = await disruptedBooking();\n   245\t        const anotherFlight = await flight('IN-PLACE-REWRITE');\n   246\t\n   247\t        await expect(prisma.$executeRaw`\n   248\t            UPDATE \"ItineraryLeg\"\n   249\t            SET \"flightId\" = ${anotherFlight.id}\n   250\t            WHERE \"id\" = ${scenario.oldLeg.id}\n   251\t        `).rejects.toThrow(/ItineraryLeg identity is immutable/);\n   252\t    });\n   253\t\n   254\t    it('refuses to delete a leg while its booking still exists', async () => {\n   255\t        const scenario = await disruptedBooking();\n   256\t\n   257\t        await expect(prisma.itineraryLeg.delete({\n   258\t            where: { id: scenario.oldLeg.id },\n   259\t        })).rejects.toThrow(/cannot be deleted while booking/);\n   260\t\n   261\t        expect(await prisma.itineraryLeg.count({\n   262\t            where: { id: scenario.oldLeg.id },\n   263\t        })).toBe(1);\n   264\t    });\n   265\t\n   266\t    it('does not let a cascading leg delete erase its rebooking mapping', async () => {\n   267\t        const saved = await recordRebooking();\n   268\t\n   269\t        await expect(prisma.itineraryLeg.delete({\n   270\t            where: { id: saved.oldLeg.id },\n   271\t        })).rejects.toThrow(/cannot be deleted while booking/);\n   272\t\n   273\t        expect(await prisma.bookingRebookingLeg.count({\n   274\t            where: { rebookingId: saved.rebookingId },\n   275\t        })).toBe(1);\n   276\t    });\n   277\t\n   278\t    it('does not let a cascading replacement delete erase its rebooking mapping', async () => {\n   279\t        const saved = await recordRebooking();\n   280\t\n   281\t        await expect(prisma.itineraryLeg.delete({\n   282\t            where: { id: saved.newLegId },\n   283\t        })).rejects.toThrow(/cannot be deleted while booking/);\n   284\t\n   285\t        expect(await prisma.bookingRebookingLeg.count({\n   286\t            where: { rebookingId: saved.rebookingId },\n   287\t        })).toBe(1);\n   288\t    });\n   289\t\n   290\t    it('makes the rebooking event append-only', async () => {\n   291\t        const saved = await recordRebooking();\n   292\t\n   293\t        await expect(prisma.$executeRaw`\n   294\t            UPDATE \"BookingRebooking\" SET \"createdAt\" = \"createdAt\"\n   295\t            WHERE \"id\" = ${saved.rebookingId}\n   296\t        `).rejects.toThrow(/BookingRebooking is append-only/);\n   297\t    });\n   298\t\n   299\t    it('makes the rebooking leg mapping append-only', async () => {\n   300\t        const saved = await recordRebooking();\n   301\t\n   302\t        await expect(prisma.$executeRaw`\n   303\t            UPDATE \"BookingRebookingLeg\" SET \"toLegId\" = \"toLegId\"\n   304\t            WHERE \"rebookingId\" = ${saved.rebookingId}\n   305\t              AND \"fromLegId\" = ${saved.oldLeg.id}\n   306\t        `).rejects.toThrow(/BookingRebookingLeg is append-only/);\n   307\t    });\n   308\t\n   309\t    it('refuses to delete a leg mapping while its historical leg remains', async () => {\n   310\t        const saved = await recordRebooking();\n   311\t\n   312\t        await expect(prisma.$transaction(async tx => {\n   313\t            await tx.bookingRebookingLeg.delete({\n   314\t                where: {\n   315\t                    rebookingId_fromLegId: {\n   316\t                        rebookingId: saved.rebookingId,\n   317\t                        fromLegId: saved.oldLeg.id,\n   318\t                    },\n   319\t                },\n   320\t            });\n   321\t            await tx.$executeRaw`\n   322\t                SET CONSTRAINTS \"BookingRebookingLeg_preserves_supersession\" IMMEDIATE\n   323\t            `;\n   324\t        })).rejects.toThrow(/cannot be deleted directly/);\n   325\t\n   326\t        expect(await prisma.bookingRebookingLeg.count({\n   327\t            where: { rebookingId: saved.rebookingId },\n   328\t        })).toBe(1);\n   329\t    });\n   330\t\n   331\t    it('refuses to delete a rebooking event while its historical leg remains', async () => {\n   332\t        const saved = await recordRebooking();\n   333\t\n   334\t        await expect(prisma.$transaction(async tx => {\n   335\t            await tx.bookingRebooking.delete({ where: { id: saved.rebookingId } });\n   336\t            await tx.$executeRaw`\n   337\t                SET CONSTRAINTS \"BookingRebookingLeg_preserves_supersession\" IMMEDIATE\n   338\t            `;\n   339\t        })).rejects.toThrow(/cannot be deleted directly/);\n   340\t\n   341\t        expect(await prisma.bookingRebooking.count({\n   342\t            where: { id: saved.rebookingId },\n   343\t        })).toBe(1);\n   344\t    });\n   345\t\n   346\t    it('refuses a mapping between different itinerary positions', async () => {\n   347\t        const scenario = await disruptedBooking();\n   348\t        const replacementFlight = await flight('WRONG-SEQUENCE');\n   349\t        const rebookingId = randomUUID();\n   350\t\n   351\t        await expect(prisma.$transaction(async tx => {\n   352\t            await tx.$executeRaw`\n   353\t                UPDATE \"ItineraryLeg\"\n   354\t                SET \"supersededAt\" = statement_timestamp()\n   355\t                WHERE \"id\" = ${scenario.oldLeg.id}\n   356\t            `;\n   357\t            const [wrongLeg] = await tx.$queryRaw<Array<{ id: number }>>`\n   358\t                INSERT INTO \"ItineraryLeg\" (\"bookingId\", \"sequence\", \"flightId\")\n   359\t                VALUES (${scenario.booking.id}, 2, ${replacementFlight.id})\n   360\t                RETURNING \"id\"\n   361\t            `;\n   362\t            await resolveDisruption(tx, scenario.booking.id, rebookingId);\n   363\t            await tx.$executeRaw`\n   364\t                INSERT INTO \"BookingRebookingLeg\" (\"rebookingId\", \"fromLegId\", \"toLegId\")\n   365\t                VALUES (${rebookingId}, ${scenario.oldLeg.id}, ${wrongLeg.id})\n   366\t            `;\n   367\t        })).rejects.toThrow(/same itinerary position/);\n   368\t    });\n   369\t\n   370\t    it('refuses to supersede a leg without recording its replacement', async () => {\n   371\t        const scenario = await disruptedBooking();\n   372\t\n   373\t        await expect(prisma.$executeRaw`\n   374\t            UPDATE \"ItineraryLeg\"\n   375\t            SET \"supersededAt\" = statement_timestamp()\n   376\t            WHERE \"id\" = ${scenario.oldLeg.id}\n   377\t        `).rejects.toThrow(/must be recorded by a BookingRebookingLeg/);\n   378\t    });\n   379\t\n   380\t    it('refuses to supersede a leg while its old seat is still live', async () => {\n   381\t        await expect(recordRebooking({\n   382\t            releaseOldSeat: false,\n   383\t            checkSupersessionNow: true,\n   384\t        })).rejects.toThrow(/cannot retain live seat assignments/);\n   385\t    });\n   386\t\n   387\t    it('refuses a rebooking event with no leg replacement', async () => {\n   388\t        const scenario = await disruptedBooking();\n   389\t        const rebookingId = randomUUID();\n   390\t\n   391\t        await expect(prisma.$transaction(async tx => {\n   392\t            await resolveDisruption(tx, scenario.booking.id, rebookingId);\n   393\t            // Prisma 5 logs a deferred-constraint failure from COMMIT but can\n   394\t            // resolve the interactive-transaction promise. A product writer\n   395\t            // will make all rebooking constraints immediate as its final\n   396\t            // statement; do that here so the rejected write is observable to\n   397\t            // the caller as well as rolled back by PostgreSQL.\n   398\t            await tx.$executeRaw`SET CONSTRAINTS \"BookingRebooking_has_legs\" IMMEDIATE`;\n   399\t        })).rejects.toThrow(/must map at least one itinerary leg/);\n   400\t    });\n   401\t\n   402\t    it('refuses a leg mapping that crosses booking references', async () => {\n   403\t        const scenario = await disruptedBooking();\n   404\t        const other = await disruptedBooking();\n   405\t        const rebookingId = randomUUID();\n   406\t\n   407\t        await expect(prisma.$transaction(async tx => {\n   408\t            await tx.$executeRaw`\n   409\t                UPDATE \"ItineraryLeg\"\n   410\t                SET \"supersededAt\" = statement_timestamp()\n   411\t                WHERE \"id\" = ${scenario.oldLeg.id}\n   412\t            `;\n   413\t            await resolveDisruption(tx, scenario.booking.id, rebookingId);\n   414\t            await tx.$executeRaw`\n   415\t                INSERT INTO \"BookingRebookingLeg\" (\"rebookingId\", \"fromLegId\", \"toLegId\")\n   416\t                VALUES (${rebookingId}, ${scenario.oldLeg.id}, ${other.oldLeg.id})\n   417\t            `;\n   418\t        })).rejects.toThrow(/same booking and same itinerary position/);\n   419\t    });\n   420\t\n   421\t    it('refuses an event whose status change also records a refund', async () => {\n   422\t        const scenario = await disruptedBooking();\n   423\t        const rebookingId = randomUUID();\n   424\t\n   425\t        await expect(prisma.$transaction(async tx => {\n   426\t            await tx.$executeRaw`\n   427\t                SELECT set_config('app.booking_refund_cents', '1', true)\n   428\t            `;\n   429\t            await resolveDisruption(tx, scenario.booking.id, rebookingId);\n   430\t        })).rejects.toThrow(/one non-refunding DISRUPTED to CONFIRMED status change/);\n   431\t    });\n   432\t\n   433\t    it('refuses an event that is not the resolution of a disruption', async () => {\n   434\t        const scenario = await disruptedBooking();\n   435\t        const initialChange = await prisma.bookingStatusChange.findFirstOrThrow({\n   436\t            where: { bookingId: scenario.booking.id, from: null, to: 'DISRUPTED' },\n   437\t        });\n   438\t\n   439\t        await expect(prisma.$executeRaw`\n   440\t            INSERT INTO \"BookingRebooking\"\n   441\t                (\"id\", \"bookingId\", \"bookingStatusChangeId\", \"farePolicy\")\n   442\t            VALUES (\n   443\t                ${randomUUID()},\n   444\t                ${scenario.booking.id},\n   445\t                ${initialChange.id},\n   446\t                'DISRUPTION_WAIVER'\n   447\t            )\n   448\t        `).rejects.toThrow(/one non-refunding DISRUPTED to CONFIRMED status change/);\n   449\t    });\n   450\t\n   451\t    it('cascades the immutable history when its booking is deleted', async () => {\n   452\t        const saved = await recordRebooking();\n   453\t\n   454\t        expect(await prisma.booking.deleteMany({\n   455\t            where: { id: saved.booking.id },\n   456\t        })).toEqual({ count: 1 });\n   457\t\n   458\t        expect(await prisma.bookingRebooking.count({\n   459\t            where: { id: saved.rebookingId },\n   460\t        })).toBe(0);\n   461\t        expect(await prisma.bookingRebookingLeg.count({\n   462\t            where: { rebookingId: saved.rebookingId },\n   463\t        })).toBe(0);\n   464\t        expect(await prisma.itineraryLeg.count({\n   465\t            where: { bookingId: saved.booking.id },\n   466\t        })).toBe(0);\n   467\t    });\n   468\t});\n","stderr":"","aggregated_output":" M __tests__/app/actions.test.ts\n M __tests__/lib/FlightBookingService.test.ts\n M __tests__/lib/bookingItinerary.test.ts\n M app/actions.ts\n M app/admin/flights/page.tsx\n M app/admin/page.tsx\n M app/profile/page.tsx\n M lib/FlightBookingService.ts\n M lib/bookingItinerary.ts\n M lib/flightLock.ts\n M prisma/schema.prisma\n?? __tests__/app/activeItineraryReads.test.tsx\n?? __tests__/lib/itineraryRebooking.database.test.ts\n?? prisma/migrations/20260816181000_version_itinerary_legs/\n    35\t-- rows share a sequence, restoring the unconditional unique key is impossible\n    36\t-- without deleting audit history.\n    37\t\n    38\tCREATE TYPE \"RebookingFarePolicy\" AS ENUM ('DISRUPTION_WAIVER');\n    39\t\n    40\tALTER TABLE \"ItineraryLeg\"\n    41\t    ADD COLUMN \"supersededAt\" TIMESTAMP(3);\n    42\t\n    43\tDROP INDEX \"ItineraryLeg_bookingId_sequence_key\";\n    44\t\n    45\t-- Historical rows may share a position; exactly one current row may not.\n    46\tCREATE UNIQUE INDEX \"ItineraryLeg_active_booking_sequence_key\"\n    47\t    ON \"ItineraryLeg\"(\"bookingId\", \"sequence\")\n    48\t    WHERE \"supersededAt\" IS NULL;\n    49\t\n    50\tCREATE INDEX \"ItineraryLeg_bookingId_supersededAt_sequence_idx\"\n    51\t    ON \"ItineraryLeg\"(\"bookingId\", \"supersededAt\", \"sequence\");\n    52\t\n    53\tCREATE TABLE \"BookingRebooking\" (\n    54\t    \"id\" TEXT NOT NULL,\n    55\t    \"bookingId\" INTEGER NOT NULL,\n    56\t    \"bookingStatusChangeId\" TEXT NOT NULL,\n    57\t    \"farePolicy\" \"RebookingFarePolicy\" NOT NULL DEFAULT 'DISRUPTION_WAIVER',\n    58\t    \"createdAt\" TIMESTAMP(3) NOT NULL DEFAULT CURRENT_TIMESTAMP,\n    59\t\n    60\t    CONSTRAINT \"BookingRebooking_pkey\" PRIMARY KEY (\"id\")\n    61\t);\n    62\t\n    63\tCREATE UNIQUE INDEX \"BookingRebooking_bookingStatusChangeId_key\"\n    64\t    ON \"BookingRebooking\"(\"bookingStatusChangeId\");\n    65\tCREATE INDEX \"BookingRebooking_bookingId_createdAt_idx\"\n    66\t    ON \"BookingRebooking\"(\"bookingId\", \"createdAt\");\n    67\t\n    68\tALTER TABLE \"BookingRebooking\"\n    69\t    ADD CONSTRAINT \"BookingRebooking_bookingId_fkey\"\n    70\t        FOREIGN KEY (\"bookingId\") REFERENCES \"Booking\"(\"id\")\n    71\t        ON DELETE CASCADE ON UPDATE CASCADE,\n    72\t    ADD CONSTRAINT \"BookingRebooking_bookingStatusChangeId_fkey\"\n    73\t        FOREIGN KEY (\"bookingStatusChangeId\") REFERENCES \"BookingStatusChange\"(\"id\")\n    74\t        ON DELETE NO ACTION ON UPDATE CASCADE;\n    75\t\n    76\tCREATE TABLE \"BookingRebookingLeg\" (\n    77\t    \"rebookingId\" TEXT NOT NULL,\n    78\t    \"fromLegId\" INTEGER NOT NULL,\n    79\t    \"toLegId\" INTEGER NOT NULL,\n    80\t\n    81\t    CONSTRAINT \"BookingRebookingLeg_pkey\" PRIMARY KEY (\"rebookingId\", \"fromLegId\"),\n    82\t    CONSTRAINT \"BookingRebookingLeg_different_legs\" CHECK (\"fromLegId\" <> \"toLegId\")\n    83\t);\n    84\t\n    85\tCREATE UNIQUE INDEX \"BookingRebookingLeg_fromLegId_key\"\n    86\t    ON \"BookingRebookingLeg\"(\"fromLegId\");\n    87\tCREATE UNIQUE INDEX \"BookingRebookingLeg_toLegId_key\"\n    88\t    ON \"BookingRebookingLeg\"(\"toLegId\");\n    89\t\n    90\tALTER TABLE \"BookingRebookingLeg\"\n    91\t    ADD CONSTRAINT \"BookingRebookingLeg_rebookingId_fkey\"\n    92\t        FOREIGN KEY (\"rebookingId\") REFERENCES \"BookingRebooking\"(\"id\")\n    93\t        ON DELETE CASCADE ON UPDATE CASCADE,\n    94\t    ADD CONSTRAINT \"BookingRebookingLeg_fromLegId_fkey\"\n    95\t        FOREIGN KEY (\"fromLegId\") REFERENCES \"ItineraryLeg\"(\"id\")\n    96\t        ON DELETE CASCADE ON UPDATE CASCADE,\n    97\t    ADD CONSTRAINT \"BookingRebookingLeg_toLegId_fkey\"\n    98\t        FOREIGN KEY (\"toLegId\") REFERENCES \"ItineraryLeg\"(\"id\")\n    99\t        ON DELETE CASCADE ON UPDATE CASCADE;\n   100\t\n   101\t-- Every historical leg has to become historical through the recorded update\n   102\t-- below. Accepting a row that starts superseded would bypass that audit path.\n   103\tCREATE FUNCTION \"require_new_itinerary_leg_active\"()\n   104\tRETURNS TRIGGER AS $$\n   105\tBEGIN\n   106\t    IF NEW.\"supersededAt\" IS NOT NULL THEN\n   107\t        RAISE EXCEPTION\n   108\t            'A new ItineraryLeg must start active; supersede it through a recorded rebooking.';\n   109\t    END IF;\n   110\t    RETURN NEW;\n   111\tEND;\n   112\t$$ LANGUAGE plpgsql;\n   113\t\n   114\tCREATE TRIGGER \"ItineraryLeg_starts_active\"\n   115\t    BEFORE INSERT ON \"ItineraryLeg\"\n   116\t    FOR EACH ROW EXECUTE FUNCTION \"require_new_itinerary_leg_active\"();\n   117\t\n   118\t-- A leg disappears only when its whole booking does. Deferred so the booking\n   119\t-- cascade has removed the parent by the time this checks it; a direct leg\n   120\t-- delete, even beside deletion of its audit mapping, still sees the booking.\n   121\tCREATE FUNCTION \"require_itinerary_leg_booking_delete\"()\n   122\tRETURNS TRIGGER AS $$\n   123\tBEGIN\n   124\t    IF EXISTS (SELECT 1 FROM \"Booking\" WHERE \"id\" = OLD.\"bookingId\") THEN\n   125\t        RAISE EXCEPTION\n   126\t            'ItineraryLeg % cannot be deleted while booking % exists.',\n   127\t            OLD.\"id\", OLD.\"bookingId\";\n   128\t    END IF;\n   129\t    RETURN NULL;\n   130\tEND;\n   131\t$$ LANGUAGE plpgsql;\n   132\t\n   133\tCREATE CONSTRAINT TRIGGER \"ItineraryLeg_deletes_with_booking\"\n   134\t    AFTER DELETE ON \"ItineraryLeg\"\n   135\t    DEFERRABLE INITIALLY DEFERRED\n   136\t    FOR EACH ROW EXECUTE FUNCTION \"require_itinerary_leg_booking_delete\"();\n   137\t\n   138\t-- A leg's identity never changes in place: a different flight is a new version.\n   139\t-- Once superseded, its timestamp is permanent too. The sole state transition\n   140\t-- this permits is setting supersededAt on a currently active leg.\n   141\tCREATE FUNCTION \"refuse_itinerary_leg_rewrite\"()\n   142\tRETURNS TRIGGER AS $$\n   143\tBEGIN\n   144\t    IF NEW.\"id\" IS DISTINCT FROM OLD.\"id\"\n   145\t       OR NEW.\"bookingId\" IS DISTINCT FROM OLD.\"bookingId\"\n   146\t       OR NEW.\"sequence\" IS DISTINCT FROM OLD.\"sequence\"\n   147\t       OR NEW.\"flightId\" IS DISTINCT FROM OLD.\"flightId\" THEN\n   148\t        RAISE EXCEPTION\n   149\t            'ItineraryLeg identity is immutable: replace leg % with a new version.',\n   150\t            OLD.\"id\";\n   151\t    END IF;\n   152\t    IF OLD.\"supersededAt\" IS NOT NULL\n   153\t       AND NEW.\"supersededAt\" IS DISTINCT FROM OLD.\"supersededAt\" THEN\n   154\t        RAISE EXCEPTION\n   155\t            'ItineraryLeg supersession is permanent: leg % cannot become active or change time.',\n   156\t            OLD.\"id\";\n   157\t    END IF;\n   158\t    RETURN NEW;\n   159\tEND;\n   160\t$$ LANGUAGE plpgsql;\n   161\t\n   162\tCREATE TRIGGER \"ItineraryLeg_supersession_is_permanent\"\n   163\t    BEFORE UPDATE ON \"ItineraryLeg\"\n   164\t    FOR EACH ROW EXECUTE FUNCTION \"refuse_itinerary_leg_rewrite\"();\n   165\t\n   166\t-- A superseded leg must be named by an immutable rebooking mapping before its\n   167\t-- transaction commits. Deferred because the event and replacement leg are\n   168\t-- naturally written after the original leg is marked historical.\n   169\tCREATE FUNCTION \"require_recorded_leg_supersession\"()\n   170\tRETURNS TRIGGER AS $$\n   171\tBEGIN\n   172\t    IF NOT EXISTS (SELECT 1 FROM \"ItineraryLeg\" WHERE \"id\" = NEW.\"id\") THEN\n   173\t        RETURN NULL;\n   174\t    END IF;\n   175\t    IF NOT EXISTS (\n   176\t        SELECT 1 FROM \"BookingRebookingLeg\" WHERE \"fromLegId\" = NEW.\"id\"\n   177\t    ) THEN\n   178\t        RAISE EXCEPTION\n   179\t            'Superseded ItineraryLeg % must be recorded by a BookingRebookingLeg.',\n   180\t            NEW.\"id\";\n   181\t    END IF;\n   182\t    IF EXISTS (\n   183\t        SELECT 1 FROM \"SeatAssignment\"\n   184\t        WHERE \"legId\" = NEW.\"id\" AND \"releasedAt\" IS NULL\n   185\t    ) THEN\n   186\t        RAISE EXCEPTION\n   187\t            'Superseded ItineraryLeg % cannot retain live seat assignments.',\n   188\t            NEW.\"id\";\n   189\t    END IF;\n   190\t    RETURN NULL;\n   191\tEND;\n   192\t$$ LANGUAGE plpgsql;\n   193\t\n   194\tCREATE CONSTRAINT TRIGGER \"ItineraryLeg_supersession_is_recorded\"\n   195\t    AFTER UPDATE OF \"supersededAt\" ON \"ItineraryLeg\"\n   196\t    DEFERRABLE INITIALLY DEFERRED\n   197\t    FOR EACH ROW\n   198\t    WHEN (OLD.\"supersededAt\" IS NULL AND NEW.\"supersededAt\" IS NOT NULL)\n   199\t    EXECUTE FUNCTION \"require_recorded_leg_supersession\"();\n   200\t\n   201\t-- The status row is the booking-wide audit sequence. A rebooking can only be\n   202\t-- attached to the transition that resolves a disruption, for the same\n   203\t-- booking, and cannot simultaneously claim a refund.\n   204\tCREATE FUNCTION \"validate_booking_rebooking\"()\n   205\tRETURNS TRIGGER AS $$\n   206\tDECLARE\n   207\t    change \"BookingStatusChange\";\n   208\tBEGIN\n   209\t    SELECT * INTO change\n   210\t    FROM \"BookingStatusChange\"\n   211\t    WHERE \"id\" = NEW.\"bookingStatusChangeId\";\n   212\t\n   213\t    IF NOT FOUND\n   214\t       OR change.\"bookingId\" <> NEW.\"bookingId\"\n   215\t       OR change.\"from\" IS DISTINCT FROM 'DISRUPTED'::\"BookingStatus\"\n   216\t       OR change.\"to\" IS DISTINCT FROM 'CONFIRMED'::\"BookingStatus\"\n   217\t       OR change.\"refundCents\" IS NOT NULL THEN\n   218\t        RAISE EXCEPTION\n   219\t            'BookingRebooking must match one non-refunding DISRUPTED to CONFIRMED status change.';\n   220\t    END IF;\n   221\t    RETURN NEW;\n   222\tEND;\n   223\t$$ LANGUAGE plpgsql;\n   224\t\n   225\tCREATE TRIGGER \"BookingRebooking_is_consistent\"\n   226\t    BEFORE INSERT ON \"BookingRebooking\"\n   227\t    FOR EACH ROW EXECUTE FUNCTION \"validate_booking_rebooking\"();\n   228\t\n   229\t-- Both legs remain real rows. The old one must already be historical, the new\n   230\t-- one current, and both must occupy the same position in this booking.\n   231\tCREATE FUNCTION \"validate_booking_rebooking_leg\"()\n   232\tRETURNS TRIGGER AS $$\n   233\tDECLARE\n   234\t    event_booking_id INTEGER;\n   235\t    from_booking_id INTEGER;\n   236\t    from_sequence INTEGER;\n   237\t    from_superseded_at TIMESTAMP(3);\n   238\t    to_booking_id INTEGER;\n   239\t    to_sequence INTEGER;\n   240\t    to_superseded_at TIMESTAMP(3);\n   241\tBEGIN\n   242\t    SELECT \"bookingId\" INTO event_booking_id\n   243\t    FROM \"BookingRebooking\"\n   244\t    WHERE \"id\" = NEW.\"rebookingId\";\n   245\t    SELECT \"bookingId\", \"sequence\", \"supersededAt\"\n   246\t        INTO from_booking_id, from_sequence, from_superseded_at\n   247\t    FROM \"ItineraryLeg\" WHERE \"id\" = NEW.\"fromLegId\";\n   248\t    SELECT \"bookingId\", \"sequence\", \"supersededAt\"\n   249\t        INTO to_booking_id, to_sequence, to_superseded_at\n   250\t    FROM \"ItineraryLeg\" WHERE \"id\" = NEW.\"toLegId\";\n   251\t\n   252\t    IF event_booking_id IS NULL\n   253\t       OR from_booking_id IS NULL\n   254\t       OR to_booking_id IS NULL\n   255\t       OR from_booking_id <> event_booking_id\n   256\t       OR to_booking_id <> event_booking_id\n   257\t       OR from_sequence <> to_sequence\n   258\t       OR from_superseded_at IS NULL\n   259\t       OR to_superseded_at IS NOT NULL THEN\n   260\t        RAISE EXCEPTION\n   261\t            'BookingRebookingLeg must map superseded and active legs from the same booking and same itinerary position.';\n   262\t    END IF;\n   263\t    RETURN NEW;\n   264\tEND;\n   265\t$$ LANGUAGE plpgsql;\n   266\t\n   267\tCREATE TRIGGER \"BookingRebookingLeg_is_consistent\"\n   268\t    BEFORE INSERT ON \"BookingRebookingLeg\"\n   269\t    FOR EACH ROW EXECUTE FUNCTION \"validate_booking_rebooking_leg\"();\n   270\t\n   271\t-- An event with no leg mapping says a rebooking happened but cannot say what\n   272\t-- changed. Deferred so a normal transaction can insert the event first.\n   273\tCREATE FUNCTION \"require_rebooking_legs\"()\n   274\tRETURNS TRIGGER AS $$\n   275\tBEGIN\n   276\t    IF NOT EXISTS (SELECT 1 FROM \"BookingRebooking\" WHERE \"id\" = NEW.\"id\") THEN\n   277\t        RETURN NULL;\n   278\t    END IF;\n   279\t    IF NOT EXISTS (\n   280\t        SELECT 1 FROM \"BookingRebookingLeg\" WHERE \"rebookingId\" = NEW.\"id\"\n   281\t    ) THEN\n   282\t        RAISE EXCEPTION 'BookingRebooking % must map at least one itinerary leg.', NEW.\"id\";\n   283\t    END IF;\n   284\t    RETURN NULL;\n   285\tEND;\n   286\t$$ LANGUAGE plpgsql;\n   287\t\n   288\tCREATE CONSTRAINT TRIGGER \"BookingRebooking_has_legs\"\n   289\t    AFTER INSERT ON \"BookingRebooking\"\n   290\t    DEFERRABLE INITIALLY DEFERRED\n   291\t    FOR EACH ROW EXECUTE FUNCTION \"require_rebooking_legs\"();\n   292\t\n   293\t-- A direct mapping or event delete would leave its source leg historical with\n   294\t-- no record of what replaced it. Deferred so deleting the whole booking remains\n   295\t-- possible: that cascade also deletes the source leg before this check runs.\n   296\tCREATE FUNCTION \"require_supersession_mapping_after_delete\"()\n   297\tRETURNS TRIGGER AS $$\n   298\tBEGIN\n   299\t    IF EXISTS (\n   300\t        SELECT 1 FROM \"ItineraryLeg\"\n   301\t        WHERE \"id\" = OLD.\"fromLegId\" AND \"supersededAt\" IS NOT NULL\n   302\t    ) AND NOT EXISTS (\n   303\t        SELECT 1 FROM \"BookingRebookingLeg\" WHERE \"fromLegId\" = OLD.\"fromLegId\"\n   304\t    ) THEN\n   305\t        RAISE EXCEPTION\n   306\t            'BookingRebookingLeg for superseded ItineraryLeg % cannot be deleted directly.',\n   307\t            OLD.\"fromLegId\";\n   308\t    END IF;\n   309\t    RETURN NULL;\n   310\tEND;\n   311\t$$ LANGUAGE plpgsql;\n   312\t\n   313\tCREATE CONSTRAINT TRIGGER \"BookingRebookingLeg_preserves_supersession\"\n   314\t    AFTER DELETE ON \"BookingRebookingLeg\"\n   315\t    DEFERRABLE INITIALLY DEFERRED\n   316\t    FOR EACH ROW EXECUTE FUNCTION \"require_supersession_mapping_after_delete\"();\n   317\t\n   318\t-- Updates rewrite audit history. Deletes remain available only through the\n   319\t-- booking cascade, matching BookingStatusChange and test-data cleanup.\n   320\tCREATE FUNCTION \"refuse_rebooking_audit_update\"()\n   321\tRETURNS TRIGGER AS $$\n   322\tBEGIN\n   323\t    RAISE EXCEPTION '% is append-only and cannot be modified.', TG_TABLE_NAME;\n   324\tEND;\n   325\t$$ LANGUAGE plpgsql;\n   326\t\n   327\tCREATE TRIGGER \"BookingRebooking_is_append_only\"\n   328\t    BEFORE UPDATE ON \"BookingRebooking\"\n   329\t    FOR EACH ROW EXECUTE FUNCTION \"refuse_rebooking_audit_update\"();\n   330\t\n   331\tCREATE TRIGGER \"BookingRebookingLeg_is_append_only\"\n   332\t    BEFORE UPDATE ON \"BookingRebookingLeg\"\n   333\t    FOR EACH ROW EXECUTE FUNCTION \"refuse_rebooking_audit_update\"();\n   150\tdescribe('immutable itinerary rebooking records', () => {\n   151\t    it('keeps the original leg and released seat while one replacement becomes active', async () => {\n   152\t        const saved = await recordRebooking();\n   153\t\n   154\t        const legs = await prisma.$queryRaw<Array<{\n   155\t            id: number;\n   156\t            supersededAt: Date | null;\n   157\t        }>>`\n   158\t            SELECT \"id\", \"supersededAt\"\n   159\t            FROM \"ItineraryLeg\"\n   160\t            WHERE \"bookingId\" = ${saved.booking.id}\n   161\t            ORDER BY \"id\"\n   162\t        `;\n   163\t        const seats = await prisma.seatAssignment.findMany({\n   164\t            where: { passengerId: saved.passengerId },\n   165\t            orderBy: { id: 'asc' },\n   166\t        });\n   167\t        const currentBooking = await prisma.booking.findUniqueOrThrow({\n   168\t            where: { id: saved.booking.id },\n   169\t            include: { rebookings: true },\n   170\t        });\n   171\t\n   172\t        expect(legs).toEqual([\n   173\t            { id: saved.oldLeg.id, supersededAt: expect.any(Date) },\n   174\t            { id: saved.newLegId, supersededAt: null },\n   175\t        ]);\n   176\t        expect(seats).toEqual(expect.arrayContaining([\n   177\t            expect.objectContaining({ legId: saved.oldLeg.id, seatNumber: '11A', releasedAt: expect.any(Date) }),\n   178\t            expect.objectContaining({ legId: saved.newLegId, seatNumber: '14C', releasedAt: null }),\n   179\t        ]));\n   180\t        expect(currentBooking).toMatchObject({\n   181\t            status: 'CONFIRMED',\n   182\t            paymentIntentId: saved.booking.paymentIntentId,\n   183\t            totalPriceCents: 30_000,\n   184\t            rebookings: [expect.objectContaining({\n   185\t                id: saved.rebookingId,\n   186\t                farePolicy: 'DISRUPTION_WAIVER',\n   187\t            })],\n   188\t        });\n   189\t        expect(saved.replacementFlight.priceCents).toBe(45_000);\n   190\t    });\n   191\t\n   192\t    it('stops treating the superseded flight as part of the live booking', async () => {\n   193\t        const saved = await recordRebooking();\n   194\t\n   195\t        const locked = await prisma.$transaction(async tx => ({\n   196\t            oldFlight: await lockBookingsOnFlightForUpdate(tx, saved.oldLeg.flightId),\n   197\t            replacementFlight: await lockBookingsOnFlightForUpdate(\n   198\t                tx,\n   199\t                saved.replacementFlight.id,\n   200\t            ),\n   201\t        }));\n   202\t\n   203\t        expect(locked).toEqual({\n   204\t            oldFlight: [],\n   205\t            replacementFlight: [saved.booking.id],\n   206\t        });\n   207\t    });\n   208\t\n   209\t    it('allows only one active leg at an itinerary position', async () => {\n   210\t        const saved = await recordRebooking();\n   211\t        const anotherFlight = await flight('THIRD');\n   212\t\n   213\t        await expect(prisma.$executeRaw`\n   214\t            INSERT INTO \"ItineraryLeg\" (\"bookingId\", \"sequence\", \"flightId\")\n   215\t            VALUES (${saved.booking.id}, 1, ${anotherFlight.id})\n   216\t        `).rejects.toThrow(/Key \\(\\\"bookingId\\\", sequence\\)=\\(.+, 1\\) already exists/);\n   217\t    });\n   218\t\n   219\t    it('requires every new leg to start active', async () => {\n   220\t        const scenario = await disruptedBooking();\n   221\t        const anotherFlight = await flight('PRE-SUPERSEDED');\n   222\t\n   223\t        await expect(prisma.$executeRaw`\n   224\t            INSERT INTO \"ItineraryLeg\"\n   225\t                (\"bookingId\", \"sequence\", \"flightId\", \"supersededAt\")\n   226\t            VALUES (\n   227\t                ${scenario.booking.id},\n   228\t                2,\n   229\t                ${anotherFlight.id},\n   230\t                statement_timestamp()\n   231\t            )\n   232\t        `).rejects.toThrow(/new ItineraryLeg must start active/);\n   233\t    });\n   234\t\n   235\t    it('never lets a superseded leg become active again', async () => {\n   236\t        const saved = await recordRebooking();\n   237\t\n   238\t        await expect(prisma.$executeRaw`\n   239\t            UPDATE \"ItineraryLeg\" SET \"supersededAt\" = NULL WHERE \"id\" = ${saved.oldLeg.id}\n   240\t        `).rejects.toThrow(/ItineraryLeg supersession is permanent/);\n   241\t    });\n   242\t\n   243\t    it('requires a new version instead of rewriting a leg in place', async () => {\n   244\t        const scenario = await disruptedBooking();\n   245\t        const anotherFlight = await flight('IN-PLACE-REWRITE');\n   246\t\n   247\t        await expect(prisma.$executeRaw`\n   248\t            UPDATE \"ItineraryLeg\"\n   249\t            SET \"flightId\" = ${anotherFlight.id}\n   250\t            WHERE \"id\" = ${scenario.oldLeg.id}\n   251\t        `).rejects.toThrow(/ItineraryLeg identity is immutable/);\n   252\t    });\n   253\t\n   254\t    it('refuses to delete a leg while its booking still exists', async () => {\n   255\t        const scenario = await disruptedBooking();\n   256\t\n   257\t        await expect(prisma.itineraryLeg.delete({\n   258\t            where: { id: scenario.oldLeg.id },\n   259\t        })).rejects.toThrow(/cannot be deleted while booking/);\n   260\t\n   261\t        expect(await prisma.itineraryLeg.count({\n   262\t            where: { id: scenario.oldLeg.id },\n   263\t        })).toBe(1);\n   264\t    });\n   265\t\n   266\t    it('does not let a cascading leg delete erase its rebooking mapping', async () => {\n   267\t        const saved = await recordRebooking();\n   268\t\n   269\t        await expect(prisma.itineraryLeg.delete({\n   270\t            where: { id: saved.oldLeg.id },\n   271\t        })).rejects.toThrow(/cannot be deleted while booking/);\n   272\t\n   273\t        expect(await prisma.bookingRebookingLeg.count({\n   274\t            where: { rebookingId: saved.rebookingId },\n   275\t        })).toBe(1);\n   276\t    });\n   277\t\n   278\t    it('does not let a cascading replacement delete erase its rebooking mapping', async () => {\n   279\t        const saved = await recordRebooking();\n   280\t\n   281\t        await expect(prisma.itineraryLeg.delete({\n   282\t            where: { id: saved.newLegId },\n   283\t        })).rejects.toThrow(/cannot be deleted while booking/);\n   284\t\n   285\t        expect(await prisma.bookingRebookingLeg.count({\n   286\t            where: { rebookingId: saved.rebookingId },\n   287\t        })).toBe(1);\n   288\t    });\n   289\t\n   290\t    it('makes the rebooking event append-only', async () => {\n   291\t        const saved = await recordRebooking();\n   292\t\n   293\t        await expect(prisma.$executeRaw`\n   294\t            UPDATE \"BookingRebooking\" SET \"createdAt\" = \"createdAt\"\n   295\t            WHERE \"id\" = ${saved.rebookingId}\n   296\t        `).rejects.toThrow(/BookingRebooking is append-only/);\n   297\t    });\n   298\t\n   299\t    it('makes the rebooking leg mapping append-only', async () => {\n   300\t        const saved = await recordRebooking();\n   301\t\n   302\t        await expect(prisma.$executeRaw`\n   303\t            UPDATE \"BookingRebookingLeg\" SET \"toLegId\" = \"toLegId\"\n   304\t            WHERE \"rebookingId\" = ${saved.rebookingId}\n   305\t              AND \"fromLegId\" = ${saved.oldLeg.id}\n   306\t        `).rejects.toThrow(/BookingRebookingLeg is append-only/);\n   307\t    });\n   308\t\n   309\t    it('refuses to delete a leg mapping while its historical leg remains', async () => {\n   310\t        const saved = await recordRebooking();\n   311\t\n   312\t        await expect(prisma.$transaction(async tx => {\n   313\t            await tx.bookingRebookingLeg.delete({\n   314\t                where: {\n   315\t                    rebookingId_fromLegId: {\n   316\t                        rebookingId: saved.rebookingId,\n   317\t                        fromLegId: saved.oldLeg.id,\n   318\t                    },\n   319\t                },\n   320\t            });\n   321\t            await tx.$executeRaw`\n   322\t                SET CONSTRAINTS \"BookingRebookingLeg_preserves_supersession\" IMMEDIATE\n   323\t            `;\n   324\t        })).rejects.toThrow(/cannot be deleted directly/);\n   325\t\n   326\t        expect(await prisma.bookingRebookingLeg.count({\n   327\t            where: { rebookingId: saved.rebookingId },\n   328\t        })).toBe(1);\n   329\t    });\n   330\t\n   331\t    it('refuses to delete a rebooking event while its historical leg remains', async () => {\n   332\t        const saved = await recordRebooking();\n   333\t\n   334\t        await expect(prisma.$transaction(async tx => {\n   335\t            await tx.bookingRebooking.delete({ where: { id: saved.rebookingId } });\n   336\t            await tx.$executeRaw`\n   337\t                SET CONSTRAINTS \"BookingRebookingLeg_preserves_supersession\" IMMEDIATE\n   338\t            `;\n   339\t        })).rejects.toThrow(/cannot be deleted directly/);\n   340\t\n   341\t        expect(await prisma.bookingRebooking.count({\n   342\t            where: { id: saved.rebookingId },\n   343\t        })).toBe(1);\n   344\t    });\n   345\t\n   346\t    it('refuses a mapping between different itinerary positions', async () => {\n   347\t        const scenario = await disruptedBooking();\n   348\t        const replacementFlight = await flight('WRONG-SEQUENCE');\n   349\t        const rebookingId = randomUUID();\n   350\t\n   351\t        await expect(prisma.$transaction(async tx => {\n   352\t            await tx.$executeRaw`\n   353\t                UPDATE \"ItineraryLeg\"\n   354\t                SET \"supersededAt\" = statement_timestamp()\n   355\t                WHERE \"id\" = ${scenario.oldLeg.id}\n   356\t            `;\n   357\t            const [wrongLeg] = await tx.$queryRaw<Array<{ id: number }>>`\n   358\t                INSERT INTO \"ItineraryLeg\" (\"bookingId\", \"sequence\", \"flightId\")\n   359\t                VALUES (${scenario.booking.id}, 2, ${replacementFlight.id})\n   360\t                RETURNING \"id\"\n   361\t            `;\n   362\t            await resolveDisruption(tx, scenario.booking.id, rebookingId);\n   363\t            await tx.$executeRaw`\n   364\t                INSERT INTO \"BookingRebookingLeg\" (\"rebookingId\", \"fromLegId\", \"toLegId\")\n   365\t                VALUES (${rebookingId}, ${scenario.oldLeg.id}, ${wrongLeg.id})\n   366\t            `;\n   367\t        })).rejects.toThrow(/same itinerary position/);\n   368\t    });\n   369\t\n   370\t    it('refuses to supersede a leg without recording its replacement', async () => {\n   371\t        const scenario = await disruptedBooking();\n   372\t\n   373\t        await expect(prisma.$executeRaw`\n   374\t            UPDATE \"ItineraryLeg\"\n   375\t            SET \"supersededAt\" = statement_timestamp()\n   376\t            WHERE \"id\" = ${scenario.oldLeg.id}\n   377\t        `).rejects.toThrow(/must be recorded by a BookingRebookingLeg/);\n   378\t    });\n   379\t\n   380\t    it('refuses to supersede a leg while its old seat is still live', async () => {\n   381\t        await expect(recordRebooking({\n   382\t            releaseOldSeat: false,\n   383\t            checkSupersessionNow: true,\n   384\t        })).rejects.toThrow(/cannot retain live seat assignments/);\n   385\t    });\n   386\t\n   387\t    it('refuses a rebooking event with no leg replacement', async () => {\n   388\t        const scenario = await disruptedBooking();\n   389\t        const rebookingId = randomUUID();\n   390\t\n   391\t        await expect(prisma.$transaction(async tx => {\n   392\t            await resolveDisruption(tx, scenario.booking.id, rebookingId);\n   393\t            // Prisma 5 logs a deferred-constraint failure from COMMIT but can\n   394\t            // resolve the interactive-transaction promise. A product writer\n   395\t            // will make all rebooking constraints immediate as its final\n   396\t            // statement; do that here so the rejected write is observable to\n   397\t            // the caller as well as rolled back by PostgreSQL.\n   398\t            await tx.$executeRaw`SET CONSTRAINTS \"BookingRebooking_has_legs\" IMMEDIATE`;\n   399\t        })).rejects.toThrow(/must map at least one itinerary leg/);\n   400\t    });\n   401\t\n   402\t    it('refuses a leg mapping that crosses booking references', async () => {\n   403\t        const scenario = await disruptedBooking();\n   404\t        const other = await disruptedBooking();\n   405\t        const rebookingId = randomUUID();\n   406\t\n   407\t        await expect(prisma.$transaction(async tx => {\n   408\t            await tx.$executeRaw`\n   409\t                UPDATE \"ItineraryLeg\"\n   410\t                SET \"supersededAt\" = statement_timestamp()\n   411\t                WHERE \"id\" = ${scenario.oldLeg.id}\n   412\t            `;\n   413\t            await resolveDisruption(tx, scenario.booking.id, rebookingId);\n   414\t            await tx.$executeRaw`\n   415\t                INSERT INTO \"BookingRebookingLeg\" (\"rebookingId\", \"fromLegId\", \"toLegId\")\n   416\t                VALUES (${rebookingId}, ${scenario.oldLeg.id}, ${other.oldLeg.id})\n   417\t            `;\n   418\t        })).rejects.toThrow(/same booking and same itinerary position/);\n   419\t    });\n   420\t\n   421\t    it('refuses an event whose status change also records a refund', async () => {\n   422\t        const scenario = await disruptedBooking();\n   423\t        const rebookingId = randomUUID();\n   424\t\n   425\t        await expect(prisma.$transaction(async tx => {\n   426\t            await tx.$executeRaw`\n   427\t                SELECT set_config('app.booking_refund_cents', '1', true)\n   428\t            `;\n   429\t            await resolveDisruption(tx, scenario.booking.id, rebookingId);\n   430\t        })).rejects.toThrow(/one non-refunding DISRUPTED to CONFIRMED status change/);\n   431\t    });\n   432\t\n   433\t    it('refuses an event that is not the resolution of a disruption', async () => {\n   434\t        const scenario = await disruptedBooking();\n   435\t        const initialChange = await prisma.bookingStatusChange.findFirstOrThrow({\n   436\t            where: { bookingId: scenario.booking.id, from: null, to: 'DISRUPTED' },\n   437\t        });\n   438\t\n   439\t        await expect(prisma.$executeRaw`\n   440\t            INSERT INTO \"BookingRebooking\"\n   441\t                (\"id\", \"bookingId\", \"bookingStatusChangeId\", \"farePolicy\")\n   442\t            VALUES (\n   443\t                ${randomUUID()},\n   444\t                ${scenario.booking.id},\n   445\t                ${initialChange.id},\n   446\t                'DISRUPTION_WAIVER'\n   447\t            )\n   448\t        `).rejects.toThrow(/one non-refunding DISRUPTED to CONFIRMED status change/);\n   449\t    });\n   450\t\n   451\t    it('cascades the immutable history when its booking is deleted', async () => {\n   452\t        const saved = await recordRebooking();\n   453\t\n   454\t        expect(await prisma.booking.deleteMany({\n   455\t            where: { id: saved.booking.id },\n   456\t        })).toEqual({ count: 1 });\n   457\t\n   458\t        expect(await prisma.bookingRebooking.count({\n   459\t            where: { id: saved.rebookingId },\n   460\t        })).toBe(0);\n   461\t        expect(await prisma.bookingRebookingLeg.count({\n   462\t            where: { rebookingId: saved.rebookingId },\n   463\t        })).toBe(0);\n   464\t        expect(await prisma.itineraryLeg.count({\n   465\t            where: { bookingId: saved.booking.id },\n   466\t        })).toBe(0);\n   467\t    });\n   468\t});\n","exit_code":0,"duration":{"secs":0,"nanos":49602},"formatted_output":" M __tests__/app/actions.test.ts\n M __tests__/lib/FlightBookingService.test.ts\n M __tests__/lib/bookingItinerary.test.ts\n M app/actions.ts\n M app/admin/flights/page.tsx\n M app/admin/page.tsx\n M app/profile/page.tsx\n M lib/FlightBookingService.ts\n M lib/bookingItinerary.ts\n M lib/flightLock.ts\n M prisma/schema.prisma\n?? __tests__/app/activeItineraryReads.test.tsx\n?? __tests__/lib/itineraryRebooking.database.test.ts\n?? prisma/migrations/20260816181000_version_itinerary_legs/\n    35\t-- rows share a sequence, restoring the unconditional unique key is impossible\n    36\t-- without deleting audit history.\n    37\t\n    38\tCREATE TYPE \"RebookingFarePolicy\" AS ENUM ('DISRUPTION_WAIVER');\n    39\t\n    40\tALTER TABLE \"ItineraryLeg\"\n    41\t    ADD COLUMN \"supersededAt\" TIMESTAMP(3);\n    42\t\n    43\tDROP INDEX \"ItineraryLeg_bookingId_sequence_key\";\n    44\t\n    45\t-- Historical rows may share a position; exactly one current row may not.\n    46\tCREATE UNIQUE INDEX \"ItineraryLeg_active_booking_sequence_key\"\n    47\t    ON \"ItineraryLeg\"(\"bookingId\", \"sequence\")\n    48\t    WHERE \"supersededAt\" IS NULL;\n    49\t\n    50\tCREATE INDEX \"ItineraryLeg_bookingId_supersededAt_sequence_idx\"\n    51\t    ON \"ItineraryLeg\"(\"bookingId\", \"supersededAt\", \"sequence\");\n    52\t\n    53\tCREATE TABLE \"BookingRebooking\" (\n    54\t    \"id\" TEXT NOT NULL,\n    55\t    \"bookingId\" INTEGER NOT NULL,\n    56\t    \"bookingStatusChangeId\" TEXT NOT NULL,\n    57\t    \"farePolicy\" \"RebookingFarePolicy\" NOT NULL DEFAULT 'DISRUPTION_WAIVER',\n    58\t    \"createdAt\" TIMESTAMP(3) NOT NULL DEFAULT CURRENT_TIMESTAMP,\n    59\t\n    60\t    CONSTRAINT \"BookingRebooking_pkey\" PRIMARY KEY (\"id\")\n    61\t);\n    62\t\n    63\tCREATE UNIQUE INDEX \"BookingRebooking_bookingStatusChangeId_key\"\n    64\t    ON \"BookingRebooking\"(\"bookingStatusChangeId\");\n    65\tCREATE INDEX \"BookingRebooking_bookingId_createdAt_idx\"\n    66\t    ON \"BookingRebooking\"(\"bookingId\", \"createdAt\");\n    67\t\n    68\tALTER TABLE \"BookingRebooking\"\n    69\t    ADD CONSTRAINT \"BookingRebooking_bookingId_fkey\"\n    70\t        FOREIGN KEY (\"bookingId\") REFERENCES \"Booking\"(\"id\")\n    71\t        ON DELETE CASCADE ON UPDATE CASCADE,\n    72\t    ADD CONSTRAINT \"BookingRebooking_bookingStatusChangeId_fkey\"\n    73\t        FOREIGN KEY (\"bookingStatusChangeId\") REFERENCES \"BookingStatusChange\"(\"id\")\n    74\t        ON DELETE NO ACTION ON UPDATE CASCADE;\n    75\t\n    76\tCREATE TABLE \"BookingRebookingLeg\" (\n    77\t    \"rebookingId\" TEXT NOT NULL,\n    78\t    \"fromLegId\" INTEGER NOT NULL,\n    79\t    \"toLegId\" INTEGER NOT NULL,\n    80\t\n    81\t    CONSTRAINT \"BookingRebookingLeg_pkey\" PRIMARY KEY (\"rebookingId\", \"fromLegId\"),\n    82\t    CONSTRAINT \"BookingRebookingLeg_different_legs\" CHECK (\"fromLegId\" <> \"toLegId\")\n    83\t);\n    84\t\n    85\tCREATE UNIQUE INDEX \"BookingRebookingLeg_fromLegId_key\"\n    86\t    ON \"BookingRebookingLeg\"(\"fromLegId\");\n    87\tCREATE UNIQUE INDEX \"BookingRebookingLeg_toLegId_key\"\n    88\t    ON \"BookingRebookingLeg\"(\"toLegId\");\n    89\t\n    90\tALTER TABLE \"BookingRebookingLeg\"\n    91\t    ADD CONSTRAINT \"BookingRebookingLeg_rebookingId_fkey\"\n    92\t        FOREIGN KEY (\"rebookingId\") REFERENCES \"BookingRebooking\"(\"id\")\n    93\t        ON DELETE CASCADE ON UPDATE CASCADE,\n    94\t    ADD CONSTRAINT \"BookingRebookingLeg_fromLegId_fkey\"\n    95\t        FOREIGN KEY (\"fromLegId\") REFERENCES \"ItineraryLeg\"(\"id\")\n    96\t        ON DELETE CASCADE ON UPDATE CASCADE,\n    97\t    ADD CONSTRAINT \"BookingRebookingLeg_toLegId_fkey\"\n    98\t        FOREIGN KEY (\"toLegId\") REFERENCES \"ItineraryLeg\"(\"id\")\n    99\t        ON DELETE CASCADE ON UPDATE CASCADE;\n   100\t\n   101\t-- Every historical leg has to become historical through the recorded update\n   102\t-- below. Accepting a row that starts superseded would bypass that audit path.\n   103\tCREATE FUNCTION \"require_new_itinerary_leg_active\"()\n   104\tRETURNS TRIGGER AS $$\n   105\tBEGIN\n   106\t    IF NEW.\"supersededAt\" IS NOT NULL THEN\n   107\t        RAISE EXCEPTION\n   108\t            'A new ItineraryLeg must start active; supersede it through a recorded rebooking.';\n   109\t    END IF;\n   110\t    RETURN NEW;\n   111\tEND;\n   112\t$$ LANGUAGE plpgsql;\n   113\t\n   114\tCREATE TRIGGER \"ItineraryLeg_starts_active\"\n   115\t    BEFORE INSERT ON \"ItineraryLeg\"\n   116\t    FOR EACH ROW EXECUTE FUNCTION \"require_new_itinerary_leg_active\"();\n   117\t\n   118\t-- A leg disappears only when its whole booking does. Deferred so the booking\n   119\t-- cascade has removed the parent by the time this checks it; a direct leg\n   120\t-- delete, even beside deletion of its audit mapping, still sees the booking.\n   121\tCREATE FUNCTION \"require_itinerary_leg_booking_delete\"()\n   122\tRETURNS TRIGGER AS $$\n   123\tBEGIN\n   124\t    IF EXISTS (SELECT 1 FROM \"Booking\" WHERE \"id\" = OLD.\"bookingId\") THEN\n   125\t        RAISE EXCEPTION\n   126\t            'ItineraryLeg % cannot be deleted while booking % exists.',\n   127\t            OLD.\"id\", OLD.\"bookingId\";\n   128\t    END IF;\n   129\t    RETURN NULL;\n   130\tEND;\n   131\t$$ LANGUAGE plpgsql;\n   132\t\n   133\tCREATE CONSTRAINT TRIGGER \"ItineraryLeg_deletes_with_booking\"\n   134\t    AFTER DELETE ON \"ItineraryLeg\"\n   135\t    DEFERRABLE INITIALLY DEFERRED\n   136\t    FOR EACH ROW EXECUTE FUNCTION \"require_itinerary_leg_booking_delete\"();\n   137\t\n   138\t-- A leg's identity never changes in place: a different flight is a new version.\n   139\t-- Once superseded, its timestamp is permanent too. The sole state transition\n   140\t-- this permits is setting supersededAt on a currently active leg.\n   141\tCREATE FUNCTION \"refuse_itinerary_leg_rewrite\"()\n   142\tRETURNS TRIGGER AS $$\n   143\tBEGIN\n   144\t    IF NEW.\"id\" IS DISTINCT FROM OLD.\"id\"\n   145\t       OR NEW.\"bookingId\" IS DISTINCT FROM OLD.\"bookingId\"\n   146\t       OR NEW.\"sequence\" IS DISTINCT FROM OLD.\"sequence\"\n   147\t       OR NEW.\"flightId\" IS DISTINCT FROM OLD.\"flightId\" THEN\n   148\t        RAISE EXCEPTION\n   149\t            'ItineraryLeg identity is immutable: replace leg % with a new version.',\n   150\t            OLD.\"id\";\n   151\t    END IF;\n   152\t    IF OLD.\"supersededAt\" IS NOT NULL\n   153\t       AND NEW.\"supersededAt\" IS DISTINCT FROM OLD.\"supersededAt\" THEN\n   154\t        RAISE EXCEPTION\n   155\t            'ItineraryLeg supersession is permanent: leg % cannot become active or change time.',\n   156\t            OLD.\"id\";\n   157\t    END IF;\n   158\t    RETURN NEW;\n   159\tEND;\n   160\t$$ LANGUAGE plpgsql;\n   161\t\n   162\tCREATE TRIGGER \"ItineraryLeg_supersession_is_permanent\"\n   163\t    BEFORE UPDATE ON \"ItineraryLeg\"\n   164\t    FOR EACH ROW EXECUTE FUNCTION \"refuse_itinerary_leg_rewrite\"();\n   165\t\n   166\t-- A superseded leg must be named by an immutable rebooking mapping before its\n   167\t-- transaction commits. Deferred because the event and replacement leg are\n   168\t-- naturally written after the original leg is marked historical.\n   169\tCREATE FUNCTION \"require_recorded_leg_supersession\"()\n   170\tRETURNS TRIGGER AS $$\n   171\tBEGIN\n   172\t    IF NOT EXISTS (SELECT 1 FROM \"ItineraryLeg\" WHERE \"id\" = NEW.\"id\") THEN\n   173\t        RETURN NULL;\n   174\t    END IF;\n   175\t    IF NOT EXISTS (\n   176\t        SELECT 1 FROM \"BookingRebookingLeg\" WHERE \"fromLegId\" = NEW.\"id\"\n   177\t    ) THEN\n   178\t        RAISE EXCEPTION\n   179\t            'Superseded ItineraryLeg % must be recorded by a BookingRebookingLeg.',\n   180\t            NEW.\"id\";\n   181\t    END IF;\n   182\t    IF EXISTS (\n   183\t        SELECT 1 FROM \"SeatAssignment\"\n   184\t        WHERE \"legId\" = NEW.\"id\" AND \"releasedAt\" IS NULL\n   185\t    ) THEN\n   186\t        RAISE EXCEPTION\n   187\t            'Superseded ItineraryLeg % cannot retain live seat assignments.',\n   188\t            NEW.\"id\";\n   189\t    END IF;\n   190\t    RETURN NULL;\n   191\tEND;\n   192\t$$ LANGUAGE plpgsql;\n   193\t\n   194\tCREATE CONSTRAINT TRIGGER \"ItineraryLeg_supersession_is_recorded\"\n   195\t    AFTER UPDATE OF \"supersededAt\" ON \"ItineraryLeg\"\n   196\t    DEFERRABLE INITIALLY DEFERRED\n   197\t    FOR EACH ROW\n   198\t    WHEN (OLD.\"supersededAt\" IS NULL AND NEW.\"supersededAt\" IS NOT NULL)\n   199\t    EXECUTE FUNCTION \"require_recorded_leg_supersession\"();\n   200\t\n   201\t-- The status row is the booking-wide audit sequence. A rebooking can only be\n   202\t-- attached to the transition that resolves a disruption, for the same\n   203\t-- booking, and cannot simultaneously claim a refund.\n   204\tCREATE FUNCTION \"validate_booking_rebooking\"()\n   205\tRETURNS TRIGGER AS $$\n   206\tDECLARE\n   207\t    change \"BookingStatusChange\";\n   208\tBEGIN\n   209\t    SELECT * INTO change\n   210\t    FROM \"BookingStatusChange\"\n   211\t    WHERE \"id\" = NEW.\"bookingStatusChangeId\";\n   212\t\n   213\t    IF NOT FOUND\n   214\t       OR change.\"bookingId\" <> NEW.\"bookingId\"\n   215\t       OR change.\"from\" IS DISTINCT FROM 'DISRUPTED'::\"BookingStatus\"\n   216\t       OR change.\"to\" IS DISTINCT FROM 'CONFIRMED'::\"BookingStatus\"\n   217\t       OR change.\"refundCents\" IS NOT NULL THEN\n   218\t        RAISE EXCEPTION\n   219\t            'BookingRebooking must match one non-refunding DISRUPTED to CONFIRMED status change.';\n   220\t    END IF;\n   221\t    RETURN NEW;\n   222\tEND;\n   223\t$$ LANGUAGE plpgsql;\n   224\t\n   225\tCREATE TRIGGER \"BookingRebooking_is_consistent\"\n   226\t    BEFORE INSERT ON \"BookingRebooking\"\n   227\t    FOR EACH ROW EXECUTE FUNCTION \"validate_booking_rebooking\"();\n   228\t\n   229\t-- Both legs remain real rows. The old one must already be historical, the new\n   230\t-- one current, and both must occupy the same position in this booking.\n   231\tCREATE FUNCTION \"validate_booking_rebooking_leg\"()\n   232\tRETURNS TRIGGER AS $$\n   233\tDECLARE\n   234\t    event_booking_id INTEGER;\n   235\t    from_booking_id INTEGER;\n   236\t    from_sequence INTEGER;\n   237\t    from_superseded_at TIMESTAMP(3);\n   238\t    to_booking_id INTEGER;\n   239\t    to_sequence INTEGER;\n   240\t    to_superseded_at TIMESTAMP(3);\n   241\tBEGIN\n   242\t    SELECT \"bookingId\" INTO event_booking_id\n   243\t    FROM \"BookingRebooking\"\n   244\t    WHERE \"id\" = NEW.\"rebookingId\";\n   245\t    SELECT \"bookingId\", \"sequence\", \"supersededAt\"\n   246\t        INTO from_booking_id, from_sequence, from_superseded_at\n   247\t    FROM \"ItineraryLeg\" WHERE \"id\" = NEW.\"fromLegId\";\n   248\t    SELECT \"bookingId\", \"sequence\", \"supersededAt\"\n   249\t        INTO to_booking_id, to_sequence, to_superseded_at\n   250\t    FROM \"ItineraryLeg\" WHERE \"id\" = NEW.\"toLegId\";\n   251\t\n   252\t    IF event_booking_id IS NULL\n   253\t       OR from_booking_id IS NULL\n   254\t       OR to_booking_id IS NULL\n   255\t       OR from_booking_id <> event_booking_id\n   256\t       OR to_booking_id <> event_booking_id\n   257\t       OR from_sequence <> to_sequence\n   258\t       OR from_superseded_at IS NULL\n   259\t       OR to_superseded_at IS NOT NULL THEN\n   260\t        RAISE EXCEPTION\n   261\t            'BookingRebookingLeg must map superseded and active legs from the same booking and same itinerary position.';\n   262\t    END IF;\n   263\t    RETURN NEW;\n   264\tEND;\n   265\t$$ LANGUAGE plpgsql;\n   266\t\n   267\tCREATE TRIGGER \"BookingRebookingLeg_is_consistent\"\n   268\t    BEFORE INSERT ON \"BookingRebookingLeg\"\n   269\t    FOR EACH ROW EXECUTE FUNCTION \"validate_booking_rebooking_leg\"();\n   270\t\n   271\t-- An event with no leg mapping says a rebooking happened but cannot say what\n   272\t-- changed. Deferred so a normal transaction can insert the event first.\n   273\tCREATE FUNCTION \"require_rebooking_legs\"()\n   274\tRETURNS TRIGGER AS $$\n   275\tBEGIN\n   276\t    IF NOT EXISTS (SELECT 1 FROM \"BookingRebooking\" WHERE \"id\" = NEW.\"id\") THEN\n   277\t        RETURN NULL;\n   278\t    END IF;\n   279\t    IF NOT EXISTS (\n   280\t        SELECT 1 FROM \"BookingRebookingLeg\" WHERE \"rebookingId\" = NEW.\"id\"\n   281\t    ) THEN\n   282\t        RAISE EXCEPTION 'BookingRebooking % must map at least one itinerary leg.', NEW.\"id\";\n   283\t    END IF;\n   284\t    RETURN NULL;\n   285\tEND;\n   286\t$$ LANGUAGE plpgsql;\n   287\t\n   288\tCREATE CONSTRAINT TRIGGER \"BookingRebooking_has_legs\"\n   289\t    AFTER INSERT ON \"BookingRebooking\"\n   290\t    DEFERRABLE INITIALLY DEFERRED\n   291\t    FOR EACH ROW EXECUTE FUNCTION \"require_rebooking_legs\"();\n   292\t\n   293\t-- A direct mapping or event delete would leave its source leg historical with\n   294\t-- no record of what replaced it. Deferred so deleting the whole booking remains\n   295\t-- possible: that cascade also deletes the source leg before this check runs.\n   296\tCREATE FUNCTION \"require_supersession_mapping_after_delete\"()\n   297\tRETURNS TRIGGER AS $$\n   298\tBEGIN\n   299\t    IF EXISTS (\n   300\t        SELECT 1 FROM \"ItineraryLeg\"\n   301\t        WHERE \"id\" = OLD.\"fromLegId\" AND \"supersededAt\" IS NOT NULL\n   302\t    ) AND NOT EXISTS (\n   303\t        SELECT 1 FROM \"BookingRebookingLeg\" WHERE \"fromLegId\" = OLD.\"fromLegId\"\n   304\t    ) THEN\n   305\t        RAISE EXCEPTION\n   306\t            'BookingRebookingLeg for superseded ItineraryLeg % cannot be deleted directly.',\n   307\t            OLD.\"fromLegId\";\n   308\t    END IF;\n   309\t    RETURN NULL;\n   310\tEND;\n   311\t$$ LANGUAGE plpgsql;\n   312\t\n   313\tCREATE CONSTRAINT TRIGGER \"BookingRebookingLeg_preserves_supersession\"\n   314\t    AFTER DELETE ON \"BookingRebookingLeg\"\n   315\t    DEFERRABLE INITIALLY DEFERRED\n   316\t    FOR EACH ROW EXECUTE FUNCTION \"require_supersession_mapping_after_delete\"();\n   317\t\n   318\t-- Updates rewrite audit history. Deletes remain available only through the\n   319\t-- booking cascade, matching BookingStatusChange and test-data cleanup.\n   320\tCREATE FUNCTION \"refuse_rebooking_audit_update\"()\n   321\tRETURNS TRIGGER AS $$\n   322\tBEGIN\n   323\t    RAISE EXCEPTION '% is append-only and cannot be modified.', TG_TABLE_NAME;\n   324\tEND;\n   325\t$$ LANGUAGE plpgsql;\n   326\t\n   327\tCREATE TRIGGER \"BookingRebooking_is_append_only\"\n   328\t    BEFORE UPDATE ON \"BookingRebooking\"\n   329\t    FOR EACH ROW EXECUTE FUNCTION \"refuse_rebooking_audit_update\"();\n   330\t\n   331\tCREATE TRIGGER \"BookingRebookingLeg_is_append_only\"\n   332\t    BEFORE UPDATE ON \"BookingRebookingLeg\"\n   333\t    FOR EACH ROW EXECUTE FUNCTION \"refuse_rebooking_audit_update\"();\n   150\tdescribe('immutable itinerary rebooking records', () => {\n   151\t    it('keeps the original leg and released seat while one replacement becomes active', async () => {\n   152\t        const saved = await recordRebooking();\n   153\t\n   154\t        const legs = await prisma.$queryRaw<Array<{\n   155\t            id: number;\n   156\t            supersededAt: Date | null;\n   157\t        }>>`\n   158\t            SELECT \"id\", \"supersededAt\"\n   159\t            FROM \"ItineraryLeg\"\n   160\t            WHERE \"bookingId\" = ${saved.booking.id}\n   161\t            ORDER BY \"id\"\n   162\t        `;\n   163\t        const seats = await prisma.seatAssignment.findMany({\n   164\t            where: { passengerId: saved.passengerId },\n   165\t            orderBy: { id: 'asc' },\n   166\t        });\n   167\t        const currentBooking = await prisma.booking.findUniqueOrThrow({\n   168\t            where: { id: saved.booking.id },\n   169\t            include: { rebookings: true },\n   170\t        });\n   171\t\n   172\t        expect(legs).toEqual([\n   173\t            { id: saved.oldLeg.id, supersededAt: expect.any(Date) },\n   174\t            { id: saved.newLegId, supersededAt: null },\n   175\t        ]);\n   176\t        expect(seats).toEqual(expect.arrayContaining([\n   177\t            expect.objectContaining({ legId: saved.oldLeg.id, seatNumber: '11A', releasedAt: expect.any(Date) }),\n   178\t            expect.objectContaining({ legId: saved.newLegId, seatNumber: '14C', releasedAt: null }),\n   179\t        ]));\n   180\t        expect(currentBooking).toMatchObject({\n   181\t            status: 'CONFIRMED',\n   182\t            paymentIntentId: saved.booking.paymentIntentId,\n   183\t            totalPriceCents: 30_000,\n   184\t            rebookings: [expect.objectContaining({\n   185\t                id: saved.rebookingId,\n   186\t                farePolicy: 'DISRUPTION_WAIVER',\n   187\t            })],\n   188\t        });\n   189\t        expect(saved.replacementFlight.priceCents).toBe(45_000);\n   190\t    });\n   191\t\n   192\t    it('stops treating the superseded flight as part of the live booking', async () => {\n   193\t        const saved = await recordRebooking();\n   194\t\n   195\t        const locked = await prisma.$transaction(async tx => ({\n   196\t            oldFlight: await lockBookingsOnFlightForUpdate(tx, saved.oldLeg.flightId),\n   197\t            replacementFlight: await lockBookingsOnFlightForUpdate(\n   198\t                tx,\n   199\t                saved.replacementFlight.id,\n   200\t            ),\n   201\t        }));\n   202\t\n   203\t        expect(locked).toEqual({\n   204\t            oldFlight: [],\n   205\t            replacementFlight: [saved.booking.id],\n   206\t        });\n   207\t    });\n   208\t\n   209\t    it('allows only one active leg at an itinerary position', async () => {\n   210\t        const saved = await recordRebooking();\n   211\t        const anotherFlight = await flight('THIRD');\n   212\t\n   213\t        await expect(prisma.$executeRaw`\n   214\t            INSERT INTO \"ItineraryLeg\" (\"bookingId\", \"sequence\", \"flightId\")\n   215\t            VALUES (${saved.booking.id}, 1, ${anotherFlight.id})\n   216\t        `).rejects.toThrow(/Key \\(\\\"bookingId\\\", sequence\\)=\\(.+, 1\\) already exists/);\n   217\t    });\n   218\t\n   219\t    it('requires every new leg to start active', async () => {\n   220\t        const scenario = await disruptedBooking();\n   221\t        const anotherFlight = await flight('PRE-SUPERSEDED');\n   222\t\n   223\t        await expect(prisma.$executeRaw`\n   224\t            INSERT INTO \"ItineraryLeg\"\n   225\t                (\"bookingId\", \"sequence\", \"flightId\", \"supersededAt\")\n   226\t            VALUES (\n   227\t                ${scenario.booking.id},\n   228\t                2,\n   229\t                ${anotherFlight.id},\n   230\t                statement_timestamp()\n   231\t            )\n   232\t        `).rejects.toThrow(/new ItineraryLeg must start active/);\n   233\t    });\n   234\t\n   235\t    it('never lets a superseded leg become active again', async () => {\n   236\t        const saved = await recordRebooking();\n   237\t\n   238\t        await expect(prisma.$executeRaw`\n   239\t            UPDATE \"ItineraryLeg\" SET \"supersededAt\" = NULL WHERE \"id\" = ${saved.oldLeg.id}\n   240\t        `).rejects.toThrow(/ItineraryLeg supersession is permanent/);\n   241\t    });\n   242\t\n   243\t    it('requires a new version instead of rewriting a leg in place', async () => {\n   244\t        const scenario = await disruptedBooking();\n   245\t        const anotherFlight = await flight('IN-PLACE-REWRITE');\n   246\t\n   247\t        await expect(prisma.$executeRaw`\n   248\t            UPDATE \"ItineraryLeg\"\n   249\t            SET \"flightId\" = ${anotherFlight.id}\n   250\t            WHERE \"id\" = ${scenario.oldLeg.id}\n   251\t        `).rejects.toThrow(/ItineraryLeg identity is immutable/);\n   252\t    });\n   253\t\n   254\t    it('refuses to delete a leg while its booking still exists', async () => {\n   255\t        const scenario = await disruptedBooking();\n   256\t\n   257\t        await expect(prisma.itineraryLeg.delete({\n   258\t            where: { id: scenario.oldLeg.id },\n   259\t        })).rejects.toThrow(/cannot be deleted while booking/);\n   260\t\n   261\t        expect(await prisma.itineraryLeg.count({\n   262\t            where: { id: scenario.oldLeg.id },\n   263\t        })).toBe(1);\n   264\t    });\n   265\t\n   266\t    it('does not let a cascading leg delete erase its rebooking mapping', async () => {\n   267\t        const saved = await recordRebooking();\n   268\t\n   269\t        await expect(prisma.itineraryLeg.delete({\n   270\t            where: { id: saved.oldLeg.id },\n   271\t        })).rejects.toThrow(/cannot be deleted while booking/);\n   272\t\n   273\t        expect(await prisma.bookingRebookingLeg.count({\n   274\t            where: { rebookingId: saved.rebookingId },\n   275\t        })).toBe(1);\n   276\t    });\n   277\t\n   278\t    it('does not let a cascading replacement delete erase its rebooking mapping', async () => {\n   279\t        const saved = await recordRebooking();\n   280\t\n   281\t        await expect(prisma.itineraryLeg.delete({\n   282\t            where: { id: saved.newLegId },\n   283\t        })).rejects.toThrow(/cannot be deleted while booking/);\n   284\t\n   285\t        expect(await prisma.bookingRebookingLeg.count({\n   286\t            where: { rebookingId: saved.rebookingId },\n   287\t        })).toBe(1);\n   288\t    });\n   289\t\n   290\t    it('makes the rebooking event append-only', async () => {\n   291\t        const saved = await recordRebooking();\n   292\t\n   293\t        await expect(prisma.$executeRaw`\n   294\t            UPDATE \"BookingRebooking\" SET \"createdAt\" = \"createdAt\"\n   295\t            WHERE \"id\" = ${saved.rebookingId}\n   296\t        `).rejects.toThrow(/BookingRebooking is append-only/);\n   297\t    });\n   298\t\n   299\t    it('makes the rebooking leg mapping append-only', async () => {\n   300\t        const saved = await recordRebooking();\n   301\t\n   302\t        await expect(prisma.$executeRaw`\n   303\t            UPDATE \"BookingRebookingLeg\" SET \"toLegId\" = \"toLegId\"\n   304\t            WHERE \"rebookingId\" = ${saved.rebookingId}\n   305\t              AND \"fromLegId\" = ${saved.oldLeg.id}\n   306\t        `).rejects.toThrow(/BookingRebookingLeg is append-only/);\n   307\t    });\n   308\t\n   309\t    it('refuses to delete a leg mapping while its historical leg remains', async () => {\n   310\t        const saved = await recordRebooking();\n   311\t\n   312\t        await expect(prisma.$transaction(async tx => {\n   313\t            await tx.bookingRebookingLeg.delete({\n   314\t                where: {\n   315\t                    rebookingId_fromLegId: {\n   316\t                        rebookingId: saved.rebookingId,\n   317\t                        fromLegId: saved.oldLeg.id,\n   318\t                    },\n   319\t                },\n   320\t            });\n   321\t            await tx.$executeRaw`\n   322\t                SET CONSTRAINTS \"BookingRebookingLeg_preserves_supersession\" IMMEDIATE\n   323\t            `;\n   324\t        })).rejects.toThrow(/cannot be deleted directly/);\n   325\t\n   326\t        expect(await prisma.bookingRebookingLeg.count({\n   327\t            where: { rebookingId: saved.rebookingId },\n   328\t        })).toBe(1);\n   329\t    });\n   330\t\n   331\t    it('refuses to delete a rebooking event while its historical leg remains', async () => {\n   332\t        const saved = await recordRebooking();\n   333\t\n   334\t        await expect(prisma.$transaction(async tx => {\n   335\t            await tx.bookingRebooking.delete({ where: { id: saved.rebookingId } });\n   336\t            await tx.$executeRaw`\n   337\t                SET CONSTRAINTS \"BookingRebookingLeg_preserves_supersession\" IMMEDIATE\n   338\t            `;\n   339\t        })).rejects.toThrow(/cannot be deleted directly/);\n   340\t\n   341\t        expect(await prisma.bookingRebooking.count({\n   342\t            where: { id: saved.rebookingId },\n   343\t        })).toBe(1);\n   344\t    });\n   345\t\n   346\t    it('refuses a mapping between different itinerary positions', async () => {\n   347\t        const scenario = await disruptedBooking();\n   348\t        const replacementFlight = await flight('WRONG-SEQUENCE');\n   349\t        const rebookingId = randomUUID();\n   350\t\n   351\t        await expect(prisma.$transaction(async tx => {\n   352\t            await tx.$executeRaw`\n   353\t                UPDATE \"ItineraryLeg\"\n   354\t                SET \"supersededAt\" = statement_timestamp()\n   355\t                WHERE \"id\" = ${scenario.oldLeg.id}\n   356\t            `;\n   357\t            const [wrongLeg] = await tx.$queryRaw<Array<{ id: number }>>`\n   358\t                INSERT INTO \"ItineraryLeg\" (\"bookingId\", \"sequence\", \"flightId\")\n   359\t                VALUES (${scenario.booking.id}, 2, ${replacementFlight.id})\n   360\t                RETURNING \"id\"\n   361\t            `;\n   362\t            await resolveDisruption(tx, scenario.booking.id, rebookingId);\n   363\t            await tx.$executeRaw`\n   364\t                INSERT INTO \"BookingRebookingLeg\" (\"rebookingId\", \"fromLegId\", \"toLegId\")\n   365\t                VALUES (${rebookingId}, ${scenario.oldLeg.id}, ${wrongLeg.id})\n   366\t            `;\n   367\t        })).rejects.toThrow(/same itinerary position/);\n   368\t    });\n   369\t\n   370\t    it('refuses to supersede a leg without recording its replacement', async () => {\n   371\t        const scenario = await disruptedBooking();\n   372\t\n   373\t        await expect(prisma.$executeRaw`\n   374\t            UPDATE \"ItineraryLeg\"\n   375\t            SET \"supersededAt\" = statement_timestamp()\n   376\t            WHERE \"id\" = ${scenario.oldLeg.id}\n   377\t        `).rejects.toThrow(/must be recorded by a BookingRebookingLeg/);\n   378\t    });\n   379\t\n   380\t    it('refuses to supersede a leg while its old seat is still live', async () => {\n   381\t        await expect(recordRebooking({\n   382\t            releaseOldSeat: false,\n   383\t            checkSupersessionNow: true,\n   384\t        })).rejects.toThrow(/cannot retain live seat assignments/);\n   385\t    });\n   386\t\n   387\t    it('refuses a rebooking event with no leg replacement', async () => {\n   388\t        const scenario = await disruptedBooking();\n   389\t        const rebookingId = randomUUID();\n   390\t\n   391\t        await expect(prisma.$transaction(async tx => {\n   392\t            await resolveDisruption(tx, scenario.booking.id, rebookingId);\n   393\t            // Prisma 5 logs a deferred-constraint failure from COMMIT but can\n   394\t            // resolve the interactive-transaction promise. A product writer\n   395\t            // will make all rebooking constraints immediate as its final\n   396\t            // statement; do that here so the rejected write is observable to\n   397\t            // the caller as well as rolled back by PostgreSQL.\n   398\t            await tx.$executeRaw`SET CONSTRAINTS \"BookingRebooking_has_legs\" IMMEDIATE`;\n   399\t        })).rejects.toThrow(/must map at least one itinerary leg/);\n   400\t    });\n   401\t\n   402\t    it('refuses a leg mapping that crosses booking references', async () => {\n   403\t        const scenario = await disruptedBooking();\n   404\t        const other = await disruptedBooking();\n   405\t        const rebookingId = randomUUID();\n   406\t\n   407\t        await expect(prisma.$transaction(async tx => {\n   408\t            await tx.$executeRaw`\n   409\t                UPDATE \"ItineraryLeg\"\n   410\t                SET \"supersededAt\" = statement_timestamp()\n   411\t                WHERE \"id\" = ${scenario.oldLeg.id}\n   412\t            `;\n   413\t            await resolveDisruption(tx, scenario.booking.id, rebookingId);\n   414\t            await tx.$executeRaw`\n   415\t                INSERT INTO \"BookingRebookingLeg\" (\"rebookingId\", \"fromLegId\", \"toLegId\")\n   416\t                VALUES (${rebookingId}, ${scenario.oldLeg.id}, ${other.oldLeg.id})\n   417\t            `;\n   418\t        })).rejects.toThrow(/same booking and same itinerary position/);\n   419\t    });\n   420\t\n   421\t    it('refuses an event whose status change also records a refund', async () => {\n   422\t        const scenario = await disruptedBooking();\n   423\t        const rebookingId = randomUUID();\n   424\t\n   425\t        await expect(prisma.$transaction(async tx => {\n   426\t            await tx.$executeRaw`\n   427\t                SELECT set_config('app.booking_refund_cents', '1', true)\n   428\t            `;\n   429\t            await resolveDisruption(tx, scenario.booking.id, rebookingId);\n   430\t        })).rejects.toThrow(/one non-refunding DISRUPTED to CONFIRMED status change/);\n   431\t    });\n   432\t\n   433\t    it('refuses an event that is not the resolution of a disruption', async () => {\n   434\t        const scenario = await disruptedBooking();\n   435\t        const initialChange = await prisma.bookingStatusChange.findFirstOrThrow({\n   436\t            where: { bookingId: scenario.booking.id, from: null, to: 'DISRUPTED' },\n   437\t        });\n   438\t\n   439\t        await expect(prisma.$executeRaw`\n   440\t            INSERT INTO \"BookingRebooking\"\n   441\t                (\"id\", \"bookingId\", \"bookingStatusChangeId\", \"farePolicy\")\n   442\t            VALUES (\n   443\t                ${randomUUID()},\n   444\t                ${scenario.booking.id},\n   445\t                ${initialChange.id},\n   446\t                'DISRUPTION_WAIVER'\n   447\t            )\n   448\t        `).rejects.toThrow(/one non-refunding DISRUPTED to CONFIRMED status change/);\n   449\t    });\n   450\t\n   451\t    it('cascades the immutable history when its booking is deleted', async () => {\n   452\t        const saved = await recordRebooking();\n   453\t\n   454\t        expect(await prisma.booking.deleteMany({\n   455\t            where: { id: saved.booking.id },\n   456\t        })).toEqual({ count: 1 });\n   457\t\n   458\t        expect(await prisma.bookingRebooking.count({\n   459\t            where: { id: saved.rebookingId },\n   460\t        })).toBe(0);\n   461\t        expect(await prisma.bookingRebookingLeg.count({\n   462\t            where: { rebookingId: saved.rebookingId },\n   463\t        })).toBe(0);\n   464\t        expect(await prisma.itineraryLeg.count({\n   465\t            where: { bookingId: saved.booking.id },\n   466\t        })).toBe(0);\n   467\t    });\n   468\t});\n"},"started_at_ms":1786906944113,"completed_at_ms":1786906944115}}
{"timestamp":"2026-08-16T19:02:24.281Z","ordinal":25305,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a00bf4-2319-73b1-b4be-9be1fceb8939","call_id":"call_NPRwMx4mJornrv09E5Q0KAVT","output":[{"type":"input_text","text":"Script completed\nWall time 0.4 seconds\nOutput:\n"},{"type":"input_text","text":" M __tests__/app/actions.test.ts\n M __tests__/lib/FlightBookingService.test.ts\n M __tests__/lib/bookingItinerary.test.ts\n M app/actions.ts\n M app/admin/flights/page.tsx\n M app/admin/page.tsx\n M app/profile/page.tsx\n M lib/FlightBookingService.ts\n M lib/bookingItinerary.ts\n M lib/flightLock.ts\n M prisma/schema.prisma\n?? __tests__/app/activeItineraryReads.test.tsx\n?? __tests__/lib/itineraryRebooking.database.test.ts\n?? prisma/migrations/20260816181000_version_itinerary_legs/\n    35\t-- rows share a sequence, restoring the unconditional unique key is impossible\n    36\t-- without deleting audit history.\n    37\t\n    38\tCREATE TYPE \"RebookingFarePolicy\" AS ENUM ('DISRUPTION_WAIVER');\n    39\t\n    40\tALTER TABLE \"ItineraryLeg\"\n    41\t    ADD COLUMN \"supersededAt\" TIMESTAMP(3);\n    42\t\n    43\tDROP INDEX \"ItineraryLeg_bookingId_sequence_key\";\n    44\t\n    45\t-- Historical rows may share a position; exactly one current row may not.\n    46\tCREATE UNIQUE INDEX \"ItineraryLeg_active_booking_sequence_key\"\n    47\t    ON \"ItineraryLeg\"(\"bookingId\", \"sequence\")\n    48\t    WHERE \"supersededAt\" IS NULL;\n    49\t\n    50\tCREATE INDEX \"ItineraryLeg_bookingId_supersededAt_sequence_idx\"\n    51\t    ON \"ItineraryLeg\"(\"bookingId\", \"supersededAt\", \"sequence\");\n    52\t\n    53\tCREATE TABLE \"BookingRebooking\" (\n    54\t    \"id\" TEXT NOT NULL,\n    55\t    \"bookingId\" INTEGER NOT NULL,\n    56\t    \"bookingStatusChangeId\" TEXT NOT NULL,\n    57\t    \"farePolicy\" \"RebookingFarePolicy\" NOT NULL DEFAULT 'DISRUPTION_WAIVER',\n    58\t    \"createdAt\" TIMESTAMP(3) NOT NULL DEFAULT CURRENT_TIMESTAMP,\n    59\t\n    60\t    CONSTRAINT \"BookingRebooking_pkey\" PRIMARY KEY (\"id\")\n    61\t);\n    62\t\n    63\tCREATE UNIQUE INDEX \"BookingRebooking_bookingStatusChangeId_key\"\n    64\t    ON \"BookingRebooking\"(\"bookingStatusChangeId\");\n    65\tCREATE INDEX \"BookingRebooking_bookingId_createdAt_idx\"\n    66\t    ON \"BookingRebooking\"(\"bookingId\", \"createdAt\");\n    67\t\n    68\tALTER TABLE \"BookingRebooking\"\n    69\t    ADD CONSTRAINT \"BookingRebooking_bookingId_fkey\"\n    70\t        FOREIGN KEY (\"bookingId\") REFERENCES \"Booking\"(\"id\")\n    71\t        ON DELETE CASCADE ON UPDATE CASCADE,\n    72\t    ADD CONSTRAINT \"BookingRebooking_bookingStatusChangeId_fkey\"\n    73\t        FOREIGN KEY (\"bookingStatusChangeId\") REFERENCES \"BookingStatusChange\"(\"id\")\n    74\t        ON DELETE NO ACTION ON UPDATE CASCADE;\n    75\t\n    76\tCREATE TABLE \"BookingRebookingLeg\" (\n    77\t    \"rebookingId\" TEXT NOT NULL,\n    78\t    \"fromLegId\" INTEGER NOT NULL,\n    79\t    \"toLegId\" INTEGER NOT NULL,\n    80\t\n    81\t    CONSTRAINT \"BookingRebookingLeg_pkey\" PRIMARY KEY (\"rebookingId\", \"fromLegId\"),\n    82\t    CONSTRAINT \"BookingRebookingLeg_different_legs\" CHECK (\"fromLegId\" <> \"toLegId\")\n    83\t);\n    84\t\n    85\tCREATE UNIQUE INDEX \"BookingRebookingLeg_fromLegId_key\"\n    86\t    ON \"BookingRebookingLeg\"(\"fromLegId\");\n    87\tCREATE UNIQUE INDEX \"BookingRebookingLeg_toLegId_key\"\n    88\t    ON \"BookingRebookingLeg\"(\"toLegId\");\n    89\t\n    90\tALTER TABLE \"BookingRebookingLeg\"\n    91\t    ADD CONSTRAINT \"BookingRebookingLeg_rebookingId_fkey\"\n    92\t        FOREIGN KEY (\"rebookingId\") REFERENCES \"BookingRebooking\"(\"id\")\n    93\t        ON DELETE CASCADE ON UPDATE CASCADE,\n    94\t    ADD CONSTRAINT \"BookingRebookingLeg_fromLegId_fkey\"\n    95\t        FOREIGN KEY (\"fromLegId\") REFERENCES \"ItineraryLeg\"(\"id\")\n    96\t        ON DELETE CASCADE ON UPDATE CASCADE,\n    97\t    ADD CONSTRAINT \"BookingRebookingLeg_toLegId_fkey\"\n    98\t        FOREIGN KEY (\"toLegId\") REFERENCES \"ItineraryLeg\"(\"id\")\n    99\t        ON DELETE CASCADE ON UPDATE CASCADE;\n   100\t\n   101\t-- Every historical leg has to become historical through the recorded update\n   102\t-- below. Accepting a row that starts superseded would bypass that audit path.\n   103\tCREATE FUNCTION \"require_new_itinerary_leg_active\"()\n   104\tRETURNS TRIGGER AS $$\n   105\tBEGIN\n   106\t    IF NEW.\"supersededAt\" IS NOT NULL THEN\n   107\t        RAISE EXCEPTION\n   108\t            'A new ItineraryLeg must start active; supersede it through a recorded rebooking.';\n   109\t    END IF;\n   110\t    RETURN NEW;\n   111\tEND;\n   112\t$$ LANGUAGE plpgsql;\n   113\t\n   114\tCREATE TRIGGER \"ItineraryLeg_starts_active\"\n   115\t    BEFORE INSERT ON \"ItineraryLeg\"\n   116\t    FOR EACH ROW EXECUTE FUNCTION \"require_new_itinerary_leg_active\"();\n   117\t\n   118\t-- A leg disappears only when its whole booking does. Deferred so the booking\n   119\t-- cascade has removed the parent by the time this checks it; a direct leg\n   120\t-- delete, even beside deletion of its audit mapping, still sees the booking.\n   121\tCREATE FUNCTION \"require_itinerary_leg_booking_delete\"()\n   122\tRETURNS TRIGGER AS $$\n   123\tBEGIN\n   124\t    IF EXISTS (SELECT 1 FROM \"Booking\" WHERE \"id\" = OLD.\"bookingId\") THEN\n   125\t        RAISE EXCEPTION\n   126\t            'ItineraryLeg % cannot be deleted while booking % exists.',\n   127\t            OLD.\"id\", OLD.\"bookingId\";\n   128\t    END IF;\n   129\t    RETURN NULL;\n   130\tEND;\n   131\t$$ LANGUAGE plpgsql;\n   132\t\n   133\tCREATE CONSTRAINT TRIGGER \"ItineraryLeg_deletes_with_booking\"\n   134\t    AFTER DELETE ON \"ItineraryLeg\"\n   135\t    DEFERRABLE INITIALLY DEFERRED\n   136\t    FOR EACH ROW EXECUTE FUNCTION \"require_itinerary_leg_booking_delete\"();\n   137\t\n   138\t-- A leg's identity never changes in place: a different flight is a new version.\n   139\t-- Once superseded, its timestamp is permanent too. The sole state transition\n   140\t-- this permits is setting supersededAt on a currently active leg.\n   141\tCREATE FUNCTION \"refuse_itinerary_leg_rewrite\"()\n   142\tRETURNS TRIGGER AS $$\n   143\tBEGIN\n   144\t    IF NEW.\"id\" IS DISTINCT FROM OLD.\"id\"\n   145\t       OR NEW.\"bookingId\" IS DISTINCT FROM OLD.\"bookingId\"\n   146\t       OR NEW.\"sequence\" IS DISTINCT FROM OLD.\"sequence\"\n   147\t       OR NEW.\"flightId\" IS DISTINCT FROM OLD.\"flightId\" THEN\n   148\t        RAISE EXCEPTION\n   149\t            'ItineraryLeg identity is immutable: replace leg % with a new version.',\n   150\t            OLD.\"id\";\n   151\t    END IF;\n   152\t    IF OLD.\"supersededAt\" IS NOT NULL\n   153\t       AND NEW.\"supersededAt\" IS DISTINCT FROM OLD.\"supersededAt\" THEN\n   154\t        RAISE EXCEPTION\n   155\t            'ItineraryLeg supersession is permanent: leg % cannot become active or change time.',\n   156\t            OLD.\"id\";\n   157\t    END IF;\n   158\t    RETURN NEW;\n   159\tEND;\n   160\t$$ LANGUAGE plpgsql;\n   161\t\n   162\tCREATE TRIGGER \"ItineraryLeg_supersession_is_permanent\"\n   163\t    BEFORE UPDATE ON \"ItineraryLeg\"\n   164\t    FOR EACH ROW EXECUTE FUNCTION \"refuse_itinerary_leg_rewrite\"();\n   165\t\n   166\t-- A superseded leg must be named by an immutable rebooking mapping before its\n   167\t-- transaction commits. Deferred because the event and replacement leg are\n   168\t-- naturally written after the original leg is marked historical.\n   169\tCREATE FUNCTION \"require_recorded_leg_supersession\"()\n   170\tRETURNS TRIGGER AS $$\n   171\tBEGIN\n   172\t    IF NOT EXISTS (SELECT 1 FROM \"ItineraryLeg\" WHERE \"id\" = NEW.\"id\") THEN\n   173\t        RETURN NULL;\n   174\t    END IF;\n   175\t    IF NOT EXISTS (\n   176\t        SELECT 1 FROM \"BookingRebookingLeg\" WHERE \"fromLegId\" = NEW.\"id\"\n   177\t    ) THEN\n   178\t        RAISE EXCEPTION\n   179\t            'Superseded ItineraryLeg % must be recorded by a BookingRebookingLeg.',\n   180\t            NEW.\"id\";\n   181\t    END IF;\n   182\t    IF EXISTS (\n   183\t        SELECT 1 FROM \"SeatAssignment\"\n   184\t        WHERE \"legId\" = NEW.\"id\" AND \"releasedAt\" IS NULL\n   185\t    ) THEN\n   186\t        RAISE EXCEPTION\n   187\t            'Superseded ItineraryLeg % cannot retain live seat assignments.',\n   188\t            NEW.\"id\";\n   189\t    END IF;\n   190\t    RETURN NULL;\n   191\tEND;\n   192\t$$ LANGUAGE plpgsql;\n   193\t\n   194\tCREATE CONSTRAINT TRIGGER \"ItineraryLeg_supersession_is_recorded\"\n   195\t    AFTER UPDATE OF \"supersededAt\" ON \"ItineraryLeg\"\n   196\t    DEFERRABLE INITIALLY DEFERRED\n   197\t    FOR EACH ROW\n   198\t    WHEN (OLD.\"supersededAt\" IS NULL AND NEW.\"supersededAt\" IS NOT NULL)\n   199\t    EXECUTE FUNCTION \"require_recorded_leg_supersession\"();\n   200\t\n   201\t-- The status row is the booking-wide audit sequence. A rebooking can only be\n   202\t-- attached to the transition that resolves a disruption, for the same\n   203\t-- booking, and cannot simultaneously claim a refund.\n   204\tCREATE FUNCTION \"validate_booking_rebooking\"()\n   205\tRETURNS TRIGGER AS $$\n   206\tDECLARE\n   207\t    change \"BookingStatusChange\";\n   208\tBEGIN\n   209\t    SELECT * INTO change\n   210\t    FROM \"BookingStatusChange\"\n   211\t    WHERE \"id\" = NEW.\"bookingStatusChangeId\";\n   212\t\n   213\t    IF NOT FOUND\n   214\t       OR change.\"bookingId\" <> NEW.\"bookingId\"\n   215\t       OR change.\"from\" IS DISTINCT FROM 'DISRUPTED'::\"BookingStatus\"\n   216\t       OR change.\"to\" IS DISTINCT FROM 'CONFIRMED'::\"BookingStatus\"\n   217\t       OR change.\"refundCents\" IS NOT NULL THEN\n   218\t        RAISE EXCEPTION\n   219\t            'BookingRebooking must match one non-refunding DISRUPTED to CONFIRMED status change.';\n   220\t    END IF;\n   221\t    RETURN NEW;\n   222\tEND;\n   223\t$$ LANGUAGE plpgsql;\n   224\t\n   225\tCREATE TRIGGER \"BookingRebooking_is_consistent\"\n   226\t    BEFORE INSERT ON \"BookingRebooking\"\n   227\t    FOR EACH ROW EXECUTE FUNCTION \"validate_booking_rebooking\"();\n   228\t\n   229\t-- Both legs remain real rows. The old one must already be historical, the new\n   230\t-- one current, and both must occupy the same position in this booking.\n   231\tCREATE FUNCTION \"validate_booking_rebooking_leg\"()\n   232\tRETURNS TRIGGER AS $$\n   233\tDECLARE\n   234\t    event_booking_id INTEGER;\n   235\t    from_booking_id INTEGER;\n   236\t    from_sequence INTEGER;\n   237\t    from_superseded_at TIMESTAMP(3);\n   238\t    to_booking_id INTEGER;\n   239\t    to_sequence INTEGER;\n   240\t    to_superseded_at TIMESTAMP(3);\n   241\tBEGIN\n   242\t    SELECT \"bookingId\" INTO event_booking_id\n   243\t    FROM \"BookingRebooking\"\n   244\t    WHERE \"id\" = NEW.\"rebookingId\";\n   245\t    SELECT \"bookingId\", \"sequence\", \"supersededAt\"\n   246\t        INTO from_booking_id, from_sequence, from_superseded_at\n   247\t    FROM \"ItineraryLeg\" WHERE \"id\" = NEW.\"fromLegId\";\n   248\t    SELECT \"bookingId\", \"sequence\", \"supersededAt\"\n   249\t        INTO to_booking_id, to_sequence, to_superseded_at\n   250\t    FROM \"ItineraryLeg\" WHERE \"id\" = NEW.\"toLegId\";\n   251\t\n   252\t    IF event_booking_id IS NULL\n   253\t       OR from_booking_id IS NULL\n   254\t       OR to_booking_id IS NULL\n   255\t       OR from_booking_id <> event_booking_id\n   256\t       OR to_booking_id <> event_booking_id\n   257\t       OR from_sequence <> to_sequence\n   258\t       OR from_superseded_at IS NULL\n   259\t       OR to_superseded_at IS NOT NULL THEN\n   260\t        RAISE EXCEPTION\n   261\t            'BookingRebookingLeg must map superseded and active legs from the same booking and same itinerary position.';\n   262\t    END IF;\n   263\t    RETURN NEW;\n   264\tEND;\n   265\t$$ LANGUAGE plpgsql;\n   266\t\n   267\tCREATE TRIGGER \"BookingRebookingLeg_is_consistent\"\n   268\t    BEFORE INSERT ON \"BookingRebookingLeg\"\n   269\t    FOR EACH ROW EXECUTE FUNCTION \"validate_booking_rebooking_leg\"();\n   270\t\n   271\t-- An event with no leg mapping says a rebooking happened but cannot say what\n   272\t-- changed. Deferred so a normal transaction can insert the event first.\n   273\tCREATE FUNCTION \"require_rebooking_legs\"()\n   274\tRETURNS TRIGGER AS $$\n   275\tBEGIN\n   276\t    IF NOT EXISTS (SELECT 1 FROM \"BookingRebooking\" WHERE \"id\" = NEW.\"id\") THEN\n   277\t        RETURN NULL;\n   278\t    END IF;\n   279\t    IF NOT EXISTS (\n   280\t        SELECT 1 FROM \"BookingRebookingLeg\" WHERE \"rebookingId\" = NEW.\"id\"\n   281\t    ) THEN\n   282\t        RAISE EXCEPTION 'BookingRebooking % must map at least one itinerary leg.', NEW.\"id\";\n   283\t    END IF;\n   284\t    RETURN NULL;\n   285\tEND;\n   286\t$$ LANGUAGE plpgsql;\n   287\t\n   288\tCREATE CONSTRAINT TRIGGER \"BookingRebooking_has_legs\"\n   289\t    AFTER INSERT ON \"BookingRebooking\"\n   290\t    DEFERRABLE INITIALLY DEFERRED\n   291\t    FOR EACH ROW EXECUTE FUNCTION \"require_rebooking_legs\"();\n   292\t\n   293\t-- A direct mapping or event delete would leave its source leg historical with\n   294\t-- no record of what replaced it. Deferred so deleting the whole booking remains\n   295\t-- possible: that cascade also deletes the source leg before this check runs.\n   296\tCREATE FUNCTION \"require_supersession_mapping_after_delete\"()\n   297\tRETURNS TRIGGER AS $$\n   298\tBEGIN\n   299\t    IF EXISTS (\n   300\t        SELECT 1 FROM \"ItineraryLeg\"\n   301\t        WHERE \"id\" = OLD.\"fromLegId\" AND \"supersededAt\" IS NOT NULL\n   302\t    ) AND NOT EXISTS (\n   303\t        SELECT 1 FROM \"BookingRebookingLeg\" WHERE \"fromLegId\" = OLD.\"fromLegId\"\n   304\t    ) THEN\n   305\t        RAISE EXCEPTION\n   306\t            'BookingRebookingLeg for superseded ItineraryLeg % cannot be deleted directly.',\n   307\t            OLD.\"fromLegId\";\n   308\t    END IF;\n   309\t    RETURN NULL;\n   310\tEND;\n   311\t$$ LANGUAGE plpgsql;\n   312\t\n   313\tCREATE CONSTRAINT TRIGGER \"BookingRebookingLeg_preserves_supersession\"\n   314\t    AFTER DELETE ON \"BookingRebookingLeg\"\n   315\t    DEFERRABLE INITIALLY DEFERRED\n   316\t    FOR EACH ROW EXECUTE FUNCTION \"require_supersession_mapping_after_delete\"();\n   317\t\n   318\t-- Updates rewrite audit history. Deletes remain available only through the\n   319\t-- booking cascade, matching BookingStatusChange and test-data cleanup.\n   320\tCREATE FUNCTION \"refuse_rebooking_audit_update\"()\n   321\tRETURNS TRIGGER AS $$\n   322\tBEGIN\n   323\t    RAISE EXCEPTION '% is append-only and cannot be modified.', TG_TABLE_NAME;\n   324\tEND;\n   325\t$$ LANGUAGE plpgsql;\n   326\t\n   327\tCREATE TRIGGER \"BookingRebooking_is_append_only\"\n   328\t    BEFORE UPDATE ON \"BookingRebooking\"\n   329\t    FOR EACH ROW EXECUTE FUNCTION \"refuse_rebooking_audit_update\"();\n   330\t\n   331\tCREATE TRIGGER \"BookingRebookingLeg_is_append_only\"\n   332\t    BEFORE UPDATE ON \"BookingRebookingLeg\"\n   333\t    FOR EACH ROW EXECUTE FUNCTION \"refuse_rebooking_audit_update\"();\n   150\tdescribe('immutable itinerary rebooking records', () => {\n   151\t    it('keeps the original leg and released seat while one replacement becomes active', async () => {\n   152\t        const saved = await recordRebooking();\n   153\t\n   154\t        const legs = await prisma.$queryRaw<Array<{\n   155\t            id: number;\n   156\t            supersededAt: Date | null;\n   157\t        }>>`\n   158\t            SELECT \"id\", \"supersededAt\"\n   159\t            FROM \"ItineraryLeg\"\n   160\t            WHERE \"bookingId\" = ${saved.booking.id}\n   161\t            ORDER BY \"id\"\n   162\t        `;\n   163\t        const seats = await prisma.seatAssignment.findMany({\n   164\t            where: { passengerId: saved.passengerId },\n   165\t            orderBy: { id: 'asc' },\n   166\t        });\n   167\t        const currentBooking = await prisma.booking.findUniqueOrThrow({\n   168\t            where: { id: saved.booking.id },\n   169\t            include: { rebookings: true },\n   170\t        });\n   171\t\n   172\t        expect(legs).toEqual([\n   173\t            { id: saved.oldLeg.id, supersededAt: expect.any(Date) },\n   174\t            { id: saved.newLegId, supersededAt: null },\n   175\t        ]);\n   176\t        expect(seats).toEqual(expect.arrayContaining([\n   177\t            expect.objectContaining({ legId: saved.oldLeg.id, seatNumber: '11A', releasedAt: expect.any(Date) }),\n   178\t            expect.objectContaining({ legId: saved.newLegId, seatNumber: '14C', releasedAt: null }),\n   179\t        ]));\n   180\t        expect(currentBooking).toMatchObject({\n   181\t            status: 'CONFIRMED',\n   182\t            paymentIntentId: saved.booking.paymentIntentId,\n   183\t            totalPriceCents: 30_000,\n   184\t            rebookings: [expect.objectContaining({\n   185\t                id: saved.rebookingId,\n   186\t                farePolicy: 'DISRUPTION_WAIVER',\n   187\t            })],\n   188\t        });\n   189\t        expect(saved.replacementFlight.priceCents).toBe(45_000);\n   190\t    });\n   191\t\n   192\t    it('stops treating the superseded flight as part of the live booking', async () => {\n   193\t        const saved = await recordRebooking();\n   194\t\n   195\t        const locked = await prisma.$transaction(async tx => ({\n   196\t            oldFlight: await lockBookingsOnFlightForUpdate(tx, saved.oldLeg.flightId),\n   197\t            replacementFlight: await lockBookingsOnFlightForUpdate(\n   198\t                tx,\n   199\t                saved.replacementFlight.id,\n   200\t            ),\n   201\t        }));\n   202\t\n   203\t        expect(locked).toEqual({\n   204\t            oldFlight: [],\n   205\t            replacementFlight: [saved.booking.id],\n   206\t        });\n   207\t    });\n   208\t\n   209\t    it('allows only one active leg at an itinerary position', async () => {\n   210\t        const saved = await recordRebooking();\n   211\t        const anotherFlight = await flight('THIRD');\n   212\t\n   213\t        await expect(prisma.$executeRaw`\n   214\t            INSERT INTO \"ItineraryLeg\" (\"bookingId\", \"sequence\", \"flightId\")\n   215\t            VALUES (${saved.booking.id}, 1, ${anotherFlight.id})\n   216\t        `).rejects.toThrow(/Key \\(\\\"bookingId\\\", sequence\\)=\\(.+, 1\\) already exists/);\n   217\t    });\n   218\t\n   219\t    it('requires every new leg to start active', async () => {\n   220\t        const scenario = await disruptedBooking();\n   221\t        const anotherFlight = await flight('PRE-SUPERSEDED');\n   222\t\n   223\t        await expect(prisma.$executeRaw`\n   224\t            INSERT INTO \"ItineraryLeg\"\n   225\t                (\"bookingId\", \"sequence\", \"flightId\", \"supersededAt\")\n   226\t            VALUES (\n   227\t                ${scenario.booking.id},\n   228\t                2,\n   229\t                ${anotherFlight.id},\n   230\t                statement_timestamp()\n   231\t            )\n   232\t        `).rejects.toThrow(/new ItineraryLeg must start active/);\n   233\t    });\n   234\t\n   235\t    it('never lets a superseded leg become active again', async () => {\n   236\t        const saved = await recordRebooking();\n   237\t\n   238\t        await expect(prisma.$executeRaw`\n   239\t            UPDATE \"ItineraryLeg\" SET \"supersededAt\" = NULL WHERE \"id\" = ${saved.oldLeg.id}\n   240\t        `).rejects.toThrow(/ItineraryLeg supersession is permanent/);\n   241\t    });\n   242\t\n   243\t    it('requires a new version instead of rewriting a leg in place', async () => {\n   244\t        const scenario = await disruptedBooking();\n   245\t        const anotherFlight = await flight('IN-PLACE-REWRITE');\n   246\t\n   247\t        await expect(prisma.$executeRaw`\n   248\t            UPDATE \"ItineraryLeg\"\n   249\t            SET \"flightId\" = ${anotherFlight.id}\n   250\t            WHERE \"id\" = ${scenario.oldLeg.id}\n   251\t        `).rejects.toThrow(/ItineraryLeg identity is immutable/);\n   252\t    });\n   253\t\n   254\t    it('refuses to delete a leg while its booking still exists', async () => {\n   255\t        const scenario = await disruptedBooking();\n   256\t\n   257\t        await expect(prisma.itineraryLeg.delete({\n   258\t            where: { id: scenario.oldLeg.id },\n   259\t        })).rejects.toThrow(/cannot be deleted while booking/);\n   260\t\n   261\t        expect(await prisma.itineraryLeg.count({\n   262\t            where: { id: scenario.oldLeg.id },\n   263\t        })).toBe(1);\n   264\t    });\n   265\t\n   266\t    it('does not let a cascading leg delete erase its rebooking mapping', async () => {\n   267\t        const saved = await recordRebooking();\n   268\t\n   269\t        await expect(prisma.itineraryLeg.delete({\n   270\t            where: { id: saved.oldLeg.id },\n   271\t        })).rejects.toThrow(/cannot be deleted while booking/);\n   272\t\n   273\t        expect(await prisma.bookingRebookingLeg.count({\n   274\t            where: { rebookingId: saved.rebookingId },\n   275\t        })).toBe(1);\n   276\t    });\n   277\t\n   278\t    it('does not let a cascading replacement delete erase its rebooking mapping', async () => {\n   279\t        const saved = await recordRebooking();\n   280\t\n   281\t        await expect(prisma.itineraryLeg.delete({\n   282\t            where: { id: saved.newLegId },\n   283\t        })).rejects.toThrow(/cannot be deleted while booking/);\n   284\t\n   285\t        expect(await prisma.bookingRebookingLeg.count({\n   286\t            where: { rebookingId: saved.rebookingId },\n   287\t        })).toBe(1);\n   288\t    });\n   289\t\n   290\t    it('makes the rebooking event append-only', async () => {\n   291\t        const saved = await recordRebooking();\n   292\t\n   293\t        await expect(prisma.$executeRaw`\n   294\t            UPDATE \"BookingRebooking\" SET \"createdAt\" = \"createdAt\"\n   295\t            WHERE \"id\" = ${saved.rebookingId}\n   296\t        `).rejects.toThrow(/BookingRebooking is append-only/);\n   297\t    });\n   298\t\n   299\t    it('makes the rebooking leg mapping append-only', async () => {\n   300\t        const saved = await recordRebooking();\n   301\t\n   302\t        await expect(prisma.$executeRaw`\n   303\t            UPDATE \"BookingRebookingLeg\" SET \"toLegId\" = \"toLegId\"\n   304\t            WHERE \"rebookingId\" = ${saved.rebookingId}\n   305\t              AND \"fromLegId\" = ${saved.oldLeg.id}\n   306\t        `).rejects.toThrow(/BookingRebookingLeg is append-only/);\n   307\t    });\n   308\t\n   309\t    it('refuses to delete a leg mapping while its historical leg remains', async () => {\n   310\t        const saved = await recordRebooking();\n   311\t\n   312\t        await expect(prisma.$transaction(async tx => {\n   313\t            await tx.bookingRebookingLeg.delete({\n   314\t                where: {\n   315\t                    rebookingId_fromLegId: {\n   316\t                        rebookingId: saved.rebookingId,\n   317\t                        fromLegId: saved.oldLeg.id,\n   318\t                    },\n   319\t                },\n   320\t            });\n   321\t            await tx.$executeRaw`\n   322\t                SET CONSTRAINTS \"BookingRebookingLeg_preserves_supersession\" IMMEDIATE\n   323\t            `;\n   324\t        })).rejects.toThrow(/cannot be deleted directly/);\n   325\t\n   326\t        expect(await prisma.bookingRebookingLeg.count({\n   327\t            where: { rebookingId: saved.rebookingId },\n   328\t        })).toBe(1);\n   329\t    });\n   330\t\n   331\t    it('refuses to delete a rebooking event while its historical leg remains', async () => {\n   332\t        const saved = await recordRebooking();\n   333\t\n   334\t        await expect(prisma.$transaction(async tx => {\n   335\t            await tx.bookingRebooking.delete({ where: { id: saved.rebookingId } });\n   336\t            await tx.$executeRaw`\n   337\t                SET CONSTRAINTS \"BookingRebookingLeg_preserves_supersession\" IMMEDIATE\n   338\t            `;\n   339\t        })).rejects.toThrow(/cannot be deleted directly/);\n   340\t\n   341\t        expect(await prisma.bookingRebooking.count({\n   342\t            where: { id: saved.rebookingId },\n   343\t        })).toBe(1);\n   344\t    });\n   345\t\n   346\t    it('refuses a mapping between different itinerary positions', async () => {\n   347\t        const scenario = await disruptedBooking();\n   348\t        const replacementFlight = await flight('WRONG-SEQUENCE');\n   349\t        const rebookingId = randomUUID();\n   350\t\n   351\t        await expect(prisma.$transaction(async tx => {\n   352\t            await tx.$executeRaw`\n   353\t                UPDATE \"ItineraryLeg\"\n   354\t                SET \"supersededAt\" = statement_timestamp()\n   355\t                WHERE \"id\" = ${scenario.oldLeg.id}\n   356\t            `;\n   357\t            const [wrongLeg] = await tx.$queryRaw<Array<{ id: number }>>`\n   358\t                INSERT INTO \"ItineraryLeg\" (\"bookingId\", \"sequence\", \"flightId\")\n   359\t                VALUES (${scenario.booking.id}, 2, ${replacementFlight.id})\n   360\t                RETURNING \"id\"\n   361\t            `;\n   362\t            await resolveDisruption(tx, scenario.booking.id, rebookingId);\n   363\t            await tx.$executeRaw`\n   364\t                INSERT INTO \"BookingRebookingLeg\" (\"rebookingId\", \"fromLegId\", \"toLegId\")\n   365\t                VALUES (${rebookingId}, ${scenario.oldLeg.id}, ${wrongLeg.id})\n   366\t            `;\n   367\t        })).rejects.toThrow(/same itinerary position/);\n   368\t    });\n   369\t\n   370\t    it('refuses to supersede a leg without recording its replacement', async () => {\n   371\t        const scenario = await disruptedBooking();\n   372\t\n   373\t        await expect(prisma.$executeRaw`\n   374\t            UPDATE \"ItineraryLeg\"\n   375\t            SET \"supersededAt\" = statement_timestamp()\n   376\t            WHERE \"id\" = ${scenario.oldLeg.id}\n   377\t        `).rejects.toThrow(/must be recorded by a BookingRebookingLeg/);\n   378\t    });\n   379\t\n   380\t    it('refuses to supersede a leg while its old seat is still live', async () => {\n   381\t        await expect(recordRebooking({\n   382\t            releaseOldSeat: false,\n   383\t            checkSupersessionNow: true,\n   384\t        })).rejects.toThrow(/cannot retain live seat assignments/);\n   385\t    });\n   386\t\n   387\t    it('refuses a rebooking event with no leg replacement', async () => {\n   388\t        const scenario = await disruptedBooking();\n   389\t        const rebookingId = randomUUID();\n   390\t\n   391\t        await expect(prisma.$transaction(async tx => {\n   392\t            await resolveDisruption(tx, scenario.booking.id, rebookingId);\n   393\t            // Prisma 5 logs a deferred-constraint failure from COMMIT but can\n   394\t            // resolve the interactive-transaction promise. A product writer\n   395\t            // will make all rebooking constraints immediate as its final\n   396\t            // statement; do that here so the rejected write is observable to\n   397\t            // the caller as well as rolled back by PostgreSQL.\n   398\t            await tx.$executeRaw`SET CONSTRAINTS \"BookingRebooking_has_legs\" IMMEDIATE`;\n   399\t        })).rejects.toThrow(/must map at least one itinerary leg/);\n   400\t    });\n   401\t\n   402\t    it('refuses a leg mapping that crosses booking references', async () => {\n   403\t        const scenario = await disruptedBooking();\n   404\t        const other = await disruptedBooking();\n   405\t        const rebookingId = randomUUID();\n   406\t\n   407\t        await expect(prisma.$transaction(async tx => {\n   408\t            await tx.$executeRaw`\n   409\t                UPDATE \"ItineraryLeg\"\n   410\t                SET \"supersededAt\" = statement_timestamp()\n   411\t                WHERE \"id\" = ${scenario.oldLeg.id}\n   412\t            `;\n   413\t            await resolveDisruption(tx, scenario.booking.id, rebookingId);\n   414\t            await tx.$executeRaw`\n   415\t                INSERT INTO \"BookingRebookingLeg\" (\"rebookingId\", \"fromLegId\", \"toLegId\")\n   416\t                VALUES (${rebookingId}, ${scenario.oldLeg.id}, ${other.oldLeg.id})\n   417\t            `;\n   418\t        })).rejects.toThrow(/same booking and same itinerary position/);\n   419\t    });\n   420\t\n   421\t    it('refuses an event whose status change also records a refund', async () => {\n   422\t        const scenario = await disruptedBooking();\n   423\t        const rebookingId = randomUUID();\n   424\t\n   425\t        await expect(prisma.$transaction(async tx => {\n   426\t            await tx.$executeRaw`\n   427\t                SELECT set_config('app.booking_refund_cents', '1', true)\n   428\t            `;\n   429\t            await resolveDisruption(tx, scenario.booking.id, rebookingId);\n   430\t        })).rejects.toThrow(/one non-refunding DISRUPTED to CONFIRMED status change/);\n   431\t    });\n   432\t\n   433\t    it('refuses an event that is not the resolution of a disruption', async () => {\n   434\t        const scenario = await disruptedBooking();\n   435\t        const initialChange = await prisma.bookingStatusChange.findFirstOrThrow({\n   436\t            where: { bookingId: scenario.booking.id, from: null, to: 'DISRUPTED' },\n   437\t        });\n   438\t\n   439\t        await expect(prisma.$executeRaw`\n   440\t            INSERT INTO \"BookingRebooking\"\n   441\t                (\"id\", \"bookingId\", \"bookingStatusChangeId\", \"farePolicy\")\n   442\t            VALUES (\n   443\t                ${randomUUID()},\n   444\t                ${scenario.booking.id},\n   445\t                ${initialChange.id},\n   446\t                'DISRUPTION_WAIVER'\n   447\t            )\n   448\t        `).rejects.toThrow(/one non-refunding DISRUPTED to CONFIRMED status change/);\n   449\t    });\n   450\t\n   451\t    it('cascades the immutable history when its booking is deleted', async () => {\n   452\t        const saved = await recordRebooking();\n   453\t\n   454\t        expect(await prisma.booking.deleteMany({\n   455\t            where: { id: saved.booking.id },\n   456\t        })).toEqual({ count: 1 });\n   457\t\n   458\t        expect(await prisma.bookingRebooking.count({\n   459\t            where: { id: saved.rebookingId },\n   460\t        })).toBe(0);\n   461\t        expect(await prisma.bookingRebookingLeg.count({\n   462\t            where: { rebookingId: saved.rebookingId },\n   463\t        })).toBe(0);\n   464\t        expect(await prisma.itineraryLeg.count({\n   465\t            where: { bookingId: saved.booking.id },\n   466\t        })).toBe(0);\n   467\t    });\n   468\t});\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a00bba-29dd-7100-8715-811d18e7c7e1"}}}
