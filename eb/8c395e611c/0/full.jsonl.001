{"timestamp":"2026-08-16T18:06:31.815Z","ordinal":23851,"type":"event_msg","payload":{"type":"token_count","info":{"total_token_usage":{"input_tokens":7911689,"cached_input_tokens":7683328,"cache_write_input_tokens":0,"output_tokens":35354,"reasoning_output_tokens":19458,"total_tokens":7947043},"last_token_usage":{"input_tokens":207461,"cached_input_tokens":206592,"cache_write_input_tokens":0,"output_tokens":3068,"reasoning_output_tokens":7,"total_tokens":210529},"model_context_window":258400},"rate_limits":{"limit_id":"codex","limit_name":null,"primary":{"used_percent":34.0,"window_minutes":10080,"resets_at":1787197964},"secondary":null,"credits":{"has_credits":false,"unlimited":false,"balance":"0"},"individual_limit":null,"spend_control_reached":null,"plan_type":"pro","rate_limit_reached_type":null}}}
