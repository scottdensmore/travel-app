{"timestamp":"2026-08-16T02:44:42.873Z","ordinal":20676,"type":"event_msg","payload":{"type":"token_count","info":{"total_token_usage":{"input_tokens":150226400,"cached_input_tokens":148199424,"cache_write_input_tokens":0,"output_tokens":249298,"reasoning_output_tokens":87145,"total_tokens":150475698},"last_token_usage":{"input_tokens":190210,"cached_input_tokens":189184,"cache_write_input_tokens":0,"output_tokens":119,"reasoning_output_tokens":35,"total_tokens":190329},"model_context_window":258400},"rate_limits":{"limit_id":"codex","limit_name":null,"primary":{"used_percent":24.0,"window_minutes":10080,"resets_at":1787197964},"secondary":null,"credits":{"has_credits":false,"unlimited":false,"balance":"0"},"individual_limit":null,"spend_control_reached":null,"plan_type":"pro","rate_limit_reached_type":null}}}
