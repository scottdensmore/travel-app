live statuses.\n    84\t                    </p>\n    85\t                </Link>\n    86\t                <Link href=\"/admin/payments\" className=\"admin-card hover:border-purple-500 transition-all\" style={{\n    87\t                    textDecoration: 'none',\n    88\t                    display: 'flex',\n    89\t                    flexDirection: 'column',\n    90\t                    gap: '0.5rem',\n    91\t                    flex: '1',\n    92\t                    minWidth: '250px',\n    93\t                    padding: '24px',\n    94\t                    marginBottom: 0,\n    95\t                    border: '1px solid rgba(255, 255, 255, 0.08)'\n    96\t                }}>\n    97\t                    <h3 style={{ color: '#c084fc', fontSize: '1.25rem', margin: 0, fontWeight: 'bold' }}>Payment Recovery</h3>\n    98\t                    <p style={{ color: 'rgba(255, 255, 255, 0.6)', fontSize: '0.9rem', margin: 0 }}>\n    99\t                        Review stale provider-backed checkouts and refresh their current Stripe status.\n   100\t                    </p>\n   101\t                </Link>\n   102\t            </div>\n   103\t\n   104\t            {/* Recent Bookings List */}\n   105\t            <div className=\"admin-card\">\n   106\t                <h2 style={{ fontSize: '1.5rem', margin: '0 0 1rem 0', color: '#c084fc', borderBottom: '1px solid rgba(255, 255, 255, 0.08)', paddingBottom: '8px' }}>\n   107\t                    Recent Bookings\n   108\t                </h2>\n     1\timport type { PaymentAttemptStatus } from '@prisma/client';\n     2\timport { prisma } from '@/lib/prisma';\n     3\timport { HOLD_MINUTES } from '@/lib/seatHolds';\n     4\t\n     5\texport const PAYMENT_RECOVERY_LIMIT = 50;\n     6\t\n     7\texport interface StalePaymentAttempt {\n     8\t    id: string;\n     9\t    checkoutId: string;\n    10\t    providerIntentId: string;\n    11\t    amountCents: number;\n    12\t    currency: string;\n    13\t    status: PaymentAttemptStatus;\n    14\t    updatedAt: Date;\n    15\t    userName: string | null;\n    16\t    userEmail: string | null;\n    17\t}\n    18\t\n    19\t/**\n    20\t * Provider-backed attempts whose local state may have missed an update.\n    21\t *\n    22\t * Checkout owns the first ten minutes. The recovery queue starts only after\n    23\t * that long without a local payment update, and uses the database clock just\n    24\t * as the seat hold does. Captured and cancelled attempts are terminal and\n    25\t * cannot need this operation.\n    26\t */\n    27\texport async function listStalePaymentAttempts(): Promise<StalePaymentAttempt[]> {\n    28\t    return prisma.$queryRaw<StalePaymentAttempt[]>`\n    29\t        SELECT\n    30\t            attempt.\"id\",\n    31\t            attempt.\"checkoutId\",\n    32\t            attempt.\"providerIntentId\",\n    33\t            attempt.\"amountCents\",\n    34\t            attempt.\"currency\",\n    35\t            attempt.\"status\",\n    36\t            attempt.\"updatedAt\",\n    37\t            customer.\"name\" AS \"userName\",\n    38\t            customer.\"email\" AS \"userEmail\"\n    39\t        FROM \"PaymentAttempt\" AS attempt\n    40\t        LEFT JOIN \"User\" AS customer ON customer.\"id\" = attempt.\"userId\"\n    41\t        WHERE attempt.\"providerIntentId\" IS NOT NULL\n    42\t          AND attempt.\"status\" NOT IN ('CAPTURED', 'CANCELLED')\n    43\t          AND attempt.\"updatedAt\" <= statement_timestamp()\n    44\t              - make_interval(mins => ${HOLD_MINUTES}::int)\n    45\t        ORDER BY attempt.\"updatedAt\" ASC, attempt.\"id\" ASC\n    46\t        LIMIT ${PAYMENT_RECOVERY_LIMIT}\n    47\t    `;\n    48\t}\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a008d3-a8d1-70b1-a975-44bf5aea121d"}}}
