t lockedBooking = await tx.booking.findUnique({\n708:            include: {\n709:                legs: {\n710:                    include: {\n867:        include: {\n868:            legs: {\n869:                include: { flight: true },\n915:        const lockedBooking = await tx.booking.findUnique({\n1419:                legs: { select: { flight: { select: { status: true } } } },\n","stderr":"","aggregated_output":"__tests__/lib/bookingItinerary.test.ts:3:    bookingFlights,\n__tests__/lib/bookingItinerary.test.ts:6:    outboundFlight,\n__tests__/lib/bookingItinerary.test.ts:24:        expect(bookingFlights(booking)).toEqual([seattle, detroit]);\n__tests__/lib/bookingItinerary.test.ts:35:        expect(outboundFlight(booking)).toEqual(seattle);\n__tests__/lib/bookingItinerary.test.ts:41:        expect(bookingFlights(booking)).toEqual([seattle]);\n__tests__/lib/bookingItinerary.test.ts:42:        expect(outboundFlight(booking)).toEqual(seattle);\n__tests__/lib/bookingItinerary.test.ts:47:        expect(bookingFlights({ legs: [] })).toEqual([]);\n__tests__/lib/bookingItinerary.test.ts:48:        expect(outboundFlight({ legs: [] })).toBeNull();\n__tests__/lib/bookingItinerary.test.ts:59:        expect(bookingFlights(booking)).toEqual([detroit]);\n__tests__/lib/bookingItinerary.test.ts:60:        expect(outboundFlight(booking)).toEqual(detroit);\n659:        include: {\n660:            legs: {\n661:                include: {\n706:        const lockedBooking = await tx.booking.findUnique({\n708:            include: {\n709:                legs: {\n710:                    include: {\n867:        include: {\n868:            legs: {\n869:                include: { flight: true },\n915:        const lockedBooking = await tx.booking.findUnique({\n1419:                legs: { select: { flight: { select: { status: true } } } },\n","exit_code":0,"duration":{"secs":0,"nanos":18669},"formatted_output":"__tests__/lib/bookingItinerary.test.ts:3:    bookingFlights,\n__tests__/lib/bo