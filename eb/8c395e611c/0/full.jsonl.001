part of customer-facing history.\n   125\t    const {\n   126\t      paymentIntentId: _paymentIntentId,\n   127\t      idempotencyKey: _idempotencyKey,\n   128\t      userId: _userId,\n   129\t      ...customerBooking\n   130\t    } = booking;\n   131\t\n   132\t    return {\n   133\t      ...customerBooking,\n   134\t      paymentReceipt: capturedPayment\n   135\t        ? {\n   136\t            amountCents: capturedPayment.amountCents,\n   137\t            currency: capturedPayment.currency,\n   138\t            paidAt: capturedPayment.createdAt,\n   139\t          }\n   140\t        : null,\n   141\t    };\n   142\t  });\n   143\t\n   144\t  const pointsActivityService = new PointsActivityService(bookings);\n   145\t  const activityData = pointsActivityService.getPointsActivity();\n   146\t  const currentPoints = pointsActivityService.getCurrentPoints();\n   147\t  const currentStatus = pointsActivityService.getCurrentStatus();\n   148\t  const monthlyHistory = pointsActivityService.getMonthlyPointsActivity();\n   149\t\n   150\t  return (\n   151\t    <ProfileClient \n   152\t      userName={userName}\n   153\t      userAvatar={userAvatar}\n   154\t      currentStatus={currentStatus}\n   155\t      currentPoints={currentPoints}\n   156\t      bookings={customerBookings}\n   157\t      favorites={userFavorites}\n   158\t      reviews={userReviews}\n   159\t      activityData={activityData}\n   160\t      monthlyHistory={monthlyHistory}\n   215\t    activityData,\n   216\t    monthlyHistory,\n   217\t    renderedAt,\n   218\t}: ProfileClientProps) {\n   219\t    const router = useRouter();\n   220\t    const [isPending, startTransition] = useTransition();\n   221\t    const [activeRefundBookingId, setActiveRefundBookingId] = useState<number | null>(null);\n   222\t    const [refundFeedback, setRefundFeedback] = useState<{\n   223\t        bookingId: number;\n   224\t        message: string;\n   225\t        focus: boolean;\n   226\t    } | null>(null);\n   227\t    const refundFeedbackRef = useRef<HTMLParagraphElement | null>(null);\n   228\t    const bookingsRegionRef = useRef<HTMLDivElement | null>(null);\n   229\t    const receiptBookings = bookings.filter(booking => booking.paymentReceipt);\n   230\t\n   231\t    useEffect(() => {\n   232\t        if (refundFeedback?.focus) refundFeedbackRef.current?.focus();\n   233\t    }, [refundFeedback]);\n   234\t    /**\n   235\t     * Whether the region still scrolls sideways.\n   236\t     *\n   237\t     * At 767px and below the table lays each booking out as a stacked card and\n   238\t     * nothing overflows, which is what put the Cancel button back inside a\n   239\t     * phone's viewport (#240). 767 rather than 640 because the table wants\n   240\t     * 590px inside a region narrower than the window: a breakpoint under that\n   690\t                                            ))}\n   691\t                                        </tbody>\n   692\t                                    );\n   693\t                                })}\n   694\t                            </table>\n   695\t                        </div>\n   696\t                    ) : (\n   697\t                        <p className=\"text-gray-500 italic\">You have no bookings yet.</p>\n   698\t                    )}\n   699\t                </div>\n   700\t\n   701\t                <section className=\"profile-card mt-8\" aria-labelledby=\"payment-history-heading\">\n   702\t                    <h2 id=\"payment-history-heading\" className=\"text-2xl font-bold mb-4\">Payment history</h2>\n   703\t                    {receiptBookings.length > 0 ? (\n   704\t                        <div className=\"payment-history-list\">\n   705\t                            {receiptBookings.map(booking => {\n   706\t                                const receipt = booking.paymentReceipt!;\n   707\t                                const flightNumbers = orderedLegs(booking)\n   708\t                                    .flatMap(leg => leg.flight ? [leg.flight.flightNumber] : []);\n   709\t                                const refund = booking.statusChanges?.[0]?.paymentRefund ?? null;\n   710\t                                const refundOutcome = refund\n   711\t                                    ? refund.status === 'SUCCEEDED'\n   712\t                                        ? `${formatPrice(refund.amountCents)} ${receipt.currency} refunded`\n   713\t                                        : refund.status === 'PENDING'\n   714\t                                            ? `${formatPrice(refund.amountCents)} ${receipt.currency} refund pending`\n   715\t                                            : `${formatPrice(refund.amountCents)} ${receipt.currency} refund needs attention`\n   716\t                                    : null;\n   717\t                                return (\n   718\t                                    <article\n   719\t                                        key={booking.id}\n   720\t                                        className=\"payment-receipt-card\"\n   721\t                                        aria-label={`Receipt for booking ${booking.id}`}\n   722\t                                    >\n   723\t                                        <div>\n   724\t                                            <p className=\"payment-receipt-eyebrow\">Payment receipt</p>\n   725\t                                            <h3>Booking {booking.id}</h3>\n   726\t                                        </div>\n   727\t                                        <div className=\"payment-receipt-details\">\n   728\t                                            <p>Paid <strong>{formatPrice(receipt.amountCents)} {receipt.currency}</strong></p>\n   729\t                                            <p>\n   730\t                                                <span>Payment date </span>\n   731\t                                                <time dateTime={new Date(receipt.paidAt).toISOString(