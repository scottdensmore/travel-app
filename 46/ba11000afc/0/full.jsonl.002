  '#selectSchedule',\n   348\t      { label: 'Playwright Air E2E606 (Seattle, USA → Detroit, USA)' }\n   349\t    );\n   350\t    await page.fill('#startDate', occurrenceDateString);\n   351\t    await page.fill('#endDate', occurrenceDateString);\n   352\t    await page.fill('#manualFirstClassRows', '1');\n   353\t    await page.fill('#manualBusinessRows', '1');\n   354\t    await page.fill('#manualPremiumEconomyRows', '1');\n   355\t    await page.fill('#manualEconomyRows', '2');\n   356\t    await page.fill('#manualSeatPattern', 'AC-DF');\n   357\t    await page.click('button:has-text(\"Generate Occurrences\")');\n   358\t    await expect(page.getByRole('status').filter({\n   359\t      hasText: 'Successfully affected 1 flight occurrence(s): 1 created, 0 updated.'\n   360\t    })).toBeVisible();\n   361\t\n   362\t    await expect.poll(async () => prisma.flight.findFirst({\n   363\t      where: {\n   364\t        flightNumber: 'E2E606',\n   365\t        departureDate: {\n   366\t          gte: new Date(`${occurrenceDateString}T00:00:00.000Z`),\n   367\t          lte: new Date(`${occurrenceDateString}T23:59:59.999Z`)\n   368\t        }\n   369\t      }\n   370\t    })).not.toBeNull();\n   371\t\n   372\t    const persistedOccurrence = await prisma.flight.findFirstOrThrow({\n   373\t      where: {\n   374\t        flightNumber: 'E2E606',\n   375\t        departureDate: {\n   376\t          gte: new Date(`${occurrenceDateString}T00:00:00.000Z`),\n   377\t          lte: new Date(`${occurrenceDateString}T23:59:59.999Z`)\n   378\t        }\n   379\t      }\n   380\t    });\n   381\t    expect(persistedOccurrence).toMatchObject({\n   382\t      firstClassRows: 1,\n   383\t      businessRows: 1,\n   384\t      premiumEconomyRows: 1,\n   385\t      economyRows: 2,\n   386\t      seatPattern: 'AC-DF'\n   387\t    });\n   388\t\n   389\t    // Checkout must render only the persisted Economy rows and seat letters.\n   390\t    await page.goto(`/checkout?outbound=${persistedOccurrence.id}`);\n   391\t    await page.fill('input[placeholder=\"John\"]', 'Layout');\n   392\t    await page.fill('input[placeholder=\"Doe\"]', 'Traveler');\n   393\t    await page.fill('input[type=\"date\"]', '1990-01-01');\n   394\t    await page.fill('input[placeholder=\"A00000000\"]', 'E2E123456');\n   395\t    await page.click('button:has-text(\"Select Seats\")');\n   396\t    await expect(page.getByTitle('Select Seat 4A')).toBeVisible();\n   397\t    await expect(page.getByTitle('Select Seat 5F')).toBeVisible();\n   398\t    await expect(page.getByTitle('Select Seat 4B')).toHaveCount(0);\n   399\t\n   400\t    // A layout update and booking must serialize on the same flight row.\n   401\t    const raceDate = new Date(`${occurrenceDateString}T10:00:00.000Z`);\n   402\t    raceDate.setUTCDate(raceDate.getUTCDate() + 1);\n   403\t    const raceFlight = await prisma.flight.create({\n   404\t      data: {\n   405\t        flightNumber: 'E2E606',\n   406\t        airline: 'Playwright Air',\n   407\t        ...airportCodesForRoute('Seattle, USA', 'Detroit, USA'),\n   408\t        departureDate: raceDate,\n   409\t        priceCents: 49900,\n   410\t        firstClassRows: 3,\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a00e33-28bf-7050-b2f6-2b374830398b"}}}
