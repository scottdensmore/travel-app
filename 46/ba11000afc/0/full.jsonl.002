5\t            if (savedSchedule.daysOfWeek.includes(dayOfWeek)) {\n    26\t                const dateStr = date.toISOString().split('T')[0];\n    27\t                const departureDate = departureInstantFor(dateStr, savedSchedule);\n    28\t            \n    29\t                // Check if flight instance already exists\n    30\t                const existingInstance = await prisma.flight.findFirst({\n    31\t                    where: {\n    32\t                        flightNumber: savedSchedule.flightNumber,\n    33\t                        departureDate: departureDate\n    34\t                    }\n    35\t                });\n    36\t\n    37\t                if (!existingInstance) {\n    38\t                    try {\n    39\t                        await prisma.flight.create({\n    40\t                            data: {\n    41\t                                flightScheduleId: savedSchedule.id,\n    42\t                                flightNumber: savedSchedule.flightNumber,\n    43\t                                airline: savedSchedule.airline,\n    44\t                                ...airportCodesForRoute(savedSchedule.from, savedSchedule.to),\n    45\t                                departureDate,\n    46\t                                priceCents: savedSchedule.priceCents,\n    47\t                                durationMinutes: savedSchedule.durationMinutes,\n    48\t                                status: 'ON_TIME',\n    49\t                                firstClassRows,\n    50\t                                businessRows,\n    51\t                                premiumEconomyRows,\n    52\t                                economyRows,\n    53\t                                seatPattern: normalizedSeatPattern\n    54\t                            }\n    55\t                        });\n    56\t                    } catch (error) {\n    57\t                        if (!(error && typeof error === 'object' && 'code' in error && error.code === 'P2002')) {\n    58\t                            throw error;\n    59\t                        }\n    60\t                    }\n    61\t                }\n    62\t            }\n    63\t        }\n    64\t        });\n    65\t    }\n    66\t\n    67\t    revalidatePath('/');\n    68\t    revalidatePath('/flights');\n    69\t    revalidatePath('/admin/flights');\n    70\t\n    71\t    return savedSchedule;\n    72\t}\n    73\t\n    74\texport async function updateFlightScheduleTermsAction(data: {\n    75\t    requestId: string;\n    76\t    flightScheduleId: number;\n    77\t    durationMinutes: number;\n    78\t    price: string;\n    79\t    confirmed: boolean;\n    80\t}) {\n    81\t    const session = await getServerSession(authOptions);\n    82\t    const actorUserId = session?.user?.id;\n     1\t    if (!parsed.ok) return parsed;\n     2\t    scheduleId = parsed.data.scheduleId;\n     3\t    startDateStr = parsed.data.startDate;\n     4\t    endDateStr = parsed.data.endDate;\n     5\t    seatingConfig = parsed.data.seatingConfig;\n     6\t\n     7\t    return withFlightScheduleGenerationLock(scheduleId, async () => {\n     8\t        const schedule = await prisma.flightSchedule.findUnique({\n     9\t            where: { id: scheduleId }\n    10\t        });\n    11\t        if (!schedule) throw new Error(\"Flight schedule not found.\");\n    12\t        if (schedule.isActive === false) {\n    13\t            return actionValidationFailure(\n    14\t                'Reactivate this template before generating occurrences.',\n    15\t                'scheduleId',\n    16\t            );\n    17\t        }\n    18\t\n    19\t        if (!/^\\d{4}-\\d{2}-\\d{2}$/.test(startDateStr) || !/^\\d{4}-\\d{2}-\\d{2}$/.test(endDateStr)) {\n    20\t            throw new Error(\"Dates must use YYYY-MM-DD format.\");\n    21\t        }\n    22\t\n    23\t        const start = new Date(`${startDateStr}T00:00:00Z`);\n    24\t        const end = new Date(`${endDateStr}T00:00:00Z`);\n    25\t    if (\n    26\t        isNaN(start.getTime()) ||\n    27\t        isNaN(end.getTime()) ||\n    28\t        start.toISOString().slice(0, 10) !== startDateStr ||\n    29\t        end.toISOString().slice(0, 10) !== endDateStr\n    30\t    ) {\n    31\t        throw new Error(\"Invalid start or end date.\");\n    32\t    }\n    33\t    if (end < start) {\n    34\t        throw new Error(\"End date must be on or after start date.\");\n    35\t    }\n    36\t    const rangeDays = Math.floor((end.getTime() - start.getTime()) / 86_400_000);\n    37\t    if (rangeDays > MAX_OCCURRENCE_RANGE_DAYS) {\n    38\t        throw new Error(`Date range cannot exceed ${MAX_OCCURRENCE_RANGE_DAYS} days.`);\n    39\t    }\n    40\t\n    41\t    const firstClassRows = seatingConfig?.firstClassRows !== undefined && seatingConfig?.firstClassRows !== null ? Number(seatingConfig.firstClassRows) : (schedule.firstClassRows ?? 3);\n    42\t    const businessRows = seatingConfig?.businessRows !== undefined && seatingConfig?.businessRows !== null ? Number(seatingConfig.businessRows) : (schedule.businessRows ?? 3);\n    43\t    const premiumEconomyRows = seatingConfig?.premiumEconomyRows !== undefined && seatingConfig?.premiumEconomyRows !== null ? Number(seatingConfig.premiumEconomyRows) : (schedule.premiumEconomyRows ?? 4);\n    44\t    const economyRows = seatingConfig?.economyRows !== undefined && seatingConfig?.economyRows !== null ? Number(seatingConfig.economyRows) : (schedule.economyRows ?? 20);\n    45\t    const seatPattern = seatingConfig?.seatPattern !== undefined && seatingConfig.seatPattern !== null\n    46\t        ? seatingConfig.seatPattern\n    47\t        : (schedule.seatPattern ?? \"ABC-DEF\");\n    48\t\n    49\t    let normalizedSeatPattern: string;\n    50\t    try {\n    51\t        normalizedSeatPattern = validateSeatingLayout(\n    52\t            firstClassRows,\n    53\t            businessRows,\n    54\t            premiumEconomyRows,\n    55\t            economyRows,\n    56\t            seatPattern\n    57\t        );\n    58\t    } catch (error) {\n    59\t        return actionValidationFailure(\n    60\t            error instanceof Error ? error.message : 'Seating layout is invalid.',\n    61\t            'seatingConfig'\n    62\t        );\n    63\t    }\n    64\t\n    65\t    const current = new Date(start);\n    66\t    let occurrencesCreated = 0;\n    67\t    let occurrencesUpdated = 0;\n    68\t\n    69\t    while (current <= end) {\n    70\t        const dayOfWeek = current.getUTCDay();\n    71\t        if (schedule.daysOfWeek.includes(dayOfWeek)) {\n    72\t            const dateStr = current.toISOString().split('T')[0];\n    73\t            const departureDate = departureInstantFor(dateStr, schedule);\n    74\t\n    75\t            const existingInstance = await prisma.flight.findFirst({\n    76\t                where: {\n    77\t                    flightNumber: schedule.flightNumber,\n    78\t                    departureDate: departureDate\n    79\t                }\n    80\t                // Only the id is used: updateFlightSeatingLayout does its own\n    81\t                // check of the seats already held on the flight.\n    82\t            });\n    83\t\n    84\t            if (!existingInstance) {\n    85\t                try {\n    86\t                    await prisma.flight.create({\n    87\t                        data: {\n    88\t                            flightScheduleId: schedule.id,\n    89\t                            flightNumber: schedule.flightNumber,\n    90\t                            airline: schedule.airline,\n    91\t                            ...airportCodesForRoute(schedule.from, schedule.to),\n    92\t                            departureDate,\n    93\t                            priceCents: schedule.priceCents,\n    94\t                            durationMinutes: schedule.durationMinutes,\n    95\t                            status: 'ON_TIME',\n    96\t                