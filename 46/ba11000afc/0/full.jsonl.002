tart) {\n    36\t            throw new Error(\"End date must be on or after start date.\");\n    37\t        }\n    38\t        const rangeDays = Math.floor((end.getTime() - start.getTime()) / 86_400_000);\n    39\t        if (rangeDays > MAX_OCCURRENCE_RANGE_DAYS) {\n    40\t            throw new Error(`Date range cannot exceed ${MAX_OCCURRENCE_RANGE_DAYS} days.`);\n    41\t        }\n    42\t    \n    43\t        const firstClassRows = seatingConfig?.firstClassRows !== undefined && seatingConfig?.firstClassRows !== null ? Number(seatingConfig.firstClassRows) : (schedule.firstClassRows ?? 3);\n    44\t        const businessRows = seatingConfig?.businessRows !== undefined && seatingConfig?.businessRows !== null ? Number(seatingConfig.businessRows) : (schedule.businessRows ?? 3);\n    45\t        const premiumEconomyRows = seatingConfig?.premiumEconomyRows !== undefined && seatingConfig?.premiumEconomyRows !== null ? Number(seatingConfig.premiumEconomyRows) : (schedule.premiumEconomyRows ?? 4);\n    46\t        const economyRows = seatingConfig?.economyRows !== undefined && seatingConfig?.economyRows !== null ? Number(seatingConfig.economyRows) : (schedule.economyRows ?? 20);\n    47\t        const seatPattern = seatingConfig?.seatPattern !== undefined && seatingConfig.seatPattern !== null\n    48\t            ? seatingConfig.seatPattern\n    49\t            : (schedule.seatPattern ?? \"ABC-DEF\");\n    50\t    \n    51\t        let normalizedSeatPattern: string;\n    52\t        try {\n    53\t            normalizedSeatPattern = validateSeatingLayout(\n    54\t                firstClassRows,\n    55\t                businessRows,\n    56\t                premiumEconomyRows,\n    57\t                economyRows,\n    58\t                seatPattern\n    59\t            );\n    60\t        } catch (error) {\n    61\t            return actionValidationFailure(\n    62\t                error instanceof Error ? error.message : 'Seating layout is invalid.',\n    63\t                'seatingConfig'\n    64\t            );\n    65\t        }\n    66\t    \n    67\t        const current = new Date(start);\n    68\t        let occurrencesCreated = 0;\n    69\t        let occurrencesUpdated = 0;\n    70\t    \n    71\t        while (current <= end) {\n    72\t            const dayOfWeek = current.getUTCDay();\n    73\t            if (schedule.daysOfWeek.includes(dayOfWeek)) {\n    74\t                const dateStr = current.toISOString().split('T')[0];\n    75\t                const departureDate = departureInstantFor(dateStr, schedule);\n    76\t    \n    77\t                const existingInstance = await prisma.flight.findFirst({\n    78\t                    where: {\n    79\t                        flightNumber: schedule.flightNumber,\n    80\t                        departureDate: departureDate\n    81\t                    }\n    82\t                    // Only the id is used: updateFlightSeatingLayout does its own\n    83\t                    // check of the seats already held on the flight.\n    84\t                });\n    85\t    \n    86\t                if (!existingInstance) {\n    87\t                    try {\n    88\t                        await prisma.flight.create({\n    89\t                            data: {\n    90\t                                flightScheduleId: schedule.id,\n    91\t                                flightNumber: schedule.flightNumber,\n    92\t                                airline: schedule.airline,\n    93\t                                ...airportCodesForRoute(schedule.from, schedule.to),\n    94\t                                departureDate,\n    95\t                                priceCents: schedule.priceCents,\n    96\t                                durationMinutes: schedule.durationMinutes,\n    97\t                                status: 'ON_TIME',\n    98\t                                firstClassRows,\n    99\t                                businessRows,\n   100\t                                premiumEconomyRows,\n   101\t                                economyRows,\n   102\t                                seatPattern: normalizedSeatPattern\n   103\t                            }\n   104\t                        });\n   105\t                        occurrencesCreated++;\n   106\t                    } catch (error) {\n   107\t                        if (!(error && typeof error === 'object' && 'code' in error && error.code === 'P2002')) {\n   108\t                            throw error;\n   109\t                        }\n   110\t                        const concurrentInstance = await prisma.flight.findFirst({\n   111\t                            where: {\n   112\t                                flightNumber: schedule.flightNumber,\n   113\t                                departureDate\n   114\t                            }\n   115\t                        });\n   116\t                        if (!concurrentInstance) {\n   117\t                            throw new Error('Concurrent occurrence creation could not be resolved.');\n   118\t                        }\n   119\t                        await updateFlightSeatingLayout(concurrentInstance.id, {\n   120\t                            firstClassRows,\n   121\t                            businessRows,\n   122\t                            premiumEconomyRows,\n   123\t                            economyRows,\n   124\t                            seatPattern: normalizedSeatPattern\n   125\t                        });\n   126\t                        occurrencesUpdated++;\n   127\t                    }\n   128\t                } else {\n   129\t                    await updateFlightSeatingLayout(existingInstance.id, {\n   130\t                        firstClassRows,\n   131\t                        businessRows,\n   132\t                        premiumEconomyRows,\n   133\t                        economyRows,\n   134\t                        seatPattern: normalizedSeatPattern\n   135\t          