mockedUserFavoriteFindUnique = (prisma as any).userFavorite.findUnique as jest.Mock;\nconst mockedUserFavoriteDelete = (prisma as any).userFavorite.delete as jest.Mock;\nconst mockedUserFavoriteCreate = (prisma as any).userFavorite.create as jest.Mock;\nconst mockedReviewCreate = (prisma as any).review.create as jest.Mock;\nconst mockedReviewFindUnique = (prisma as any).review.findUnique as jest.Mock;\nconst mockedReviewDelete = (prisma as any).review.delete as jest.Mock;\nconst mockedBookingFindUnique = (prisma as any).booking.findUnique as jest.Mock;\nconst mockedBookingUpdate = (prisma as any).booking.update as jest.Mock;\nconst mockedBookingFindMany = (prisma as any).booking.findMany as jest.Mock;\nconst mockedNotificationCreate = (prisma as any).notification.create as jest.Mock;\nconst mockedNotificationFindMany = (prisma as any).notification.findMany as jest.Mock;\nconst mockedNotificationUpdate = (prisma as any).notification.update as jest.Mock;\nconst mockedNotificationUpdateMany = (prisma as any).notification.updateMany as jest.Mock;\nconst mockedNotificationFindUnique = (prisma as any).notification.findUnique as jest.Mock;\nconst mockedNotificationCreateMany = (prisma as any).notification.createMany as jest.Mock;\n\nconst sampleGuide: any = {\n    city: 'Paris',\n    country: 'France',\n11:    saveFlightScheduleAction,\n18:    generateFlightOccurrencesAction,\n152:const mockTx = {\n191:        $transaction: jest.fn((callback) => callback(mockTx)),\n230:const mockedFlightScheduleFindUnique = (prisma as any).flightSchedule.findUnique as jest.Mock;\n1428:        mockTx.passenger.findMany.mockResolvedValue([]);\n1431:        mockTx.booking.findUnique.mockResolvedValue({\n1443:        mockTx.booking.update.mockReset();\n1444:        mockTx.bookingStatusChange.findFirstOrThrow.mockResolvedValue({ id: 'change-1' });\n1445:        mockTx.paymentRefund.create.mockResolvedValue({ id: 'refund-1' });\n1459:        expect(mockTx.booking.update).not.toHaveBeenCalled();\n1483:        mockTx.booking.update.mockResolvedValue({ id: 1 });\n1500:        expect(mockTx.booking.findUnique).toHaveBeenCalledWith({\n1513:        expect(mockTx.booking.update).toHaveBeenCalledWith({\n1518:        expect(mockTx.$queryRaw).toHaveBeenCalled();\n1555:        mockTx.booking.findUnique.mockResolvedValue({\n1568:        mockTx.passenger.findMany.mockResolvedValue([{ id: 'p-9' }]);\n1569:        mockTx.booking.update.mockResolvedValue({ id: 1 });\n1574:        expect(mockTx.booking.update).toHaveBeenCalled();\n1581:        expect(mockTx.seatAssignment.updateMany).not.toHaveBeenCalled();\n1583:        expect(mockTx.passenger.update).not.toHaveBeenCalled();\n1609:        mockTx.booking.update.mockResolvedValue({ id: 1 });\n1612:        mockTx.booking.findUnique.mockResolvedValue({\n1632:        const settings = mockTx.$executeRaw.mock.calls.map(call => ({\n1667:        mockTx.booking.findUnique.mockResolvedValue(paidBooking);\n1668:        mockTx.booking.update.mockResolvedValue({ id: 1, status: 'CANCELLED' });\n1672:        expect(mockTx.bookingStatusChange.findFirstOrThrow).toHaveBeenCalledWith({\n1676:        expect(mockTx.paymentRefund.create).toHaveBeenCalledWith({\n1702:        mockTx.booking.findUnique.mockResolvedValue(paidBooking);\n1703:        mockTx.booking.update.mockResolvedValue({ id: 1, status: 'CANCELLED' });\n1732:        mockTx.booking.findUnique.mockResolvedValue(paidBooking);\n1733:        mockTx.booking.update.mockResolvedValue({ id: 1, status: 'CANCELLED' });\n1737:        expect(mockTx.paymentRefund.create).not.toHaveBeenCalled();\n1766:        mockTx.booking.findUnique.mockResolvedValue(leg('DISRUPTED'));\n1767:        mockTx.booking.update.mockResolvedValue({ id: 1 });\n1771:        const refund = mockTx.$executeRaw.mock.calls\n1806:        expect(mockTx.booking.update).not.toHaveBeenCalled();\n1829:        mockTx.booking.update.mockResolvedValue({ id: 1 });\n1833:        expect(mockTx.booking.update).toHaveBeenCalledWith({\n1926:        mockTx.passenger.findMany.mockReset();\n1927:        mockTx.passenger.update.mockReset();\n1928:        mockTx.flight.findUnique.mockResolvedValue({ id: 10 });\n1930:        mockTx.flight.findMany.mockResolvedValue([{ id: 10 }]);\n1933:        mockTx.seatAssignment.findMany.mockImplementation(({ where }: any) =>\n1940:        mockTx.booking.findUnique.mockResolvedValue({\n1965:        mockTx.seatAssignment.findMany.mockImplementation(({ where }: any) =>\n1987:        expect(mockTx.seatAssignment.findMany).toHaveBeenCalled();\n1990:        expect(mockTx.seatAssignment.updateMany).toHaveBeenCalledWith({\n1996:        expect(mockTx.passenger.update).not.toHaveBeenCalled();\n2012:        mockTx.seatAssignment.findMany.mockImplementation(({ where }: any) =>\n2024:        expect(mockTx.passenger.update).not.toHaveBeenCalled();\n2055:        expect(mockTx.passenger.update).not.toHaveBeenCalled();\n2067:        mockTx.booking.findUnique.mockResolvedValue({ status: 'CANCELLED', passengers: [] });\n2074:        expect(mockTx.passenger.update).not.toHaveBeenCalled();\n2138:    describe('saveFlightScheduleAction', () => {\n2152:            await expect(saveFlightScheduleAction(sampleScheduleInput)).rejects.toThrow('Unauthorized');\n2157:            await expect(saveFlightScheduleAction(sampleScheduleInput)).rejects.toThrow('Unauthorized');\n2163:            await expect(saveFlightScheduleAction({\n2184:            const result = await saveFlightScheduleAction({\n2201:            const result = await saveFlightScheduleAction({\n2225:            const result = await saveFlightScheduleAction(sampleScheduleInput);\n2270:            await saveFlightScheduleAction({\n2286:            const result = await saveFlightScheduleAction(scheduleWithId);\n2316:            await saveFlightScheduleAction({ id: 5, ...sampleScheduleInput });\n2538:            mockTx.flight.update.mockResolvedValue({\n2552:            mockTx.$queryRaw.mockResolvedValue([{ id: 1 }, { id: 2 }, { id: 3 }, { id: 4 }]);\n2554:            mockTx.booking.findMany.mockResolvedValue([\n2563:            expect(mockTx.flight.update).toHaveBeenCalledWith({\n2583:            expect(mockTx.booking.findMany).toHaveBeenCalledWith({\n2596:            expect(mockTx.booking.update).not.toHaveBeenCalled();\n2691:        describe('generateFlightOccurrencesAction', () => {\n2694:                await expect(generateFlightOccurrencesAction(1, '2026-07-10', '2026-07-20')).rejects.toThrow('Unauthorized');\n2699:                await expect(generateFlightOccurrencesAction(1, '2026-07-10', '2026-07-20')).rejects.toThrow('Unauthorized');\n2704:                mockedFlightScheduleFindUnique.mockResolvedValue({\n2711:                    generateFlightOccurrencesAction(1, '2026-07-05', '2026-07-10'),\n2721:                const [lockSql, namespace, lockedScheduleId] = mockTx.$executeRaw.mock.calls[0];\n2725:                expect(mockTx.$executeRaw.mock.invocationCallOrder[0])\n2726:                    .toBeLessThan(mockedFlightScheduleFindUnique.mock.invocationCallOrder[0]);\n2732:                mockedFlightScheduleFindUnique.mockResolvedValue({\n2748:                const result = await generateFlightOccurrencesAction(1, '2026-07-05', '2026-07-10', {\n    id?: number;\n    flightNumber: string;\n    airline: string;\n    from: string;\n    to: string;\n    departureTime: string;\n    /** Elapsed minutes gate to gate; the arrival time is derived from it (#84). */\n    durationMinutes: number;\n    daysOfWeek: number[];\n    price: string;\n    firstClassRows?: number | null;\n    businessRows?: number | null;\n    premiumEconomyRows?: number | null;\n    economyRows?: number | null;\n    seatPattern?: string | null;\n}) {\n    const session = await getServerSession(authOptions);\n    if (!hasVerifiedStaffAccess(session)) throw new Error(\"Unauthorized\");\n    const parsed = parseActionInput(scheduleSchema, data);\n    if (!parsed.ok) return parsed;\n    data = parsed.data as typeof data;\n\n    // Server-side validation\n    if (!data.flightNumber || !data.airline || !data.from || !data.to || !data.departureTime || !data.price) {\n        throw new Error(\"Please fill in all required fields.\");\n    }\n\n    const timeRegex = /^([0-1]?[0-9]|2[0-3]):[0-5][0-9]$/;\n    if (!timeRegex.test(data.departureTime)) {\n        throw new Error(\"Departure time must be in HH:MM format (24-hour).\");\n    }\n\n    if (!Array.isArray(data.daysOfWeek) || data.daysOfWeek.length === 0) {\n        throw new Error(\"Please select at least one day of the week.\");\n    }\n\n    const firstClassRows = data.firstClassRows !== undefined && data.firstClassRows !== null ? Number(data.firstClassRows) : 3;\n    const businessRows = data.businessRows !== undefined && data.businessRows !== null ? Number(data.businessRows) : 3;\n    const premiumEconomyRows = data.premiumEconomyRows !== undefined && data.premiumEconomyRows !== null ? Number(data.premiumEconomyRows) : 4;\n    const economyRows = data.economyRows !== undefined && data.economyRows !== null ? Number(data.economyRows) : 20;\n    const seatPattern = data.seatPattern ?? \"ABC-DEF\";\n\n    let normalizedSeatPattern: string;\n    try {\n        normalizedSeatPattern = validateSeatingLayout(\n            firstClassRows,\n            businessRows,\n            premiumEconomyRows,\n            economyRows,\n            seatPattern\n        );\n    } catch (error) {\n        return actionValidationFailure(\n            error instanceof Error ? error.message : 'Seating layout is invalid.',\n            'seatingConfig'\n        );\n    }\n\n    // Before the schedule is written, not after.\n    //\n    // The occurrence loop below resolves these to airports, and a place that is\n    // not an airport threw there — after the schedule had already been saved.\n    // The administrator saw a generic failure for a save that had in fact\n    // succeeded, because Next masks server-action messages in production. A\n    // place someone typed is fixable input, so it is reported the way every\n    // other fixable input in this action is.\n    // Both ends, not the first bad one: returning early left the other field\n    // looking valid and cost a second round trip to be told about it.\n    const unknownPlaces: Record<string, string> = {};\n    if (airportCodeFor(data.from) === null) {\n        unknownPlaces.from = `No airport is known for \"${data.from}\". Use a place the airline flies from, such as \"Seattle, USA\".`;\n    }\n    if (airportCodeFor(data.to) === null) {\n        unknownPlaces.to = `No airport is known for \"${data.to}\". Use a place the airline flies to, such as \"Detroit, USA\".`;\n    }\n    if (Object.keys(unknownPlaces).length > 0) {\n        return actionValidationFailures(unknownPlaces);\n    }\n\n    let savedSchedule;\n    if (data.id) {\n        savedSchedule = await prisma.flightSchedule.update({\n            where: { id: data.id },\n            data: {\n                flightNumber: data.flightNumber,\n                airline: data.airline,\n                from: data.from,\n                to: data.to,\n                departureTime: data.departureTime,\n                durationMinutes: data.durationMinutes,\n                daysOfWeek: data.daysOfWeek,\n                priceCents: parsePriceToCents(data.price),\n                firstClassRows,\n                businessRows,\n                premiumEconomyRows,\n                economyRows,\n                seatPattern: normalizedSeatPattern\n            }\n        });\n    } else {\n        savedSchedule = await prisma.flightSchedule.create({\n            data: {\n                flightNumber: data.flightNumber,\n                airline: data.airline,\n                from: data.from,\n                to: data.to,\n                departureTime: data.departureTime,\n                durationMinutes: data.durationMinutes,\n                daysOfWeek: data.daysOfWeek,\n                priceCents: parsePriceToCents(data.price),\n                firstClassRows,\n                businessRows,\n                premiumEconomyRows,\n                economyRows,\n                seatPattern: normalizedSeatPattern\n            }\n        });\n    }\n\n    // An inactive template remains editable for an eventual reactivation, but\n    // editing it must not quietly resume inventory generation.\n    if (savedSchedule.isActive !== false) {\n        // Pre-generate flights for the next 30 days from this schedule\n        const today = new Date();\n        const utcToday = new Date(Date.UTC(today.getUTCFullYear(), today.getUTCMonth(), today.getUTCDate()));\n        for (let i = 0; i < 30; i++) {\n            const date = new Date(utcToday);\n            date.setUTCDate(utcToday.getUTCDate() + i);\n            const dayOfWeek = date.getUTCDay();\n\n            if (savedSchedule.daysOfWeek.includes(dayOfWeek)) {\n                const dateStr = date.toISOString().split('T')[0];\n                const departureDate = departureInstantFor(dateStr, savedSchedule);\n            \n                // Check if flight instance already exists\n                const existingInstance = await prisma.flight.findFirst({\n                    where: {\n                        flightNumber: savedSchedule.flightNumber,\n                        departureDate: departureDate\n                    }\n                });\n\n                if (!existingInstance) {\n                    try {\n                        await prisma.flight.create({\n                            data: {\n                                flightScheduleId: savedSchedule.id,\n                                flightNumber: savedSchedule.flightNumber,\n                                airline: savedSchedule.airline,\n                                ...airportCodesForRoute(savedSchedule.from, savedSchedule.to),\n                                departureDate,\n                                priceCents: savedSchedule.priceCents,\n                                durationMinutes: savedSchedule.durationMinutes,\n                                status: 'ON_TIME',\n                                firstClassRows,\n                                businessRows,\n                                premiumEconomyRows,\n                                economyRows,\n                                seatPattern: normalizedSeatPattern\n                            }\n                        });\n                    } catch (error) {\n                        if (!(error && typeof error === 'object' && 'code' in error && error.code === 'P2002')) {\n                            throw error;\n                        }\n                    }\n                }\n            }\n        }\n    }\n\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a00e33-28bf-7050-b2f6-2b374830398b"}}}
