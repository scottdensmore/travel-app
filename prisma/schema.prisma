// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum Role {
  USER
  ADMIN
}

model User {
  id                      String                @id @default(cuid())
  name                    String?
  email                   String?               @unique
  emailVerified           DateTime?
  image                   String?
  password                String?
  role                    Role                  @default(USER)
  authVersion             Int                   @default(0)
  staffMfaSecretEncrypted String?               @db.Text
  staffMfaEnrolledAt      DateTime?
  staffMfaLastUsedStep    Int?
  accounts                Account[]
  sessions                Session[]
  bookings                Booking[]
  paymentAttempts         PaymentAttempt[]
  bookingStatusChanges    BookingStatusChange[]
  favorites               UserFavorite[]
  reviews                 Review[]
  notifications           Notification[]
}

model VerificationToken {
  identifier String   @unique
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@index([expires])
}

model AuthRateLimit {
  key         String   @id
  attempts    Int      @default(0)
  windowStart DateTime
  expiresAt   DateTime

  @@index([expiresAt])
}

model CityGuide {
  id          Int      @id @default(autoincrement())
  city        String
  country     String
  latlong     Float[]
  description String
  highlights  String[]
  coverImage  String?

  favorites UserFavorite[]
  reviews   Review[]
}

/// What state a booking is in.
///
/// `DISRUPTED` is a booking whose flight the airline cancelled: the seat is
/// still held and the customer still chooses between a refund and a rebooking,
/// which is what distinguishes it from a cancellation they asked for (#76).
enum BookingStatus {
  CONFIRMED
  CANCELLED
  DISRUPTED
}

/// An airline-caused replacement keeps the original captured fare. The
/// replacement may catalogue higher or lower, but neither an extra charge nor
/// a partial refund is created: the customer can still choose the full refund.
enum RebookingFarePolicy {
  DISRUPTION_WAIVER
}

/// The provider state of one checkout's payment session.
///
/// `CREATING` closes the crash window between reserving a durable attempt and
/// calling Stripe. A retry uses the attempt ID as Stripe's idempotency key, so
/// it can safely finish that call without creating a second intent.
enum PaymentAttemptStatus {
  CREATING
  REQUIRES_PAYMENT_METHOD
  REQUIRES_CONFIRMATION
  REQUIRES_ACTION
  PROCESSING
  AUTHORIZED
  CAPTURED
  CANCELLED
}

enum PaymentRefundStatus {
  PENDING
  REQUIRES_ACTION
  SUCCEEDED
  FAILED
  CANCELLED
}

/// Safe server-side payment metadata for one checkout.
///
/// Card details stay in Stripe Elements, and even the PaymentIntent client
/// secret is deliberately not stored here. The request fingerprint binds a
/// checkout UUID to the itinerary, seats and cabins that produced its quote.
model PaymentAttempt {
  id                   String               @id
  checkoutId           String
  userId               String?
  user                 User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  requestFingerprint   String
  amountCents          Int
  currency             String               @default("USD")
  providerIntentId     String?              @unique
  status               PaymentAttemptStatus @default(CREATING)
  capturedAt           DateTime?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  webhookEvents        PaymentWebhookEvent[]

  @@unique([userId, checkoutId])
  @@index([status, updatedAt])
}

/// One successfully reconciled Stripe event.
///
/// The raw webhook body is deliberately absent: it may contain customer and
/// payment-provider data that is unnecessary after signature verification.
model PaymentWebhookEvent {
  id                 String         @id
  eventType          String
  providerIntentId   String
  paymentAttemptId   String
  paymentAttempt     PaymentAttempt @relation(fields: [paymentAttemptId], references: [id], onDelete: Cascade)
  createdAt          DateTime       @default(now())

  @@index([providerIntentId])
  @@index([paymentAttemptId])
}

model Booking {
  id              Int           @id @default(autoincrement())
  createdAt       DateTime      @default(now())
  status          BookingStatus @default(CONFIRMED)
  paymentIntentId String?       @unique
  /// The booking total in minor units. Null for bookings taken before this
  /// column existed, which fall back to the flight's catalogue price.
  totalPriceCents Int?
  currency        String        @default("USD")
  idempotencyKey  String?

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  passengers    Passenger[]
  legs          ItineraryLeg[]
  statusChanges BookingStatusChange[]
  rebookings    BookingRebooking[]

  @@unique([userId, idempotencyKey])
}

/// One move between booking states, and the only record of the ones a booking
/// is no longer in.
///
/// Append-only, enforced by a trigger rather than by convention: cancellation,
/// disruption and refunds all have to be auditable, and a table that reaches
/// this state only while every caller cooperates is not an audit trail (#76).
/// Rows go when their booking goes -- the history of a booking that does not
/// exist has no subject, and blocking that cascade would make a booking
/// undeletable.
model BookingStatusChange {
  id          String         @id @default(cuid())
  bookingId   Int
  booking     Booking        @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  /// Null for the row that records the booking coming into existence.
  from        BookingStatus?
  to          BookingStatus
  reason      String?
  /// What this change owed the customer back, in minor units. Null where the
  /// change did not refund; zero is a different and real answer, since a
  /// cancellation inside the cut-off refunds nothing (#76).
  refundCents Int?
  /// Orders changes made in the same transaction, which `createdAt` cannot:
  /// it is transaction start time, so two changes there share an instant.
  /// A `BigInt` in the client, so a row handed straight to a client component
  /// fails to serialise -- select what you need rather than the whole row.
  sequence    BigInt         @default(autoincrement())
  /// Who caused it. Null for a customer acting on their own booking, and for a
  /// change nothing attributes.
  actorUserId String?
  actor       User?          @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  paymentRefund PaymentRefund?
  rebooking   BookingRebooking?
  createdAt   DateTime       @default(now())

  @@index([bookingId, createdAt])
  @@index([bookingId, sequence])
}

/// The immutable audit event for replacing one or more disrupted itinerary
/// legs while retaining the booking, passengers, reference and captured fare.
/// The status change records the customer-visible DISRUPTED -> CONFIRMED move;
/// this row records why it happened and which legs replaced which.
model BookingRebooking {
  id                    String                @id @default(cuid())
  bookingId             Int
  booking               Booking               @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  bookingStatusChangeId String                @unique
  bookingStatusChange   BookingStatusChange   @relation(fields: [bookingStatusChangeId], references: [id], onDelete: NoAction)
  farePolicy            RebookingFarePolicy   @default(DISRUPTION_WAIVER)
  legs                  BookingRebookingLeg[]
  createdAt             DateTime              @default(now())

  @@index([bookingId, createdAt])
}

/// One old-to-new leg mapping within a rebooking. PostgreSQL additionally
/// requires both legs to belong to the event's booking and occupy the same
/// itinerary position, with only the destination leg still active.
model BookingRebookingLeg {
  rebookingId String
  rebooking   BookingRebooking @relation(fields: [rebookingId], references: [id], onDelete: Cascade)
  fromLegId   Int              @unique
  fromLeg     ItineraryLeg     @relation("RebookingFromLeg", fields: [fromLegId], references: [id], onDelete: Cascade)
  toLegId     Int              @unique
  toLeg       ItineraryLeg     @relation("RebookingToLeg", fields: [toLegId], references: [id], onDelete: Cascade)

  @@id([rebookingId, fromLegId])
}

/// One provider refund for the exact amount recorded by a cancellation.
///
/// The immutable status-change row remains the policy decision; this row is
/// the durable delivery state used to make Stripe retries idempotent without
/// retaining provider payloads or customer payment data.
model PaymentRefund {
  id                    String              @id @default(cuid())
  bookingStatusChangeId String              @unique
  bookingStatusChange   BookingStatusChange @relation(fields: [bookingStatusChangeId], references: [id], onDelete: Cascade)
  providerIntentId      String
  amountCents           Int
  currency              String              @default("USD")
  status                PaymentRefundStatus @default(PENDING)
  attempts              PaymentRefundAttempt[]
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@index([providerIntentId])
  @@index([status, updatedAt])
}

/// One durable provider submission. A terminally failed attempt is retained;
/// a retry creates another row and therefore another stable idempotency key.
model PaymentRefundAttempt {
  id               String              @id
  paymentRefundId  String
  paymentRefund    PaymentRefund       @relation(fields: [paymentRefundId], references: [id], onDelete: Cascade)
  providerRefundId String?             @unique
  status           PaymentRefundStatus @default(PENDING)
  sequence         BigInt              @default(autoincrement())
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@index([paymentRefundId, sequence])
}

model Passenger {
  id                      String    @id @default(cuid())
  firstName               String
  lastName                String
  dateOfBirthEncrypted    String?   @db.Text
  passportNumberEncrypted String?   @db.Text
  sensitiveDataExpiresAt  DateTime?
  sensitiveDataDeletedAt  DateTime?
  gender                  String

  bookingId Int
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  /// Where this traveller sits: one per leg. A traveller is a person; a seat
  /// belongs to a flight, so the two are separate records (#137).
  seatAssignments SeatAssignment[]

  @@index([sensitiveDataExpiresAt])
}

/// Whether a flight is running.
///
/// Typed in the database rather than left as free text: the column was
/// `TEXT NOT NULL DEFAULT 'ON_TIME'` with no constraint, so the three-status
/// rule lived only in `flightStatusSchema` at the request boundary. A status
/// written any other way would be filtered on by search and rendered on the
/// status board to a customer checking whether their flight is running (#73).
enum FlightStatus {
  ON_TIME
  DELAYED
  CANCELLED
}

model Flight {
  id              Int          @id @default(autoincrement())
  flightNumber    String
  airline         String
  /// Where this flight goes, and the only place it says so. The route was also
  /// stored as free text until #73: prose that was simultaneously the identity
  /// of a place and the words shown to a customer, so editing it repointed the
  /// route. The label lives on `Airport` and is read through these.
  fromAirportCode String
  toAirportCode   String
  fromAirport     Airport      @relation("FlightOrigin", fields: [fromAirportCode], references: [iataCode])
  toAirport       Airport      @relation("FlightDestination", fields: [toAirportCode], references: [iataCode])
  /// The instant the flight leaves, not a local wall clock. Built from the
  /// schedule's local time and the origin airport's zone; compare against it
  /// freely, and render it only through `lib/flightTime` (#84).
  departureDate   DateTime     @db.Timestamptz(3)
  /// Elapsed minutes gate to gate. The arrival instant is this added to the
  /// departure -- not stored, because a second answer can disagree with the
  /// first. Null for a flight created outside a schedule, which then shows no
  /// arrival rather than an invented one (#84).
  durationMinutes Int?
  /// The fare in minor units. The only form the fare is stored in (#135).
  priceCents      Int
  status          FlightStatus @default(ON_TIME)

  /// The repeating template that generated this occurrence. Null is honest for
  /// manually authored flights and historical rows whose provenance cannot be
  /// established unambiguously (#237).
  flightScheduleId Int?
  flightSchedule   FlightSchedule? @relation(fields: [flightScheduleId], references: [id], onDelete: SetNull)

  firstClassRows     Int?
  businessRows       Int?
  premiumEconomyRows Int?
  economyRows        Int?
  seatPattern        String?

  itineraryLegs   ItineraryLeg[]
  seatAssignments SeatAssignment[]
  seatHolds       SeatHold[]

  @@unique([flightNumber, departureDate])
  /// Every search and the status board range-scan this (#167).
  @@index([departureDate])
  @@index([flightScheduleId])
  @@index([fromAirportCode])
  @@index([toAirportCode])
}

model UserFavorite {
  id          String   @id @default(cuid())
  userId      String
  cityGuideId Int
  createdAt   DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  cityGuide CityGuide @relation(fields: [cityGuideId], references: [id], onDelete: Cascade)

  @@unique([userId, cityGuideId])
}

model Review {
  id          String   @id @default(cuid())
  content     String
  rating      Int
  userId      String
  cityGuideId Int
  createdAt   DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  cityGuide CityGuide @relation(fields: [cityGuideId], references: [id], onDelete: Cascade)
}

model FlightSchedule {
  id              Int     @id @default(autoincrement())
  flightNumber    String
  airline         String
  from            String
  to              String
  departureTime   String
  /// Elapsed minutes gate to gate, stated rather than inferred: subtracting
  /// local times across a timezone is not a duration, and is an hour wrong
  /// twice a year even within one (#84).
  durationMinutes Int
  daysOfWeek      Int[]
  /// The fare in minor units. The only form the fare is stored in (#135).
  priceCents      Int
  isActive        Boolean @default(true)

  firstClassRows     Int?
  businessRows       Int?
  premiumEconomyRows Int?
  economyRows        Int?
  seatPattern        String?

  flights Flight[]
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      String // "FLIGHT_STATUS" | "POINTS" | "SYSTEM"
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, isRead])
}

/// Reference data for the places routes fly between. Flights use IATA codes as
/// foreign keys; `label` is the customer-facing city and country text used by
/// search controls and route displays.
model Airport {
  iataCode String @id
  label    String @unique
  city     String
  country  String
  timeZone String

  departures Flight[] @relation("FlightOrigin")
  arrivals   Flight[] @relation("FlightDestination")
}

/// One flight within a booking. A booking is its own itinerary, so there is no
/// separate itinerary table: it would be one-to-one with Booking and carry no
/// columns of its own. `sequence` orders the legs, 1 being the outbound.
model ItineraryLeg {
  id        Int     @id @default(autoincrement())
  bookingId Int
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  sequence  Int
  flightId  Int
  flight    Flight  @relation(fields: [flightId], references: [id])

  /// Set once this position is replaced. Historical legs and their released
  /// seats stay attached to the booking; every current reader selects only
  /// rows where this is null.
  supersededAt DateTime?

  seatAssignments       SeatAssignment[]
  rebookingOrigins      BookingRebookingLeg[] @relation("RebookingFromLeg")
  rebookingDestinations BookingRebookingLeg[] @relation("RebookingToLeg")

  /// The one-active-leg-per-position rule is a partial unique index where
  /// supersededAt IS NULL, which Prisma cannot express. The rebooking
  /// migration creates it and replaces the former unconditional unique key.
  /// Lets a seat assignment reference (legId, flightId) together, so its
  /// denormalised flightId can never disagree with the leg's flight.
  @@unique([id, flightId])
  @@index([flightId])
  @@index([bookingId, supersededAt, sequence])
}

/// The cabins the airline sells.
///
/// Typed in the database rather than left as free text: the column was
/// `TEXT NOT NULL` with no constraint, so the four-cabin rule lived only in the
/// Zod schema at the request boundary and anything reaching the table another
/// way could write nonsense that every read path would then believe (#73).
enum CabinClass {
  ECONOMY
  PREMIUM_ECONOMY
  BUSINESS
  FIRST
}

/// A seat a customer is part-way through choosing.
///
/// Distinct from `SeatAssignment`, which records a seat somebody has actually
/// bought. A hold is a claim with a deadline: it stops the seat being offered
/// to anyone else while one customer is at the payment step, and stops meaning
/// anything the moment it expires (#74).
///
/// Nothing sweeps these. An abandoned checkout costs the airline nothing
/// because the row stops being live on its own, so there is no job whose
/// failure would quietly reduce inventory -- which is the acceptance criterion
/// this shape is chosen for.
model SeatHold {
  id         String   @id
  flightId   Int
  flight     Flight   @relation(fields: [flightId], references: [id], onDelete: Cascade)
  seatNumber String
  /// One server-derived user + checkout identity. This is not a relation: the
  /// checkout UUID scopes two tabs for one account independently.
  holderKey  String
  /// The migration writes `DEFAULT now()`, so the database supplies this. No
  /// production path calls `prisma.seatHold.create` -- the claim is one raw
  /// `INSERT ... ON CONFLICT` -- and the `expiresAt > createdAt` check would
  /// reject a row whose two times came from clocks that disagreed.
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  expiresAt  DateTime @db.Timestamptz(3)

  /// One live claim per seat. Expired rows stay in the table and are taken
  /// over in place, so this is unconditional rather than partial: a second row
  /// for the same seat should never exist even when the first is dead.
  @@unique([flightId, seatNumber])
  @@index([expiresAt])
  @@index([holderKey])
}

/// Where one traveller sits on one leg. Separated from Passenger because a
/// traveller is one person per booking while a seat is one per leg: a round trip
/// would otherwise need a second Passenger row, duplicating that person's
/// encrypted passport and date of birth along with their retention deadlines.
///
/// flightId is denormalised from the leg so that the seat-uniqueness constraint
/// can be expressed directly. A composite foreign key onto (id, flightId) of the
/// leg keeps the two in agreement.
model SeatAssignment {
  id          String       @id @default(cuid())
  passengerId String
  passenger   Passenger    @relation(fields: [passengerId], references: [id], onDelete: Cascade)
  legId       Int
  flightId    Int
  leg         ItineraryLeg @relation(fields: [legId, flightId], references: [id, flightId], onDelete: Cascade)
  flight      Flight       @relation(fields: [flightId], references: [id])
  seatNumber  String
  cabinClass  CabinClass
  /// When the seat was let go, and null while it is still held. Cancelling used
  /// to overwrite `seatNumber` instead, because the unique index could not tell
  /// a held seat from a released one and so held it forever (#76).
  releasedAt  DateTime?

  /// A traveller sits in exactly one seat on any given leg.
  @@unique([passengerId, legId])
  /// The guard against two customers acquiring the same seat is a *partial*
  /// unique index on (flightId, seatNumber) WHERE "releasedAt" IS NULL, which
  /// Prisma cannot express and therefore does not manage. It is created in
  /// `20260810050000_release_seats_without_renaming`. Declaring the
  /// unconditional form here would recreate exactly the constraint that
  /// migration removes.
  @@index([flightId, releasedAt])
}
