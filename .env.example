# Local development values only. Replace every value for deployed environments.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/travel_app
# The test suites delete every booking in this database before they run.
# Only ever true where losing the contents does not matter. Never set it in
# an environment that deploys this application.
DATABASE_IS_DISPOSABLE=true
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=
# Comma-separated key-id:base64-key entries. The first 32-byte key is active;
# retain older keys while rotating existing ciphertext. Generate a key with:
# openssl rand -base64 32
PASSENGER_DATA_ENCRYPTION_KEYS=
# Separate key ring used only to encrypt staff authenticator secrets.
STAFF_MFA_ENCRYPTION_KEYS=
# Direct local development does not trust forwarded addresses. The bundled
# Docker proxy supplies its own production-safe value to the app container.
AUTH_TRUSTED_PROXY_HOPS=0

# Stripe test-mode server credential. Checkout payment setup fails closed when
# this is empty; use a test key locally and inject the live key only at runtime.
STRIPE_SECRET_KEY=
# Public browser key for Stripe Elements. It is returned to checkout only after
# the authenticated server creates or resumes that checkout's PaymentIntent.
STRIPE_PUBLISHABLE_KEY=
# Signing secret for POST /api/stripe/webhook. For local forwarding, copy the
# whsec_ value printed by `stripe listen`; deployments inject their endpoint's
# own secret at runtime.
STRIPE_WEBHOOK_SECRET=

# Local email testing uses the loopback-only Mailpit service from Compose.
AUTH_EMAIL_FROM=Mona Airways <no-reply@localhost>
AUTH_EMAIL_PROVIDER=mailpit
AUTH_EMAIL_API_URL=http://localhost:8025/api/v1/send
AUTH_EMAIL_API_TOKEN=
