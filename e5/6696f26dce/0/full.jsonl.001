{"timestamp":"2026-08-16T02:26:11.344Z","ordinal":20374,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a00864-1310-7d61-8353-ace9d40bf644","call_id":"call_RyUAU6F9x2M4ozDUDTN45Lc4","output":[{"type":"input_text","text":"Script completed\nWall time 4.2 seconds\nOutput:\n"},{"type":"input_text","text":"import { defineConfig, devices } from '@playwright/test';\n\nexport default defineConfig({\n  testDir: './e2e',\n  /* Run tests in files in parallel */\n  fullyParallel: false,\n  /* Fail the build on CI if you accidentally left test.only in the source code. */\n  forbidOnly: !!process.env.CI,\n  /* Retry on CI only */\n  retries: process.env.CI ? 2 : 0,\n  /* Opt out of parallel tests on CI to avoid DB collisions */\n  workers: 1,\n  /* Reporter to use. See https://playwright.dev/docs/reporters */\n  reporter: process.env.CI ? 'dot' : 'html',\n  globalSetup: './e2e/global-setup.ts',\n  globalTeardown: './e2e/global-teardown.ts',\n  /* Shared settings for all the projects below. See https://playwright.dev/docs/api/class-testoptions. */\n  use: {\n    /* Base URL to use in actions like `await page.goto('/')`. */\n    baseURL: 'http://localhost:3000',\n\n    /* Collect trace when retrying the failed test. See https://playwright.dev/docs/trace-viewer */\n    trace: 'on-first-retry',\n    screenshot: 'only-on-failure',\n  },\n\n  /* Configure projects for major browsers */\n  projects: [\n    {\n      name: 'chromium',\n      use: { ...devices['Desktop Chrome'] },\n    },\n  ],\n\n  /* Run your local dev server before starting the tests */\n  webServer: {\n    command: 'npm run dev',\n    env: {\n      ...process.env,\n      E2E_STRIPE_MODE: 'playwright',\n    },\n    url: 'http://localhost:3000',\n    // Never reuse a server this run did not start.\n    //\n    // Reusing one silently served stale output: a healthy branch failed three\n    // runs out of three and looked like a regression, and the bisect that\n    // followed was worthless because `npm run build` changes nothing when the\n    // server is `next dev`. The mirror case is worse -- a stale server can\n    // report a pass for code that is not the code under test (#196).\n    //\n    // The cost is that a dev server already on this port now stops the suite\n    // rather than being borrowed. That is the point: a loud refusal beats a\n    // quiet wrong answer.\n    reuseExistingServer: false,\n    stdout: 'ignore',\n    stderr: 'pipe',\n    timeout: 120000,\n  },\n});\nplaywright.config.ts:8:  forbidOnly: !!process.env.CI,\nplaywright.config.ts:10:  retries: process.env.CI ? 2 : 0,\nplaywright.config.ts:14:  reporter: process.env.CI ? 'dot' : 'html',\nplaywright.config.ts:39:      ...process.env,\ne2e/helpers/mailpit.ts:3:const mailpitUrl = process.env.MAILPIT_HTTP_URL ?? 'http://127.0.0.1:8025';\ne2e/auth-recovery.spec.ts:14:  const secret = process.env.NEXTAUTH_SECRET;\ne2e/auth-abuse.spec.ts:14:  const rateLimitSecret = process.env.NEXTAUTH_SECRET;\ne2e/global-setup.ts:96: * about the database, not about them. `.env.example` and CI set it; nothing\ne2e/global-setup.ts:108: * `travel_app` is the only name the repository configures -- `.env.example`,\ne2e/global-setup.ts:120: * `DATABASE_URL` catastrophic and silent: point it at staging, run `npm test`\ne2e/global-setup.ts:128:  const databaseUrl = process.env.DATABASE_URL;\ne2e/global-setup.ts:130:    throw new Error('Refusing to clear bookings: DATABASE_URL is not set.');\ne2e/global-setup.ts:133:  if (process.env[DISPOSABLE_MARKER] !== 'true') {\ne2e/global-setup.ts:138:      + 'to the .env you use for development and testing -- and never to one that deploys '\ne2e/global-setup.ts:152:    throw new Error('Refusing to clear bookings: DATABASE_URL is not a URL this can check.');\ne2e/global-setup.ts:157:      `Refusing to clear bookings: DATABASE_URL points at host \"${host}\", which is not one `\ne2e/global-setup.ts:159:      + 'Point DATABASE_URL at a local or Compose database before r