derIntentId: true,\n    87\t          amountCents: true,\n    88\t          currency: true,\n    89\t          createdAt: true,\n    90\t        },\n    91\t      })\n    92\t    : [];\n    93\t  const capturedPaymentByIntent = new Map(\n    94\t    capturedPayments.flatMap(payment => payment.providerIntentId\n    95\t      ? [[payment.providerIntentId, payment] as const]\n    96\t      : []\n    97\t    )\n    98\t  );\n    99\t\n   100\t  const userFavorites = await prisma.userFavorite.findMany({\n   101\t    where: { userId },\n   102\t    include: { cityGuide: true },\n   103\t    orderBy: { createdAt: \"desc\" }\n   104\t  });\n   105\t\n   106\t  const userReviews = await prisma.review.findMany({\n   107\t    where: { userId },\n   108\t    include: { cityGuide: true },\n   109\t    orderBy: { createdAt: \"desc\" }\n   110\t  });\n   111\t\n   112\t  // The route each leg renders comes from the airports its flight references.\n   113\t  // Resolved once here so the client component and the points activity both\n   114\t  // keep receiving a flight with `from` and `to` on it (#73).\n   115\t  const bookings = userBookings.map(booking => ({\n   116\t    ...booking,\n   117\t    legs: booking.legs.map(withLegRouteLabels),\n   118\t  }));\n   119\t  const customerBookings = bookings.map(booking => {\n   120\t    const capturedPayment = booking.paymentIntentId\n   121\t      ? capturedPaymentByIntent.get(booking.paymentIntentId)\n   122\t      : undefined;\n   123\t    // These identifiers are useful only to server-side idempotency and provider\n   124\t    // reconciliation. Do not make them part of customer-facing history.\n   125\t    const {\n   126\t      paymentIntentId: _paymentIntentId,\n   127\t      idempotencyKey: _idempotencyKey,\n   128\t      userId: _userId,\n   129\t      ...customerBooking\n   130\t    } = booking;\n   131\t\n   132\t    return {\n   133\t      ...customerBooking,\n   134\t      paymentReceipt: capturedPayment\n   135\t        ? {\n   136\t            amountCents: capturedPayment.amountCents,\n   137\t            currency: capturedPayment.currency,\n   138\t            paidAt: capturedPayment.createdAt,\n   139\t          }\n   140\t        : null,\n   141\t    };\n   142\t  });\n   143\t\n   144\t  const pointsActivityService = new PointsActivityService(bookings);\n   145\t  const activityData = pointsActivityService.getPointsActivity();\n   146\t  const currentPoints = pointsActivityService.getCurrentPoints();\n   147\t  const currentStatus = pointsActivityService.getCurrentStatus();\n   148\t  const monthlyHistory = pointsActivityService.getMonthlyPointsActivity();\n   149\t\n   150\t  return (\n   151\t    <ProfileClient \n   152\t      userName={userName}\n   153\t      userAvatar={userAvatar}\n   154\t      currentStatus={currentStatus}\n   155\t      currentPoints={currentPoints}\n   156\t      bookings={customerBookings}\n   157\t      favorites={userFavorites}\n   158\t      reviews={userReviews}\n   159\t      activityData={activityData}\n   160\t      monthlyHistory={monthlyHistory}\n   215\t    activityData,\n   216\t    monthlyHistory,\n   217\t    renderedAt,\n   218\t}: ProfileClientProps) {\n   219\t    const router = useRouter();\n   220\t    const [isPending, startTransition] = useTransition();\n   221\t    const [activeRefundBookingId, setActiveRefundBookingId] = useState<number | null>(null);\n   222\t    const [refundFeedback, setRefundFeedback] = useState<{\n   223\t        bookingId: number;\n   224\t        message: string;\n   225\t        focus: boolean;\n   226\t    } | null>(null);\n   227\t    const refundFeedbackRef = useRef<HTMLParagraphElement | null>(null);\n   228\t    const bookingsRegionRef = useRef<HTMLDivElement | null>(null);\n   229\t    const receiptBookings = bookings.filter(booking => booking.paymentReceipt);\n   230\t\n   231\t    useEffect(() => {\n   232\t        if (refundFeedback?.focus) refundFeedbackRef.current?.focus();\n   233\t    }, [refundFeedback]);\n   234\t    /**\n   235\t     * Whether the region still scrolls sideways.\n   236\t     *\n   237\t     * At 767px and below the table lays each booking out as a stacked card and\n   238\t     * nothing overflows, which is what put the Cancel button back inside a\n   239\t     * phone's viewport (#240). 767 rather than 640 because the table wants\n   240\t     * 590px inside a region narrower than the window: a breakpoint under that\n   690\t                                            ))}\n   691\t                                        </tbody>\n   692\t                                    );\n   693\t                                })}\n   694\t                            </table>\n   695\t                        </div>\n   696\t                    ) : (\n   697\t                        <p className=\"text-gray-500 italic\">You have no bookings yet.</p>\n   698\t                    )}\n   699\t                </div>\n   700\t\n   701\t                <section className=\"profile-card mt-8\" aria-labelledby=\"payment-history-heading\">\n   702\t                    <h2 id=\"payment-history-heading\" className=\"text-2xl font-bold mb-4\">Payment history</h2>\n   703\t                    {receiptBookings.length > 0 ? (\n   704\t                        <div className=\"payment-history-list\">\n   705\t                            {receiptBookings.map(booking => {\n   706\t                                const receipt = booking.paymentReceipt!;\n   707\t                                const flightNumbers = orderedLegs(booking)\n   708\t                                    .flatMap(leg => leg.flight ? [leg.flight.flightNumber] : []);\n   709\t                                const refund = booking.statusChanges?.[0]?.paymentRefund ?? null;\n   710\t                                const refundOutcome = refund\n   711\t                                    ? refund.status === 'SUCCEEDED'\n   712\t                                        ? `${formatPrice(refund.amountCents)} ${receipt.currency} refunded`\n   713\t                                        : refund.status === 'PENDING'\n   714\t                                            ? `${formatPrice(refund.amountCents)} ${receipt.currency} refund pending`\n   715\t                                            : `${formatPrice(refund.amountCents)} ${receipt.currency} refund needs attention`\n   716\t                                    : null;\n   717\t                                return (\n   718\t                                    <article\n   719\t                                        key={booking.id}\n   720\t                                        className=\"payment-receipt-card\"\n   721\t                                        aria-label={`Receipt for booking ${booking.id}`}\n   722\t                                    >\n   723\t                                        <div>\n   724\t                                            <p className=\"payment-receipt-eyebrow\">Payment receipt</p>\n   725\t                                            <h3>Booking {booking.id}</h3>\n   726\t                                        </div>\n   727\t                                        <div className=\"payment-receipt-details\">\n   728\t                                            <p>Paid <strong>{formatPrice(receipt.amountCents)} {receipt.currency}</strong></p>\n   729\t                                            <p>\n   730\t                                                <span>Payment date </span>\n   731\t                                                <time dateTime={new Date(receipt.paidAt).toISOString()}>\n   732\t                                                    {formatReceiptDate(receipt.paidAt)}\n   733\t                                                </time>\n   734\t                                            </p>\n   735\t                                            <p>Flights {flightNumbers.join(', ') || 'unavailable'}</p>\n   736\t                                            {refundOutcome && <p>{refundOutcome}</p>}\n   737\t                                        </div>\n   738\t                                    </article>\n   739\t                                );\n   740\t                            })}\n   741\t                        </div>\n   742\t                    ) : (\n   743\t                        <p className=\"text-gray-500 italic\">No payment receipts yet.</p>\n   744\t                    )}\n   745\t                </section>\n   746\t\n   747\t                {/* Favorites Section */}\n   748\t                <div className=\"profile-card mt-8\">\n   749\t                    <h2 className=\"text-2xl font-bold mb-4\">Favorite City Guides</h2>\n   750\t                    {favorites.length > 0 ? (\n   751\t                        <div className=\"grid grid-cols-1 md:grid-cols-2 gap-4\" style={{ display: 'grid', gridTemplateColumns: 'repeat(auto-fill, minmax(220px, 1fr))', gap: '1rem' }}>\n   752\t                            {favorites.map((fav) => (\n   753\t                                <div key={fav.id} className=\"border rounded-lg p-4 bg-gray-50 flex flex-col justify-between\" style={{ border: '1px solid rgba(255, 255, 255, 0.1)', borderRadius: '8px', padding: '1rem', backgroundColor: 'rgba(255, 255, 255, 0.02)', display: 'flex', flexDirection: 'column', justifyContent: 'space-between' }}>\n   754\t                                    <div>\n   755\t                                        {fav.cityGuide.coverImage && (\n   756\t                                            <img src={fav.cityGuide.coverImage} alt={fav.cityGuide.city} style={{ width: '100%', height: '120px', objectFit: 'cover', borderRadius: '4px', marginBottom: '8px' }} />\n   757\t                                        )}\n   758\t                                        <h3 style={{ margin: '0 0 4px', fontSize: '1.1rem', color: '#fff' }}>{fav.cityGuide.city}</h3>\n   759\t                                        <p style={{ margin: '0 0 12px', color: 'rgba(255, 255, 255, 0.6)', fontSize: '0.9rem' }}>{fav.cityGuide.country}</p>\n   760\t                                    </div>\n  1210\t  text-align: left;\n  1211\t}\n  1212\t\n  1213\t.refund-action-feedback:focus {\n  1214\t  outline: 3px solid #fbbf24;\n  1215\t  outline-offset: 3px;\n  1216\t  box-shadow: 0 0 0 5px rgba(251, 191, 36, 0.28);\n  1217\t}\n  1218\t\n  1219\t.payment-history-list {\n  1220\t  display: grid;\n  1221\t  gap: 12px;\n  1222\t  grid-template-columns: repeat(auto-fit, minmax(min(100%, 250px), 1fr));\n  1223\t}\n  1224\t\n  1225\t.payment-receipt-card {\n  1226\t  background: rgba(255, 255, 255, 0.03);\n  1227\t  border: 1px solid rgba(255, 255, 255, 0.14);\n  1228\t  border-radius: 8px;\n  1229\t  display: flex;\n  1230\t  flex-direction: column;\n  1231\t  gap: 12px;\n  1232\t  padding: 16px;\n  1233\t}\n  1234\t\n  1235\t.payment-receipt-card h3,\n  1236\t.payment-receipt-card p {\n  1237\t  margin: 0;\n  1238\t}\n  1239\t\n  1240\t.payment-receipt-eyebrow {\n  1241\t  color: #c4b5fd;\n  1242\t  font-size: 0.7rem;\n  1243\t  font-weight: 700;\n  1244\t  letter-spacing: 0.06em;\n  1245\t  text-transform: uppercase;\n  1246\t}\n  1247\t\n  1248\t.payment-receipt-details {\n  1249\t  color: rgba(255, 255, 255, 0.82);\n  1250\t  display: grid;\n  1251\t  font-size: 0.85rem;\n  1252\t  gap: 6px;\n  1253\t}\n  1254\t\n  1255\t/* Eyes only, and only when stacked: the header row is still read out. */\n  1256\t.cell-label {\n  1257\t  display: none;\n  1258\t}\n  1259\t\n  1260\t@media (max-width: 767px) {\n  1261\t  .bookings-table,\n  1262\t  .bookings-table td {\n  1263\t    display: block;\n  1264\t    width: auto;\n  1265\t  }\n   185\t    // Verify booking list\n   186\t    await expect(page).toHaveURL('/profile');\n   187\t    await expect(page.locator('h2:has-text(\"My Bookings\")')).toBeVisible();\n   188\t    \n   189\t    const bookingRows = page.locator('table tbody tr');\n   190\t    await expect(bookingRows.first()).toBeVisible();\n   191\t\n   192\t    const receipt = page.getByRole('article', {\n   193\t      name: `Receipt for booking ${persistedBooking.id}`,\n   194\t    });\n   195\t    await expect(receipt).toBeVisible();\n   196\t    await expect(receipt).toContainText(`Paid ${expectedTotal.formatted} USD`);\n   197\t    await expect(receipt).toContainText(targetFlight.flightNumber);\n   198\t    await expect(page.getByText(persistedBooking.paymentIntentId!)).toHaveCount(0);\n   199\t    await expect(page.getByText(persistedBooking.idempotencyKey!)).toHaveCount(0);\n   200\t    await page.setViewportSize({ width: 390, height: 844 });\n   201\t    const phoneReceiptBox = await receipt.boundingBox();\n   202\t    expect(phoneReceiptBox).not.toBeNull();\n   203\t    expect(phoneReceiptBox!.x).toBeGreaterThanOrEqual(0);\n   204\t    expect(phoneReceiptBox!.x + phoneReceiptBox!.width).toBeLessThanOrEqual(390);\n   205\t    await expect.poll(() => page.evaluate(() => ({\n   206\t      clientWidth: document.documentElement.clientWidth,\n   207\t      scrollWidth: document.documentElement.scrollWidth,\n   208\t    }))).toEqual({ clientWidth: 390, scrollWidth: 390 });\n   209\t    await page.setViewportSize({ width: 1280, height: 720 });\n   210\t    \n   211\t    // Verify points balance has increased (non-zero status points)\n   212\t    const pointsText = await page.locator('p:has-text(\"Status Points\")').textContent();\n   213\t    expect(pointsText).not.toBeNull();\n   214\t    const pointsNum = parseInt(pointsText?.replace(/[^0-9]/g, '') || '0', 10);\n   215\t    expect(pointsNum).toBeGreaterThan(0);\n   216\t\n   217\t    // --- CHANGE SEATS FLOW ---\n   218\t    await page.click('button:has-text(\"Change Seats\")');\n   219\t    await expect(page.locator('h2:has-text(\"Change Seats\")')).toBeVisible();\n   220\t\n   258\t    // load `releasedAt` *and* render from it -- drop either and this prints\n   259\t    // 11B, a seat the customer no longer holds and somebody else may (#76).\n   260\t    await expect(page.locator('text=Bob (Seat released)')).toBeVisible();\n   261\t    await expect(page.locator('text=Bob (Seat 11B)')).not.toBeVisible();\n   262\t\n   263\t    // The paid booking crosses the real cancellation action and the guarded\n   264\t    // provider boundary. One Economy fare keeps 20%; the rest is delivered by\n   265\t    // one durable refund request and one successful provider attempt.\n   266\t    const expectedRefundCents = expectedTotal.cents - Math.floor(expectedTotal.cents * 20 / 100);\n   267\t    await expect(page.getByTestId(`booking-refund-${persistedBooking.id}`))\n   268\t      .toHaveText(`${formatPrice(expectedRefundCents)} refund sent.`);\n   269\t    await expect(receipt).toContainText(`${formatPrice(expectedRefundCents)} USD refunded`);\n   270\t    await expect(page.getByRole('button', { name: 'Retry Refund' })).toHaveCount(0);\n   271\t    const refund = await prisma.paymentRefund.findFirstOrThrow({\n   272\t      where: { bookingStatusChange: { bookingId: persistedBooking.id } },\n   273\t      include: { attempts: true },\n   274\t    });\n   275\t    expect(refund).toMatchObject({\n## feat/75-payment-receipts\n M __tests__/components/ProfileClient.test.tsx\n M app/globals.css\n M app/profile/page.tsx\n M components/ui/ProfileClient.tsx\n M e2e/booking.spec.ts\n?? __tests__/app/profilePaymentHistory.database.test.ts\n","stderr":"","aggregated_output":"    65\t            select: { amountCents: true, status: true },\n    66\t          },\n    67\t        },\n    68\t      },\n    69\t    },\n    70\t  });\n    71\t\n    72\t  // A booking exists only after capture, but the durable attempt remains the\n    73\t  // authoritative payment record. Select only captured rows, then project a\n    74\t  // receipt below without sending Stripe IDs, checkout IDs or fingerprints to\n    75\t  // the client (#75).\n    76\t  const providerIntentIds = userBookings.flatMap(booking =>\n    77\t    booking.pay