{
  "name": "travel-app",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/sanitize-standalone.mjs",
    "start": "next start",
    "lint": "eslint app components lib e2e __tests__",
    "test": "npm run test:unit && npm run test:database",
    "test:unit": "npx jest --selectProjects unit",
    "test:database": "npx jest --selectProjects database --runInBand",
    "inventory:generate": "ts-node --compiler-options '{\"module\":\"CommonJS\"}' scripts/generate-inventory.ts",
    "inventory:check": "ts-node --compiler-options '{\"module\":\"CommonJS\"}' scripts/check-inventory.ts",
    "airports:generate": "ts-node --compiler-options '{\"module\":\"CommonJS\"}' scripts/generate-airports.ts",
    "airports:check": "ts-node --compiler-options '{\"module\":\"CommonJS\"}' scripts/generate-airports.ts --check",
    "verify:repo": "node scripts/verify-repo-policy.mjs"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@prisma/client": "^5.10.2",
    "@radix-ui/react-icons": "^1.3.2",
    "@stripe/react-stripe-js": "^6.8.1",
    "@stripe/stripe-js": "^9.13.0",
    "@tanstack/react-table": "^8.20.5",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.57.0",
    "next": "16.4.2",
    "next-auth": "^4.24.15",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-simple-maps": "^3.0.0",
    "recharts": "^3.10.1",
    "stripe": "^23.0.0",
    "tailwind-merge": "^2.5.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@babel/core": "^7.29.6",
    "@babel/preset-env": "^7.25.2",
    "@babel/preset-react": "^7.25.9",
    "@babel/preset-typescript": "^7.25.9",
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^26",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.3",
    "eslint-config-next": "16.4.2",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "postcss": "^8.5.18",
    "prisma": "^5.10.2",
    "tailwindcss": "^3.4.1",
    "tailwindcss-animate": "^1.0.7",
    "ts-node": "^10.9.2",
    "typescript": "^5"
  },
  "prisma": {
    "seed": "ts-node --compiler-options {\"module\":\"CommonJS\"} prisma/seed.ts"
  },
  "overrides": {
    "react": "$react",
    "react-dom": "$react-dom",
    "next-auth": {
      "@auth/core": "0.41.3",
      "uuid": "^11.1.1"
    },
    "next": {
      "sharp": "^0.35.5"
    },
    "react-simple-maps": {
      "d3-geo": "^3.1.1",
      "d3-selection": "^3.0.0",
      "d3-zoom": "^3.0.0"
    },
    "d3-drag": "^3.0.0",
    "d3-color": "^3.1.0",
    "d3-transition": "^3.0.1",
    "postcss": "^8.5.18",
    "nanoid": "^3.3.17",
    "postcss-selector-parser": "7.1.6",
    "js-yaml": "^4.1.1",
    "braces": "file:vendor/braces-3.0.4.tgz"
  }
}
